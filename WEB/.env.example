# Default local demo remains network-isolated. For an authorized API integration
# candidate use VITE_APP_MODE=api-integration in an untracked .env.local.
VITE_APP_MODE=mock-demo

# Required only in api-integration mode, for example http://127.0.0.1:8080.
VITE_API_BASE_URL=

# Optional browser Key for Tencent Location Service JavaScript API GL.
# Keep this empty in the repository. Set it only in your untracked .env.local.
VITE_TENCENT_MAP_KEY=
