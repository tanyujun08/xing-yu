/* Shared interaction semantics for every native page. Brand exceptions may
 * override appearance, but not disabled, focus, error or safe-area behavior. */
.xy-safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* Native button defaults do not cross an isolated component boundary. Keep
 * the reset explicit so every shared action starts from the same primitive. */
.xy-button-reset {
  width: auto !important;
  max-width: 100%;
  margin: 0;
  margin-right: 0 !important;
  margin-left: 0 !important;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font-family: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  text-align: inherit;
}
.xy-button-fluid { width: 100% !important; }
.xy-button-reset::after { border: 0; }

/* The hit target owns interaction geometry; its child owns visible geometry.
 * This keeps 28/32/36px controls compact without shrinking the 44px target. */
.xy-hit-target {
  display: inline-flex;
  min-width: var(--xy-control-hit-size, 44px);
  min-height: var(--xy-control-hit-size, 44px);
  align-items: center;
  justify-content: center;
}

.xy-control-shell {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--xy-space-3, 12px);
  border-radius: var(--xy-radius-control, 999px);
}
.xy-control-shell--compact { min-height: var(--xy-control-height-compact, 28px); }
.xy-control-shell--small { min-height: var(--xy-button-height-small, 32px); }
.xy-control-shell--standard { min-height: var(--xy-button-height-standard, 36px); }
.xy-action-hit { display: flex; min-width: var(--xy-size-touch-min, 44px); min-height: var(--xy-size-touch-min, 44px); align-items: center; justify-content: center; font-size: var(--xy-text-body-size, 14px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-body-line-height, 20px); }
.xy-action-primary.xy-action-shell, .xy-action-secondary.xy-action-shell, .xy-action-danger.xy-action-shell { width: 100%; min-height: var(--xy-control-height-standard, 40px); box-sizing: border-box; overflow-wrap: anywhere; }
/* Disabled primary actions keep their brand carrier and add a white veil to
 * the carrier only. Opacity on the whole control washed out the label and
 * made the action look like an unavailable skeleton. */
.xy-action-hit.is-disabled .xy-action-primary { background: linear-gradient(var(--xy-member-color-button-overlay), var(--xy-member-color-button-overlay)), var(--xy-color-action-primary, #0a7f5e); color: var(--xy-color-text-inverse, #fff); opacity: 1; }
.xy-action-hit.is-disabled .xy-action-danger { background: linear-gradient(var(--xy-member-color-button-overlay), var(--xy-member-color-button-overlay)), var(--xy-color-action-danger, #c62828); color: var(--xy-color-text-inverse, #fff); opacity: 1; }
.xy-action-hit.is-disabled .xy-action-secondary { border-color: var(--xy-color-brand-disabled, #98b4ac); color: var(--xy-color-text-disabled, #c4c6cc); }
.xy-price-group { display: inline-flex; flex: none; align-items: baseline; white-space: nowrap; }
.xy-price--wrap { flex-wrap: wrap; row-gap: var(--xy-space-1, 4px); white-space: normal; }

/* Draft media: the transparent target and the small visible close mark have
 * separate geometry. Only pages with an existing delete action opt in. */
.xy-media-remove {
  position: absolute;
  z-index: var(--xy-z-local-raised);
  top: 0;
  right: 0;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  width: var(--xy-control-hit-size);
  height: var(--xy-control-hit-size);
  padding: 0;
  box-sizing: border-box;
  background: transparent;
}
.xy-media-remove__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--xy-size-icon-nav);
  height: var(--xy-size-icon-nav);
  border-radius: var(--xy-radius-circle);
  background: var(--xy-color-text-primary);
  color: var(--xy-color-text-inverse);
}
.xy-media-remove__glyph {
  width: var(--xy-size-icon-base);
  height: var(--xy-size-icon-base);
  font-family: var(--xy-font-family-sans);
  font-size: var(--xy-size-icon-base);
  line-height: var(--xy-size-icon-base);
  text-align: center;
}
.xy-media-remove:active { opacity: var(--xy-opacity-pressed); }
.xy-control-shell--button { border-radius: var(--xy-radius-md, 6px); }

.xy-bottom-action {
  position: fixed;
  z-index: var(--xy-z-modal, 200);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: var(--xy-layout-content-gap, 12px);
  min-height: var(--xy-fixed-bottom-height, 56px);
  padding: var(--xy-space-3, 12px) var(--xy-space-4, 16px) calc(var(--xy-space-3, 12px) + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid var(--xy-color-divider, #e2e6e5);
  background: var(--xy-color-surface, #fff);
}

.xy-action-primary,
.xy-action-secondary,
.xy-action-danger {
  position: relative;
  display: flex;
  min-height: var(--xy-control-height, 44px);
  align-items: center;
  justify-content: center;
  padding: 0 var(--xy-button-padding-x, 16px);
  border-radius: var(--xy-radius-md, 6px);
  font-size: var(--xy-text-body-size, 14px);
  font-weight: var(--xy-text-weight-semibold, 600);
  line-height: var(--xy-text-body-line-height, 20px);
}

@keyframes xy-loading-spin {
  to { transform: rotate(360deg); }
}

.xy-loading-ring {
  display: inline-block;
  width: var(--xy-loading-size-inline, 16px);
  height: var(--xy-loading-size-inline, 16px);
  flex: none;
  box-sizing: border-box;
  border: var(--xy-loading-stroke, 2px) solid currentColor;
  border-top-color: transparent;
  border-radius: 50%;
  animation: xy-loading-spin var(--xy-loading-duration, 800ms) linear infinite;
}

.xy-loading-ring--page {
  width: var(--xy-loading-size-page, 32px);
  height: var(--xy-loading-size-page, 32px);
}

.xy-action-content {
  display: inline-flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: var(--xy-space-2, 8px);
}

.xy-bottom-actions {
  display: flex;
  width: 100%;
  align-items: center;
  gap: var(--xy-layout-content-gap, 12px);
  padding: var(--xy-space-3, 12px) var(--xy-space-4, 16px);
  box-sizing: border-box;
  border-top: 1rpx solid var(--xy-color-divider, #e2e6e5);
  background: var(--xy-color-surface, #fff);
}

.xy-action-primary { background: var(--xy-color-action-primary, #0a7f5e); color: var(--xy-color-text-inverse, #fff); }
.xy-action-secondary { border: 1rpx solid var(--xy-color-border-strong, #858d96); background: var(--xy-color-action-secondary, #fff); color: var(--xy-color-text-primary, #202937); }
.xy-action-danger { background: var(--xy-color-action-danger, #c62828); color: var(--xy-color-text-inverse, #fff); }
.xy-action-text { display: inline-flex; min-width: var(--xy-size-touch-min, 44px); min-height: var(--xy-size-touch-min, 44px); box-sizing: border-box; align-items: center; justify-content: center; padding: 0 var(--xy-inset-card, 12px); background: transparent; color: var(--xy-color-brand, #0a7f5e); font-size: var(--xy-text-body-size, 14px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-body-line-height, 20px); text-align: center; }
.xy-action-text:active:not(.is-disabled):not(.is-waiting) { color: var(--xy-color-brand-pressed, #075f48); }
.xy-action-text.is-disabled, .xy-action-text.is-waiting { color: var(--xy-color-brand-disabled, #98b4ac); opacity: 1; }
.xy-action-primary:active:not(.is-disabled):not(.is-waiting) { background: var(--xy-color-action-pressed, #075f48); }
.xy-action-primary.is-disabled { background: linear-gradient(var(--xy-member-color-button-overlay), var(--xy-member-color-button-overlay)), var(--xy-color-action-primary, #0a7f5e); border-color: var(--xy-color-action-primary, #0a7f5e); color: var(--xy-color-text-inverse, #fff); opacity: 1; }
.xy-action-secondary.is-disabled { border-color: var(--xy-color-brand-disabled, #98b4ac); background: var(--xy-color-surface, #fff); color: var(--xy-color-text-disabled, #c4c6cc); opacity: 1; }
.xy-action-danger.is-disabled { background: linear-gradient(var(--xy-member-color-button-overlay), var(--xy-member-color-button-overlay)), var(--xy-color-action-danger, #c62828); border-color: var(--xy-color-action-danger, #c62828); color: var(--xy-color-text-inverse, #fff); opacity: 1; }
.xy-action-primary.xy-action-text { border-color: transparent; background: transparent; color: var(--xy-color-brand, #0a7f5e); }
.xy-action-primary.xy-action-text:active:not(.is-disabled):not(.is-waiting) { background: transparent; color: var(--xy-color-brand-pressed, #075f48); }
.xy-action-primary.xy-action-text.is-disabled,
.xy-action-primary.xy-action-text.is-waiting { border-color: transparent; background: transparent; color: var(--xy-color-brand-disabled, #98b4ac); }
.xy-action-hit.is-disabled { opacity: 1; }

.xy-support-fab {
  position: fixed;
  z-index: var(--xy-z-fab, 20);
  right: var(--xy-layout-page-padding-x, 16px);
  bottom: calc(24px + env(safe-area-inset-bottom));
  display: flex;
  min-width: var(--xy-size-touch-min, 44px);
  min-height: var(--xy-size-touch-min, 44px);
  align-items: center;
  justify-content: center;
  padding: 0 16px;
  border: 1rpx solid var(--xy-color-brand, #0a7f5e);
  border-radius: var(--xy-radius-pill, 999rpx);
  background: var(--xy-color-surface, #fff);
  box-shadow: var(--xy-shadow-float, 0 16rpx 40rpx rgba(19, 25, 38, .12));
  color: var(--xy-color-brand, #0a7f5e);
  font-size: var(--xy-text-body-small-size, 12px);
  font-weight: var(--xy-text-weight-semibold, 600);
  line-height: var(--xy-text-caption-line-height, 16px);
}
.xy-support-fab--above-bottom { bottom: calc(var(--xy-fixed-bottom-height, 56px) + 24px + env(safe-area-inset-bottom)); }

.xy-field-error { margin-top: var(--xy-space-1, 4px); color: var(--xy-color-danger, #c62828); font-size: var(--xy-text-caption-size, 11px); line-height: var(--xy-text-caption-line-height, 16px); }
.xy-required::before { margin-right: 4px; color: var(--xy-color-danger, #c62828); content: '*'; }
.xy-state-success { color: var(--xy-color-success, #1f7957); }
.xy-state-info { color: var(--xy-color-info, #2b67bd); }
.xy-state-warning { color: var(--xy-color-warning, #b45309); }
.xy-state-error { color: var(--xy-color-danger, #c62828); }
.xy-state-disabled { color: var(--xy-color-disabled, #98b4ac); }

/* Stable discovery patterns. These primitives describe relationships, not
 * individual screens, so page-specific copy and exceptional geometry stay
 * local to the page stylesheet. */
.xy-price { display: flex; min-width: 0; align-items: baseline; white-space: nowrap; }
.xy-price--end { justify-content: flex-end; text-align: right; }
.xy-price__symbol { flex: none; margin-right: var(--xy-gap-label-value, 4px); color: var(--xy-color-text-secondary, #58616e); font-family: var(--xy-font-family-numeric, sans-serif); font-size: var(--xy-price-symbol-size, 12px); line-height: var(--xy-price-symbol-line-height, 18px); }
.xy-price__value { flex: none; color: var(--xy-color-text-primary, #202937); font-family: var(--xy-font-family-numeric, sans-serif); font-size: var(--xy-price-value-size, 20px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-price-value-line-height, 24px); }
.xy-price__unit { flex: none; margin-left: var(--xy-space-1, 4px); color: var(--xy-color-text-muted, #67707c); font-size: var(--xy-price-unit-size, 11px); line-height: var(--xy-price-unit-line-height, 16px); }
.xy-price__meta { min-width: 0; overflow: hidden; margin-left: var(--xy-gap-related, 8px); color: var(--xy-color-text-secondary, #58616e); font-size: var(--xy-price-meta-size, 12px); line-height: var(--xy-price-meta-line-height, 18px); text-overflow: ellipsis; }
.xy-price__meta--critical { overflow: visible; text-overflow: clip; white-space: normal; overflow-wrap: anywhere; }
.xy-price--promo .xy-price__value { color: var(--xy-color-promo, #c62828); }

.xy-product-list,
.xy-store-list { display: flex; flex-direction: column; min-width: 0; }
.xy-product-item,
.xy-store-item { position: relative; display: flex; min-width: 0; align-items: flex-start; padding: var(--xy-layout-content-gap, 12px) 0; border-bottom: 0; background: transparent; }
.xy-product-item:not(:last-child)::after { position: absolute; right: 0; bottom: 0; left: calc(var(--xy-product-list-media-size, 100px) + var(--xy-product-list-media-gap, 12px)); border-bottom: 1rpx dashed var(--xy-color-divider, #e2e6e5); content: ''; }
.xy-product-item--media-72:not(:last-child)::after { left: calc(72px + var(--xy-product-list-media-gap, 12px)); }
.xy-product-item--media-82:not(:last-child)::after { left: calc(var(--xy-product-list-media-size-compact, 82px) + var(--xy-product-list-media-gap, 12px)); }
.xy-product-item--media-100:not(:last-child)::after { left: calc(100px + var(--xy-product-list-media-gap, 12px)); }
.xy-product-item__media,
.xy-store-item__media { display: block; flex: none; width: var(--xy-product-list-media-size, 200rpx); height: var(--xy-product-list-media-size, 200rpx); overflow: hidden; border-radius: var(--xy-radius-media, 4px); background: var(--xy-color-surface-subtle, #f5f6fa); }
.xy-store-item__media { width: var(--xy-store-list-media-size, 128rpx); height: var(--xy-store-list-media-size, 128rpx); }
.xy-product-item--media-82 > .xy-product-item__media { width: var(--xy-product-list-media-size-compact, 82px); height: var(--xy-product-list-media-size-compact, 82px); }
.xy-product-item__content,
.xy-store-item__content { min-width: 0; flex: 1; margin-left: var(--xy-product-list-media-gap, 12px); }
.xy-store-item__content { margin-left: var(--xy-store-list-media-gap, 12px); }
.xy-store-item--object-card { padding: var(--xy-inset-card, 12px); box-sizing: border-box; border: var(--xy-border-object-card-width, 1px) solid var(--xy-color-border, #e2e6e5); border-radius: var(--xy-radius-container, 6px); background: var(--xy-color-surface, #fff); }
.xy-product-item__title,
.xy-store-item__title { display: block; overflow: hidden; color: var(--xy-color-text-primary, #202937); font-size: var(--xy-text-item-title-size, 14px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-item-title-line-height, 20px); text-overflow: ellipsis; white-space: nowrap; }
.xy-product-item__meta,
.xy-store-item__meta { display: block; overflow: hidden; margin-top: var(--xy-space-1, 4px); color: var(--xy-color-text-secondary, #58616e); font-size: var(--xy-text-body-small-size, 12px); line-height: var(--xy-text-body-small-line-height, 18px); text-overflow: ellipsis; white-space: nowrap; }

.xy-list-group {
  overflow: hidden;
  border: 0;
  border-radius: var(--xy-radius-container, 6px);
  background: var(--xy-color-surface, #fff);
  box-shadow: none;
}
.xy-list-group--outlined { border: var(--xy-divider-hairline, 1rpx) solid var(--xy-color-border, #e2e6e5); }
.xy-list-group--tinted { border: 0; box-shadow: none; }
.xy-list-row {
  position: relative;
  min-width: 0;
  padding: var(--xy-inset-card, 12px);
  border-bottom: 0;
}
.xy-list-row:not(:last-child)::after { position: absolute; right: 0; bottom: 0; left: 0; border-bottom: var(--xy-divider-hairline, 1rpx) solid var(--xy-color-divider, #e2e6e5); content: ''; }
.xy-list-row--media { padding-left: 0; }
.xy-list-row--media > .xy-list-row__content { margin-left: var(--xy-inset-card, 12px); }

.xy-sparse-card { padding: var(--xy-inset-card, 12px); border: 0; border-radius: var(--xy-radius-md, 6px); background: var(--xy-color-surface, #fff); box-shadow: none; text-align: center; }
.xy-sparse-card--outlined { border: var(--xy-divider-hairline, 1rpx) solid var(--xy-color-border, #e2e6e5); }
.xy-sparse-title { display: block; color: var(--xy-color-text-primary, #202937); font-size: var(--xy-text-section-title-size, 16px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-section-title-line-height, 24px); overflow-wrap: anywhere; }
.xy-sparse-copy { display: block; margin-top: var(--xy-gap-related, 8px); color: var(--xy-color-text-secondary, #58616e); font-size: var(--xy-text-body-size, 14px); line-height: var(--xy-text-body-line-height, 20px); overflow-wrap: anywhere; }

.xy-section-head { display: flex; min-height: var(--xy-text-section-title-line-height, 24px); align-items: center; justify-content: space-between; gap: var(--xy-gap-related, 8px); }
.xy-section-head + .xy-section-content { margin-top: var(--xy-layout-title-content-gap, 12px); }

/* Stable two-line entry: the 44px hit target is independent from its visible
 * 36/40px carrier; title and supporting copy form one growing centered group. */
.xy-icon-entry { display: flex; min-width: 0; min-height: var(--xy-control-hit-size, 44px); align-items: center; }
.xy-icon-entry__carrier { display: flex; width: var(--xy-size-icon-entry-block, 40px); height: var(--xy-size-icon-entry-block, 40px); flex: 0 0 var(--xy-size-icon-entry-block, 40px); align-items: center; justify-content: center; border-radius: var(--xy-radius-container, 6px); background: var(--xy-color-icon-carrier, #eef1f0); }
.xy-icon-entry__glyph { display: block; width: var(--xy-size-icon-entry-glyph, 24px); height: var(--xy-size-icon-entry-glyph, 24px); }
.xy-icon-entry--prominent .xy-icon-entry__carrier { width: var(--xy-size-icon-entry-block, 40px); height: var(--xy-size-icon-entry-block, 40px); flex-basis: var(--xy-size-icon-entry-block, 40px); }
.xy-icon-entry--prominent .xy-icon-entry__glyph { width: var(--xy-size-icon-entry-glyph, 24px); height: var(--xy-size-icon-entry-glyph, 24px); }
.xy-icon-entry--compact .xy-icon-entry__carrier { width: var(--xy-size-icon-entry-block-compact, 36px); height: var(--xy-size-icon-entry-block-compact, 36px); flex-basis: var(--xy-size-icon-entry-block-compact, 36px); }
.xy-icon-entry--compact .xy-icon-entry__glyph { width: var(--xy-size-icon-entry-glyph-compact, 24px); height: var(--xy-size-icon-entry-glyph-compact, 24px); }
.xy-icon-entry--compact .xy-icon-entry__copy { display: flex; min-height: var(--xy-size-icon-entry-copy-compact, 42px); flex-direction: column; justify-content: center; }
.xy-icon-entry__copy { min-width: 0; margin-left: var(--xy-gap-group, 12px); }
.xy-icon-entry__title { display: block; color: var(--xy-color-text-primary, #202937); font-size: var(--xy-text-item-title-size, 14px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-item-title-line-height, 20px); overflow-wrap: anywhere; }
.xy-icon-entry__detail { display: block; margin-top: var(--xy-gap-title-description, 4px); color: var(--xy-color-text-secondary, #58616e); font-size: var(--xy-text-body-small-size, 12px); line-height: var(--xy-text-body-small-line-height, 18px); overflow-wrap: anywhere; }
.xy-icon-entry__end { min-width: 0; flex: none; margin-left: auto; padding-left: var(--xy-gap-group, 12px); }

/* Elevation is opt-in and role-bound. Ordinary cards keep shadow-card:none. */
.xy-elevation-banner { box-shadow: var(--xy-shadow-banner, none); }
.xy-elevation-floating-action { box-shadow: var(--xy-shadow-floating-action, none); }
.xy-elevation-overlap-card { box-shadow: var(--xy-shadow-overlap-card, none); }

/* PAT-14: a neutral rail describes real nodes. Only the current node receives
 * one brand accent; pending and UNKNOWN remain neutral and never imply done. */
.xy-flow-rail { position: relative; display: flex; min-width: 0; flex-direction: column; }
.xy-flow-node { position: relative; min-width: 0; padding: 0 0 var(--xy-gap-group, 12px) calc(var(--xy-size-icon-base, 16px) + var(--xy-gap-related, 8px)); color: var(--xy-color-text-secondary, #58616e); }
.xy-flow-node:not(:last-child)::before { position: absolute; top: var(--xy-size-icon-base, 16px); bottom: 0; left: var(--xy-space-2, 8px); border-left: var(--xy-divider-hairline, 1rpx) solid var(--xy-color-divider, #e2e6e5); content: ''; }
.xy-flow-node::after { position: absolute; top: 0; left: 0; width: var(--xy-size-icon-base, 16px); height: var(--xy-size-icon-base, 16px); box-sizing: border-box; border: var(--xy-divider-hairline, 1rpx) solid var(--xy-color-border-strong, #858d96); border-radius: var(--xy-radius-circle, 50%); background: var(--xy-color-surface, #fff); content: ''; }
.xy-flow-node.is-current { color: var(--xy-color-text-primary, #202937); }
.xy-flow-node.is-current::after { border-color: var(--xy-color-brand, #0a7f5e); background: var(--xy-color-brand, #0a7f5e); }
.xy-flow-node.is-unknown::after { border-color: var(--xy-color-border-strong, #858d96); background: var(--xy-color-surface, #fff); }

.xy-tabs { display: flex; min-width: 0; align-items: center; border-bottom: 1rpx solid var(--xy-color-divider, #e2e6e5); }
.xy-tabs--equal > .xy-tab { flex: 1; }
.xy-tabs--compact { justify-content: flex-start; gap: var(--xy-space-1, 4px); }
.xy-tab { position: relative; display: flex; min-width: var(--xy-control-hit-size, 44px); min-height: var(--xy-control-hit-size, 44px); align-items: center; justify-content: center; padding: 0 var(--xy-space-2, 8px); color: var(--xy-color-text-secondary, #58616e); font-size: var(--xy-text-body-small-size, 12px); line-height: var(--xy-text-body-small-line-height, 18px); }
.xy-tab--filter { padding-right: var(--xy-space-3, 12px); padding-left: var(--xy-space-3, 12px); }
.xy-tab--navigation { font-size: var(--xy-text-body-size, 14px); line-height: var(--xy-text-body-line-height, 20px); }
.xy-tab--active { color: var(--xy-color-text-primary, #202937); font-weight: var(--xy-text-weight-semibold, 600); }
.xy-tab__indicator { position: absolute; right: var(--xy-space-2, 8px); bottom: -1rpx; left: var(--xy-space-2, 8px); height: var(--xy-divider-selected, 2px); border-radius: var(--xy-radius-pill, 999px); background: var(--xy-color-brand, #0a7f5e); content: ''; }

.xy-discovery-empty { display: flex; width: 100%; align-items: center; justify-content: center; flex-wrap: wrap; column-gap: var(--xy-space-2); min-height: var(--xy-size-touch-min); box-sizing: border-box; padding: var(--xy-layout-section-gap) var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); text-align: center; }
.xy-discovery-empty__action { display: inline-flex; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.xy-empty-illustration { display: block; width: var(--xy-empty-page-illustration-width, 400rpx); height: var(--xy-empty-page-illustration-height, 300rpx); flex: none; }
.xy-empty-page { display: flex; min-height: var(--xy-empty-page-min-height, 360px); box-sizing: border-box; align-items: center; flex-direction: column; justify-content: center; padding: var(--xy-space-4) var(--xy-inset-card); text-align: center; }
.xy-empty-page--surface { border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.xy-empty-page__illustration { display: block; width: var(--xy-empty-page-illustration-width, 400rpx); height: var(--xy-empty-page-illustration-height, 300rpx); flex: none; margin-bottom: calc(-1 * var(--xy-space-1)); }
.xy-empty-page__title { display: block; color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); overflow-wrap: anywhere; }
.xy-empty-page__copy { display: block; max-width: 560rpx; margin-top: var(--xy-optical-text-frame-nudge); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; }
.xy-empty-page__action { margin-top: var(--xy-space-2); }
.xy-empty-section { display: flex; min-height: var(--xy-empty-section-min-height, 120px); box-sizing: border-box; align-items: center; flex-direction: column; justify-content: center; padding: var(--xy-space-4) var(--xy-inset-card); color: var(--xy-color-text-secondary); text-align: center; }
.xy-empty-section__illustration { display: block; width: var(--xy-empty-section-illustration-width, 192rpx); height: var(--xy-empty-section-illustration-height, 144rpx); flex: none; margin-bottom: calc(-1 * var(--xy-space-1)); }
.xy-empty-section__title { display: block; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; }
.xy-empty-section__copy { display: block; margin-top: var(--xy-optical-text-frame-nudge); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); overflow-wrap: anywhere; }
.xy-empty-section__action { margin-top: var(--xy-space-1); }
.xy-search-field { display: flex; min-height: var(--xy-size-touch-min, 44px); align-items: center; color: var(--xy-color-text-secondary, #58616e); }
.xy-chip-hit { display: inline-flex; min-width: var(--xy-control-hit-size, 44px); min-height: var(--xy-control-hit-size, 44px); align-items: center; justify-content: center; }
.xy-chip { display: inline-flex; min-height: var(--xy-control-height-compact, 28px); align-items: center; justify-content: center; padding: 0 var(--xy-space-3, 12px); border: 1rpx solid var(--xy-color-border, #e2e6e5); border-radius: var(--xy-radius-pill, 999px); background: var(--xy-color-surface, #fff); color: var(--xy-color-text-secondary, #58616e); font-size: var(--xy-text-body-small-size, 12px); line-height: var(--xy-text-body-small-line-height, 18px); }
.xy-chip.is-current { border-color: var(--xy-color-brand, #0a7f5e); background: var(--xy-color-brand-light, #e7f7f1); color: var(--xy-color-brand, #0a7f5e); }

.xy-arrow-icon { display: block; width: var(--xy-size-icon-base, 16px); height: var(--xy-size-icon-base, 16px); flex: none; }

/* Cards on white page backgrounds use an outline; gray page backgrounds use the plain card. */
.xy-card.xy-card--outlined { box-sizing: border-box; border: var(--xy-divider-hairline, 1rpx) solid var(--xy-color-border, #e2e6e5); }

/* Draft evidence groups: shared only by the four explicitly opted-in pages. */
.xy-draft-media-grid { display: flex; flex-wrap: wrap; gap: var(--xy-space-2); margin-top: var(--xy-space-3); white-space: normal; }
.xy-draft-media-grid .xy-draft-media-tile { position: relative; box-sizing: border-box; flex: 0 0 136rpx; width: 136rpx; height: 136rpx; min-height: 136rpx; margin: 0; overflow: hidden; border-radius: var(--xy-radius-media); }
.xy-draft-media-grid .xy-draft-media-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-0-5); padding: 0; border: 2rpx dashed var(--xy-color-border-strong); border-radius: var(--xy-radius-sm); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); }
.xy-draft-media-add .xy-draft-media-symbol { color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-caption-line-height); }
.xy-draft-media-add .xy-draft-media-label { font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-weight: var(--xy-text-weight-semibold); }
.xy-draft-media-add .xy-draft-media-count { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.xy-draft-media-tile .hero-image, .xy-draft-media-tile .media-thumb-media { display: block; width: 100%; height: 100%; }

/* Location discovery: shared language, explicit preview/detail emphasis. */
.xy-discovery-band { height: 8px; flex: none; background: var(--xy-color-page); }
.xy-discovery-inset { padding-right: var(--xy-layout-page-padding-x); padding-left: var(--xy-layout-page-padding-x); }
.xy-discovery-heading { display: flex; align-items: baseline; justify-content: space-between; gap: var(--xy-space-3); padding-top: var(--xy-space-3); padding-bottom: var(--xy-space-2); }
.xy-discovery-heading__title { font-size: var(--xy-text-section-title-size); line-height: var(--xy-text-section-title-line-height); font-weight: var(--xy-text-weight-semibold); color: var(--xy-color-text-primary); }
.xy-discovery-meta { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.xy-discovery-icon { display: block; width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); flex: none; }
.xy-discovery-icon-action { display: flex; width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); flex: none; align-items: center; justify-content: flex-end; }
.xy-discovery-info { position: relative; display: grid; grid-template-columns: var(--xy-size-icon-row) calc(var(--xy-text-body-small-size) * 4) minmax(0, 1fr); column-gap: var(--xy-space-4); align-items: center; box-sizing: border-box; min-height: var(--xy-size-touch-min); }
.xy-discovery-info::after { content: ''; position: absolute; left: calc(var(--xy-size-icon-row) + var(--xy-space-4)); right: 0; bottom: 0; height: var(--xy-divider-hairline); background: var(--xy-color-border-weak); }
.xy-discovery-info:last-child::after { display: none; }
.xy-discovery-info__label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.xy-discovery-info__content { display: flex; align-items: center; gap: var(--xy-space-4); min-width: 0; }
.xy-discovery-info__value { min-width: 0; flex: 1; overflow-wrap: anywhere; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); color: var(--xy-color-text-primary); font-variant-numeric: tabular-nums; }
.xy-discovery-identity { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--xy-space-2) var(--xy-space-3); padding-top: var(--xy-space-4); padding-bottom: var(--xy-space-4); }
.xy-discovery-identity__title { flex: 1; min-width: 0; font-size: var(--xy-text-page-title-size); line-height: var(--xy-text-page-title-line-height); font-weight: var(--xy-text-weight-semibold); overflow-wrap: anywhere; }
.xy-discovery-distance { display: flex; align-items: center; gap: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); font-variant-numeric: tabular-nums; }
.xy-discovery-distance__icon { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.xy-discovery-status { display: inline-flex; min-height: var(--xy-size-icon-nav); align-items: center; padding: 0 var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.xy-discovery-status--unavailable { background: var(--xy-color-page); color: var(--xy-color-danger); }
.xy-discovery-note { display: flex; align-items: flex-start; gap: var(--xy-space-3); padding: var(--xy-space-3); background: var(--xy-color-page); border-radius: var(--xy-radius-container); }
.xy-discovery-note__copy { min-width: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.xy-discovery-device { position:relative; display:flex; gap:10px; align-items:center; padding:12px 0; color:var(--xy-color-text-primary); }
.xy-discovery-device:last-child { border-bottom:0; }
.xy-discovery-device__media { flex:none; width:72px; height:72px; overflow:hidden; border-radius:6px; background:var(--xy-color-page); }
.xy-discovery-device__image { display:block; width:100%; height:100%; }
.xy-discovery-device__copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:4px; }
.xy-discovery-device__line { display:flex; align-items:center; gap:8px; min-width:0; }
.xy-discovery-device__name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:14px; line-height:22px; font-weight:600; }
.xy-discovery-device__rent { flex:none; display:flex; align-items:baseline; white-space:nowrap; }
.xy-discovery-device__value { font-size:19px; line-height:24px; font-weight:600; }
.xy-discovery-device__unit,.xy-discovery-device__deposit { font-size:10px; line-height:16px; color:var(--xy-color-text-secondary); white-space:nowrap; }
.xy-discovery-device__deposit { flex:none; }
.xy-discovery-device__tags { flex:1; min-width:0; display:flex; gap:4px; overflow:hidden; }
.xy-discovery-device__channel,.xy-discovery-device__tag { padding:2px 5px; border-radius:4px; font-size:10px; line-height:14px; white-space:nowrap; }
.xy-discovery-device__channel { flex:none; background:#e7f7f1; color:#07865f; }
.xy-discovery-device__channel--store { background:#eaf3ff; color:#2675c9; }
.xy-discovery-device__channel--personal { background:#fff3df; color:#a96912; }
.xy-discovery-device__tag { overflow:hidden; text-overflow:ellipsis; color:var(--xy-color-text-secondary); background:var(--xy-color-page); }
.xy-discovery-device__description { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:12px; line-height:18px; color:var(--xy-color-text-secondary); }
.xy-discovery-device--narrow { gap:8px; }
.xy-discovery-device--narrow .xy-discovery-device__media { width:56px; height:56px; }
.xy-discovery-device--narrow .xy-discovery-device__name { font-size:12px; line-height:20px; }
.xy-discovery-device--narrow .xy-discovery-device__value { font-size:17px; line-height:22px; }
.xy-discovery-device--narrow .xy-discovery-device__line { gap:4px; }
.xy-discovery-device--narrow .xy-discovery-device__description { font-size:11px; line-height:17px; }

.xy-discovery-device::after { content:''; position:absolute; left:82px; right:0; bottom:0; height:1px; background:var(--xy-color-border-weak); }
.xy-discovery-device--narrow::after { left:64px; }
