
.return-page,.flow-page,.return-list-page { box-sizing:border-box; display:flex; flex-direction:column; gap:var(--xy-space-3); padding:var(--xy-space-3) var(--xy-space-4) var(--xy-space-4); color:var(--xy-color-text-primary); }
.return-card,.return-surface { box-sizing:border-box; padding:var(--xy-space-3); border:1px solid var(--xy-color-border); border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); }
.return-title { display:block; font-size:var(--xy-return-title-size); line-height:var(--xy-return-line-compact); font-weight:var(--xy-text-weight-semibold); }
.return-subtitle { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-return-line-body); font-weight:var(--xy-text-weight-semibold); }
.return-copy { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-return-line-copy); overflow-wrap:anywhere; }
.return-note { display:flex; gap:var(--xy-space-2); align-items:flex-start; padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface-subtle); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-return-line-copy); }
.return-note--success { background:var(--xy-color-brand-light); color:var(--xy-color-brand); }
.return-note--warning { background:var(--xy-return-warning-soft); color:var(--xy-color-warning); }
.return-note--danger { background:var(--xy-return-danger-soft); color:var(--xy-color-danger); }
.return-actions { display:flex; flex-direction:column; gap:var(--xy-space-2); padding:var(--xy-space-2) var(--xy-space-4) var(--xy-space-3); background:var(--xy-color-page); }
.return-actions button,.return-primary,.return-secondary { box-sizing:border-box; width:100% !important; min-height:var(--xy-control-height-large); display:flex; align-items:center; justify-content:center; margin:0; padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-md); font-size:var(--xy-text-section-title-size); line-height:var(--xy-return-line-body); font-weight:var(--xy-text-weight-semibold); }
.return-primary { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); border:1px solid var(--xy-color-brand); }
.return-secondary { background:var(--xy-color-surface); color:var(--xy-color-info); border:1px solid var(--xy-color-border); }
.return-primary::after,.return-secondary::after,.return-link::after { border:0; }
.return-actions .return-primary[disabled],.return-primary[disabled][aria-disabled] { background:var(--xy-return-disabled); color:var(--xy-color-text-inverse); border-color:var(--xy-return-disabled); }
.return-actions .return-secondary[disabled],.return-secondary[disabled][aria-disabled] { background:var(--xy-color-surface-subtle); color:var(--xy-color-text-muted); }
.return-link { display:flex; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin:0; padding:0; border:0; border-radius:0; background:transparent; color:var(--xy-color-info); font-size:var(--xy-text-body-size); line-height:var(--xy-return-line-body); }
.return-link[disabled] { color:var(--xy-color-text-muted); background:transparent; }
.return-inline { display:flex; align-items:center; gap:var(--xy-space-3); }
.return-inline image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.return-fact { box-sizing:border-box; display:flex; align-items:center; gap:var(--xy-space-3); min-height:var(--xy-control-height-large); padding:var(--xy-space-2) 0; border-bottom:1px solid var(--xy-color-border); font-size:var(--xy-text-body-size); line-height:var(--xy-return-line-body); }
.return-fact:last-child { border:0; }
.return-fact image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.return-fact__label { flex:1; color:var(--xy-color-text-secondary); }
.return-fact__value { flex:1; text-align:right; overflow-wrap:anywhere; }
.return-good { color:var(--xy-color-brand); }
.return-error { color:var(--xy-color-danger); }
.return-center { text-align:center; }

.return-status-icon { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }

.return-actions button { gap:var(--xy-space-2); }
.return-primary>.return-status-icon { filter:brightness(0) invert(1); }
.return-cabinet-icon { transform:scale(1.35); }
