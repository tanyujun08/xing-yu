/* Shared by pickup, return and credential entry: one spacing owner per row. */
.surface-card { margin-top:var(--xy-space-3); padding:var(--xy-space-3); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.credential-card { margin-top:0; }
.cabinet-card { margin-top:var(--xy-space-3); }
.card-head { display:flex; align-items:baseline; justify-content:space-between; gap:var(--xy-space-3); margin-bottom:var(--xy-space-3); }
.section-title { display:block; font-size:var(--xy-text-section-title-size); font-weight:var(--xy-text-weight-semibold); line-height:var(--xy-text-section-title-line-height); }
.info-row { display:flex; align-items:flex-start; justify-content:space-between; gap:var(--xy-space-3); padding:var(--xy-space-3) 0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.info-row > text:first-child { flex:none; }
.info-row > text:last-child { min-width:0; max-width:72%; color:var(--xy-color-text-primary); text-align:right; overflow-wrap:anywhere; }
.info-row + .info-row { border-top:1rpx solid var(--xy-color-divider); }
.card-head + .info-row { padding-top:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); }
.info-row:last-child { padding-bottom:0; }
.state-label { flex:none; color:var(--xy-color-info); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.state-label.is-success { color:var(--xy-color-success); }
.state-label.is-error { color:var(--xy-color-danger); }
.state-label.is-warning { color:var(--xy-color-warning); }

.method-list { display:flex; flex-direction:column; padding:0 var(--xy-space-3); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.method-card { display:flex; align-items:center; width:100%; min-height:0; margin:0; padding:var(--xy-space-4) 0; border:0; border-radius:0; background:transparent; color:var(--xy-color-text-primary); text-align:left; }
.method-card + .method-card { border-top:1rpx solid var(--xy-color-divider); }
.method-icon { display:flex; align-items:center; justify-content:center; flex:none; width:44px; height:44px; border-radius:var(--xy-radius-container); background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-item-title-size); font-weight:var(--xy-text-weight-semibold); }
.scan-icon::after { content:''; width:22px; height:22px; border:2px solid var(--xy-color-brand); border-radius:4px; background:linear-gradient(var(--xy-color-brand),var(--xy-color-brand)) center/14px 2px no-repeat; }
.method-copy { display:flex; flex:1; min-width:0; flex-direction:column; margin-left:var(--xy-space-3); }
.method-title { font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.method-description { margin-top:var(--xy-space-1); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-text-secondary); }
.method-arrow { flex:none; margin-left:var(--xy-space-3); color:var(--xy-color-text-muted); font-size:var(--xy-text-page-title-size); }

/* Keep the existing visual carrier; constrain only its interaction box. */
.method-card { box-sizing:border-box; min-height:var(--xy-size-touch-min); }
