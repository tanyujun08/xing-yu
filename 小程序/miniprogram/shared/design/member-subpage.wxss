@import "./member-tokens.wxss";

.member-subpage {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--xy-space-3) var(--xy-layout-page-padding-x) calc(var(--xy-space-6) + env(safe-area-inset-bottom));
  background: var(--xy-member-gradient-page);
  color: var(--xy-color-text-primary);

  padding-top: var(--xy-layout-card-stack-start-gap);
}

.member-subpage__hero {
  padding: var(--xy-inset-card);
  border: 0;
  border-radius: var(--xy-radius-emphasis);
  background: var(--xy-member-gradient-hero);
  box-shadow: none;
}

.member-subpage__hero--pink {
  border-color: var(--xy-member-color-hero-pink-border);
  background: var(--xy-member-gradient-hero-pink);
}

.member-subpage__hero--dark {
  border-color: var(--xy-member-color-hero-dark-border);
  background: var(--xy-member-gradient-hero-dark);
  color: var(--xy-member-color-hero-dark-text);
}

.member-subpage__hero-top,
.member-subpage__hero-meta,
.member-subpage__section-head,
.member-subpage__row,
.member-subpage__row-main,
.member-subpage__row-end {
  display: flex;
}

.member-subpage__hero-top,
.member-subpage__section-head,
.member-subpage__row {
  align-items: center;
  justify-content: space-between;
}

.member-subpage__eyebrow {
  display: block;
  color: var(--xy-color-brand);
  font-size: var(--xy-text-caption-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-caption-line-height);
}

.member-subpage__hero--dark .member-subpage__eyebrow {
  color: var(--xy-member-color-hero-dark-eyebrow);
}

.member-subpage__title {
  display: block;
  margin-top: var(--xy-gap-label-value);
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-page-title-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-page-title-line-height);
}

.member-subpage__hero--dark .member-subpage__title {
  color: var(--xy-member-color-white);
}

.member-subpage__hero-copy {
  display: block;
  margin-top: var(--xy-gap-title-description);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-subpage__hero--dark .member-subpage__hero-copy {
  color: var(--xy-member-color-hero-dark-copy);
}

.member-subpage__balance {
  display: flex;
  align-items: baseline;
  gap: var(--xy-gap-label-value);
  margin-top: var(--xy-gap-group);
}

.member-subpage__balance-value {
  color: var(--xy-color-text-primary);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-operations-hero-size);
  font-weight: var(--xy-text-weight-bold);
  line-height: var(--xy-text-operations-hero-line-height);
}

.member-subpage__hero--dark .member-subpage__balance-value {
  color: var(--xy-member-color-white);
}

.member-subpage__balance-value--pink {
  color: var(--xy-member-color-pink);
}

.member-subpage__balance-unit {
  color: var(--xy-color-brand);
  font-size: var(--xy-text-body-size);
  font-weight: var(--xy-text-weight-bold);
  line-height: var(--xy-text-body-line-height);
}

.member-subpage__hero--dark .member-subpage__balance-unit {
  color: var(--xy-member-color-gold);
}

.member-subpage__hero-meta {
  align-items: flex-end;
  gap: var(--xy-gap-content-action);
  margin-top: var(--xy-gap-group);
}

.member-subpage__meta-item {
  display: flex;
  flex-direction: column;
  gap: var(--xy-gap-label-value);
}

.member-subpage__meta-value {
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-item-title-size);
  font-weight: var(--xy-text-weight-bold);
  line-height: var(--xy-text-item-title-line-height);
}

.member-subpage__hero--dark .member-subpage__meta-value {
  color: var(--xy-member-color-white);
}

.member-subpage__meta-label {
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}

.member-subpage__hero--dark .member-subpage__meta-label {
  color: var(--xy-member-color-hero-dark-muted);
}

.member-subpage__progress {
  height: var(--xy-space-2);
  margin-top: var(--xy-gap-group);
  overflow: hidden;
  border-radius: var(--xy-radius-pill);
  background: var(--xy-member-color-progress);
}

.member-subpage__hero--dark .member-subpage__progress {
  background: var(--xy-member-color-hero-progress-dark);
}

.member-subpage__progress-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--xy-member-gradient-progress);
}

.member-subpage__hero--dark .member-subpage__progress-fill {
  background: var(--xy-member-gradient-progress-dark);
}

.member-subpage__progress-caption {
  display: flex;
  justify-content: space-between;
  gap: var(--xy-space-2);
  margin-top: var(--xy-gap-label-value);
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}

.member-subpage__hero--dark .member-subpage__progress-caption {
  color: var(--xy-member-color-hero-dark-caption);
}

.member-subpage__progress-caption text:last-child {
  color: var(--xy-color-brand);
  font-weight: var(--xy-text-weight-semibold);
}

.member-subpage__hero--dark .member-subpage__progress-caption text:last-child {
  color: var(--xy-member-color-gold);
}

.member-subpage__actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--xy-space-3);
  margin-top: var(--xy-space-4);
}

.member-subpage__button {
  display: flex;
  width: 100% !important;
  min-width: 0;
  min-height: var(--xy-size-touch-min);
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 var(--xy-space-3);
  border: 1rpx solid var(--xy-member-color-neutral-border);
  border-radius: var(--xy-radius-md);
  background: var(--xy-member-color-white);
  color: var(--xy-color-brand);
  font-size: var(--xy-text-body-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-body-line-height);
}

.member-subpage__button--primary {
  border-color: transparent;
  background: var(--xy-color-brand);
  color: var(--xy-member-color-white);
}

.member-subpage__hero--dark .member-subpage__button--primary {
  background: var(--xy-member-color-white);
  color: var(--xy-color-brand);
}

.member-subpage__hero--dark .member-subpage__actions .member-subpage__button:not(.member-subpage__button--primary) {
  border-color: var(--xy-member-color-button-overlay);
  background: transparent;
  color: var(--xy-member-color-white);
}

.member-subpage__button--pink {
  border-color: transparent;
  background: var(--xy-member-color-pink);
  color: var(--xy-member-color-white);
}

.member-subpage__button--small {
  width: auto !important;
  min-width: 68px;
  min-height: var(--xy-button-height-standard);
  padding: 0 var(--xy-space-3);
  border-radius: var(--xy-radius-md);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-subpage__button[disabled] {
  border-color: transparent;
  background: var(--xy-member-color-disabled-bg);
  color: var(--xy-member-color-disabled-text);
}

.member-subpage__section {
  margin-top: var(--xy-layout-section-gap);
}

.member-subpage__section-head {
  min-height: var(--xy-text-section-title-line-height);
}

.member-subpage__section-title {
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-section-title-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-section-title-line-height);
}

.member-subpage__section-note {
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
  text-align: right;
}

.member-subpage__surface { margin-top: var(--xy-layout-card-stack-start-gap);
  overflow: hidden;
  border: 0;
  border-radius: var(--xy-radius-container);
  background: var(--xy-color-surface);
  box-shadow: none;
}

.member-subpage__row {
  position: relative;
  min-height: calc(var(--xy-size-icon-entry-block) + var(--xy-inset-card) + var(--xy-inset-card));
  padding: var(--xy-space-3);
  border-bottom: 0;

  box-sizing: border-box;
}

.member-subpage__row:not(:last-child)::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: var(--xy-divider-hairline);
  background: var(--xy-color-divider);
  content: '';
}

.member-subpage__row-main {
  align-items: center;
  min-width: 0;
  flex: 1;
}

.member-subpage__icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 var(--xy-size-icon-entry-block);
  width: var(--xy-size-icon-entry-block);
  height: var(--xy-size-icon-entry-block);
  border-radius: var(--xy-radius-container);
  background: var(--xy-color-icon-carrier);
}

.member-subpage__icon-box--pink {
  background: var(--xy-member-color-pink-surface);
}

.member-subpage__icon-box--gold {
  background: var(--xy-member-color-gold-surface-soft);
}

.member-subpage__icon {
  width: var(--xy-size-icon-entry-glyph);
  height: var(--xy-size-icon-entry-glyph);
}

.member-subpage__copy {
  min-width: 0;
  margin-left: var(--xy-gap-group);
}

.member-subpage__row-title {
  display: block;
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-item-title-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-item-title-line-height);
}

.member-subpage__row-detail {
  display: block;
  margin-top: var(--xy-gap-title-description);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-subpage__row-end {
  align-items: center;
  flex: 0 0 auto;
  gap: var(--xy-space-2);
  margin-left: var(--xy-gap-group);

  flex-shrink: 1;

  text-align: right;
}

.member-subpage__amount {
  color: var(--xy-color-brand);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-price-value-size);
  font-weight: var(--xy-text-weight-bold);
  line-height: var(--xy-price-value-line-height);
}

.member-subpage__amount--pink {
  color: var(--xy-member-color-pink);
}

.member-subpage__amount--gold {
  color: var(--xy-member-color-gold-amount);
}

.member-subpage__status {
  padding: var(--xy-space-1) var(--xy-space-2);
  border-radius: var(--xy-radius-pill);
  background: var(--xy-color-brand-light);
  color: var(--xy-color-brand);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
  white-space: nowrap;
}

.member-subpage__status--muted {
  background: var(--xy-member-color-muted-bg);
  color: var(--xy-color-text-muted);
}

.member-subpage__status--gold {
  background: var(--xy-member-color-gold-surface-warm);
  color: var(--xy-member-color-gold-text);
}

.member-subpage__divider {
  height: var(--xy-divider-hairline);
  background: var(--xy-color-divider);
}

.member-subpage__footnote {
  margin: var(--xy-space-2) var(--xy-space-1) 0;
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-subpage__empty {
  padding: var(--xy-layout-section-gap) var(--xy-layout-page-padding-x);
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-body-size);
  line-height: var(--xy-text-body-line-height);
  text-align: center;
}

.member-subpage__arrow {
  width: var(--xy-size-icon-base);
  height: var(--xy-size-icon-base);
  opacity: .58;
}

.member-subpage__input {
  flex: 1;
  min-width: 0;
  margin-left: var(--xy-gap-group);
  color: var(--xy-color-text-primary);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-asset-summary-size);
  line-height: var(--xy-text-asset-summary-line-height);
}

.member-subpage__notice {
  margin-top: var(--xy-gap-group);
  padding: var(--xy-inset-card);
  border-radius: var(--xy-radius-container);
  background: var(--xy-member-color-neutral-light);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-subpage__notice--pink {
  background: var(--xy-member-color-pink-surface-soft);
  color: var(--xy-member-color-pink-copy);
}
