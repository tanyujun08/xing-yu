/* 订单流程（方向 H）共享版式：白块无边框无阴影、44 行高、发丝分割线、一个钱的结论。 */
.xy-h-page { display: flex; flex-direction: column; gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-space-4); color: var(--xy-color-text-primary); font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); }
.xy-h-blk { padding: 0 var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.xy-h-blk--pad { padding: var(--xy-space-4); }
.xy-h-row { position: relative; display: flex; align-items: center; gap: var(--xy-space-3); min-height: var(--xy-row-height); font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); }
.xy-h-row + .xy-h-row, .xy-h-sep { border-top: 1rpx solid var(--xy-color-hairline); }
.xy-h-row__k { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: var(--xy-space-2) 0; overflow-wrap: anywhere; }
.xy-h-row__v { color: var(--xy-color-text-secondary); text-align: right; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
.xy-h-row__v--strong { color: var(--xy-color-text-primary); }
.xy-h-row__sub { color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.xy-h-row--link { color: var(--xy-color-brand); }
.xy-h-cap { padding: 0; margin: var(--xy-space-1) 0 calc(var(--xy-space-1) * -1); color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.xy-h-note { display: block; padding: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); overflow-wrap: anywhere; }
.xy-h-title { font-size: var(--xy-text-section-title-size); line-height: var(--xy-text-section-title-line-height); font-weight: var(--xy-text-weight-semibold); }
.xy-h-key { display: flex; flex-direction: column; gap: var(--xy-space-1); padding: var(--xy-space-4) 0 var(--xy-space-3); }
.xy-h-key__label, .xy-h-key__note { color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.xy-h-key__amount { color: var(--xy-color-text-primary); font-size: var(--xy-key-amount-size); line-height: var(--xy-key-amount-line-height); font-weight: var(--xy-text-weight-semibold); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.xy-h-key--warn .xy-h-key__amount { color: var(--xy-color-key-warning); }
.xy-h-key--brand .xy-h-key__amount { color: var(--xy-color-brand); }
.xy-h-tag { margin-right: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); }
.xy-h-tag--warn { color: var(--xy-color-key-warning); font-weight: var(--xy-text-weight-semibold); }
.xy-h-tag--brand { color: var(--xy-color-brand); }
.xy-h-total { display: flex; align-items: center; justify-content: space-between; min-height: var(--xy-row-height); margin: var(--xy-space-2) calc(var(--xy-space-2) * -1) var(--xy-space-3); padding: 0 var(--xy-space-2); border-radius: var(--xy-radius-md); background: var(--xy-color-key-warning-soft); color: var(--xy-color-key-warning); font-weight: var(--xy-text-weight-semibold); }
.xy-h-hit { display: flex; align-items: center; min-height: var(--xy-size-touch-min); padding: 0; margin: 0; background: transparent; color: var(--xy-color-brand); font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); }
.xy-h-hit::after { border: 0; }
.xy-h-agree { display: flex; align-items: center; gap: var(--xy-space-2); min-height: var(--xy-size-touch-min); padding: 0; margin: 0; background: transparent; color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); text-align: left; }
.xy-h-agree::after { border: 0; }
.xy-h-check { flex: none; width: calc(var(--xy-space-4) + var(--xy-space-1)); height: calc(var(--xy-space-4) + var(--xy-space-1)); border: 1rpx solid var(--xy-color-border-strong); border-radius: var(--xy-radius-sm); box-sizing: border-box; }
.xy-h-check.is-checked { border-color: var(--xy-color-brand); background: var(--xy-color-brand); }
.xy-h-check image { display: block; width: 100%; height: 100%; }
.xy-h-actions { display: flex; align-items: center; gap: var(--xy-space-3); width: 100%; }
.xy-h-actions__main { flex: 1; min-width: 0; display: flex; gap: var(--xy-space-3); }
.xy-h-actions__main > button { flex: 1; min-width: 0; }
.xy-h-kf { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); padding: 0; margin: 0; background: transparent; color: var(--xy-color-text-primary); font-size: var(--xy-text-caption-size); line-height: var(--xy-row-caption-line-height); }
.xy-h-kf::after { border: 0; }
.xy-h-kf image { display: block; width: calc(var(--xy-space-5) + var(--xy-space-1) / 2); height: calc(var(--xy-space-5) + var(--xy-space-1) / 2); }
/* 流程步骤条：已完成实心、当前空心粗环、未到灰环 */
.xy-h-steps { display: flex; padding: var(--xy-space-1) 0 var(--xy-space-2); }
.xy-h-step { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: var(--xy-space-2); color: var(--xy-color-text-muted); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.xy-h-step::before { content: ""; position: absolute; top: calc(var(--xy-space-2) - 1rpx); right: 50%; width: 100%; border-top: 3rpx solid var(--xy-color-border); }
.xy-h-step:first-child::before { display: none; }
.xy-h-step.is-done::before, .xy-h-step.is-current::before { border-top-color: var(--xy-color-brand); }
.xy-h-step__dot { position: relative; width: var(--xy-space-4); height: var(--xy-space-4); border: 3rpx solid var(--xy-color-border-strong); border-radius: var(--xy-radius-circle); background: var(--xy-color-surface); box-sizing: border-box; }
.xy-h-step.is-done .xy-h-step__dot { border-color: var(--xy-color-brand); background: var(--xy-color-brand); }
.xy-h-step.is-current .xy-h-step__dot { border: calc(var(--xy-space-1) + 1rpx) solid var(--xy-color-brand); }
.xy-h-step.is-done, .xy-h-step.is-current { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-medium); }
