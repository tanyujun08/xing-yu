/* 发布与出租（第 5 批，2026-11-20 用户确认）：
   灰底 + 摘要卡 + 白色分组卡；手机触控标准：行高 56、按钮视觉 32（点击区另外扩到 44）、输入框 48、
   相邻可点元素间隔 ≥ 12；编辑一律「点一行 → 底部弹层」，弹层里不再弹第二层，选项用整行单选 / 勾选。 */
.pf-page { display: flex; flex-direction: column; gap: var(--xy-space-6); min-height: 100vh; box-sizing: border-box; padding: 0 var(--xy-space-4) var(--xy-space-6); background: var(--xy-color-page); color: var(--xy-color-text-primary); font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); }
.pf-page--bar { padding-bottom: var(--xy-fixed-bottom-clearance); }
.pf-page > page-header { margin: 0 calc(var(--xy-space-4) * -1); }
.pf-block { display: flex; flex-direction: column; gap: var(--xy-space-3); }
.pf-gt { display: block; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.pf-gt-row { display: flex; align-items: baseline; justify-content: space-between; }
.pf-gt-row__aside { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); }
.pf-link { display: inline-flex; align-items: center; min-height: var(--xy-size-touch-min); color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); }
.pf-cd { overflow: hidden; border-radius: var(--xy-pf-radius); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-raised); }
.pf-sum { padding: var(--xy-space-4); border-radius: var(--xy-pf-radius); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-raised); }
.pf-sum__t { display: flex; align-items: center; gap: var(--xy-space-2); font-size: var(--xy-pf-title); font-weight: var(--xy-text-weight-semibold); line-height: calc(var(--xy-pf-title) + 8px); }
.pf-sum__s { display: block; margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: calc(var(--xy-text-body-small-size) + 8px); }
.pf-dot { flex: none; width: var(--xy-space-2); height: var(--xy-space-2); border-radius: 50%; background: var(--xy-color-brand); }
.pf-dot.is-warn { background: var(--xy-color-warning); }
.pf-k { display: block; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: calc(var(--xy-text-body-small-size) + 6px); }
.pf-n { display: flex; align-items: baseline; gap: var(--xy-space-1); }
.pf-n__v { font-size: var(--xy-key-amount-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-key-amount-line-height); font-variant-numeric: tabular-nums; }
.pf-n__u { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); }
.pf-sum__f { display: flex; flex-wrap: wrap; align-items: center; gap: var(--xy-space-4); margin-top: var(--xy-space-3); padding-top: var(--xy-space-3); border-top: 1rpx solid var(--xy-color-hairline); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); }
.pf-sum__f text text { margin-left: var(--xy-space-1); color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); font-variant-numeric: tabular-nums; }
.pf-sum__f .is-soon text { color: var(--xy-color-text-muted); font-weight: var(--xy-text-weight-regular); }
.pf-tap:active { opacity: var(--xy-opacity-pressed); }
/* 行：左标签、右值、可选箭头 / 按钮；行内分割线从左内边距起 */
.pf-row { position: relative; display: flex; align-items: center; gap: var(--xy-space-3); min-height: var(--xy-pf-row); padding: 0 var(--xy-space-4); box-sizing: border-box; }
.pf-row + .pf-row::before, .pf-cd > .pf-row + picker .pf-row::before, .pf-cd > picker + picker .pf-row::before, .pf-cd > picker + .pf-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); border-top: 1rpx solid var(--xy-color-hairline); content: ''; }
.pf-row:active { background: var(--xy-color-well); }
.pf-row__k { flex: none; color: var(--xy-color-text-secondary); }
.pf-row__k--ink { color: var(--xy-color-text-primary); }
.pf-row__v { flex: 1; min-width: 0; text-align: right; color: var(--xy-color-text-primary); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.pf-row__v.is-muted { color: var(--xy-color-text-muted); }
.pf-row__v.is-warn { color: var(--xy-color-warning); }
.pf-row__v.is-left { text-align: left; }
.pf-arrow { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); opacity: .5; }
/* 按钮：点击区高 44（min-height 取触控最小值），可见色块 32 高画在 ::after 上 */
.pf-btn { position: relative; isolation: isolate; display: flex; flex: none; align-items: center; justify-content: center; min-width: calc(var(--xy-space-6) * 3); min-height: var(--xy-size-touch-min); padding: 0 var(--xy-space-4); box-sizing: border-box; font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); white-space: nowrap; }
.pf-btn::after { position: absolute; top: 50%; right: 0; left: 0; z-index: var(--xy-z-behind); height: var(--xy-pf-btn); transform: translateY(-50%); border-radius: var(--xy-radius-pill); content: ''; }
.pf-btn--p::after { background: var(--xy-color-brand); }
.pf-btn--p { color: var(--xy-color-text-inverse); }
.pf-btn--s::after { background: var(--xy-color-brand-soft); }
.pf-btn--s { color: var(--xy-color-brand); }
.pf-btn--o::after { background: var(--xy-color-surface); }
.pf-btn--o { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-medium); }
.pf-btn--o::after { box-shadow: inset 0 0 0 1rpx var(--xy-color-border-strong); }
.pf-btn--d::after { background: var(--xy-color-well); }
.pf-btn--d { color: var(--xy-color-text-muted); font-weight: var(--xy-text-weight-medium); }
.pf-btn:active { opacity: var(--xy-opacity-pressed); }
.pf-fnote { display: block; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: calc(var(--xy-text-body-small-size) + 6px); }
.pf-empty { padding: var(--xy-space-4); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: calc(var(--xy-text-body-small-size) + 8px); }
/* 状态小标签（绿 = 已上架 / 完成，橙 = 要处理，蓝 = 等平台，灰 = 结束） */
.pf-chip { flex: none; padding: 0 var(--xy-space-1); border-radius: var(--xy-space-1); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-semibold); line-height: calc(var(--xy-text-caption-size) + 5px); }
.pf-chip--g { background: var(--xy-color-brand-soft); color: var(--xy-color-brand); }
.pf-chip--o { background: var(--xy-color-key-warning-soft); color: var(--xy-color-key-warning); }
.pf-chip--b { background: var(--xy-color-info-light); color: var(--xy-color-info); }
.pf-chip--n { background: var(--xy-color-well); color: var(--xy-color-text-secondary); }
/* 底栏：次左（占 1）主右（占 2），高 44 */
.pf-foot > view, .pf-foot > button { flex: 1; }
.pf-foot > view:last-child { flex: 2; }
.pf-foot > button:only-child { flex: 1; }
.pf-foot > view:only-child { flex: 1; }
/* 卡内标题（设计稿 v5 发布设备 / 设价上架）：卡片第一行，16/600，右侧灰字说明 */
.pf-ch { display: flex; align-items: baseline; justify-content: space-between; gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-space-4) var(--xy-space-2); }
.pf-ch__t { font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.pf-ch__a { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.pf-ch + .pf-row::before, .pf-ch + picker .pf-row::before { display: none; }
/* 底栏次按钮固定 120 宽 */
.pf-foot > .pf-foot__s { flex: 0 0 calc(var(--xy-space-6) * 5); }
