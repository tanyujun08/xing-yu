.mc__tx{display:block}.mc__nm{display:flex;flex-direction:column}.mc__hit{flex:none;align-items:center;min-height:44px}
.mc{font-family:inherit}.mc__bal-b{font-family:"Helvetica Neue",Arial,sans-serif}.mc__btn{color:var(--m-accent)}

.member-overview{display:flex;flex-direction:column;gap:16px;margin-top:26px;color:#202622}
.ov-panel{border:1px solid #fff;border-radius:17px;background:linear-gradient(165deg,#fff 25%,#fafbfa 100%);box-shadow:0 1px 2px rgba(38,56,44,.04),0 10px 24px -20px rgba(39,60,48,.22)}
.ov-icon{display:flex;align-items:center;justify-content:center;flex:none;width:34px;height:34px;border-radius:10px;background:linear-gradient(145deg,#f8faf8,#edf1ef);box-shadow:inset 0 1px 1px #fff}
.ov-icon image{width:21px;height:21px}
.ov-icon--pink{background:linear-gradient(145deg,#fff6fa,#f8e1ec)}
.ov-icon--gold{background:linear-gradient(145deg,#fffaf0,#fae9cb)}
.ov-name{font-size:14px;font-weight:600;line-height:1.3;color:#202622}
.ov-meta{color:#656b74;font-size:12px;line-height:1.25}
.ov-meta--pink{color:#bf2d62;font-weight:600}
.asset-panel{display:flex;align-items:center;padding:4px}
.asset-row{position:relative;flex:1;min-width:0;display:flex;align-items:center;gap:10px;min-height:65px;padding:8px 11px;border-radius:12px;box-sizing:border-box}
.asset-row+.asset-row::before{content:"";position:absolute;top:14px;bottom:14px;left:0;border-left:1px solid #e9eceb}
.asset-copy{display:flex;flex-direction:column;gap:5px;min-width:0}
.asset-label{color:#656b74;font-size:12px;line-height:14px;white-space:nowrap}
.asset-value{font-family:"Helvetica Neue",Arial,sans-serif;font-size:23px;line-height:1;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.8px;color:#202622}
.asset-value--up{color:#263a32}
.asset-row .chevron{margin-left:auto;color:#747c86}
.quick-actions{display:flex;gap:4px;padding:2px 8px 4px}
.quick-item{flex:1;min-height:44px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:5px 3px;border-radius:13px}
.quick-item .ov-icon{width:43px;height:43px;margin-bottom:2px;border-radius:13px;background:linear-gradient(145deg,#f0faf5,#d8eee4);box-shadow:inset 0 1px 1px #fff,0 4px 9px -7px rgba(69,91,77,.26)}
.quick-item .ov-icon image{width:27px;height:27px}
.quick-item .quick-pink{background:linear-gradient(145deg,#fdf0f6,#f8d9e7)}
.quick-item .quick-gold{background:linear-gradient(145deg,#fff8ea,#f9e9cc)}
.ov-section{margin-top:5px}
.ov-section-header{display:flex;align-items:center;justify-content:space-between;min-height:44px;margin-bottom:4px}
.ov-section-header .ov-title{font-size:17px;line-height:24px;font-weight:700;color:#202622}
.ov-link{display:flex;align-items:center;gap:6px;min-height:44px;padding:0 4px;color:#58645f;font-size:12px;font-weight:600}
.task-list{padding:1px 13px}
.task-row{display:flex;align-items:center;gap:10px;min-height:61px;padding:8px 0;box-sizing:border-box}
.task-row+.task-row{border-top:1px solid #e9eceb}
.task-text{flex:1;display:flex;flex-direction:column;gap:5px;min-width:0}
.task-rewards{display:flex;flex-wrap:wrap;align-items:center;gap:4px 7px;font-size:13px;font-weight:600}
.reward-stars{color:#96590e}.reward-pink{color:#bf2d62}
.task-button{flex:none;display:flex;align-items:center;justify-content:center;min-width:60px;min-height:44px}
.task-button__in{display:flex;align-items:center;justify-content:center;width:100%;box-sizing:border-box;min-height:31px;padding:0 8px;border-radius:16px;color:#075f45;background:#e1f3e8;box-shadow:inset 0 0 0 1px #cae8d5;white-space:nowrap;font-size:12px;font-weight:600}
.task-button--todo .task-button__in{color:#485a51;background:#f3f5f3;box-shadow:inset 0 0 0 1px #e1e7e2}
.task-button--done .task-button__in{color:#8a948e;background:transparent;box-shadow:none}
.task-progress{width:48px;height:5px;overflow:hidden;border-radius:3px;background:#e0e8e3}
.task-progress__fill{height:100%;border-radius:3px;background:#789b88}
.task-count{color:#656b74;font-variant-numeric:tabular-nums}
.perk-grid{padding:0 12px}
.member-perk{display:flex;align-items:center;gap:10px;min-height:56px;padding:5px 1px;box-sizing:border-box}
.member-perk+.member-perk{border-top:1px solid #e9eceb}
.member-perk .ov-name{flex:1}
.member-perk .chevron{color:#656b74}
.member-notice{display:block;margin:12px 0;font-size:12px;color:#c0392b}


.levels-page{background:radial-gradient(ellipse 61% 205px at 83% 120px,var(--m-level-tone),transparent 98%),linear-gradient(180deg,#fcfcfb 0,#f5f5f7 382px);color:#23262b}
.levels-page .page-light{--m-top-tint:var(--m-level-tone);--m-top-tint-w:var(--m-level-tone-w);opacity:.25;height:258px}
.levels-body{position:relative;z-index:1;padding:0 16px calc(38px + env(safe-area-inset-bottom))}
.levels-hero{position:relative;display:flex;align-items:center;min-height:151px;margin:0 8px}
.levels-hero::before{content:"";position:absolute;top:-12px;bottom:-9px;left:49%;right:-4px;pointer-events:none;background:radial-gradient(ellipse 57% 44% at 54% 54%,rgba(255,255,255,.6),transparent 96%),radial-gradient(ellipse 45% 9% at 53% 89%,var(--m-shade19),transparent)}
.levels-hero-copy{position:relative;z-index:1;align-self:flex-start;width:52%;min-width:0;padding-top:6px}
.levels-current{display:inline-flex;align-items:center;gap:4px;min-height:23px;padding:2px 8px;box-sizing:border-box;border-radius:12px;color:var(--m-lacc);background:var(--m-lacc10w);font-size:12px;font-weight:700}
.levels-current__star{width:13px;height:13px;background:var(--m-lacc);-webkit-mask-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIiBwcmVzZXJ2ZUFzcGVjdFJhdGlvPSJub25lIj48cGF0aCBkPSJNNTAgOC4zTDYyLjUgMzQuNkw5MS43IDM4LjNMNzAuNCA1OC44TDc1LjQgODcuNUw1MCA3NC4yTDI0LjYgODcuNUwyOS42IDU4LjhMOC4zIDM4LjNMMzcuNSAzNC42WiIgZmlsbD0iIzAwMCIvPjwvc3ZnPg==");-webkit-mask-size:100% 100%;mask-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIiBwcmVzZXJ2ZUFzcGVjdFJhdGlvPSJub25lIj48cGF0aCBkPSJNNTAgOC4zTDYyLjUgMzQuNkw5MS43IDM4LjNMNzAuNCA1OC44TDc1LjQgODcuNUw1MCA3NC4yTDI0LjYgODcuNUwyOS42IDU4LjhMOC4zIDM4LjNMMzcuNSAzNC42WiIgZmlsbD0iIzAwMCIvPjwvc3ZnPg==");mask-size:100% 100%}
.levels-name{display:block;margin:7px 0 3px;font-size:24px;line-height:1.18;font-weight:700}
.levels-balance{display:flex;align-items:baseline;gap:4px;margin:5px 0 12px;color:#626971;font-size:12px;white-space:nowrap}
.levels-balance__n{color:#23262b;font-family:"Helvetica Neue",Arial,sans-serif;font-size:29px;font-weight:700;letter-spacing:-1px;line-height:1}
.level-hero-progress{height:9px;box-sizing:border-box;border:1px solid #fff;border-radius:5px;background:#e5e9e8;overflow:hidden}
.level-hero-progress__fill{height:100%;border-radius:5px;background:linear-gradient(90deg,var(--m-lacc60w),var(--m-lacc))}
.levels-range{display:flex;justify-content:space-between;gap:4px;margin-top:6px;color:#626971;font-size:12px}
.levels-hero-visual{position:relative;width:53%;height:0;padding-bottom:53%;margin:-5% 0 -5% -1.5%}
.levels-hero-visual__in,.next-level-visual__in{position:absolute;top:0;left:0;right:0;bottom:0}
.levels-hero-art,.next-level-art{position:relative;z-index:1;display:block;width:100%;height:100%}
.levels-art-base{position:absolute;z-index:0;bottom:12%;left:19%;width:62%;height:11%;box-sizing:border-box;border:1px solid rgba(255,255,255,.79);border-radius:50%/40%;background:linear-gradient(90deg,var(--m-stand-a),#fdfefd 47%,var(--m-stand-b));box-shadow:0 5px 10px -5px var(--m-stand-c)}
.levels-art-base::before{content:"";position:absolute;top:-17%;left:0;right:0;height:50%;box-sizing:border-box;border:1px solid #fff;border-radius:50%;background:radial-gradient(ellipse at center,#fff,var(--m-stand-d))}
.has-stand .levels-hero-art,.has-stand .next-level-art{transform:translateY(-3%) scale(var(--m-stand-scale))}
.level-rail{position:relative;margin:22px 0 16px;padding-top:26px}
.level-rail::before{content:"";position:absolute;top:0;left:7.14%;right:7.14%;height:42px;background:linear-gradient(90deg,var(--m-lacc56r) var(--m-rail-filled),#d9dddc var(--m-rail-filled));-webkit-mask-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIiBwcmVzZXJ2ZUFzcGVjdFJhdGlvPSJub25lIj48cGF0aCBkPSJNMCA4NkMzMyA0NyA2NyAzOSAxMDAgMEwxMDAgOEM2NyA0NyAzMyA1NSAwIDk0WiIgZmlsbD0iIzAwMCIvPjwvc3ZnPg==");-webkit-mask-size:100% 100%;mask-image:url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIiBwcmVzZXJ2ZUFzcGVjdFJhdGlvPSJub25lIj48cGF0aCBkPSJNMCA4NkMzMyA0NyA2NyAzOSAxMDAgMEwxMDAgOEM2NyA0NyAzMyA1NSAwIDk0WiIgZmlsbD0iIzAwMCIvPjwvc3ZnPg==");mask-size:100% 100%}
.level-rail-items{position:relative;display:flex}
.level-rail-item{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;gap:3px}
.level-rail-marker{display:flex;align-items:center;justify-content:center;width:23px;height:23px;margin-bottom:2px;box-sizing:border-box;border:1.5px solid #fff;border-radius:50%;background:#e2e7e6;box-shadow:0 3px 6px rgba(25,62,48,.13)}
.level-rail-marker image{width:12px;height:12px}
.level-rail-item--reached .level-rail-marker{background:#eef1f0}
.level-rail-item--reached .level-rail-marker image{opacity:.7}
.level-rail-item--locked .level-rail-marker image{opacity:.61}
.level-rail-item--current .level-rail-marker{background:var(--m-lacc);border-color:#fff;box-shadow:0 0 0 2px var(--m-lacc38w),0 3px 10px rgba(82,97,90,.19)}
.level-rail-item--next .level-rail-marker{background:#f8f9f8;border-color:#c3ccca}
.level-rail-item--next .level-rail-marker image{opacity:.85}
.level-rail-name{padding:2px 4px;font-size:12px;font-weight:600;white-space:nowrap;line-height:16px}
.level-rail-item--current .level-rail-name{border-radius:10px;color:#fff;background:var(--m-lacc)}
.level-rail-item--next .level-rail-name{color:#58645f}
.next-level-panel{display:flex;flex-wrap:wrap;align-items:center;padding:12px 15px 15px;border:1px solid #fff;border-radius:18px;background:radial-gradient(ellipse 50% 80% at 90% 0%,var(--m-lacc9w),transparent),#fff;box-shadow:0 10px 24px -20px rgba(48,75,68,.23)}
.next-level-copy{flex:1;min-width:0;padding:4px 10px 8px 0}
.next-level-title{display:block;font-size:17px;line-height:1.4;font-weight:700}
.next-level-title__gap{color:var(--m-lacc);font-size:19.5px;white-space:nowrap}
.next-level-caption{display:block;margin-top:5px;color:#626971;font-size:12px}
.next-level-visual{position:relative;flex:none;width:80px;height:80px}
.next-benefits{width:100%;display:flex;gap:8px;padding:12px 0;border-top:1px solid #e8ebe9}
.next-benefit{flex:1;display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600}
.next-benefit__icon{flex:none;width:26px;height:26px;padding:5px;box-sizing:border-box;border-radius:7px;background:#f0f3f1}
.next-benefit__icon image{display:block;width:16px;height:16px}
.level-actions{width:100%;display:flex;gap:8px}
.xy-button-reset.level-action{flex:1;display:flex;align-items:center;justify-content:center;min-height:44px;margin:0;padding:4px;border:0;border-radius:11px;color:#fff;background:#087b57;font-size:14px;font-weight:700;line-height:1.3;width:auto}
.xy-button-reset.level-action::after{display:none}
.xy-button-reset.level-action--secondary{color:#45534d;background:#f0f3f1}
.level-rules{margin-top:16px}
.level-rules-header{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:5px;margin:0 2px 10px}
.level-rules-header__t{font-size:17px;font-weight:700}
.level-rules-header__s{color:#626971;font-size:11px}
.level-rule-box{padding:3px 8px 5px;border:1px solid #fff;border-radius:15px;background:rgba(255,255,255,.85)}
.level-rule{display:flex;align-items:center;font-size:13px;white-space:nowrap;border-bottom:1px solid #e8ebe9}
.level-rule:last-child{border-bottom:0}
.level-rule__c{flex:1;padding:6px 5px}
.level-rule__c+.level-rule__c{text-align:right}
.level-rule--head{color:#626971;font-size:12px;font-weight:600}
.level-rule--current{color:var(--m-lacc);background:var(--m-lacc8w);font-weight:700;border-radius:7px}
.level-state-pill{display:inline-block;padding:2px 6px;border-radius:9px;color:#64716b;background:#f1f3f2;font-size:11px;line-height:14px}
.level-state-pill--current{color:#fff;background:var(--m-lacc)}

.stand-diamond{--m-stand-a:rgba(202,220,239,1.000);--m-stand-b:rgba(212,226,242,1.000);--m-stand-c:rgba(143,180,221,0.350);--m-stand-d:rgba(230,238,248,1.000);--m-stand-scale:1.02}
.stand-stellar{--m-stand-a:rgba(205,224,219,1.000);--m-stand-b:rgba(214,230,226,1.000);--m-stand-c:rgba(148,189,178,0.350);--m-stand-d:rgba(231,240,238,1.000);--m-stand-scale:0.82}
.stand-royal{--m-stand-a:rgba(231,220,202,1.000);--m-stand-b:rgba(236,227,212,1.000);--m-stand-c:rgba(204,181,143,0.350);--m-stand-d:rgba(244,239,230,1.000);--m-stand-scale:1.02}
