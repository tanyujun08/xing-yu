  --xy-color-action-secondary: var(--xy-color-surface);
  --xy-color-action-danger: var(--xy-color-danger);
  --xy-color-action-pressed: var(--xy-color-brand-pressed);
  --xy-color-focus: #2b67bd;
  --xy-color-link: #2b67bd;
  --xy-color-border: #e5e5ea;
  --xy-color-border-weak: #ebebed;
  --xy-color-border-strong: #858d96;
  --xy-color-divider: #ebebed;
