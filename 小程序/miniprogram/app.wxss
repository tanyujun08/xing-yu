  --xy-text-navigation-title-size: calc(9px + .5rem);
  --xy-text-preview-title-size: calc(5px + .5rem);
  --xy-text-micro-size: calc(2px + .5rem);
  --xy-text-micro-line-height: calc(6px + .5rem);
  --xy-text-calendar-caption-line-height: calc(4px + .5rem);
  --xy-text-body-relaxed-line-height: calc(14px + .5rem);
  --xy-text-task-amount-size: calc(16px + .5rem);
  --xy-text-task-amount-line-height: calc(22px + .5rem);
  --xy-line-height-icon: 1;
  --xy-radius-segment: 3px;
  --xy-radius-discovery-preview: 8px;
  --xy-radius-switch: 13px;
  --xy-radius-step-marker: 10px;
  --xy-color-gallery-counter: rgba(0,0,0,.5);
  --xy-color-calendar-track: #A5AFBA;
  --xy-color-source-cabinet: #07865f;
  --xy-color-source-store: #2675c9;
  --xy-color-source-store-surface: #eaf3ff;
  --xy-color-source-personal: #a96912;
  --xy-color-source-personal-surface: #fff3df;
  --xy-shadow-segment-selected: 0 1px 3px rgba(0,0,0,.08);
  --xy-z-navigation: 30;
}

view, text, image, input, textarea, button, label, picker, scroll-view, swiper { box-sizing: border-box; }
button::after { border: 0; }
button { width: auto !important; max-width: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font-family: inherit; font-size: inherit; font-weight: inherit; line-height: inherit; text-align: inherit; }
.xy-button-reset { width: auto !important; max-width: 100%; margin-right: 0 !important; margin-left: 0 !important; padding: 0; border: 0; border-radius: 0; background: transparent; color: inherit; font-family: inherit; font-size: inherit; font-weight: inherit; line-height: inherit; text-align: inherit; }
.xy-button-fluid { width: 100% !important; }
.xy-page { min-height: 100vh; padding-bottom: var(--xy-fixed-bottom-clearance); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.xy-page--white { background: var(--xy-color-surface); }
/* Deprecated: use surface, divider and list patterns for ordinary sections.
 * Keep only for isolated entities, benefits, coupons and empty states. */
.xy-card { border: 0; border-radius: var(--xy-radius-container, 6px); background: var(--xy-color-surface, #fff); box-shadow: none; }
.xy-section-title { color: var(--xy-color-text-primary, #202937); font-size: var(--xy-text-section-title-size, 16px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-section-title-line-height, 24px); }
.xy-body { color: var(--xy-color-text-secondary, #58616e); font-size: var(--xy-text-body-size, 14px); line-height: var(--xy-text-body-line-height, 20px); }
.xy-caption { color: var(--xy-color-text-muted, #67707c); font-size: var(--xy-text-caption-size, 11px); line-height: var(--xy-text-caption-line-height, 16px); }
/* Deprecated alias: use the structured .xy-price component for new money UI. */
.xy-amount { color: var(--xy-color-text-primary, #202937); font-family: var(--xy-font-family-numeric, sans-serif); font-size: var(--xy-price-value-size, 20px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-price-value-line-height, 24px); }
.xy-tap { transition: opacity var(--xy-duration-fast) ease; }
.xy-tap:active { opacity: var(--xy-opacity-pressed); }
.xy-tap:focus { outline: 2rpx solid var(--xy-color-focus); outline-offset: 2rpx; }
.muted { color: var(--xy-color-text-secondary); }
.hint { color: var(--xy-color-text-muted, #67707c); font-size: var(--xy-text-body-small-size, 12px); line-height: var(--xy-text-body-small-line-height, 18px); }
.link { color: var(--xy-color-link); }
.primary-button { display: flex; align-items: center; justify-content: center; min-height: var(--xy-control-height, 44px); border-radius: var(--xy-radius-md, 6px); background: var(--xy-color-action-primary, #0a7f5e); color: var(--xy-color-text-inverse, #fff); font-size: var(--xy-text-body-size, 14px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-body-line-height, 20px); }
.secondary-button { display: flex; align-items: center; justify-content: center; min-height: var(--xy-control-height, 44px); border: 1rpx solid var(--xy-color-border-strong, #858d96); border-radius: var(--xy-radius-md, 6px); background: var(--xy-color-action-secondary, #fff); color: var(--xy-color-text-primary, #202937); font-size: var(--xy-text-body-size, 14px); font-weight: var(--xy-text-weight-semibold, 600); line-height: var(--xy-text-body-line-height, 20px); }
.card { background: var(--xy-color-surface); }

/* Scoped to the approved return v3 journey; no global redesign. */
.return-theme {
  --xy-color-brand: var(--xy-return-brand);
  --xy-color-brand-light: var(--xy-return-brand-soft);
  --xy-color-brand-soft: var(--xy-return-brand-soft);
  --xy-color-success: var(--xy-return-brand);
  --xy-color-page: var(--xy-return-canvas);
  --xy-color-text-primary: var(--xy-return-ink);
  --xy-color-text-secondary: var(--xy-return-muted);
  --xy-color-text-muted: var(--xy-return-muted);
  --xy-color-info: var(--xy-return-link);
  --xy-color-link: var(--xy-return-link);
  --xy-color-border: var(--xy-return-border);
  --xy-color-divider: var(--xy-return-border);
  --xy-color-surface-subtle: var(--xy-return-control);
  --xy-color-disabled: var(--xy-return-disabled);
}
