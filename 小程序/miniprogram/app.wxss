  --xy-control-hit-overhang-small: 6px;
  --xy-control-hit-overhang-standard: 4px;
  --xy-button-padding-x: 16px;
  --xy-size-icon-base: 16px;
  --xy-size-icon-row: 20px;
  --xy-size-icon-nav: 24px;
  --xy-size-icon-feature: 32px;
