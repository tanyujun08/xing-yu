  --xy-font-family-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  --xy-font-family-numeric: var(--xy-font-family-sans);
  /* Algebraically equivalent to base + .5 * (1rem - 16px), without relying
   * on unsupported CSS multiplication. Viewport width never scales type. */
  --xy-text-page-title-size: calc(12px + .5rem);
  --xy-text-page-title-line-height: calc(20px + .5rem);
  --xy-text-section-title-size: calc(8px + .5rem);
  --xy-text-section-title-line-height: calc(16px + .5rem);
  --xy-text-item-title-size: calc(6px + .5rem);
  --xy-text-item-title-line-height: calc(12px + .5rem);
  --xy-text-body-size: calc(6px + .5rem);
  --xy-text-body-line-height: calc(12px + .5rem);
  --xy-text-body-small-size: calc(4px + .5rem);
  --xy-text-body-small-line-height: calc(8px + .5rem);
  --xy-text-caption-size: calc(3px + .5rem);
  --xy-text-caption-line-height: calc(8px + .5rem);
  --xy-text-weight-regular: 400;
  --xy-text-weight-medium: 500;
  --xy-text-weight-semibold: 600;
  --xy-text-weight-bold: 700;
  --xy-text-weight-heavy: 800;
  /* Spacing is a fixed CSS-px scale; it must not grow with viewport width. */
  --xy-space-1: 4px;
  --xy-space-2: 8px;
  --xy-space-3: 12px;
  --xy-space-4: 16px;
  --xy-space-5: 20px;
  --xy-space-6: 24px;
  /* Compatibility only for pages not yet migrated to the final names. */
  --xy-space-0-5: var(--xy-space-1);
  --xy-space-1-5: var(--xy-space-2);
  --xy-space-2-5: var(--xy-space-3);
  --xy-layout-page-padding-x: var(--xy-space-4);
  --xy-layout-page-padding-top: var(--xy-space-3);
  --xy-layout-first-block-gap: var(--xy-space-3);
  --xy-layout-first-block-gap-form: var(--xy-space-4);
  --xy-layout-card-stack-start-gap: var(--xy-space-4);
  --xy-discovery-rail-width: 112px;
  --xy-region-index-step: 24px;
  --xy-layout-section-gap: var(--xy-space-6);
  --xy-layout-section-gap-lg: var(--xy-space-6);
  --xy-layout-title-content-gap: var(--xy-space-3);
  --xy-layout-content-gap: var(--xy-space-3);
  --xy-layout-content-gap-compact: var(--xy-space-2);
  --xy-layout-inline-gap: var(--xy-space-2);
  /* Relationship aliases keep spacing tied to meaning instead of a page-local number. */
  --xy-gap-label-value: var(--xy-space-1);
  --xy-gap-title-description: var(--xy-space-1);
  --xy-gap-related: var(--xy-space-2);
  --xy-gap-group: var(--xy-space-3);
  --xy-gap-content-action: var(--xy-space-4);
  --xy-gap-product-meta-rows: 2px;
  --xy-gap-label-value-compact: 2px;
  --xy-gap-chip-compact: 6px;
  --xy-inset-card: var(--xy-space-3);
  --xy-inset-chip-compact-x: 6px;
  --xy-inset-chip-compact-y: 1px;
  /* Bounded optical compensation for adjacent text frames whose font leading
   * otherwise adds one extra visible pixel beyond the relationship target. */
  --xy-optical-text-frame-nudge: -1px;
  /* Radius is a separate shape scale: compact2 / media4 / card6 / emphasis12. */
  --xy-radius-compact: 2px;
  --xy-radius-sm: 4px;
  --xy-radius-md: 6px;
  --xy-radius-lg: 8px;
  --xy-radius-sheet: 16px;
  --xy-radius-pill: 999px;
  --xy-radius-media: var(--xy-radius-sm);
  --xy-radius-container: var(--xy-radius-lg);
  --xy-radius-emphasis: var(--xy-radius-lg);
  --xy-radius-control: var(--xy-radius-md);
  --xy-radius-circle: 50%;
  --xy-shadow-card: none;
  --xy-z-behind: -1;
  --xy-color-glass: rgba(255, 255, 255, .96);
  --xy-color-glass-soft: rgba(255, 255, 255, .88);
  --xy-shadow-ring: 0 0 0 2px var(--xy-color-surface);
  --xy-shadow-segment: 0 1px 3px rgba(17, 24, 39, .08);
  --xy-blur-glass: blur(20px);
  --xy-text-code-cell-size: calc(16px + .5rem);
  --xy-shadow-key: 0 6px 20px rgba(17, 24, 39, .06), 0 1px 3px rgba(17, 24, 39, .04);
  --xy-shadow-banner: 0 4px 12px rgba(18, 28, 26, .08);
  --xy-shadow-floating-action: 0 8px 20px rgba(18, 28, 26, .12);
  --xy-shadow-overlap-card: 0 8px 24px rgba(0, 0, 0, .14);
  --xy-shadow-float: 0 16rpx 40rpx rgba(19, 25, 38, .12);
  --xy-shadow-fixed: 0 -8rpx 24rpx rgba(19, 25, 38, .08);
  --xy-fixed-tab-visible-height: 56px;
  --xy-fixed-tab-clearance: calc(var(--xy-fixed-tab-visible-height) + var(--xy-space-4) + env(safe-area-inset-bottom));
  --xy-gap-tab-icon-label: 2px;
  --xy-size-tab-icon: 24px;
  --xy-text-tab-label-size: calc(3px + .5rem);
  --xy-text-tab-label-line-height: calc(8px + .5rem);
  --xy-fixed-bottom-height: 56px;
  --xy-fixed-bottom-clearance: calc(var(--xy-fixed-bottom-height) + var(--xy-space-4) + env(safe-area-inset-bottom));
  --xy-empty-page-min-height: 360px;
  --xy-empty-section-min-height: 120px;
  --xy-empty-page-illustration-width: 400rpx;
  --xy-empty-page-illustration-height: 300rpx;
