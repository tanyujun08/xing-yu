.custom-tab-bar {
  position: fixed;
  z-index: var(--xy-z-overlay, 100);
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(var(--xy-fixed-tab-visible-height, 56px) + env(safe-area-inset-bottom));
  min-height: calc(var(--xy-fixed-tab-visible-height, 56px) + env(safe-area-inset-bottom));
  padding: 0 0 env(safe-area-inset-bottom);
  border-top: 1rpx solid var(--xy-color-divider, #ebebed);
  /* Custom components do not reliably inherit page-scoped design tokens, so
   * every semantic value has a safe fallback for the component scope. */
  background: var(--xy-color-glass, #fff);
  -webkit-backdrop-filter: var(--xy-blur-glass);
  backdrop-filter: var(--xy-blur-glass);
  box-sizing: border-box;
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: var(--xy-fixed-tab-visible-height, 56px);
  color: var(--xy-color-text-muted, #86868b);
  font-size: var(--xy-text-tab-label-size, 11px);
  line-height: var(--xy-text-tab-label-line-height, 16px);
  font-weight: var(--xy-text-weight-medium, 500);
  transition: color .2s ease;
}

.tab-icon {
  width: var(--xy-size-tab-icon, 24px);
  height: var(--xy-size-tab-icon, 24px);
  margin-bottom: var(--xy-gap-tab-icon-label, 2px);
  transition: transform .12s ease;
}

/* 点按：图标轻微下压；切换：选中图标弹一下 */
.tab-item:active .tab-icon { transform: scale(.88); }
.tab-item.is-active .tab-icon { animation: tab-pop .32s cubic-bezier(.3, 1.5, .5, 1); }

.tab-item.is-active {
  color: var(--xy-color-brand, #0a7f5e);
  font-weight: var(--xy-text-weight-semibold, 600);
}

.tab-unread {
  position: absolute;
  top: var(--xy-space-1, 4px);
  left: calc(50% + var(--xy-space-1, 4px));
  box-sizing: border-box;
  min-width: var(--xy-size-icon-base, 16px);
  height: var(--xy-size-icon-base, 16px);
  padding: 0 var(--xy-space-1, 4px);
  border-radius: var(--xy-radius-container, 8px);
  background: var(--xy-color-danger, #d9381e);
  box-shadow: var(--xy-shadow-ring);
  color: var(--xy-color-text-inverse, #fff);
  font-size: var(--xy-text-caption-size, 11px);
  line-height: var(--xy-text-tab-label-line-height, 16px);
  font-weight: var(--xy-text-weight-semibold, 600);
  text-align: center;
}

@keyframes tab-pop {
  0% { transform: scale(.82); }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); }
}
