<view wx:if="{{visible}}" class="login-overlay" role="dialog" aria-label="登录星遇">
  <view class="login-backdrop" catchtap="close" role="button" aria-label="关闭登录弹窗" />
  <view class="login-sheet">
    <image class="login-deco" src="{{icons.loginSheetDeco}}" mode="widthFix" aria-hidden="true" />
    <view class="login-brand">
      <image class="login-logo" src="{{icons.loginLogo}}" mode="aspectFill" aria-hidden="true" />
      <text class="login-heading">星遇</text>
      <text class="login-copy">随时发现、租用和分享数码设备</text>
    </view>
    <view class="login-actions">
      <text wx:if="{{errorText}}" class="login-error" role="alert">{{errorText}}</text>
      <button class="quick-button {{submitting ? 'is-disabled' : ''}}" disabled="{{submitting}}" aria-disabled="{{submitting}}" bindtap="quickLogin" aria-label="微信一键登录"><image class="login-action-icon" src="{{icons.loginWechatWhite}}" mode="aspectFit" aria-hidden="true" /><text>{{submitting ? '登录中…' : '微信一键登录'}}</text></button>
      <button wx:if="{{!agreed}}" class="phone-button {{submitting ? 'is-disabled' : ''}}" disabled="{{submitting}}" aria-disabled="{{submitting}}" bindtap="phoneConsent" aria-label="同意协议后使用手机快捷登录"><image class="login-action-icon" src="{{icons.loginPhoneDark}}" mode="aspectFit" aria-hidden="true" /><text>手机快捷登录</text></button>
      <button wx:else class="phone-button {{submitting ? 'is-disabled' : ''}}" bindtap="demoPhoneAuthorize" disabled="{{submitting}}" aria-disabled="{{submitting}}" aria-label="微信授权手机快捷登录"><image class="login-action-icon" src="{{icons.loginPhoneDark}}" mode="aspectFit" aria-hidden="true" /><text>手机快捷登录</text></button>
      <view class="agreement-row" bindtap="toggleAgree" role="checkbox" aria-checked="{{agreed}}" aria-label="同意用户协议和隐私声明">
        <view class="agree-box {{agreed ? 'is-checked' : ''}}"><image wx:if="{{agreed}}" class="agree-icon" src="{{icons.agreementCheck}}" mode="aspectFit" aria-hidden="true" /></view>
        <view class="agreement-text">已阅读并同意 <view class="agreement-link-label">用户协议<button class="agreement-link-hit" data-legal="user-agreement" catchtap="openLegal" aria-label="阅读用户协议" hover-class="none" /></view> & <view class="agreement-link-label">隐私声明<button class="agreement-link-hit" data-legal="privacy-policy" catchtap="openLegal" aria-label="阅读隐私声明" hover-class="none" /></view></view>
      </view>
    </view>
    <button class="guest-button" bindtap="close" aria-label="暂不登录，随便逛逛"><text>暂不登录，随便逛逛</text><image class="guest-arrow" src="{{icons.loginGuestArrow}}" mode="aspectFit" aria-hidden="true" /></button>
  </view>
  <view wx:if="{{showConsentModal}}" class="consent-mask" catchtap="closeConsentModal" role="button" aria-label="关闭温馨提示">
    <view class="consent-modal" catchtap="noop" role="dialog" aria-label="温馨提示">
      <text class="consent-title">请先同意协议</text>
      <text class="consent-copy">登录前请阅读并同意《用户协议》与《隐私声明》，同意后再次点击登录。</text>
      <view class="consent-actions"><button class="consent-cancel" bindtap="closeConsentModal">取消</button><button class="consent-confirm" bindtap="confirmConsent">同意</button></view>
    </view>
  </view>
</view>
