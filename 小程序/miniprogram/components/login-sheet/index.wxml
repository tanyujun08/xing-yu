<view wx:if="{{visible}}" class="login-overlay" role="dialog" aria-label="登录星遇">
  <view class="login-backdrop" catchtap="close" role="button" aria-label="关闭登录弹窗" />
  <view class="login-sheet" style="{{windowWidth > 0 ? 'width:' + windowWidth + 'px;' : ''}}">
    <view class="login-hero">
      <view class="login-hero__ring login-hero__ring--lg" />
      <view class="login-hero__ring login-hero__ring--sm" />
      <button class="login-close" bindtap="close" aria-label="关闭登录弹窗" hover-class="none"><image class="login-close__icon" src="{{icons.loginClear}}" mode="aspectFit" aria-hidden="true" /></button>
      <image class="login-logo" src="{{icons.loginLogo}}" mode="aspectFill" aria-hidden="true" />
      <text class="login-heading">登录星遇</text>
      <text class="login-copy">登录后可租借设备、查看订单和收益</text>
    </view>
    <view class="login-body">
      <text wx:if="{{errorText}}" class="login-error" role="alert">{{errorText}}</text>
      <button class="quick-button {{submitting ? 'is-disabled' : ''}}" disabled="{{submitting}}" aria-disabled="{{submitting}}" bindtap="quickLogin" aria-label="微信登录"><view class="quick-icon"><image class="login-action-icon" src="{{icons.loginWechat}}" mode="aspectFit" aria-hidden="true" /></view><text>{{submitting ? '登录中…' : '微信一键登录'}}</text></button>
      <button wx:if="{{!agreed}}" class="phone-button {{submitting ? 'is-disabled' : ''}}" disabled="{{submitting}}" aria-disabled="{{submitting}}" bindtap="phoneConsent" aria-label="同意协议后使用手机号快捷登录"><image class="login-action-icon" src="{{icons.loginPhone}}" mode="aspectFit" aria-hidden="true" /><text>手机号快捷登录</text></button>
      <button wx:else class="phone-button {{submitting ? 'is-disabled' : ''}}" bindtap="demoPhoneAuthorize" disabled="{{submitting}}" aria-disabled="{{submitting}}" aria-label="微信授权手机号快捷登录"><image class="login-action-icon" src="{{icons.loginPhone}}" mode="aspectFit" aria-hidden="true" /><text>手机号快捷登录</text></button>
      <view class="trust-row"><image class="trust-icon" src="{{icons.loginShield}}" mode="aspectFit" aria-hidden="true" /><text class="phone-hint">手机号由微信授权获取，无需短信验证码</text></view>
      <view class="agreement-row" bindtap="toggleAgree" role="checkbox" aria-checked="{{agreed}}" aria-label="同意用户协议和隐私声明">
        <view class="agree-box {{agreed ? 'is-checked' : ''}}"><image wx:if="{{agreed}}" class="agree-icon" src="{{icons.agreementCheck}}" mode="aspectFit" aria-hidden="true" /></view>
        <view class="agreement-text">我已阅读并同意 <view class="agreement-link-label">《用户协议》<button class="agreement-link-hit" data-legal="user-agreement" catchtap="openLegal" aria-label="阅读用户协议" hover-class="none" /></view> 与 <view class="agreement-link-label">《隐私声明》<button class="agreement-link-hit" data-legal="privacy-policy" catchtap="openLegal" aria-label="阅读隐私声明" hover-class="none" /></view></view>
      </view>
      <button class="guest-button" bindtap="close" aria-label="暂不登录，留在当前页面">暂不登录，继续逛逛</button>
    </view>
  </view>
  <view wx:if="{{showConsentModal}}" class="consent-mask" catchtap="closeConsentModal" role="button" aria-label="关闭温馨提示">
    <view class="consent-modal" catchtap="noop" role="dialog" aria-label="温馨提示">
      <text class="consent-title">请先同意协议</text>
      <text class="consent-copy">登录前请阅读并同意《用户协议》与《隐私声明》，同意后再次点击登录。</text>
      <view class="consent-actions"><button class="consent-cancel" bindtap="closeConsentModal">取消</button><button class="consent-confirm" bindtap="confirmConsent">同意</button></view>
    </view>
  </view>
</view>
