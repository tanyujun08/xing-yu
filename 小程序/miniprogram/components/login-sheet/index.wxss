/* 登录弹层 第 3 稿：浅绿主视觉头（品牌图标 + 标题 18 + 一句价值说明，右上装饰圆环）→ 微信一键登录（主按钮）/ 手机号快捷登录（描边）→ 安全说明 → 协议勾选 → 暂不登录 */
.login-overlay { position: fixed; z-index: var(--xy-z-modal, 200); top: 0; bottom: 0; left: 0; right: 0; box-sizing: border-box; display: flex; align-items: flex-end; background: var(--xy-color-scrim, rgba(19, 25, 38, .45)); }
.login-backdrop { position: absolute; inset: 0; }
.login-sheet { position: relative; width: 100%; max-width: 100%; min-width: 0; max-height: calc(100vh - var(--xy-control-height-large)); overflow-y: auto; box-sizing: border-box; border-radius: var(--xy-radius-lg) var(--xy-radius-lg) 0 0; background: var(--xy-color-surface, #fff); color: var(--xy-color-text-primary, #202937); }
.login-hero { position: relative; display: flex; flex-direction: column; align-items: flex-start; overflow: hidden; padding: var(--xy-space-6) var(--xy-space-6) var(--xy-space-5); background: var(--xy-color-brand-light); }
.login-hero__ring { position: absolute; border-radius: var(--xy-radius-circle); box-shadow: inset 0 0 0 calc(var(--xy-space-4) + var(--xy-space-2)) var(--xy-color-surface); opacity: .55; }
.login-hero__ring--lg { top: calc(var(--xy-space-6) * -2); right: calc(var(--xy-space-6) * -2); width: calc(var(--xy-space-6) * 7); height: calc(var(--xy-space-6) * 7); }
.login-hero__ring--sm { right: calc(var(--xy-space-6) * 2); bottom: calc(var(--xy-space-4) * -1); width: calc(var(--xy-space-6) * 2); height: calc(var(--xy-space-6) * 2); box-shadow: inset 0 0 0 var(--xy-space-2) var(--xy-color-surface); }
.login-close { position: absolute; top: var(--xy-space-2); right: var(--xy-space-2); display: flex; width: var(--xy-size-touch-min); min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; background: transparent; }
.login-close__icon { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.login-logo { position: relative; display: block; width: calc(var(--xy-space-6) * 2); height: calc(var(--xy-space-6) * 2); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-card); }
.login-heading { position: relative; margin-top: var(--xy-space-4); color: var(--xy-color-text-strong); font-size: var(--xy-text-order-navigation-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.login-copy { position: relative; margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.login-body { display: flex; flex-direction: column; gap: var(--xy-space-3); padding: var(--xy-space-5) var(--xy-space-6) calc(var(--xy-space-3) + env(safe-area-inset-bottom)); }
.login-error { display: block; color: var(--xy-color-danger); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.quick-button, .phone-button { display: flex; width: 100% !important; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; gap: var(--xy-space-2); box-sizing: border-box; margin: 0 !important; padding: var(--xy-space-0-5) var(--xy-space-3); border-radius: var(--xy-radius-md); font-family: inherit; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.quick-button { border: 0; background: var(--xy-color-brand); color: var(--xy-color-text-inverse); }
.quick-icon { display: flex; width: var(--xy-size-icon-nav); height: var(--xy-size-icon-nav); align-items: center; justify-content: center; border-radius: var(--xy-radius-circle); background: var(--xy-color-surface); }
.quick-icon .login-action-icon { width: var(--xy-size-icon-sm); height: var(--xy-size-icon-sm); }
.login-action-icon { display: block; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.phone-button { border: 1px solid var(--xy-color-border); background: var(--xy-color-surface); color: var(--xy-color-text-strong); }
.quick-button.is-disabled, .phone-button.is-disabled { opacity: .55; }
.trust-row { display: flex; align-items: center; gap: var(--xy-space-1); }
.trust-icon { flex: none; width: var(--xy-size-icon-sm); height: var(--xy-size-icon-sm); }
.phone-hint { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.agreement-row { display: flex; min-height: var(--xy-size-touch-min); align-items: center; gap: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.agreement-text { min-width: 0; flex: 0 1 auto; overflow-wrap: anywhere; }
.agreement-link-label { position: relative; display: inline-block; color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.agreement-link-hit { position: absolute; top: 50%; left: 0; right: 0; min-height: var(--xy-size-touch-min); min-width: var(--xy-size-touch-min); transform: translateY(-50%); margin: 0; padding: 0; border: 0; background: transparent; }
.agree-box { display: flex; width: var(--xy-size-icon-sm); height: var(--xy-size-icon-sm); flex: none; align-items: center; justify-content: center; box-sizing: border-box; border: 1px solid var(--xy-color-border-strong); border-radius: var(--xy-radius-circle); background: var(--xy-color-surface); }
.agree-box.is-checked { border-color: var(--xy-color-brand); background: var(--xy-color-brand); }
.agree-icon { width: var(--xy-space-3); height: var(--xy-space-3); }
.guest-button { display: flex; width: 100% !important; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; margin: 0 !important; padding: 0; border: 0; border-top: 1px solid var(--xy-color-divider); border-radius: 0; background: transparent; color: var(--xy-color-text-secondary); font-family: inherit; font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-regular); line-height: var(--xy-text-body-small-line-height); }
.login-close::after, .quick-button::after, .phone-button::after, .guest-button::after, .agreement-link-hit::after, .consent-cancel::after, .consent-confirm::after { border: 0; }
.consent-mask { position: fixed; z-index: var(--xy-z-modal, 200); inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: var(--xy-space-6); background: var(--xy-color-scrim); }
.consent-modal { width: 100%; box-sizing: border-box; padding: var(--xy-space-6) var(--xy-space-5) var(--xy-space-5); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.consent-title { display: block; color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); text-align: center; }
.consent-copy { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-align: center; }
.consent-actions { display: flex; gap: var(--xy-space-3); margin-top: var(--xy-space-5); }
.consent-cancel, .consent-confirm { display: flex; flex: 1; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: var(--xy-radius-md); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); }
.consent-cancel { background: var(--xy-color-surface-subtle); color: var(--xy-color-text-primary); }
.consent-confirm { background: var(--xy-color-brand); color: var(--xy-color-text-inverse); }
