.sheet-mask { position:fixed; inset:0; z-index:var(--xy-z-modal,1000); display:flex; align-items:flex-end; background:var(--xy-color-scrim); }
.sheet-mask__dismiss { position:absolute; inset:0; width:100%; height:100%; margin:0; padding:0; border:0; border-radius:0; background:transparent; }
.sheet-mask__dismiss::after { border:0; }
.sheet { position:relative; display:flex; flex-direction:column; width:100%; max-height:75vh; padding-bottom:env(safe-area-inset-bottom); box-sizing:border-box; border-radius:var(--xy-radius-sheet) var(--xy-radius-sheet) 0 0; overflow:hidden; background:var(--xy-color-surface); color:var(--xy-color-text-primary); }
.sheet__header { position:relative; display:flex; flex:none; align-items:center; padding:var(--xy-space-4) calc(var(--xy-space-4) + var(--xy-size-touch-min)) var(--xy-space-4) var(--xy-space-4); gap:var(--xy-space-3); }
.sheet__title { flex:1; font-size:var(--xy-text-section-title-size,16px); line-height:var(--xy-text-section-title-line-height,24px); font-weight:var(--xy-text-weight-semibold,600); }
.sheet__close { position:absolute; right:var(--xy-space-2); top:50%; transform:translateY(-50%); display:flex; align-items:center; justify-content:flex-end; min-width:var(--xy-size-touch-min); width:var(--xy-size-touch-min); height:var(--xy-size-touch-min); padding:0; margin:0; border:0; background:transparent; color:var(--xy-color-text-secondary); font-size:var(--xy-size-icon-nav); line-height:var(--xy-size-icon-nav); }
.sheet__close::after { border:0; }
.sheet__body { flex:none; min-height:0; overflow:hidden; box-sizing:border-box; }
.sheet__content { padding:0 var(--xy-space-4); }
.sheet__summary { flex:none; position:relative; background:var(--xy-color-surface); }
.sheet__summary:empty { display:none; }
.sheet__footer { flex:none; position:relative; padding:var(--xy-space-3) var(--xy-space-4); background:var(--xy-color-surface); }
.sheet--full { height:100%; max-height:100%; border-radius:0; background:var(--xy-color-page); }
.sheet__header--full { display:block; padding:0; }
.sheet--full .sheet__content { padding-top:var(--xy-space-3); padding-bottom:var(--xy-space-4); }
