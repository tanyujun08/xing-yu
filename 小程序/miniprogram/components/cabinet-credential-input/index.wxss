.credential { color: var(--xy-color-text-primary, #202937); font-family: var(--xy-font-family-sans, sans-serif); }
.credential__label { display: block; color: var(--xy-color-text-muted, #67707c); font-size: var(--xy-text-body-small-size, 12px); line-height: var(--xy-text-body-small-line-height, 18px); }
.credential__value { display: block; margin-top: var(--xy-space-1, 4px); color: var(--xy-color-text-strong, #111827); font-family: var(--xy-font-family-numeric, sans-serif); font-size: calc(var(--xy-text-page-title-size) + var(--xy-space-2)); font-weight: var(--xy-text-weight-bold, 700); letter-spacing: var(--xy-space-1); line-height: calc(var(--xy-text-page-title-line-height) + var(--xy-space-2)); }
.credential__entry { position: relative; margin-top: var(--xy-space-3, 12px); }
.credential__input { position: absolute; z-index: var(--xy-z-local, 1); inset: 0; width: 100%; height: 100%; opacity: 0; }
.credential__cells { display: flex; gap: var(--xy-space-2, 8px); }
.credential__cell { display: flex; min-width: 0; min-height:52px; flex: 1 1 0; align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid var(--xy-color-border, #e5e5ea); border-radius: var(--xy-radius-md, 6px); background: var(--xy-color-surface-subtle, #fafafc); color: var(--xy-color-text-primary, #202937); font-family: var(--xy-font-family-numeric, sans-serif); font-size: calc(16px + .5rem); font-weight: var(--xy-text-weight-heavy, 800); }
.credential__cell.is-active { background:var(--xy-color-brand-light); border-color: var(--xy-color-brand, #0a7f5e); box-shadow: inset 0 0 0 1rpx var(--xy-color-brand, #0a7f5e); }
.credential__entry.has-error .credential__cell { border-color: var(--xy-color-danger, #c62828); box-shadow: none; }
.credential__error { display: block; margin-top: var(--xy-space-1, 4px); color: var(--xy-color-danger, #c62828); font-size: var(--xy-text-body-small-size, 12px); line-height: var(--xy-text-body-small-line-height, 18px); }
