<wxs module="g">
// 按凭证分类分组：每组一张白卡，组内一行三格
module.exports.groups = function (tiles, readOnly) {
  var list = [], index = {};
  for (var i = 0; i < tiles.length; i++) {
    var t = tiles[i], k = t.slotKey;
    if (index[k] === undefined) { index[k] = list.length; list.push({ key: k, title: t.groupTitle || t.title, kind: t.kind, instruction: t.instruction, exampleKey: t.example ? t.key : '', ready: 0, total: 0, required: false, items: [] }); }
    var group = list[index[k]];
    group.total++;
    if (!readOnly || t.ready || t.draftPreview) group.items.push(t);
    if (t.ready && !t.pending) group.ready++;
    if (t.required) group.required = true;
  }
  // 记录模式只展示已保存的凭证；整组为空时留一个占位格说明状态
  if (readOnly) for (var j = 0; j < list.length; j++) if (!list[j].items.length) list[j].items.push({ key: list[j].key + ':none', state: '未提交' });
  return list;
};
module.exports.hasFocus = function (items, key) { for (var i = 0; i < items.length; i++) if (items[i].key === key) return true; return false; };
</wxs>
<view wx:if="{{single}}" class="single">
  <view wx:for="{{tiles}}" wx:key="key" class="single__row {{item.failed ? 'is-failed' : ''}}">
    <button wx:if="{{item.ready || item.draftPreview}}" class="cell cell--single" data-key="{{item.key}}" bindtap="preview" aria-label="预览{{item.title}}凭证"><image class="cell__media" src="{{item.draftPreview || (item.kind === 'VIDEO' ? item.poster : item.url)}}" mode="aspectFill" /><text wx:if="{{item.failed}}" class="cell__badge cell__badge--bad">上传失败</text><text wx:elif="{{item.pending}}" class="cell__badge">{{item.state}}</text></button>
    <view wx:elif="{{readOnly}}" class="cell cell--single cell--empty"><text class="cell__hint">{{item.state}}</text></view>
    <button wx:else class="cell cell--single cell--empty {{busy || !item.editable || (item.pending && !item.failed) ? 'is-disabled' : ''}}" data-key="{{item.key}}" bindtap="select" disabled="{{busy || !item.editable || (item.pending && !item.failed)}}" aria-disabled="{{busy || !item.editable || (item.pending && !item.failed)}}" aria-label="上传{{item.title}}"><text class="cell__plus" aria-hidden="true">+</text><text class="cell__hint">{{albumOnly ? '从相册选择' : '拍摄'}}</text></button>
    <view class="single__copy">
      <text class="single__title">{{item.title}}</text>
      <text class="single__note">{{albumOnly ? '从已拍摄照片中选择，更换后保留历史记录' : '须拍清设备与全部配件，请在关门前完成拍摄'}}</text>
      <view wx:if="{{!readOnly && item.editable}}" class="single__links">
        <button wx:if="{{item.pending}}" class="link {{busy ? 'is-disabled' : ''}}" data-key="{{item.key}}" bindtap="recover" disabled="{{busy}}" aria-disabled="{{busy}}">{{item.failed ? '继续上传' : '查看上传进度'}}</button>
        <button wx:if="{{item.ready && !item.pending || item.failed}}" class="link {{busy ? 'is-disabled' : ''}}" data-key="{{item.key}}" bindtap="select" disabled="{{busy}}" aria-disabled="{{busy}}">更换照片</button>
        <button wx:if="{{item.example}}" class="link" data-key="{{item.key}}" bindtap="example" aria-label="查看{{item.title}}示例">查看示例</button>
      </view>
      <text wx:if="{{item.error}}" class="error" role="alert">{{item.error}}</text>
    </view>
  </view>
</view>
<view wx:else class="groups">
  <view wx:for="{{g.groups(tiles, readOnly)}}" wx:for-item="group" wx:key="key" class="group {{!readOnly && focusKey && g.hasFocus(group.items, focusKey) ? 'is-focused' : ''}}">
    <view class="group__head">
      <text class="group__title">{{group.title}}</text>
      <text class="group__count {{group.ready >= group.total ? 'is-done' : ''}}">{{readOnly ? group.ready + ' 项' : group.ready + '/' + group.total + (group.required ? ' · 必填' : '')}}</text>
      <text wx:if="{{!readOnly && focusKey && g.hasFocus(group.items, focusKey)}}" class="group__focus" role="status">待补交</text>
      <button wx:if="{{group.exampleKey && !readOnly}}" class="link group__example" data-key="{{group.exampleKey}}" bindtap="example" aria-label="查看{{group.title}}示例">示例</button>
    </view>
    <view class="cells">
      <view wx:for="{{group.items}}" wx:key="key" class="cells__item">
        <button wx:if="{{item.ready || item.draftPreview}}" class="cell {{item.failed ? 'is-failed' : ''}}" data-key="{{item.key}}" bindtap="preview" aria-label="预览{{item.title}}凭证">
          <image class="cell__media" src="{{item.draftPreview || (item.kind === 'VIDEO' ? item.poster : item.url)}}" mode="aspectFill" />
          <image wx:if="{{item.kind === 'VIDEO'}}" class="cell__play" src="{{icons.returnVideoPlay}}" mode="aspectFit" />
          <text wx:if="{{item.failed}}" class="cell__badge cell__badge--bad">失败</text><text wx:elif="{{item.pending}}" class="cell__badge">{{item.state}}</text>
        </button>
        <view wx:elif="{{readOnly}}" class="cell cell--empty"><text class="cell__hint">{{item.state}}</text></view>
        <button wx:else class="cell cell--empty {{busy || !item.editable || (item.pending && !item.failed) ? 'is-disabled' : ''}}" data-key="{{item.key}}" bindtap="select" disabled="{{busy || !item.editable || (item.pending && !item.failed)}}" aria-disabled="{{busy || !item.editable || (item.pending && !item.failed)}}" aria-label="上传{{item.title}}"><text class="cell__plus" aria-hidden="true">+</text><text class="cell__hint">{{albumOnly ? '相册' : item.kind === 'VIDEO' ? '录像' : item.required ? '拍摄' : '选填'}}</text></button>
        <button wx:if="{{!readOnly && item.editable && item.pending}}" class="link cells__act {{busy ? 'is-disabled' : ''}}" data-key="{{item.key}}" bindtap="recover" disabled="{{busy}}" aria-disabled="{{busy}}">{{item.failed ? '重试' : '进度'}}</button>
        <button wx:elif="{{!readOnly && item.editable && item.ready}}" class="link cells__act {{busy ? 'is-disabled' : ''}}" data-key="{{item.key}}" bindtap="select" disabled="{{busy}}" aria-disabled="{{busy}}">更换</button>
      </view>
    </view>
    <text wx:if="{{group.instruction}}" class="group__note">{{group.instruction}}</text>
    <block wx:for="{{group.items}}" wx:key="key"><text wx:if="{{item.error}}" class="error" role="alert">{{item.title}}：{{item.error}}</text></block>
  </view>
</view>
