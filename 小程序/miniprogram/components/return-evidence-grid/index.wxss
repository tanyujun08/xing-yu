
.evidence-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--xy-space-2); }
.evidence-tile { box-sizing:border-box; min-width:0; padding:0 var(--xy-space-2) var(--xy-space-2); border:1px solid var(--xy-color-border); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.evidence-heading { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-1); }
.evidence-title { min-width:0; font-size:var(--xy-text-body-small-size); line-height:var(--xy-return-line-compact); font-weight:var(--xy-text-weight-semibold); color:var(--xy-color-text-primary); overflow-wrap:anywhere; }
.evidence-link { flex-shrink:0; display:flex; align-items:center; justify-content:center; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); margin:0; padding:0; border:0; background:transparent; color:var(--xy-color-info); font-size:var(--xy-text-caption-size); line-height:var(--xy-return-line-compact); white-space:normal; }
.evidence-link::after,.evidence-preview::after,.evidence-upload::after { border:0; }
.evidence-body { display:flex; gap:var(--xy-space-2); align-items:center; }
.evidence-preview,.evidence-upload { box-sizing:border-box; position:relative; display:flex; width:100% !important; height:var(--xy-return-upload-height); min-height:var(--xy-size-touch-min); margin:0; padding:0; align-items:center; justify-content:center; overflow:hidden; border:0; border-radius:var(--xy-radius-md); background:var(--xy-color-surface-subtle); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-return-line-body); }
.evidence-upload { flex-direction:column; gap:var(--xy-space-2); }
.evidence-upload-icon { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); opacity:1; }
.has-media .evidence-preview,.has-media .evidence-upload { flex:1; width:0 !important; height:var(--xy-return-proof-height); }
.evidence-media { display:block; width:100%; height:100%; }
.evidence-play { position:absolute; width:36px; height:36px; left:50%; top:50%; transform:translate(-50%,-50%); }
.evidence-status-icon { width:24px; height:24px; }
.evidence-status { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:var(--xy-space-1); width:44px; flex:none; text-align:center; font-size:var(--xy-text-caption-size); line-height:var(--xy-return-line-compact); color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.evidence-status.is-ready { color:var(--xy-color-success); }
.is-failed { background:var(--xy-return-danger-soft); }
.evidence-controls { position:relative; display:flex; justify-content:center; gap:var(--xy-space-2); height:28px; }
.evidence-controls .evidence-replace { position:relative; top:calc(0px - var(--xy-space-2)); }
.evidence-replace { font-size:var(--xy-text-body-small-size); }
.evidence-error { display:block; color:var(--xy-color-danger); font-size:var(--xy-text-caption-size); line-height:var(--xy-return-line-body); }
.evidence-link.is-disabled,.evidence-upload.is-disabled { opacity:var(--xy-opacity-disabled); }
.is-single { display:block; }
.is-single .evidence-tile { border:0; padding:0; }
.is-single .evidence-title { font-size:var(--xy-text-section-title-size); }
.is-single .evidence-preview,.is-single .evidence-upload { flex:none; width:var(--xy-return-photo-size) !important; height:var(--xy-return-photo-size); }
.is-single .evidence-single-copy { flex:1; display:flex; flex-direction:column; gap:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-return-line-copy); }
.is-single .evidence-status { display:none; }
.is-single .evidence-controls { justify-content:flex-start; }
@media (max-width:340px) { .evidence-grid:not(.is-single) { grid-template-columns:minmax(0,1fr); } }

.evidence-grid .evidence-upload.is-disabled { background:var(--xy-color-surface-subtle); color:var(--xy-color-text-secondary); }

.evidence-heading { position:relative; min-height:28px; padding-right:calc(var(--xy-size-touch-min) + var(--xy-space-2)); }
.evidence-example { position:absolute; right:0; top:-8px; }

.is-single .is-failed { background:var(--xy-color-surface); }
.evidence-failed-label { position:absolute; bottom:0; left:0; padding:var(--xy-space-1); border-radius:var(--xy-radius-md); background:var(--xy-color-danger); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); line-height:var(--xy-return-line-body); }
.evidence-single-copy .evidence-link { justify-content:flex-start; gap:var(--xy-space-2); font-size:var(--xy-text-body-size); }
.evidence-tile.is-focused { outline:1px solid var(--xy-color-brand); }
.evidence-focus { display:block; color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); margin-bottom:var(--xy-space-2); }
