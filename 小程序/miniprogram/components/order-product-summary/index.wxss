.summary { min-width:0; color:var(--xy-color-text-primary); }
.summary__main { display:flex; align-items:flex-start; gap:var(--xy-space-3,12px); min-width:0; min-height:var(--xy-size-touch-min); }
.summary__media { display:block; flex:0 0 64px; width:64px; height:64px; overflow:hidden; border-radius:var(--xy-radius-md); background:var(--xy-color-page); }
.summary__copy { position:relative; flex:1; min-width:0; }
.summary__title { display:block; font-size:var(--xy-text-body-size,14px); line-height:var(--xy-text-body-line-height,20px); font-weight:var(--xy-text-weight-semibold,600); overflow-wrap:anywhere; }
.summary__secondary { display:block; margin-top:var(--xy-space-1,4px); font-size:var(--xy-text-body-small-size,12px); line-height:var(--xy-text-body-small-line-height,18px); color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.summary--list .summary__title { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.summary--list .summary__secondary { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.summary__arrow { flex:0 0 12px; margin-left:calc(var(--xy-space-4) - var(--xy-space-5)); font-size:var(--xy-size-icon-row); line-height:var(--xy-size-icon-row); color:var(--xy-color-text-muted); }

/* Keep the existing visual carrier; constrain only its interaction box. */
.summary { box-sizing:border-box; min-height:var(--xy-size-touch-min); }
.summary--order-list .summary__media { flex-basis:var(--xy-order-thumbnail-size); width:var(--xy-order-thumbnail-size); height:var(--xy-order-thumbnail-size); }
.summary--order-list .summary__title { font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.summary--order-list .summary__title--clamped { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.summary--order-list .summary__title-measure { position:absolute; top:0; left:0; width:100%; display:block; visibility:hidden; pointer-events:none; }
.summary__title-action { display:block; box-sizing:border-box; min-height:var(--xy-size-touch-min); margin:var(--xy-space-1) 0 0; padding:var(--xy-space-2) 0; border:0; border-radius:0; background:transparent; color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); text-align:right; }
.summary__title-action::after { border:0; }
