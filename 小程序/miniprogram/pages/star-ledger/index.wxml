<page-meta root-font-size="system" />
<view class="member-subpage star-ledger-page">
<page-header title="{{secondaryNavigationTitle || '星光明细'}}" background="#F7F9F8" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <status-view wx:if="{{!loggedIn}}" state="empty" title="登录后查看星光明细" description="积分流水属于当前账号" action-text="去登录" bindaction="openLogin" />
  <view wx:if="{{loggedIn}}" class="member-subpage__hero member-subpage__hero--dark">
    <view class="member-subpage__hero-top"><view><text class="member-subpage__eyebrow">成长账本</text><text class="member-subpage__title">星光明细</text></view><view class="star-ledger-mark"><image src="{{icons.membershipTaskUpgrade}}" mode="aspectFit" /></view></view>
    <view class="member-subpage__balance"><text class="member-subpage__balance-value">{{starBalance}}</text><text class="member-subpage__balance-unit">星光</text></view>
    <text class="member-subpage__hero-copy">星光用于会员等级成长，实际奖励与变动以账户流水为准。</text>
    <view class="member-subpage__hero-meta star-ledger-meta"><view class="member-subpage__meta-item"><text class="member-subpage__meta-value">{{today}}</text><text class="member-subpage__meta-label">今日变动</text></view><view class="member-subpage__meta-item"><text class="member-subpage__meta-value">{{week}}</text><text class="member-subpage__meta-label">本周变动</text></view></view>
    <view class="member-subpage__actions"><button class="member-subpage__button member-subpage__button--primary xy-button-reset xy-button-fluid" bindtap="openTasks" role="button">去做任务</button><button class="member-subpage__button xy-button-reset xy-button-fluid" bindtap="openLevelRights" role="button">等级与权益</button></view>
  </view>

  <view wx:if="{{loggedIn}}" class="member-subpage__section">
    <view class="member-subpage__section-head"><text class="member-subpage__section-title">收支记录</text><text class="member-subpage__section-note">账户流水</text></view>
    <status-view wx:if="{{listState.phase === 'initial-loading'}}" state="loading" title="正在加载星光明细" />
    <status-view wx:elif="{{listState.phase === 'initial-error'}}" state="error" title="星光明细加载失败" description="{{listState.error.message}}" action-text="重试" bindaction="retryInitial" />
    <status-view wx:elif="{{listState.phase === 'empty'}}" state="empty" title="暂无星光流水" description="账户产生星光变动后会显示在这里" />
    <view class="member-subpage__surface star-record-list">
      <view wx:for="{{items}}" wx:key="id" class="member-subpage__row star-record-row">
        <view class="member-subpage__row-main"><view class="member-subpage__icon-box member-subpage__icon-box--gold"><image class="member-subpage__icon" src="{{item.icon}}" mode="aspectFit" /></view><view class="member-subpage__copy"><text class="member-subpage__row-title">{{item.title}}</text><text class="member-subpage__row-detail">{{item.detail}}</text></view></view>
        <view class="member-subpage__row-end"><text class="member-subpage__amount member-subpage__amount--{{item.tone === 'minus' ? 'pink' : 'gold'}}">{{item.amount}}</text><text class="star-record-unit">星光</text></view>
      </view>
    </view>
    <status-view wx:if="{{listState.phase === 'ready' && listState.incremental === 'refreshing'}}" state="loading" density="compact-footer" title="正在刷新明细" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'refresh-error'}}" state="error" density="compact-footer" title="刷新失败" action-text="重试刷新" bindaction="retryRefresh" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'loading-more'}}" state="loading" density="compact-footer" title="正在加载更多" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'load-more-error'}}" state="error" density="compact-footer" title="加载更多失败" action-text="重试" bindaction="retryLoadMore" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'done'}}" state="end" density="compact-footer" title="流水已全部加载" />
    <text class="member-subpage__footnote">统计按北京时间自然日和周一开始的本周计算，包含奖励与冲正净变动。</text>
  </view>
</view>
