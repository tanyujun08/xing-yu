@import "../../shared/design/components.wxss";
.store-detail-page { min-height:100vh; padding-bottom:calc(var(--xy-space-4) + env(safe-area-inset-bottom)); background:var(--xy-color-surface); }
.entity-hero { position:relative; }
.store-hero { display:block; width:100%; height:auto; }
.store-identity { display:flex; align-items:baseline; gap:var(--xy-space-3); padding:var(--xy-space-4); }
.store-title { flex:1; min-width:0; overflow-wrap:anywhere; font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.store-distance { flex:none; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-service-copy { display:block; margin-top:calc(var(--xy-space-2) - var(--xy-space-4)); padding:0 var(--xy-space-4) var(--xy-space-4); overflow-wrap:anywhere; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-info { padding:0 var(--xy-space-4); }
.store-info-row { display:grid; grid-template-columns:20px 48px minmax(0,1fr) 44px; column-gap:var(--xy-space-3); align-items:center; min-height:48px; padding:0; border-bottom:1rpx solid var(--xy-color-divider); }
.store-info-row:last-child { border-bottom:0; }
.store-info-icon { align-self:center; width:18px; height:18px; margin-top:0; }
.store-info-label { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-info-value { min-width:0; overflow-wrap:anywhere; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.store-info-action { display:flex; align-items:center; justify-content:center; min-width:44px; min-height:var(--xy-control-height); color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.page--large .store-identity { flex-wrap:wrap; }
.page--large .store-title { flex-basis:100%; }
.page--large .store-distance { margin-left:auto; }
.page--large .store-info-row { grid-template-columns:20px minmax(0,1fr) 44px; grid-template-areas:'icon label action' '. value value'; column-gap:var(--xy-space-2); }
.page--large .store-info-icon { grid-area:icon; }
.page--large .store-info-label { grid-area:label; }
.page--large .store-info-value { grid-area:value; }
.page--large .store-info-action { grid-area:action; }
.entity-swiper { display:block; width:100%; height:50vw; max-height:240px; background:var(--xy-color-page); }
.entity-slide { display:block; width:100%; height:100%; }
.gallery-count { position:absolute; right:12px; bottom:12px; padding:calc(var(--xy-space-3) / 4) calc(var(--xy-space-3) - var(--xy-space-3) / 4); border-radius:var(--xy-radius-lg); background:var(--xy-color-gallery-counter); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }

/* 视觉规范 v1：图片通栏；图下第一块是带阴影的信息卡；设备列表是白底卡。 */
.store-detail-page { background:var(--xy-color-page); }
.entity-card { margin:var(--xy-space-3) var(--xy-layout-page-padding-x) 0; overflow:hidden; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.entity-card .store-service-copy { margin-top:0; }
.entity-block { margin:var(--xy-space-6) var(--xy-layout-page-padding-x) 0; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }

/* 第 3 批重排：门店标签与状态行、门店设备两列卡片 */
.store-title-row { display:flex; align-items:center; gap:var(--xy-space-2); min-width:0; }
.store-title-row .store-title { font-weight:var(--xy-text-weight-bold); }
.store-status-line { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.store-open { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.store-devices { margin:var(--xy-space-6) var(--xy-space-4) 0; padding-bottom:var(--xy-space-6); }
.store-devices-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--xy-space-3); }
.store-devices-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.store-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:var(--xy-space-3); }
.store-grid-card { display:flex; flex-direction:column; min-height:var(--xy-size-touch-min); overflow:hidden; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.store-grid-media { position:relative; width:100%; height:0; padding-bottom:100%; background:var(--xy-color-canvas-muted); }
.store-grid-image { position:absolute; inset:0; width:100%; height:100%; }
.store-grid-copy { display:flex; flex-direction:column; gap:var(--xy-space-1); padding:var(--xy-space-3); }
.store-grid-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-bold); }
.store-grid-price { display:flex; align-items:baseline; gap:calc(var(--xy-space-1) / 2); }
.store-grid-amount { color:var(--xy-color-brand); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-heavy); }
.store-grid-unit,.store-grid-deposit { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.store-identity + .store-status-line { margin-top:calc(-1 * var(--xy-space-3)); padding:0 var(--xy-space-4) var(--xy-space-2); }

/* 尺寸逐项对齐画布：信息卡头部 16/16/12，信息行 py12 + 16 图标 + 56 标签列 + 28 按钮，设备卡与首页瀑布流同款 */
.store-head { padding:var(--xy-space-4) var(--xy-space-4) var(--xy-space-3); border-bottom:1px solid var(--xy-color-border-weak); }
.store-head .store-identity { align-items:center; padding:0; }
.store-head .store-status-line,.store-identity + .store-status-line { margin-top:var(--xy-space-1); padding:0; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.store-distance { color:var(--xy-color-text-muted); }
.store-info { padding:0; }
.store-info-row { position:relative; display:flex; align-items:center; gap:var(--xy-space-2); min-height:var(--xy-size-touch-min); padding:var(--xy-space-3) var(--xy-space-4); box-sizing:border-box; border-bottom:0; }
.store-info-row + .store-info-row::before { position:absolute; top:0; right:0; left:40px; height:1px; background:var(--xy-color-border-weak); content:''; }
.store-info-icon { flex:none; width:16px; height:16px; }
.store-info-label { flex:none; width:56px; }
.store-info-value { flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.store-info-action { position:relative; z-index:0; flex:none; min-width:0; min-height:var(--xy-size-touch-min); margin:calc(var(--xy-space-3) * -1) 0; padding:0 var(--xy-space-3); color:var(--xy-color-text-strong); font-weight:var(--xy-text-weight-semibold); }
.store-info-action::before { position:absolute; z-index:var(--xy-z-behind); top:var(--xy-space-2); right:0; bottom:var(--xy-space-2); left:0; border-radius:var(--xy-radius-md); box-shadow:inset 0 0 0 1px var(--xy-color-border); content:''; }
.store-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:var(--xy-space-3); align-items:start; }
.store-grid-card { border-radius:var(--xy-radius-lg); }
.store-grid-copy { gap:0; padding:var(--xy-space-3) var(--xy-space-4); }
.store-grid-name { display:-webkit-box; overflow:hidden; white-space:normal; -webkit-box-orient:vertical; -webkit-line-clamp:2; font-weight:var(--xy-text-weight-semibold); }
.store-grid-meta { display:block; margin-top:var(--xy-space-1); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-grid-source { color:var(--xy-color-warning); font-weight:var(--xy-text-weight-semibold); }
.store-grid-foot { display:flex; align-items:baseline; justify-content:space-between; gap:var(--xy-space-2); margin-top:var(--xy-space-3); }
.store-grid-symbol { font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-bold); }
.store-grid-amount { color:var(--xy-color-text-strong); }
.store-grid-unit,.store-grid-deposit { color:var(--xy-color-text-muted); }
.store-grid-deposit { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.store-grid-deposit-value { color:var(--xy-color-text-secondary); }
