<page-meta root-font-size="system" />
<view class="subpage">
<page-header title="{{secondaryNavigationTitle || '账户安全'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <view wx:if="{{errorText}}" class="alert-row"><text class="form-error" role="alert">{{errorText}}</text><button class="retry-button xy-button-reset" bindtap="loadAuthenticators" aria-label="重试读取账户安全">重试</button></view>
  <text wx:if="{{loading}}" class="note" role="status">正在读取账户安全…</text>
  <text class="group-label">登录方式</text>
  <view class="security-list">
    <view class="security-row">
      <view class="security-icon"><image src="{{icons.loginPhone}}" mode="aspectFit" aria-hidden="true" /></view>
      <view class="security-copy"><text class="security-label">手机号</text><text class="security-value">{{phoneText}}</text></view>
      <button class="security-pill xy-button-reset" bindtap="demoPhoneAuthorize" disabled="{{!phoneActionEnabled || actionBusy}}" aria-disabled="{{!phoneActionEnabled || actionBusy}}" aria-label="{{phoneActionText}}"><text>{{phoneActionText === '换绑手机号' ? '换绑' : '绑定'}}</text></button>
    </view>
    <view class="security-row">
      <view class="security-icon"><image src="{{icons.loginWechat}}" mode="aspectFit" aria-hidden="true" /></view>
      <view class="security-copy"><text class="security-label">微信</text><text class="security-value">{{wechatText}}</text></view>
      <button class="security-pill xy-button-reset" disabled="{{!wechatActionEnabled || actionBusy}}" aria-disabled="{{!wechatActionEnabled || actionBusy}}" bindtap="bindWechat" aria-label="绑定微信"><text>绑定</text></button>
    </view>
  </view>
  <text class="note">手机号由微信授权获取，换绑只验证新号。</text>
  <view wx:if="{{unbindPhoneEnabled}}" class="danger-zone">
    <button class="unbind-button xy-button-reset" disabled="{{actionBusy}}" aria-disabled="{{actionBusy}}" bindtap="unbindPhone" aria-label="解绑手机号">解绑手机号</button>
    <text class="danger-note">解绑前请确保微信已绑定</text>
  </view>
</view>
