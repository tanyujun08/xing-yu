.subpage { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-4); background: var(--xy-color-page); color: var(--xy-color-text-primary); 
  padding-top: var(--xy-layout-card-stack-start-gap);
}
.section-head { display: flex; min-height: var(--xy-text-section-title-line-height); align-items: center; margin-bottom: var(--xy-layout-card-stack-start-gap); }
.section-head text { color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.security-list { overflow: hidden; border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.security-row { display: flex; width: 100%; min-height: calc(var(--xy-size-touch-min) + var(--xy-space-2)); box-sizing: border-box; align-items: center; padding: 0 var(--xy-inset-card); border: 0; border-bottom: 1rpx solid var(--xy-color-divider); border-radius: 0; background: var(--xy-color-surface); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-align: left; }
.security-row:last-child { border-bottom: 0; }
.security-label { min-width: 0; flex: 1; }
.security-value { min-width: 0; max-width: 68%; margin-left: var(--xy-gap-group); color: var(--xy-color-text-secondary); font-weight: var(--xy-text-weight-semibold); overflow-wrap: anywhere; text-align: right; }
.security-arrow { flex: 0 0 var(--xy-size-icon-base); width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-left: var(--xy-gap-related); }
.note { display: block; margin-top: var(--xy-space-2); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); overflow-wrap: anywhere; }
.retry-button { min-height: var(--xy-size-touch-min); }
