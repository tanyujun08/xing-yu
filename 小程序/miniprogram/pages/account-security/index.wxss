/* 视觉规范 v1：区块标题 16/700 带绿竖条 → 12 → 白卡列表（行高 52，内边距 16，分割线左缩进 16） */
.subpage { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.section-head { display: flex; min-height: var(--xy-text-section-title-line-height); align-items: center; margin: var(--xy-space-3) 0 var(--xy-layout-title-content-gap); }
.section-head text { display: flex; align-items: center; color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.section-head text::before { display: inline-block; width: var(--xy-space-1); height: var(--xy-space-4); margin-right: var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); content: ''; }
.security-list { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.security-row { position: relative; display: flex; width: 100%; min-height: 52px; box-sizing: border-box; align-items: center; padding: var(--xy-space-4); border: 0; border-radius: 0; background: var(--xy-color-surface); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-align: left; }
.security-row + .security-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.security-action:active { background: var(--xy-color-surface-subtle); }
.security-label { min-width: 0; flex: 1; }
.security-value { min-width: 0; max-width: 68%; margin-left: var(--xy-space-3); color: var(--xy-color-text-secondary); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; text-align: right; }
.security-arrow { flex: 0 0 var(--xy-size-icon-base); width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-left: var(--xy-space-2); opacity: .6; }

.note { display: block; margin-top: var(--xy-space-3); padding: 0 var(--xy-space-4); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; }
.retry-button { min-height: var(--xy-size-touch-min); color: var(--xy-color-brand); }
