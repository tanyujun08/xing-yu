.subpage { min-height: 100%; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-4); background: var(--xy-color-surface-subtle); 
  padding-top: var(--xy-layout-card-stack-start-gap);

  box-sizing: border-box;
}
.profile-list { overflow: hidden; border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.profile-row { box-sizing: border-box; display: grid; width: 100%; min-height: var(--xy-size-touch-min); grid-template-columns: 88px minmax(0, 1fr) var(--xy-size-icon-base); align-items: center; column-gap: var(--xy-space-2); padding: var(--xy-space-2) var(--xy-inset-card); border-bottom: 1rpx solid var(--xy-color-divider); text-align: left; }
.profile-row:last-child { border-bottom: 0; }
.nickname-row { grid-template-columns: 88px minmax(0, 1fr); }
.profile-row > text:first-child { font-size: var(--xy-text-body-size); }
.profile-row input { width: 100%; min-width: 0; text-align: right; font-size: var(--xy-text-body-size); }
.avatar-row { min-height: 72px; }
.edit-avatar { width: 48px; height: 48px; justify-self: end; border-radius: var(--xy-radius-circle); background: var(--xy-color-surface-subtle); }
.arrow { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.status { min-width: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); text-align: right; overflow-wrap: anywhere; }
.note { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }

.status--success { color: var(--xy-color-success); }
