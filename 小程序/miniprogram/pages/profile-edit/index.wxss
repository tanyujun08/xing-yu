/* 视觉规范 v1：灰底页面，白卡圆角 8、左右内边距 16，行高 52，卡内分割线左缩进 16 */
.subpage { min-height: 100%; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.profile-list { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.profile-row { position: relative; box-sizing: border-box; display: grid; width: 100%; min-height: 52px; grid-template-columns: 80px minmax(0, 1fr) var(--xy-size-icon-base); align-items: center; column-gap: var(--xy-space-2); padding: var(--xy-space-4); background: var(--xy-color-surface); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-align: left; }
.profile-row + .profile-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.profile-row:active { background: var(--xy-color-surface-subtle); }
.nickname-row { grid-template-columns: 80px minmax(0, 1fr); }
.profile-row > text:first-child { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.profile-row input { width: 100%; min-width: 0; height: var(--xy-text-body-line-height); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-align: right; }
.avatar-row { min-height: 80px; padding-top: var(--xy-space-4); padding-bottom: var(--xy-space-4); }
.edit-avatar { width: 48px; height: 48px; justify-self: end; border-radius: var(--xy-radius-circle); background: var(--xy-color-brand-light); }
.arrow { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); opacity: .6; }
.status { min-width: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-align: right; overflow-wrap: anywhere; }
.status--success { color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.subpage > .profile-row { margin-top: var(--xy-space-3); border-radius: var(--xy-radius-lg); grid-template-columns: minmax(0, 1fr); color: var(--xy-color-brand); text-align: center; }
.note { display: block; margin-top: var(--xy-space-3); padding: 0 var(--xy-space-4); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }

