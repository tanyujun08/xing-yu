/* 重设计 第 1 批：头像卡 → 昵称输入卡 → 身份信息卡；分组小标题 12 灰，卡片圆角 8、内边距 16 */
.subpage { min-height: 100%; box-sizing: border-box; display: flex; flex-direction: column; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.avatar-card { display: flex; align-items: center; gap: var(--xy-space-4); padding: var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.edit-avatar { flex: none; width: 64px; height: 64px; border-radius: var(--xy-radius-circle); background: var(--xy-color-brand-light); }
.avatar-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-1); }
.avatar-name { overflow: hidden; color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); text-overflow: ellipsis; white-space: nowrap; }
.avatar-hint { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.avatar-change { position: relative; isolation: isolate; display: flex; flex: none; min-height: var(--xy-size-touch-min); align-items: center; padding: 0 var(--xy-space-3); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.avatar-change::before { position: absolute; top: 50%; right: 0; left: 0; z-index: var(--xy-z-behind); height: calc(var(--xy-space-4) * 2); margin-top: calc(var(--xy-space-4) * -1); box-sizing: border-box; border: 1px solid var(--xy-color-divider); border-radius: var(--xy-radius-pill); content: ''; }
.avatar-actions { display: flex; flex-wrap: wrap; gap: var(--xy-space-2); margin-top: var(--xy-space-2); }
.avatar-action { display: flex; min-height: var(--xy-size-touch-min); align-items: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.avatar-action--quiet { color: var(--xy-color-text-secondary); font-weight: var(--xy-text-weight-regular); }
.group-label { display: block; margin: var(--xy-space-4) 0 var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.field-card { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.name-field { display: flex; min-height: 52px; box-sizing: border-box; align-items: center; gap: var(--xy-space-2); padding: 0 var(--xy-space-4); }
.name-field input { min-width: 0; flex: 1; height: var(--xy-text-body-line-height); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.name-placeholder { color: var(--xy-color-text-weak); }
.name-count { flex: none; color: var(--xy-color-text-weak); font-size: var(--xy-text-body-small-size); font-variant-numeric: tabular-nums; line-height: var(--xy-text-body-small-line-height); }
.identity-row { display: flex; width: 100%; min-height: 52px; box-sizing: border-box; align-items: center; gap: var(--xy-space-2); padding: 0 var(--xy-space-4); background: var(--xy-color-surface); text-align: left; }
.identity-row:active { background: var(--xy-color-surface-subtle); }
.identity-label { min-width: 0; flex: 1; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.status { flex: none; height: 20px; padding: 0 var(--xy-space-1-5); border-radius: var(--xy-radius-sm); background: var(--xy-color-warning-soft); color: var(--xy-color-warning); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-body-line-height); }
.status--success { background: var(--xy-color-brand-light); color: var(--xy-color-brand); }
.arrow { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); opacity: .6; }
.form-error { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.note { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.identity-hint { margin-left: auto; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
