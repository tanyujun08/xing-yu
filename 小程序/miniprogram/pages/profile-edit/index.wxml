<page-meta root-font-size="system" />
<page-shell surface="page" aria-busy="{{saving}}">
<page-header title="{{secondaryNavigationTitle || '个人资料'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" slot="header" />
  <view class="subpage">
    <view class="avatar-card">
      <image wx:if="{{!avatarReloading}}" class="edit-avatar" src="{{avatarPath || icons.profileAvatar}}" mode="aspectFill" data-src="{{avatarPath}}" data-owner="{{avatarOwner}}" data-epoch="{{avatarEpoch}}" binderror="onAvatarImageError" />
      <view wx:else class="edit-avatar" />
      <view class="avatar-copy"><text class="avatar-name">{{name || '未设置昵称'}}</text><text class="avatar-hint">{{selectingAvatar ? '正在选择头像…' : '点击右侧按钮更换头像'}}</text></view>
      <button class="avatar-change xy-button-reset" bindtap="chooseAvatar" disabled="{{selectingAvatar}}" aria-disabled="{{selectingAvatar}}" aria-busy="{{selectingAvatar}}" aria-label="选择头像"><text>{{selectingAvatar ? '选择中…' : '更换头像'}}</text></button>
    </view>
    <view wx:if="{{avatarFailed || (avatarPending && !selectingAvatar) || avatarPending}}" class="avatar-actions">
      <button wx:if="{{avatarFailed}}" class="avatar-action xy-button-reset" data-src="{{avatarPath}}" data-owner="{{avatarOwner}}" data-epoch="{{avatarEpoch}}" catchtap="retryAvatarImage" disabled="{{avatarReloading}}" aria-disabled="{{avatarReloading}}" aria-label="重试当前头像">头像加载失败，重试</button>
      <button wx:if="{{avatarPending && !selectingAvatar}}" class="avatar-action xy-button-reset" bindtap="recoverAvatar" aria-label="显式恢复原头像文件和原请求">恢复原头像请求</button>
      <button wx:if="{{avatarPending}}" class="avatar-action avatar-action--quiet xy-button-reset" bindtap="cancelAvatar" aria-label="取消本次头像处理">取消本次头像处理</button>
    </view>
    <text wx:if="{{avatarStatus}}" class="note" role="status">{{avatarStatus}}</text>
    <text class="group-label">昵称</text>
    <view class="field-card">
      <label class="name-field"><input value="{{name}}" maxlength="20" placeholder="请输入昵称" placeholder-class="name-placeholder" bindinput="inputName" aria-label="昵称" /><text class="name-count">{{name.length}}/20</text></label>
    </view>
    <text class="group-label">身份信息</text>
    <view class="field-card">
      <button class="identity-row xy-button-reset xy-button-fluid" bindtap="openIdentity" aria-label="进入实名认证"><text class="identity-label">实名认证</text><text class="status status--{{identityTone}}">{{identityText}}</text><image class="arrow" src="{{icons.arrowRight}}" mode="aspectFit" aria-hidden="true" /></button>
    </view>
    <text wx:if="{{errorText}}" class="form-error" role="alert">{{errorText}}</text>
    <text class="note">头像与昵称保存到本人账户；头像须通过服务端处理。</text>
  </view>
  <bottom-actions slot="footer" primary-text="保存资料" busy-text="保存中…" busy="{{saving}}" disabled="{{saving || avatarPending || selectingAvatar}}" bindprimary="save" />
</page-shell>
