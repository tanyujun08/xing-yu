.detail-deposit-row { margin-top:var(--xy-space-1); }
.detail-deposit-value { color:var(--xy-color-text-secondary); font-weight:var(--xy-text-weight-semibold); }
.detail-name { font-weight:var(--xy-text-weight-bold); }
.detail-benefit { margin-top:var(--xy-space-3); padding:var(--xy-space-2) var(--xy-space-3); border-top:0; border-radius:var(--xy-radius-control); background:var(--xy-color-control-surface); }
.section-title { margin-bottom:var(--xy-space-3); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.detail-group + .detail-group { margin-top:var(--xy-space-6); padding-top:0; border-top:0; }
