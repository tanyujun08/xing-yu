.media-reference { position:absolute; bottom:4px; right:4px; padding:calc(var(--xy-space-1) / 2) var(--xy-space-1); border-radius:var(--xy-radius-compact); background:var(--xy-color-surface); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.gallery.is-empty { padding-top:var(--xy-space-3); }
