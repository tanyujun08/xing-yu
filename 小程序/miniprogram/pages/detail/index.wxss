.detail-card,.pickup-card,.detail-section { margin:var(--xy-space-3) var(--xy-space-4) 0; padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.detail-name { display:block; overflow-wrap:anywhere; color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.detail-model,.detail-description,.detail-attributes { display:block; margin-top:var(--xy-space-1); overflow-wrap:anywhere; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
