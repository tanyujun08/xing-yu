.detail-price-value { overflow-wrap:anywhere; font-family:var(--xy-font-family-numeric); font-size:var(--xy-text-asset-summary-size); line-height:var(--xy-text-asset-summary-line-height); font-weight:var(--xy-text-weight-bold); }
.detail-price-unit { margin-left:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.detail-deposit-value { overflow-wrap:anywhere; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.detail-benefit { margin-top:var(--xy-space-3); padding-top:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.detail-benefit-link { display:flex; box-sizing:border-box; align-items:flex-start; position:relative; margin-top:var(--xy-space-1); padding-top:0; gap:var(--xy-space-1); min-height:0; color:var(--xy-color-info); }
.pickup-card { display:flex; align-items:center; min-height:44px; }
.pickup-copy { display:flex; flex:1; flex-direction:column; gap:var(--xy-space-1); min-width:0; }
