.detail-bottom.xy-bottom-action { position:sticky; bottom:0; z-index:var(--xy-z-fab); display:grid; grid-template-columns:minmax(0,1fr) 196px; gap:var(--xy-space-3); margin-top:auto; padding:var(--xy-space-3) var(--xy-space-4) calc(var(--xy-space-3) + env(safe-area-inset-bottom)); background:var(--xy-color-surface); border-top:1rpx solid var(--xy-color-divider); }
.bottom-price,.manage-bottom-copy { display:flex; flex-direction:column; gap:var(--xy-space-1); min-width:0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); overflow-wrap:anywhere; }
.bottom-rent { color:var(--xy-color-text-strong); font-size:var(--xy-price-value-size); line-height:var(--xy-price-value-line-height); font-weight:var(--xy-text-weight-semibold); }
.detail-action-group { display:flex; gap:var(--xy-space-3); align-items:center; min-width:0; }
.support-action { flex:0 0 64px; min-height:var(--xy-control-height); }
.buy-button { flex:1; min-width:0; min-height:var(--xy-control-height); }
.detail-action-group .xy-action-shell { width:100%; padding:var(--xy-space-2) var(--xy-space-3); box-sizing:border-box; }
.detail-page--stacked .info-line,.detail-page--stacked .detail-price-row,.detail-page--stacked .detail-deposit-row { grid-template-columns:minmax(0,1fr); row-gap:var(--xy-space-1); }
.detail-page--stacked .detail-bottom { grid-template-columns:minmax(0,1fr); }
.detail-page--stacked .detail-action-group { justify-content:flex-end; }
@media (max-width:360px) { .gallery-frame,.gallery-image,.gallery-swiper { height:192px; } }.gallery { position:relative; }
.gallery-count { position:absolute; right:28px; bottom:12px; padding:calc(var(--xy-space-3) / 4) calc(var(--xy-space-3) - var(--xy-space-3) / 4); border-radius:var(--xy-radius-lg); background:var(--xy-color-gallery-counter); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.detail-videos { margin:var(--xy-space-3) var(--xy-space-4) 0; padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
