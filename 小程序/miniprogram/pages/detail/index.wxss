/* 设备详情：整份按第十四轮画布重写（390 宽基准）。
 * 结构：通栏图 → 价格/名称/规则条 → 取还地点 → 设备资料 → 租赁须知 → 底栏。
 * 白色区块满宽、无圆角，块与块之间 12 灰缝；区块内边距 16，标题到内容 12。 */

.detail-page { display:flex; flex-direction:column; min-height:100vh; padding-bottom:var(--xy-space-3); box-sizing:border-box; background:var(--xy-color-page); color:var(--xy-color-text-strong); }

/* 图片：正方形通栏；左下视频、右下计数 */
.gallery { position:relative; background:var(--xy-color-canvas-muted); }
.gallery-frame,.gallery-image,.gallery-swiper { display:block; width:100%; height:100vw; overflow:hidden; background:var(--xy-color-canvas-muted); }
.gallery-frame { position:relative; }
.gallery.is-empty .gallery-image { height:calc(var(--xy-space-6) * 2 + var(--xy-text-caption-line-height)); }
.gallery-empty-copy { display:block; padding:var(--xy-space-1) var(--xy-space-3) var(--xy-space-3); text-align:center; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.gallery-count { position:absolute; right:var(--xy-space-4); bottom:var(--xy-space-3); height:20px; padding:0 var(--xy-space-2); border-radius:var(--xy-radius-pill); background:var(--xy-color-gallery-counter); color:var(--xy-color-text-inverse); display:flex; align-items:center; box-sizing:border-box; font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-semibold); }
.gallery-video { position:absolute; left:var(--xy-space-4); bottom:0; display:flex; align-items:center; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); margin:0; padding:0; border:0; background:transparent; }
.gallery-video::after { border:0; }
.gallery-video-pill { height:20px; padding:0 var(--xy-space-2); border-radius:var(--xy-radius-pill); background:var(--xy-color-gallery-counter); color:var(--xy-color-text-inverse); display:flex; align-items:center; box-sizing:border-box; font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-semibold); }

/* 视频播放区（点视频后出现；多个视频时列出其余按钮） */
.detail-videos { margin-top:var(--xy-space-3); padding:var(--xy-space-4); background:var(--xy-color-surface); }
.detail-videos__title { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.detail-videos__actions { display:flex; flex-wrap:wrap; gap:var(--xy-space-2); margin-top:var(--xy-space-3); }
.detail-videos__play { margin:0; min-height:var(--xy-size-touch-min); background:var(--xy-color-control-surface); color:var(--xy-color-text-strong); font-size:var(--xy-text-body-small-size); }
.detail-videos__player { display:block; width:100%; height:56vw; margin-top:var(--xy-space-3); background:var(--xy-color-media-canvas); }
.detail-videos__error { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }

/* 白色区块 */
.detail-card,.pickup-card,.detail-group { padding:var(--xy-space-4); background:var(--xy-color-surface); }
.pickup-card,.detail-group { margin-top:var(--xy-space-3); }
.detail-section { display:flex; flex-direction:column; }
.section-title { display:block; margin-bottom:var(--xy-space-3); color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }

/* 价格行：左 ¥80/天（28 粗绿），右 押金 */
.detail-card { display:flex; flex-direction:column; }
.detail-commerce { display:flex; align-items:flex-end; justify-content:space-between; gap:var(--xy-space-3); }
.detail-price-row { min-width:0; }
.detail-price-label { display:none; }
.detail-price { display:flex; align-items:baseline; gap:calc(var(--xy-space-1) / 2); color:var(--xy-color-brand); }
.detail-price-symbol { font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-bold); }
.detail-price-value { font-family:var(--xy-font-family-numeric); font-size:var(--xy-text-asset-summary-size); line-height:calc(var(--xy-space-6) + var(--xy-space-2)); font-weight:var(--xy-text-weight-heavy); }
.detail-price-unit { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.detail-deposit-row { display:flex; align-items:baseline; flex:none; gap:var(--xy-space-1); padding-bottom:var(--xy-space-1); }
.detail-deposit-label { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.detail-deposit-value { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.detail-name { display:block; margin-top:var(--xy-space-2); overflow-wrap:anywhere; color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-bold); }
.detail-model,.detail-description,.detail-attributes { display:block; margin-top:var(--xy-space-1); overflow-wrap:anywhere; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }

/* 规则条：灰底 6 圆角，左说明右链接 */
.detail-benefit { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-3); margin-top:var(--xy-space-3); padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-control-surface); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.detail-benefit-link { position:relative; display:flex; flex:none; align-items:center; color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }

/* 取还地点：40 图标块 + 名称/标签 + 地址 + 箭头 */
.pickup-row { display:flex; align-items:center; gap:var(--xy-space-3); min-height:var(--xy-size-touch-min); margin:calc(var(--xy-space-1) / -2) 0; }
.pickup-icon { display:flex; align-items:center; justify-content:center; flex:none; width:40px; height:40px; border-radius:var(--xy-radius-md); background:var(--xy-color-brand-light); }
.pickup-icon-image { width:20px; height:20px; }
.pickup-copy { display:flex; flex:1; flex-direction:column; min-width:0; }
.pickup-title-row { display:flex; align-items:center; gap:var(--xy-space-2); min-width:0; }
.pickup-title { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.pickup-title-row .xy-tag { flex:none; font-weight:var(--xy-text-weight-bold); }
.pickup-address { display:block; margin-top:calc(var(--xy-space-1) / 2); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.pickup-arrow { flex:none; width:16px; height:16px; }

/* 设备资料：标签列 64，行间 12 */
.info-line { display:flex; align-items:flex-start; gap:var(--xy-space-3); }
.info-line + .info-line { margin-top:var(--xy-space-3); }
.info-label { flex:none; width:64px; padding-top:calc(var(--xy-space-1) / 2); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.info-value { flex:1; min-width:0; overflow-wrap:anywhere; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.info-value-strong { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.info-value-muted { color:var(--xy-color-text-muted); }
.notice-copy { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-line-height); }
.notice-copy + .notice-copy { margin-top:var(--xy-space-2); }

/* 底栏：客服 44 | ¥80/天 + 押金 | 立即下单 160×44 */
.detail-bottom.xy-bottom-action { position:sticky; bottom:0; z-index:var(--xy-z-fab); display:flex; align-items:center; gap:var(--xy-space-3); margin-top:auto; padding:var(--xy-space-3) var(--xy-space-4) calc(var(--xy-space-3) + env(safe-area-inset-bottom)); border-top:1px solid var(--xy-color-border-weak); background:var(--xy-color-glass); }
.detail-bottom .support-action { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:calc(var(--xy-space-1) / 2); flex:none; width:var(--xy-size-touch-min) !important; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); margin:0; padding:0; border:0; background:transparent; color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.detail-bottom .support-action::after { border:0; }
.support-icon { width:20px; height:20px; }
.bottom-price,.manage-bottom-copy { display:flex; flex:1; flex-direction:column; min-width:0; }
.bottom-rent-row { display:flex; align-items:baseline; gap:calc(var(--xy-space-1) / 2); }
.bottom-rent-symbol { color:var(--xy-color-text-strong); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-bold); }
.bottom-rent { color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-heavy); }
.bottom-rent-unit { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.bottom-deposit,.manage-bottom-copy { color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.bottom-deposit-value { color:var(--xy-color-text-secondary); }
.detail-action-group { flex:none; width:160px; }
.buy-button { display:flex; width:100%; min-height:var(--xy-size-touch-min); }
.detail-action-group .xy-action-shell { display:flex; align-items:center; justify-content:center; width:100%; min-height:var(--xy-size-touch-min); padding:0 var(--xy-space-4); box-sizing:border-box; border-radius:var(--xy-radius-md); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }

/* 大字号 / 窄屏：价格与押金、资料行改上下排 */
.detail-page--stacked .detail-commerce { flex-wrap:wrap; }
.detail-page--stacked .info-line { flex-direction:column; gap:var(--xy-space-1); }
.detail-page--stacked .info-label { width:auto; }
.detail-page--stacked .detail-action-group { width:auto; }
