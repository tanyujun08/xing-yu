.detail-videos__error { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); }

.detail-benefit-link { position:relative; }
.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }

/* 视觉规范 v1：设备详情去卡片化 —— 图片通栏，信息块全部是满宽白底，块间 12 灰缝。 */
.gallery { padding:0; }
.gallery-frame,.gallery-image,.gallery-swiper { height:100vw; border-radius:0; background:var(--xy-color-canvas-muted); }
.gallery.is-empty .gallery-image { height:calc(48px + var(--xy-text-caption-line-height)); background:var(--xy-color-canvas-muted); }
.gallery-count { right:var(--xy-space-4); bottom:var(--xy-space-3); padding:0 var(--xy-space-2); border-radius:var(--xy-radius-lg); background:var(--xy-color-gallery-counter); }
.detail-card,.pickup-card,.detail-section,.detail-videos { margin:var(--xy-space-3) 0 0; padding:var(--xy-space-4); border-radius:0; }
.gallery + .detail-card { margin-top:0; }
.detail-card { display:flex; flex-direction:column; }
