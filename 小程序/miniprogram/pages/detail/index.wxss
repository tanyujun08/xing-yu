.detail-price-label,.detail-deposit-label { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.detail-price { display:flex; align-items:baseline; flex-wrap:wrap; min-width:0; }
