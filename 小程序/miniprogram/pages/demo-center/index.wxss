page{background:#f5f6fa;color:#172722}.demo{padding:32rpx 28rpx 70rpx;font-family:system-ui}.hero{padding:36rpx;background:#0a7f5e;border-radius:28rpx;color:white}.eyebrow{display:block;font-size:20rpx;letter-spacing:3rpx;opacity:.75}.title{display:block;font-size:42rpx;font-weight:650;margin:20rpx 0}.copy{display:block;font-size:25rpx;line-height:1.8;opacity:.8}.primary{margin-top:28rpx;background:white;color:#0a7f5e;font-size:28rpx;border-radius:16rpx}.counts{display:flex;justify-content:space-around;margin:24rpx 0;background:white;border-radius:22rpx;padding:28rpx 0}.counts view{text-align:center;font-size:22rpx;color:#68766f}.value{display:block;font-size:34rpx;font-weight:700;color:#0a7f5e;margin-bottom:8rpx}.panel{background:white;border-radius:22rpx;padding:28rpx;margin-top:24rpx}.heading{display:block;font-size:30rpx;font-weight:650;margin-bottom:20rpx}.chips{display:flex;flex-wrap:wrap;gap:12rpx}.chips button{font-size:23rpx;line-height:2.3;margin:0;border-radius:12rpx;padding:0 20rpx;background:#f1f4f2;color:#68766f}.chips .active{background:#e0f2ea;color:#0a7f5e}.reset{font-size:25rpx;background:#f5f6fa;color:#5b655f;margin-top:24rpx}.entry{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #edf0ee;font-size:28rpx}.note{display:block;font-size:22rpx;color:#8b958f;margin-top:7rpx}.arrow{color:#0a7f5e;font-size:40rpx}.log{display:block;font-size:20rpx;line-height:1.8;word-break:break-all;color:#68766f}button::after{border:0}
