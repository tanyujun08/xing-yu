.do-filters { width: 100%; white-space: nowrap; }
.do-tabs { display: inline-flex; gap: var(--xy-space-2); }
.do-tab { display: flex; flex: none; align-items: center; min-height: var(--xy-size-touch-min); }
.do-tab > text { display: flex; align-items: center; height: calc(var(--xy-space-6) + var(--xy-space-2)); padding: 0 var(--xy-space-3); border-radius: var(--xy-radius-pill); background: var(--xy-color-surface); color: var(--xy-color-text-primary); font-size: var(--xy-row-caption-size); }
.do-tab.is-active > text { background: var(--xy-color-text-primary); color: var(--xy-color-text-inverse); font-weight: var(--xy-text-weight-semibold); }
.do-list { display: flex; flex-direction: column; gap: var(--xy-space-3); margin-top: var(--xy-space-2); }
.do-item { display: flex; align-items: center; gap: var(--xy-space-3); padding: var(--xy-space-3) 0; }
.do-item__main { flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--xy-space-3); min-height: var(--xy-size-touch-min); }
.do-thumb { display: block; flex: none; width: calc(var(--xy-space-4) * 4); height: calc(var(--xy-space-4) * 4); overflow: hidden; border-radius: var(--xy-radius-media); }
.do-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--xy-space-1); }
.do-name { display: block; color: var(--xy-color-text-primary); font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); font-weight: var(--xy-text-weight-semibold); overflow-wrap: anywhere; }
.do-state { display: block; color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); font-weight: var(--xy-text-weight-semibold); }
.do-state--warning { color: var(--xy-color-key-warning); }
.do-state--success { color: var(--xy-color-brand); }
.do-state--muted { font-weight: var(--xy-text-weight-regular); }
.do-act { flex: none; display: flex; align-items: center; justify-content: flex-end; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); padding: 0; margin: 0; background: transparent; }
.do-act::after { border: 0; }
.do-pill { display: flex; align-items: center; height: calc(var(--xy-space-6) + var(--xy-space-2)); padding: 0 var(--xy-space-3); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); color: var(--xy-color-text-inverse); font-size: var(--xy-row-caption-size); font-weight: var(--xy-text-weight-semibold); }
.do-more { color: var(--xy-color-text-muted); font-size: var(--xy-text-section-title-size); }
.do-group + .do-group { border-top: 1rpx solid var(--xy-color-hairline); }
.do-group__title { font-weight: var(--xy-text-weight-semibold); }
.do-record { display: flex; flex-direction: column; gap: var(--xy-space-1); padding-top: var(--xy-space-3); border-top: 1rpx solid var(--xy-color-hairline); }
.do-record__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--xy-space-2); }
.do-record__link { min-height: var(--xy-size-touch-min); }
