<page-meta root-font-size="system" />
<page-shell surface="page" fixed-header>
<page-header slot="header" title="{{title}}" bindback="goBack" />
<view class="equipment-page">
  <view wx:if="{{missing || !loggedIn}}" class="empty">
    <text class="section-title">{{missing ? '请从我的设备重新进入' : '登录后查看设备'}}</text>
    <text wx:if="{{!missing}}" class="summary">设备订单以当前登录账号的服务端记录为准</text>
    <view class="plain-button" wx:if="{{!missing}}"><text>去登录</text><button class="touch-overlay" hover-class="none" bindtap="openLogin" aria-label="去登录"></button></view>
  </view>
  <block wx:else>
    <scroll-view class="filter-scroll" scroll-x="true" show-scrollbar="false">
      <view class="tabs"><view wx:for="{{filters}}" wx:key="id" class="tab {{filter === item.id ? 'active' : ''}}" data-filter="{{item.id}}" bindtap="chooseFilter" role="tab" aria-selected="{{filter === item.id}}">{{item.label}}</view></view>
    </scroll-view>

    <status-view wx:if="{{listState.phase === 'initial-loading'}}" state="loading" title="正在加载设备订单" description="请稍候" />
    <status-view wx:elif="{{listState.phase === 'initial-error'}}" state="error" title="设备订单加载失败" description="{{listState.error.message}}" action-text="重试" bindaction="retryInitial" illustration-src="{{icons.emptyGeneric}}" />
    <status-view wx:elif="{{listState.phase === 'empty'}}" state="empty" title="暂无相关设备订单" description="{{mode === 'lend' ? '设备产生出租订单后，会显示在这里' : '浏览设备，开启你的租赁体验'}}" illustration-src="{{icons.emptyOrders}}" />

    <view wx:else class="group">
      <view class="group-heading"><text class="section-title">{{mode === 'lend' ? '出租订单记录' : '租赁订单记录'}}</text><text class="muted">已加载 {{items.length}} 项</text></view>
      <view wx:for="{{items}}" wx:key="id" class="rental-card">
        <view class="rental-main" data-id="{{item.id}}" bindtap="openRental" role="button" aria-label="查看{{item.deviceName}}订单信息">
          <media-state class="thumb" state="{{item.mediaState}}" src="{{item.image}}" empty-label="暂无图片" mode="aspectFill" />
          <view class="copy"><text class="name">{{item.deviceName}}</text><text class="summary">{{item.rentalText}} · {{item.pickupText}}</text><text class="summary">订单编号 {{item.orderNo}}</text></view>
          <text class="status {{item.statusTone === 'primary' ? 'occupied' : ''}}">{{item.mainStatusText}}</text>
        </view>
        <view class="rental-action"><text class="muted">{{item.createdText}} · {{item.amountText}}</text><view class="action-buttons"><view class="plain-button"><text>订单详情</text><button class="touch-overlay" hover-class="none" data-id="{{item.id}}" bindtap="openOrder" aria-label="查看订单详情"></button></view></view></view>
      </view>
    </view>

    <status-view wx:if="{{listState.phase === 'ready' && listState.incremental === 'refreshing'}}" state="loading" density="compact-footer" title="正在刷新设备订单" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'refresh-error'}}" state="error" density="compact-footer" title="刷新失败" action-text="重试刷新" bindaction="retryRefresh" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'loading-more'}}" state="loading" density="compact-footer" title="正在加载更多" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'load-more-error'}}" state="error" density="compact-footer" title="加载更多失败" action-text="重试" bindaction="retryLoadMore" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'done'}}" state="end" density="compact-footer" title="设备订单已全部加载" />
  </block>
</view>
</page-shell>

<task-sheet class="xy-task-sheet" open="{{sheetOpen}}" title="{{sheetTitle}}" show-footer="{{false}}" bindclose="closeSheet">
  <view wx:for="{{recordGroups}}" wx:for-item="group" wx:key="title" class="record-group">
    <view class="record-group-heading" data-title="{{group.title}}" bindtap="toggleRecordGroup" role="button" aria-expanded="{{expandedGroup === group.title}}"><text class="section-title">{{group.title}}</text><text class="muted">{{expandedGroup === group.title ? '⌃' : '⌄'}}</text></view>
    <block wx:if="{{expandedGroup === group.title}}">
      <view wx:for="{{group.items}}" wx:key="id" class="compact-record">
        <view class="name-row"><text class="name">{{item.mainStatusText}}</text><text class="muted">{{item.amountText}}</text></view>
        <text class="summary">{{item.rentalText}}</text>
        <text class="summary">{{item.pickupText}}</text>
        <text class="summary">订单编号 {{item.orderNo}} · {{item.createdText}}</text>
        <view class="record-actions"><view class="action-buttons"><view class="plain-button"><text>查看订单详情</text><button class="touch-overlay" hover-class="none" data-id="{{item.id}}" bindtap="openOrder" aria-label="查看订单详情"></button></view></view></view>
      </view>
    </block>
  </view>
</task-sheet>
