<page-meta root-font-size="system" />
<page-shell surface="page" fixed-header has-footer="{{!missing && !loggedIn}}">
<page-header slot="header" title="{{title}}" bindback="goBack" />
<view class="xy-h-page do-page">
  <view wx:if="{{missing || !loggedIn}}" class="do-empty">
    <status-hero tone="neutral" art="shield" title="{{missing ? '请从我的设备重新进入' : '登录后查看设备订单'}}" description="{{missing ? '设备信息已失效，请返回我的设备重新选择。' : '设备订单以当前登录账号的服务端记录为准。'}}" />
  </view>
  <block wx:else>
    <scroll-view class="do-filters" scroll-x="true" show-scrollbar="false">
      <view class="do-tabs" role="tablist"><view wx:for="{{filters}}" wx:key="id" class="do-tab {{filter === item.id ? 'is-active' : ''}}" data-filter="{{item.id}}" bindtap="chooseFilter" role="tab" aria-selected="{{filter === item.id}}"><text>{{item.label}}</text></view></view>
    </scroll-view>

    <status-view wx:if="{{listState.phase === 'initial-loading'}}" state="loading" title="正在加载设备订单" description="请稍候" />
    <status-view wx:elif="{{listState.phase === 'initial-error'}}" state="error" title="设备订单加载失败" description="{{listState.error.message}}" action-text="重试" bindaction="retryInitial" illustration-src="{{icons.emptyGeneric}}" />
    <status-view wx:elif="{{listState.phase === 'empty'}}" state="empty" title="暂无相关设备订单" description="{{mode === 'lend' ? '设备产生出租订单后，会显示在这里' : '浏览设备，开启你的租赁体验'}}" illustration-src="{{icons.emptyOrders}}" />

    <view wx:else class="do-list">
      <view wx:for="{{items}}" wx:key="id" class="xy-h-blk do-item">
        <view class="do-item__main" data-id="{{item.id}}" bindtap="openRental" role="button" aria-label="查看{{item.deviceName}}订单信息">
          <media-state class="do-thumb" state="{{item.mediaState}}" src="{{item.image}}" empty-label="暂无图片" mode="aspectFill" />
          <view class="do-copy">
            <text class="do-name">{{item.deviceName}}</text>
            <text class="xy-h-row__sub">{{item.rentalText}} · {{item.pickupText}}</text>
            <text class="do-state do-state--{{item.statusTone}}">{{item.mainStatusText}}<text wx:if="{{item.amountLabel === '待补缴金额' || item.actionLabel === '去支付'}}"> {{item.amountText}}</text></text>
          </view>
        </view>
        <button wx:if="{{item.actionPrimary}}" class="do-act xy-action-hit" data-id="{{item.id}}" bindtap="openOrder" aria-label="{{item.actionLabel}}"><text class="do-pill">{{item.actionLabel}}</text></button>
        <button wx:else class="do-act xy-action-hit" data-id="{{item.id}}" bindtap="openOrder" aria-label="查看订单详情"><text class="do-more" aria-hidden="true">›</text></button>
      </view>
    </view>

    <status-view wx:if="{{listState.phase === 'ready' && listState.incremental === 'refreshing'}}" state="loading" density="compact-footer" title="正在刷新设备订单" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'refresh-error'}}" state="error" density="compact-footer" title="刷新失败" action-text="重试刷新" bindaction="retryRefresh" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'loading-more'}}" state="loading" density="compact-footer" title="正在加载更多" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'load-more-error'}}" state="error" density="compact-footer" title="加载更多失败" action-text="重试" bindaction="retryLoadMore" />
    <status-view wx:elif="{{listState.phase === 'ready' && listState.incremental === 'done'}}" state="end" density="compact-footer" title="设备订单已全部加载" />
  </block>
</view>
<view wx:if="{{!missing && !loggedIn}}" slot="footer" class="xy-h-foot"><view class="xy-h-actions"><view class="xy-h-actions__main"><button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="openLogin">去登录</button></view></view></view>
</page-shell>

<task-sheet class="xy-task-sheet" open="{{sheetOpen}}" title="{{sheetTitle}}" show-footer="{{false}}" bindclose="closeSheet">
  <view wx:for="{{recordGroups}}" wx:for-item="group" wx:key="title" class="do-group">
    <button class="xy-h-link" data-title="{{group.title}}" bindtap="toggleRecordGroup" aria-expanded="{{expandedGroup === group.title}}"><text class="xy-h-link__k do-group__title">{{group.title}}</text><text class="xy-h-link__act">{{expandedGroup === group.title ? '收起' : '展开'}}</text></button>
    <block wx:if="{{expandedGroup === group.title}}">
      <view wx:for="{{group.items}}" wx:key="id" class="do-record">
        <view class="do-record__head"><text class="do-name">{{item.mainStatusText}}</text><text class="xy-h-row__sub">{{item.amountText}}</text></view>
        <text class="xy-h-row__sub">{{item.rentalText}} · {{item.pickupText}}</text>
        <text class="xy-h-row__sub">订单编号 {{item.orderNo}} · {{item.createdText}}</text>
        <button class="xy-h-link do-record__link" data-id="{{item.id}}" bindtap="openOrder"><text class="xy-h-link__k">查看订单详情</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
      </view>
    </block>
  </view>
</task-sheet>
<login-sheet id="login-sheet" bindwechatlogin="onWechatLogin" bindphonelogin="onPhoneLogin" bindlegal="onLoginLegal" />
