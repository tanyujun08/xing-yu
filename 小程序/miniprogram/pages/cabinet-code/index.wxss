@import "../../shared/design/components.wxss";
@import "../../shared/design/cabinet-flow.wxss";
.code-page { min-height: 100%; padding: var(--xy-space-4) var(--xy-layout-page-padding-x) var(--xy-space-6); box-sizing: border-box; color: var(--xy-color-text-primary); }
.intro-block { padding: 0 0 var(--xy-layout-card-stack-start-gap); }
.page-title { display: block; font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-page-title-line-height); }
.body-copy { display: block; margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.empty-card { margin-top: 0; }
.inline-action { width: 100%; min-height: var(--xy-control-height); margin-top: var(--xy-space-4); }
.code-page .credential-card { margin-top: var(--xy-space-3); }
.credential-card .section-title { margin-bottom: var(--xy-space-3); }
.pickup-guidance { margin-top:var(--xy-space-3); }
.progress-card .xy-action-hit { margin-top:var(--xy-space-2); }

/* 视觉规范 v1：取件码输入卡是页面重点，加柔和阴影；卡片内边距 16。 */
.intro-block { display: none; }
.code-page { padding-top: var(--xy-space-3); }
.code-page .surface-card { padding: var(--xy-space-4); }
.code-page .credential-card { box-shadow: var(--xy-shadow-key); }
.code-page .body-copy { font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); color: var(--xy-color-text-muted); }

/* 第 3 批重排：柜机卡、分组标题、取件步骤、入口列表 */
.cabinet-card .card-head { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); }
.cabinet-title-row { display:flex; align-items:center; gap:var(--xy-space-2); min-width:0; }
.cabinet-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.state-label { display:flex; align-items:center; flex:none; gap:var(--xy-space-1); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-semibold); }
.state-label.is-success { color:var(--xy-color-brand); }
.state-label.is-warning { color:var(--xy-color-warning); }
.state-dot { width:var(--xy-space-2); height:var(--xy-space-2); border-radius:50%; background:currentColor; }
.cabinet-hint { display:block; margin-top:var(--xy-space-3); padding-top:var(--xy-space-3); border-top:1rpx solid var(--xy-color-border); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.group-title { display:block; margin:var(--xy-space-6) 0 var(--xy-space-3); color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.code-page .credential-card { margin-top:0; }
.steps-card { display:flex; flex-direction:column; gap:var(--xy-space-4); }
.step-row { display:flex; align-items:flex-start; gap:var(--xy-space-3); }
.step-index { display:flex; align-items:center; justify-content:center; flex:none; width:var(--xy-space-5); height:var(--xy-space-5); border-radius:50%; background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-bold); }
.step-copy { display:flex; flex-direction:column; min-width:0; }
.step-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.step-desc { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.code-page .link-card { margin-top:var(--xy-space-3); padding:0 var(--xy-space-4); }
.link-row { display:flex; align-items:center; gap:var(--xy-space-3); min-height:var(--xy-size-touch-min); padding:var(--xy-space-1) 0; }
.link-row + .link-row { border-top:1rpx solid var(--xy-color-border); }
.link-icon { flex:none; width:var(--xy-space-5); height:var(--xy-space-5); }
.link-label { flex:1; min-width:0; color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.link-arrow { flex:none; width:12px; height:12px; }
