/* 提现 第 3 稿：分段切换 → 主视觉卡（浅绿底 + 钱包插画，可提现余额 24）→ 金额表单 + 到账账户 → 说明；记录页：当前提现进度卡 + 历史列表 */
.withdrawal-page { display: flex; flex-direction: column; gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); color: var(--xy-color-text-primary); }
.withdrawal-tabs { display: flex; padding: var(--xy-space-1); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); }
.withdrawal-tab { display: flex; flex: 1; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; border-radius: var(--xy-radius-sm); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.withdrawal-tab.is-active { background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.withdrawal-summary { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-brand-light); }
.hero-main { display: flex; align-items: center; gap: var(--xy-space-2); padding: var(--xy-space-5) var(--xy-space-4) var(--xy-space-4); }
.hero-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-1); }
.summary-label-row { display: flex; align-items: center; }
.summary-label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.summary-help-button { display: flex; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; margin: calc(var(--xy-space-3) * -1) 0; }
.summary-help { width: var(--xy-size-icon-sm); height: var(--xy-size-icon-sm); opacity: .7; }
.summary-amount, .record-amount { display: flex; align-items: baseline; gap: var(--xy-space-0-5); color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-task-amount-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-task-amount-line-height); overflow-wrap: anywhere; }
.amount-symbol { font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.summary-hint { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.withdrawal-hero-art { flex: none; width: calc(var(--xy-space-6) * 5); height: calc(var(--xy-space-6) * 3 + var(--xy-space-4)); margin: calc(var(--xy-space-2) * -1) calc(var(--xy-space-2) * -1) calc(var(--xy-space-2) * -1) 0; }
.processing-summary { display: flex; align-items: center; gap: var(--xy-space-2); margin: 0 var(--xy-space-2) var(--xy-space-2); padding: var(--xy-space-3); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); }
.processing-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-0-5); }
.processing-line { display: flex; align-items: center; gap: var(--xy-space-2); }
.processing-amount { display: flex; color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-body-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-body-line-height); }
.processing-hint { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.record-link { display: flex; flex: none; min-height: var(--xy-size-touch-min); align-items: center; gap: var(--xy-space-0-5); color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.record-link image { width: var(--xy-size-icon-sm); height: var(--xy-size-icon-sm); }
.pending-block { display: flex; flex-direction: column; gap: var(--xy-space-1); padding: var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.pending-head { display: flex; align-items: center; justify-content: space-between; }
.pending-title { color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.pending-state { color: var(--xy-color-warning); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.pending-amount { color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-section-title-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.pending-copy { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.pending-action { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; margin-top: var(--xy-space-2); border-radius: var(--xy-radius-md); box-shadow: inset 0 0 0 1px var(--xy-color-border); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.form-card { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.form-title { display: block; padding: var(--xy-space-4) var(--xy-space-4) 0; color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.amount-field { display: flex; min-height: var(--xy-control-height); align-items: center; gap: var(--xy-space-2); margin: var(--xy-space-3) var(--xy-space-4) 0; padding-bottom: var(--xy-space-2); border-bottom: 1px solid var(--xy-color-divider); }
.amount-field.is-focused { border-bottom-color: var(--xy-color-brand); }
.amount-field.is-error { border-bottom-color: var(--xy-color-danger); }
.field-symbol { color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.amount-input { min-width: 0; flex: 1; min-height: var(--xy-size-touch-min); color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-task-amount-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-task-amount-line-height); }
.amount-placeholder { color: var(--xy-color-text-muted); font-weight: var(--xy-text-weight-regular); }
.all-button { display: flex; flex: none; min-height: var(--xy-size-touch-min); align-items: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.amount-field.is-disabled .all-button { color: var(--xy-color-text-muted); }
.field-error, .field-guidance { display: block; padding: var(--xy-space-2) var(--xy-space-4) var(--xy-space-3); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.field-error { color: var(--xy-color-danger); }
.field-guidance { color: var(--xy-color-text-muted); }
.account-row { display: flex; min-height: calc(var(--xy-space-6) * 2 + var(--xy-space-1)); align-items: center; gap: var(--xy-space-3); padding: 0 var(--xy-space-4); }
.account-row--joined { position: relative; }
.account-row--joined::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.account-icon { flex: none; width: var(--xy-size-icon-nav); height: var(--xy-size-icon-nav); }
.account-title { min-width: 0; flex: 1; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.account-name { flex: none; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.section-title { display: flex; align-items: center; margin-top: var(--xy-space-1); color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.section-title::before { display: inline-block; width: var(--xy-space-1); height: var(--xy-space-4); margin-right: var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); content: ''; }
.explanation-list, .history-list { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.explanation-row { position: relative; display: flex; min-height: calc(var(--xy-space-6) * 2 + var(--xy-space-1)); align-items: center; gap: var(--xy-space-3); padding: 0 var(--xy-space-4); }
.explanation-row + .explanation-row::before, .history-row + .history-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.info-icon { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.explanation-row-title { min-width: 0; flex: 1; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.explanation-row-detail { flex: none; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.current-card { display: flex; flex-direction: column; gap: var(--xy-space-2); padding: var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-card); }
.current-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--xy-space-2); }
.current-copy { display: flex; min-width: 0; flex-direction: column; gap: var(--xy-space-0-5); }
.record-kicker { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.record-meta { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); font-variant-numeric: tabular-nums; line-height: var(--xy-text-caption-line-height); }
.record-progress { display: flex; align-items: center; gap: var(--xy-space-2); margin-top: var(--xy-space-2); padding: var(--xy-space-3); border-radius: var(--xy-radius-md); background: var(--xy-color-surface-subtle); }
.progress-step { display: flex; flex: none; flex-direction: column; align-items: center; gap: var(--xy-space-1); }
.progress-dot { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.progress-label { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.progress-step.is-done .progress-label { color: var(--xy-color-text-secondary); }
.progress-step.is-current .progress-label { color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.record-progress.is-unknown .progress-step.is-current .progress-label { color: var(--xy-color-warning); }
.progress-line { flex: 1; height: 2px; margin-bottom: var(--xy-space-5); border-radius: var(--xy-radius-pill); background: var(--xy-color-divider); }
.progress-line.is-done { background: var(--xy-color-brand); }
.progress-estimate { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.record-action { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: flex-end; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.record-action--block { justify-content: center; border-radius: var(--xy-radius-md); box-shadow: inset 0 0 0 1px var(--xy-color-brand); }
.history-row { position: relative; display: flex; align-items: flex-start; gap: var(--xy-space-3); padding: var(--xy-space-4); }
.history-status { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-top: var(--xy-space-0-5); }
.history-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-0-5); }
.history-title { overflow: hidden; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-overflow: ellipsis; white-space: nowrap; }
.failure-copy { color: var(--xy-color-danger); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.history-side { display: flex; flex: none; flex-direction: column; align-items: flex-end; gap: var(--xy-space-0-5); }
.history-amount { display: flex; color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-body-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-body-line-height); }
.history-state { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.history-state--completed { color: var(--xy-color-brand); }
.history-state--failed { color: var(--xy-color-danger); }
.history-side .record-action { margin: calc(var(--xy-space-2) * -1) 0; }
