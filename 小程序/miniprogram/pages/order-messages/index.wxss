.order-messages-page { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-space-4) calc(var(--xy-space-5) + env(safe-area-inset-bottom)); background: var(--xy-color-page); color: var(--xy-color-text-primary);
  padding-top: var(--xy-layout-card-stack-start-gap);
}
.message-list { display: flex; flex-direction: column; gap: var(--xy-space-3); }
.order-message { position: relative; min-height: var(--xy-size-touch-min); padding: var(--xy-inset-card); border: 0; border-radius: var(--xy-radius-md); background: var(--xy-color-surface); box-sizing: border-box; }
.order-message-body { min-width: 0; }
.message-head, .message-context, .message-footer { display: flex; min-width: 0; align-items: center; justify-content: space-between; }

.message-type { display: flex; min-width: 0; flex: 1; align-items: center; color: var(--xy-color-text-primary); font-size: var(--xy-text-item-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); overflow-wrap: anywhere; }
.message-context { align-items: flex-start; flex-wrap: wrap; gap: var(--xy-space-1); margin-top: var(--xy-space-2); }
.device-name { display: -webkit-box; min-width: 0; overflow: hidden; flex: 1; padding-right: var(--xy-gap-related); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.status-text { max-width: 100%; box-sizing: border-box; flex: none; overflow-wrap: anywhere; padding: var(--xy-space-0-5) var(--xy-space-1-5); border-radius: var(--xy-radius-pill); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.message-content { display: block; margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); overflow-wrap: anywhere; }
.message-footer { margin-top: var(--xy-space-3); padding-top: 0; border-top: 0; flex-wrap: wrap; gap: var(--xy-space-2); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.message-order-id { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.message-arrow { display: flex; align-items: center; flex: none; margin-left: var(--xy-space-2); color: var(--xy-color-info); }
.message-arrow image { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-left: var(--xy-space-1); }
.state-card { display: flex; align-items: center; flex-direction: column; margin-top: 0; padding: var(--xy-space-6) var(--xy-space-4); border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); box-shadow: none; text-align: center; }
.state-symbol { display: flex; align-items: center; justify-content: center; width: var(--xy-size-icon-lg); height: var(--xy-size-icon-lg); background: transparent; }
.state-symbol image { width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); }
.state-title { margin-top: var(--xy-space-2-5); color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.state-button { display: flex; min-height: var(--xy-control-height); align-items: center; justify-content: center; margin-top: var(--xy-gap-content-action); padding: 0 var(--xy-button-padding-x); border-radius: var(--xy-radius-md); background: var(--xy-color-action-primary); color: var(--xy-color-text-inverse); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold);  line-height: var(--xy-text-body-line-height);}
.empty-card.xy-empty-page { padding: var(--xy-space-4) var(--xy-inset-card); }

.message-head { flex-direction: column; align-items: flex-start; gap: var(--xy-space-1); }
.message-time { margin-left: 0; white-space: normal; font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; }
