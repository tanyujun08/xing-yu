/* 订单通知：灰底，每条一行（图标 + 标题/时间 + 正文 + 设备/状态），行间只用细线。 */
.order-messages-page { min-height:100vh; box-sizing:border-box; padding:var(--xy-space-3) 0 calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background:var(--xy-color-page); }
.message-list { padding-left:var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); border-bottom:1rpx solid var(--xy-color-divider); }
.order-message { position:relative; display:flex; align-items:flex-start; gap:var(--xy-space-3); min-height:var(--xy-size-touch-min); padding:var(--xy-space-3) var(--xy-space-4) var(--xy-space-3) 0; box-sizing:border-box; }
.order-message + .order-message::before { content:""; position:absolute; top:0; right:0; left:calc(var(--xy-size-icon-feature) + var(--xy-space-3)); height:1rpx; background:var(--xy-color-divider); }
.message-icon { display:flex; flex:none; width:var(--xy-size-icon-feature); height:var(--xy-size-icon-feature); align-items:center; justify-content:center; border-radius:var(--xy-radius-container); background:var(--xy-color-brand-soft); }
.message-icon image { width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); }
.order-message-body { display:flex; min-width:0; flex:1; flex-direction:column; gap:var(--xy-space-1); }
.message-head { display:flex; align-items:baseline; gap:var(--xy-space-2); }
.message-title { min-width:0; flex:1; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.message-time { flex:none; color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-variant-numeric:tabular-nums; }
.message-content { color:var(--xy-color-text-value); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.message-context { display:flex; gap:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.status-text { color:var(--xy-color-brand); }
.state-card { margin:0 var(--xy-space-4); display:flex; flex-direction:column; align-items:center; padding:var(--xy-space-6) var(--xy-space-4); border:0; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:none; text-align:center; }
.state-symbol { display:flex; align-items:center; justify-content:center; width:56px; height:56px; border-radius:50%; background:var(--xy-color-brand-soft); }
.state-symbol image { width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); }
.state-title { margin-top:var(--xy-space-3); color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.state-button { display:flex; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin-top:var(--xy-space-4); padding:0 var(--xy-space-6); border-radius:var(--xy-radius-md); background:var(--xy-color-action-primary); color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.empty-card.xy-empty-page { min-height:360px; padding:var(--xy-space-6) var(--xy-space-4); }
.empty-card .xy-empty-page__illustration { width:200px; height:150px; margin-bottom:var(--xy-space-3); }
