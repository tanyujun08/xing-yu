/* 发布设备（设计稿 v5）：橙色提示条 → 设备卡 → 实拍图 → 出租条件 → 设备信息；编辑一律点行开底部弹层。通用样式见 shared/design/publish-flow.wxss */
.publish-page { gap: var(--xy-space-3); }
.publish-preflight { display: flex; flex-direction: column; gap: var(--xy-space-3); }
.pb-after { margin-top: calc(var(--xy-space-1) * -1); }
.pf-fnote.is-error, .pf-empty.is-error { color: var(--xy-color-key-warning); }
.pb-v { font-weight: var(--xy-text-weight-medium); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pb-v.is-muted { font-weight: var(--xy-text-weight-regular); }
/* 提示条 */
.pb-tip { display: flex; align-items: center; gap: var(--xy-space-2); padding: var(--xy-space-2-5) var(--xy-space-3); border-radius: var(--xy-radius-md); background: var(--xy-color-key-warning-soft); color: var(--xy-color-key-warning); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.pb-tip.is-info { background: var(--xy-color-well); color: var(--xy-color-text-secondary); }
.pb-tip__ic { flex: none; width: var(--xy-size-icon-sm); height: var(--xy-size-icon-sm); }
.pb-tip__t { flex: 1; min-width: 0; }
.pb-tip__go { display: flex; flex: none; align-items: center; min-height: var(--xy-size-touch-min); margin: calc(var(--xy-space-2-5) * -1) 0; font-weight: var(--xy-text-weight-semibold); }
/* 设备卡 */
.pb-pd { display: flex; align-items: center; min-height: var(--xy-size-touch-min); gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-space-3) var(--xy-space-3) var(--xy-space-4); }
.pb-pd__pic { display: flex; flex: none; width: var(--xy-pf-pic); height: var(--xy-pf-pic); align-items: center; justify-content: center; overflow: hidden; border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.pb-pd__img { width: 88%; height: 88%; }
.pb-pd__ph { width: var(--xy-size-icon-lg); height: var(--xy-size-icon-lg); opacity: .6; }
.pb-pd__b { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.pb-pd__t { overflow: hidden; font-weight: var(--xy-text-weight-semibold); text-overflow: ellipsis; white-space: nowrap; }
.pb-pd__t.is-muted { color: var(--xy-color-text-muted); font-weight: var(--xy-text-weight-regular); }
.pb-pd__s { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
/* 实拍图 */
.pb-media { padding-bottom: var(--xy-space-3); }
.pb-media > .pf-fnote { padding: 0 var(--xy-space-4); }
.pb-media .xy-draft-media-grid { margin-top: 0; padding: 0 var(--xy-space-4); }
.pb-links { display: flex; flex-wrap: wrap; gap: var(--xy-space-4); padding: 0 var(--xy-space-4); }
.pb-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-0-5); background: var(--xy-color-well); box-shadow: inset 0 0 0 1rpx var(--xy-color-border); }
.pb-add__ic { width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); }
.pb-add__t { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.pb-vfail { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.hero-card { position: relative; display: block; overflow: hidden; border-radius: var(--xy-radius-md); }
.hero-image { width: 100%; height: 100%; background: var(--xy-color-well); }
.media-badge { position: absolute; top: var(--xy-space-1); left: var(--xy-space-1); padding: 0 var(--xy-space-1); border-radius: var(--xy-radius-sm); background: var(--xy-color-scrim); color: var(--xy-color-text-inverse); font-size: var(--xy-text-micro-size); line-height: var(--xy-text-micro-line-height); }
.xy-media-remove { min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); }
.rule-option { position: absolute; right: var(--xy-space-1); bottom: var(--xy-space-1); padding: 0 var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-scrim); color: var(--xy-color-text-inverse); font-size: var(--xy-text-caption-size); }
.pb-retry, .pb-chip { min-height: var(--xy-size-touch-min); }
.pb-chip { display: flex; align-items: center; }
.is-disabled { opacity: .5; }
.publish-preflight-create { min-height: var(--xy-size-touch-min); }
/* 弹层：白底，输入框 48 高浅灰底，字段间 20 */
.sheet-mask { position: fixed; inset: 0; z-index: var(--xy-z-modal); display: flex; align-items: flex-end; background: var(--xy-color-scrim); }
.publish-sheet { display: flex; box-sizing: border-box; width: 100%; max-height: 88vh; flex-direction: column; border-radius: var(--xy-pf-radius) var(--xy-pf-radius) 0 0; background: var(--xy-color-surface); }
.pb-sheet-head { display: flex; flex: none; align-items: center; justify-content: space-between; padding: var(--xy-space-2) var(--xy-space-2) var(--xy-space-1) var(--xy-space-4); }
.pb-sheet-title { font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); }
.pb-close { display: flex; width: var(--xy-size-touch-min); height: var(--xy-size-touch-min); align-items: center; justify-content: center; color: var(--xy-color-text-secondary); font-size: var(--xy-pf-title); }
.sheet-scroll { box-sizing: border-box; flex: 1; min-height: 0; max-height: 64vh; padding: 0 var(--xy-space-4); }
.sheet-actions { flex: none; }
.pb-stack { display: flex; flex-direction: column; gap: calc(var(--xy-space-5)); padding-bottom: var(--xy-space-4); }
.pb-stack--12 { gap: var(--xy-space-3); }
.pb-field { display: flex; min-width: 0; flex-direction: column; gap: var(--xy-space-2); }
.pb-two { display: flex; gap: var(--xy-space-3); }
.pb-two > .pb-field { flex: 1; }
.pb-label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.pb-label--gap { margin-top: var(--xy-space-2); margin-bottom: calc(var(--xy-space-1) * -1); }
.pb-opt-t { margin-left: var(--xy-space-1); color: var(--xy-color-text-muted); }
.pb-box { display: flex; box-sizing: border-box; height: var(--xy-pf-field); align-items: center; gap: var(--xy-space-1-5); padding: 0 var(--xy-space-4); border-radius: var(--xy-radius-md); background: var(--xy-color-well); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-medium); font-variant-numeric: tabular-nums; }
.pb-box input { flex: 1; min-width: 0; height: var(--xy-pf-field); }
.pb-pre { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-regular); }
.pb-unit { flex: none; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-regular); }
.pb-ph { color: var(--xy-color-text-disabled); font-weight: var(--xy-text-weight-regular); }
.pb-box--tap { min-height: var(--xy-size-touch-min); font-size: var(--xy-text-body-size); }
.pb-idtype { flex: none; padding-right: var(--xy-space-2); box-shadow: inset -1rpx 0 0 var(--xy-color-border); }
.pb-idtype__t { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-regular); }
.pb-area { box-sizing: border-box; width: 100%; height: calc(var(--xy-pf-field) * 2); padding: var(--xy-space-3) var(--xy-space-4); border-radius: var(--xy-radius-md); background: var(--xy-color-well); font-size: var(--xy-row-text-size); }
/* 整行选项组：1px 描边圆角组，行内分割线 */
.pb-group { overflow: hidden; border-radius: var(--xy-pf-radius); box-shadow: inset 0 0 0 1px var(--xy-color-border); }
.pb-opt2 { min-height: calc(var(--xy-pf-row) + 4px); }
.pb-opt { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.pb-opt__t { font-weight: var(--xy-text-weight-medium); }
.pb-opt__t--b { font-weight: var(--xy-text-weight-semibold); }
.pb-opt__s { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.pb-rd { flex: none; width: var(--xy-size-icon-md); height: var(--xy-size-icon-md); box-sizing: border-box; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--xy-color-border-strong); }
.pb-rd.is-on { box-shadow: inset 0 0 0 8px var(--xy-color-brand); }
/* 交付方式卡 */
.pb-dm { display: flex; align-items: center; gap: var(--xy-space-3); min-height: var(--xy-size-touch-min); padding: var(--xy-space-3) var(--xy-space-4); border-radius: var(--xy-pf-radius); box-shadow: inset 0 0 0 1px var(--xy-color-border); }
.pb-dm.is-on { box-shadow: inset 0 0 0 1.5px var(--xy-color-brand); }
.pb-dm:active { opacity: var(--xy-opacity-pressed); }
.pb-dm__ic { display: flex; flex: none; width: var(--xy-size-icon-entry-block); height: var(--xy-size-icon-entry-block); align-items: center; justify-content: center; border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.pb-dm.is-on .pb-dm__ic { background: var(--xy-color-brand-soft); }
.pb-dm__ic image { width: var(--xy-size-icon-md); height: var(--xy-size-icon-md); }
.pb-ck { display: flex; flex: none; width: var(--xy-size-icon-md); height: var(--xy-size-icon-md); align-items: center; justify-content: center; box-sizing: border-box; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--xy-color-border-strong); }
.pb-ck.is-on { box-shadow: none; }
.pb-ck__ic { width: var(--xy-size-icon-md); height: var(--xy-size-icon-md); }
/* 商品资料图（弹层内） */
.product-media { display: flex; flex-wrap: wrap; gap: var(--xy-space-2); }
.product-media-item { width: var(--xy-pf-pic-lg); height: var(--xy-pf-pic-lg); overflow: hidden; border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.product-media-video { width: 100%; height: 100%; }
