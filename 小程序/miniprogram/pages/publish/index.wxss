/* 发布设备（第 5 批）：通用样式见 shared/design/publish-flow.wxss */
.pb-note { display: flex; gap: var(--xy-space-2); padding: var(--xy-space-3) var(--xy-space-4); border-radius: var(--xy-pf-radius); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-raised); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-line-height); }
.pb-note__k { flex: none; color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.pb-note.is-error { background: var(--xy-color-key-warning-soft); color: var(--xy-color-key-warning); box-shadow: none; }
.pf-fnote.is-error, .pf-empty.is-error { color: var(--xy-color-key-warning); }
.pb-input { flex: 1; min-width: 0; height: var(--xy-pf-row); text-align: right; font-size: var(--xy-row-text-size); }
.pb-media { padding: var(--xy-space-4); }
.pb-media .xy-draft-media-grid { margin-bottom: var(--xy-space-3); }
.pb-media .pf-fnote { margin-top: var(--xy-space-2); }
.pb-media .pf-link { margin-top: var(--xy-space-1); }
.product-media { display: flex; flex-wrap: wrap; gap: var(--xy-space-3); }
.product-media-item { width: var(--xy-pf-pic-lg); height: var(--xy-pf-pic-lg); overflow: hidden; border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.hero-card { position: relative; display: block; overflow: hidden; border-radius: var(--xy-radius-md); }
.hero-image { width: 100%; height: 100%; background: var(--xy-color-well); }
.media-badge { position: absolute; top: var(--xy-space-1); left: var(--xy-space-1); padding: 0 var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-scrim); color: var(--xy-color-text-inverse); font-size: var(--xy-text-caption-size); }
.xy-draft-media-grid .xy-draft-media-add { min-height: var(--xy-size-touch-min); }
.xy-media-remove { min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); }
.rule-option { position: absolute; right: var(--xy-space-1); bottom: var(--xy-space-1); padding: 0 var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-scrim); color: var(--xy-color-text-inverse); font-size: var(--xy-text-caption-size); }
/* 弹层 */
.sheet-mask { position: fixed; inset: 0; z-index: var(--xy-z-modal); display: flex; align-items: flex-end; background: var(--xy-color-scrim); }
.publish-sheet { display: flex; box-sizing: border-box; width: 100%; max-height: 88vh; flex-direction: column; border-radius: var(--xy-pf-radius) var(--xy-pf-radius) 0 0; background: var(--xy-color-page); }
.pb-sheet-head { display: flex; flex: none; align-items: center; justify-content: space-between; padding: var(--xy-space-2) var(--xy-space-2) 0 var(--xy-space-4); }
.pb-close { display: flex; width: var(--xy-size-touch-min); height: var(--xy-size-touch-min); align-items: center; justify-content: center; color: var(--xy-color-text-secondary); font-size: var(--xy-pf-title); }
.sheet-scroll { box-sizing: border-box; flex: 1; min-height: 0; max-height: 60vh; padding: 0 var(--xy-space-4); }
.sheet-scroll > view, .sheet-scroll > text { margin-bottom: var(--xy-space-3); }
.sheet-actions, .calendar-sheet-actions { flex: none; }
.pb-field { display: flex; flex-direction: column; gap: var(--xy-space-2); margin-bottom: var(--xy-space-4); }
.pb-label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); }
.pb-box { display: flex; box-sizing: border-box; height: var(--xy-pf-field); align-items: center; gap: var(--xy-space-1); padding: 0 var(--xy-space-4); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); font-size: var(--xy-row-text-size); }
.pb-box input { flex: 1; height: var(--xy-pf-field); }
.pb-box .is-muted { color: var(--xy-color-text-muted); }
.pb-box--tap { min-height: var(--xy-size-touch-min); }
.pb-area { box-sizing: border-box; width: 100%; min-height: calc(var(--xy-pf-field) * 2); padding: var(--xy-space-3) var(--xy-space-4); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); font-size: var(--xy-row-text-size); }
.pb-sub { display: block; padding: var(--xy-space-3) var(--xy-space-4) var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); }
.pb-opt { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.pb-pick.is-selected .pb-opt > text:first-child { color: var(--xy-color-brand); }
.pb-dotbox { display: flex; flex: none; width: var(--xy-size-icon-base); justify-content: center; }
.pb-check { display: flex; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); align-items: center; justify-content: center; border-radius: var(--xy-radius-sm); box-shadow: inset 0 0 0 2rpx var(--xy-color-border-strong); }
.pb-check.is-on { background: var(--xy-color-brand); box-shadow: none; }
.pb-check__ic { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.pb-radio { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); box-sizing: border-box; border-radius: 50%; box-shadow: inset 0 0 0 2rpx var(--xy-color-border-strong); }
.pb-radio.is-on { border: 6px solid var(--xy-color-brand); box-shadow: none; }
.is-disabled { opacity: .5; }
/* 日历弹层 */
.publish-sheet-calendar { height: calc(100vh - 150px); }
.publish-sheet-calendar .calendar-weekdays, .publish-sheet-calendar .calendar-sheet-summary { flex: none; }
.calendar-weekdays {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 36px;
  padding: 0 var(--xy-space-3);
}

.calendar-weekday {
  display: flex;
  flex: 0 0 14.2857%;
  align-items: center;
  justify-content: center;
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.calendar-weekday.is-weekend {
  color: var(--xy-color-brand);
}

.calendar-month-scroll {
  min-height: 0;
  height: auto;
  max-height: none;
  flex: 1;
  box-sizing: border-box;
  padding: 0;
}

.calendar-month {
  box-sizing: border-box;
  padding: 0 var(--xy-space-3) var(--xy-space-2);
}

.calendar-month-title {
  display: block;
  margin: var(--xy-space-3) 0 var(--xy-space-2);
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-section-title-size);
  font-weight: var(--xy-text-weight-medium);
  line-height: var(--xy-text-section-title-line-height);
  text-align: center;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}

.calendar-day {
  position: relative;
  display: flex;
  flex: 0 0 14.2857%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: var(--xy-control-height-large);
  color: var(--xy-color-text-primary);
}

.calendar-day {
  min-height: var(--xy-size-touch-min);
}

.calendar-day-inner {
  display: flex;
  width: var(--xy-size-icon-feature);
  height: var(--xy-size-icon-feature);
  flex: none;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: var(--xy-radius-circle);
  color: inherit;
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.calendar-day.is-placeholder {
  pointer-events: none;
}

.calendar-day.is-disabled {
  color: var(--xy-color-border);
}

.calendar-day.is-in-range,
.calendar-day.is-start,
.calendar-day.is-end {
  background: var(--xy-color-brand-light);
}

.calendar-day.is-start {
  border-radius: var(--xy-radius-pill) 0 0 var(--xy-radius-pill);
}

.calendar-day.is-end {
  border-radius: 0 var(--xy-radius-pill) var(--xy-radius-pill) 0;
}

.calendar-day.is-start.is-end {
  border-radius: var(--xy-radius-pill);
}

.calendar-day.is-today .calendar-day-inner {
  border-color: var(--xy-color-brand);
  color: var(--xy-color-brand);
}

.calendar-day.is-start .calendar-day-inner,
.calendar-day.is-end .calendar-day-inner {
  border-color: var(--xy-color-brand);
  background: var(--xy-color-brand);
  color: var(--xy-color-text-inverse);
}

.calendar-day-caption {
  display: block;
  position: static;
  flex: none;
  margin-top: var(--xy-space-1);
  color: var(--xy-color-brand);
  font-size: var(--xy-text-micro-size);
  line-height: var(--xy-text-calendar-caption-line-height);
  text-align: center;
}

.calendar-sheet-summary {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  column-gap: var(--xy-space-2);
  align-items: center;
  box-sizing: border-box;
  min-height: 72px;
  padding: var(--xy-space-3) var(--xy-space-4) 0;
  border-top: 1rpx solid var(--xy-color-divider);
}

.calendar-summary-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
}

.calendar-summary-item-end {
  align-items: flex-end;
  text-align: right;
}

.calendar-summary-label {
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}

.calendar-summary-value {
  margin-top: var(--xy-space-1);
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-body-size);
  font-weight: var(--xy-text-weight-regular);
  line-height: var(--xy-text-body-line-height);
}

.calendar-summary-value.is-selected {
  color: var(--xy-color-text-primary);
}

.calendar-summary-days {
  display: flex;
  min-width: 56px;
  align-items: baseline;
  justify-content: center;
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.calendar-summary-days-value {
  margin: 0 var(--xy-space-1);
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-body-size);
  line-height: var(--xy-text-body-line-height);
}

.pb-retry, .pb-chip { min-height: var(--xy-size-touch-min); }
.pb-chip { display: flex; align-items: center; }
.publish-preflight-create { min-height: var(--xy-size-touch-min); }
