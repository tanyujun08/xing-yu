.login-overlay { position: relative; display: flex; min-height: 100vh; align-items: flex-end; box-sizing: border-box; background: var(--xy-color-scrim); }
.login-backdrop { position: absolute; inset: 0; }
.login-sheet { position: relative; z-index: var(--xy-z-sticky); width: 100%; min-height: 52vh; max-height: 92vh; overflow-y: auto; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) calc(var(--xy-space-5) + env(safe-area-inset-bottom)); border-radius: var(--xy-radius-lg) var(--xy-radius-lg) 0 0; background: var(--xy-color-surface); color: var(--xy-color-text-primary); box-shadow: var(--xy-shadow-float); }
.login-sheet__handle { width: 42px; height: 4px; margin: 0 auto var(--xy-space-5); border-radius: var(--xy-radius-pill); background: var(--xy-color-border-strong); }
.brand-block { display: flex; align-items: center; flex-direction: column; text-align: center; }
.login-logo { display: block; width: 64px; height: 64px; border-radius: var(--xy-radius-container); }
.login-heading { margin-top: var(--xy-space-3); color: var(--xy-color-text-strong); font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-page-title-line-height); }
.login-copy { margin-top: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.login-error { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-danger); font-size: var(--xy-text-body-size); text-align: center; }
.login-actions { display: flex; flex-direction: column; gap: var(--xy-space-3); margin-top: var(--xy-space-6); }
.quick-button, .phone-button, .guest-button { display: flex; width: 100%; min-height: var(--xy-control-height-large); align-items: center; justify-content: center; gap: var(--xy-space-2); box-sizing: border-box; padding: var(--xy-space-3) var(--xy-button-padding-x); border-radius: var(--xy-radius-md); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); text-align: center; }
.quick-button { background: var(--xy-color-action-primary); color: var(--xy-color-text-inverse); }
.quick-button image, .phone-button image { display: block; width: var(--xy-size-icon-nav); height: var(--xy-size-icon-nav); }
.phone-button { border: 1rpx solid var(--xy-color-border); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-disabled); }
.phone-button[disabled] { border-color: var(--xy-color-border) !important; background: var(--xy-color-surface-subtle) !important; color: var(--xy-color-text-disabled) !important; opacity: 1 !important; }
.phone-hint { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); text-align: center; }
.guest-button { min-height: var(--xy-size-touch-min); color: var(--xy-color-brand); }
.agreement-row { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; gap: var(--xy-space-2); margin-top: var(--xy-space-5); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); text-align: center; }
.agreement-text { min-width: 0; flex: 0 1 auto; overflow-wrap: anywhere; }
.link { display: inline-flex; min-height: var(--xy-size-touch-min); align-items: center; color: var(--xy-color-info); }
.agreement-link-label { position: relative; display: inline-block; color: var(--xy-color-brand); font-weight: var(--xy-text-weight-medium); }
.agreement-link-hit { position: absolute; top: 50%; left: 0; right: 0; height: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); min-width: var(--xy-size-touch-min); transform: translateY(-50%); padding: 0; margin: 0; border: 0; border-radius: 0; background: transparent; }
.agreement-link-hit::after { border: 0; }
.agree-box { display: flex; flex: none; width: 16px; height: 16px; align-items: center; justify-content: center; border: 1rpx solid var(--xy-color-border-strong); border-radius: var(--xy-radius-compact); background: var(--xy-color-surface); }
.agree-box.is-checked { border-color: var(--xy-color-brand); background: var(--xy-color-brand); }
.agree-box image { width: 16px; height: 16px; }
.consent-mask { position: fixed; z-index: var(--xy-z-modal); inset: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: var(--xy-space-6); background: var(--xy-color-scrim); }
.consent-modal { width: 100%; max-width: 596px; box-sizing: border-box; padding: var(--xy-space-5); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-float); }
.consent-title { display: block; color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); text-align: center; }
.consent-copy { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.consent-actions { display: flex; gap: var(--xy-space-3); margin-top: var(--xy-space-5); }
.consent-cancel, .consent-confirm { display: flex; min-width: 0; min-height: var(--xy-size-touch-min); flex: 1; align-items: center; justify-content: center; box-sizing: border-box; padding: var(--xy-space-2); border-radius: var(--xy-radius-md); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); overflow-wrap: anywhere; text-align: center; }
.consent-cancel { border: 1rpx solid var(--xy-color-border); background: var(--xy-color-surface); color: var(--xy-color-text-primary); }
.consent-confirm { background: var(--xy-color-action-primary); color: var(--xy-color-text-inverse); }
.consent-confirm:active { background: var(--xy-color-action-pressed); }

@media (max-height: 700px) {
  .login-body { padding-top: var(--xy-space-6); }
  .login-form { margin-top: var(--xy-space-6); }
  .login-actions { margin-top: var(--xy-space-5); }
  .agreement-row { position: static; margin-top: var(--xy-space-6); }
}
