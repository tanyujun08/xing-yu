<view class="support"><page-header title="离线演示客服" bindback="back" /><view class="notice">消息只保存在本机 · 不发送给真实客服</view><view class="messages"><view wx:for="{{messages}}" wx:key="id" class="row {{item.mine?'mine':''}}"><view class="avatar">{{item.mine?'我':'星'}}</view><view class="bubble">{{item.text}}</view></view></view><view class="composer"><input value="{{content}}" bindinput="input" placeholder="输入演示咨询内容" maxlength="500" confirm-type="send" bindconfirm="send" /><button bindtap="send">发送</button></view></view>
