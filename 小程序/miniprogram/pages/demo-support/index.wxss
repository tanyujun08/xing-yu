page{background:#f5f6fa;color:#172722}.notice{text-align:center;color:#7d8b83;font-size:23rpx;padding:24rpx}.messages{padding:20rpx 28rpx 160rpx}.row{display:flex;gap:16rpx;margin:28rpx 0}.avatar{width:60rpx;height:60rpx;line-height:60rpx;border-radius:18rpx;background:#e0eee7;color:#0a7f5e;text-align:center;flex-shrink:0}.bubble{max-width:520rpx;background:#fff;border-radius:20rpx;padding:24rpx;font-size:28rpx;line-height:1.7}.mine{flex-direction:row-reverse}.mine .bubble{background:#0a7f5e;color:#fff}.composer{position:fixed;bottom:0;left:0;right:0;display:flex;gap:18rpx;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e5e9e6;align-items:center}.composer input{flex:1;background:#f3f5f4;padding:20rpx;border-radius:14rpx;font-size:28rpx}.composer button{background:#0a7f5e;color:#fff;font-size:26rpx;line-height:2.5;margin:0;border-radius:14rpx}button::after{border:0}
