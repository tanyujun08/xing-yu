/* 离线演示客服：与订单沟通页同一套气泡与输入栏。 */
.sp-content { padding:0 0 var(--xy-space-4); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.sp-notice { display:flex; justify-content:center; padding:var(--xy-space-3) var(--xy-space-4) 0; }
.sp-notice text { padding:var(--xy-space-1) var(--xy-space-3); border-radius:var(--xy-radius-pill); background:var(--xy-color-well); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.sp-list { padding:0 var(--xy-space-4); }
.sp-row { display:flex; align-items:flex-end; gap:var(--xy-space-2); margin-top:var(--xy-space-3); }
.sp-row.is-mine { justify-content:flex-end; }
.sp-avatar { display:flex; flex:none; width:calc(var(--xy-size-icon-nav) + var(--xy-space-2)); height:calc(var(--xy-size-icon-nav) + var(--xy-space-2)); align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); font-weight:var(--xy-text-weight-semibold); }
.sp-bubble { min-width:0; max-width:calc(100% - var(--xy-size-icon-nav) * 3); padding:var(--xy-space-2) var(--xy-space-3); box-sizing:border-box; border-radius:var(--xy-radius-sheet); border-bottom-left-radius:var(--xy-radius-sm); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-raised); }
.sp-row.is-mine .sp-bubble { border-bottom-left-radius:var(--xy-radius-sheet); border-bottom-right-radius:var(--xy-radius-sm); background:var(--xy-color-brand); box-shadow:none; }
.sp-text { display:block; color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); white-space:pre-wrap; overflow-wrap:anywhere; }
.sp-row.is-mine .sp-text { color:var(--xy-color-text-inverse); }
.sp-bar { display:flex; align-items:center; gap:var(--xy-space-2); min-height:var(--xy-chat-composer-height); padding:var(--xy-space-2) var(--xy-space-4); box-sizing:border-box; border-top:1rpx solid var(--xy-color-divider); background:var(--xy-color-surface); }
.sp-input { flex:1; min-width:0; height:var(--xy-size-touch-min); padding:0 var(--xy-space-3); box-sizing:border-box; border-radius:var(--xy-radius-pill); background:var(--xy-color-well); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); }
.sp-ph { color:var(--xy-color-text-muted); }
.sp-send { display:flex; flex:none; align-items:center; justify-content:center; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); margin:0; padding:0; background:transparent; }
.sp-send::after { border:0; }
.sp-send-label { padding:var(--xy-space-1) var(--xy-space-4); border-radius:var(--xy-radius-pill); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.sp-send:active .sp-send-label { background:var(--xy-color-brand-pressed); }
