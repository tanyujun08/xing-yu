.ls-card { display: flex; flex-direction: column; gap: var(--xy-space-3); padding: var(--xy-space-4); }
.ls-top { display: flex; gap: var(--xy-space-3); }
.ls-pic { flex: none; width: var(--xy-pf-pic-lg); height: var(--xy-pf-pic-lg); overflow: hidden; border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.ls-pic--s { width: var(--xy-pf-pic); height: var(--xy-pf-pic); }
.ls-info { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: var(--xy-space-1); }
.ls-name { display: flex; align-items: center; gap: var(--xy-space-2); }
.ls-name__t { min-width: 0; overflow: hidden; font-size: var(--xy-row-text-size); font-weight: var(--xy-text-weight-semibold); text-overflow: ellipsis; white-space: nowrap; }
.ls-price { font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
.ls-dep { margin-left: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-regular); }
.ls-act { display: flex; justify-content: flex-end; gap: var(--xy-space-3); }
.ls-row { min-height: calc(var(--xy-pf-row) + var(--xy-space-3)); padding-top: var(--xy-space-2); padding-bottom: var(--xy-space-2); }
.ls-state { flex: none; font-size: var(--xy-text-body-small-size); }
.ls-state--g { color: var(--xy-color-brand); }
.ls-state--b { color: var(--xy-color-info); }
.ls-state--o { color: var(--xy-color-key-warning); }
.ls-state--n { color: var(--xy-color-text-muted); }
.ls-mask { position: fixed; inset: 0; z-index: var(--xy-z-overlay); display: flex; align-items: flex-end; background: var(--xy-color-scrim); }
.ls-sheet { box-sizing: border-box; width: 100%; max-height: 80vh; padding: var(--xy-space-4); border-radius: var(--xy-pf-radius) var(--xy-pf-radius) 0 0; background: var(--xy-color-page); }
.ls-sheet__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--xy-space-3); }
.ls-sheet__card { margin-bottom: var(--xy-space-3); }
.ls-reason { display: flex; flex-direction: column; gap: var(--xy-space-1); margin-bottom: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-space-4); border-radius: var(--xy-pf-radius); background: var(--xy-color-key-warning-soft); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-line-height); }
.ls-reason__k { color: var(--xy-color-key-warning); font-weight: var(--xy-text-weight-semibold); }
.listing-detail-photos { display: flex; gap: var(--xy-space-2); margin-bottom: var(--xy-space-3); overflow-x: auto; }
.listing-detail-photo { flex: none; width: var(--xy-pf-pic-lg); height: var(--xy-pf-pic-lg); border-radius: var(--xy-radius-md); overflow: hidden; }
