/* 我发布的设备（设计稿 v5）：待处理 = 一台一张卡（72 图 + 名称/标签 + 价格 + 原因 + 右下 28 高按钮）；已提交 = 紧凑行 */
.ls-list { display: flex; flex-direction: column; gap: var(--xy-space-2); }
.ls-card { display: flex; gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-space-4) var(--xy-space-3) var(--xy-space-3); border-radius: var(--xy-pf-radius); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-raised); }
.ls-pic { flex: none; width: var(--xy-pf-pic-lg); height: var(--xy-pf-pic-lg); overflow: hidden; border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.ls-pic--s { width: calc(var(--xy-space-6) * 2); height: calc(var(--xy-space-6) * 2); }
.ls-info { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.ls-name { display: flex; align-items: center; gap: var(--xy-space-2); }
.ls-name__t { flex: 1; min-width: 0; overflow: hidden; font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); text-overflow: ellipsis; white-space: nowrap; }
.ls-name__t--r { flex: none; font-weight: var(--xy-text-weight-regular); }
.ls-price { margin-top: var(--xy-space-0-5); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); font-variant-numeric: tabular-nums; }
.ls-small { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-regular); }
.ls-reason-line { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.ls-reason-line.is-warn { color: var(--xy-color-key-warning); }
.ls-act { display: flex; justify-content: flex-end; gap: var(--xy-space-3); margin-top: var(--xy-space-1); }
.ls-btn { min-width: calc(var(--xy-space-6) * 3); }
.ls-btn::after { height: calc(var(--xy-pf-btn) - 4px); }
.ls-sub { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-variant-numeric: tabular-nums; }
.ls-row { min-height: calc(var(--xy-pf-row) + var(--xy-space-3)); padding-top: var(--xy-space-2); padding-bottom: var(--xy-space-2); }
.ls-state { flex: none; font-size: var(--xy-text-body-small-size); }
.ls-state--g { color: var(--xy-color-brand); }
.ls-state--b { color: var(--xy-color-info); }
.ls-state--o { color: var(--xy-color-key-warning); }
.ls-state--n { color: var(--xy-color-text-muted); }
.ls-mask { position: fixed; inset: 0; z-index: var(--xy-z-overlay); display: flex; align-items: flex-end; background: var(--xy-color-scrim); }
.ls-sheet { box-sizing: border-box; width: 100%; max-height: 80vh; padding: var(--xy-space-4); border-radius: var(--xy-pf-radius) var(--xy-pf-radius) 0 0; background: var(--xy-color-page); }
.ls-sheet__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--xy-space-3); }
.ls-sheet__card { margin-bottom: var(--xy-space-3); }
.ls-reason { display: flex; flex-direction: column; gap: var(--xy-space-1); margin-bottom: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-space-4); border-radius: var(--xy-pf-radius); background: var(--xy-color-key-warning-soft); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-line-height); }
.ls-reason__k { color: var(--xy-color-key-warning); font-weight: var(--xy-text-weight-semibold); }
.listing-detail-photos { display: flex; gap: var(--xy-space-2); margin-bottom: var(--xy-space-3); overflow-x: auto; }
.listing-detail-photos .listing-detail-photo { width: 180rpx; height: 180rpx; flex: 0 0 180rpx; border-radius: var(--xy-radius-media); overflow: hidden; }
