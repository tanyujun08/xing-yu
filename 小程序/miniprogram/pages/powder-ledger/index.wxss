@import "../../shared/design/member-tokens.wxss";

.powder-ledger-page { min-height: 100vh; padding-bottom: calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background: var(--xy-member-color-page-soft); color: var(--xy-color-text-primary); }
.ledger-main { padding: var(--xy-layout-card-stack-start-gap) var(--xy-layout-page-padding-x) 0; }
.asset-hero { position: relative; }
.asset-copy { position: relative; z-index: var(--xy-z-local-raised); min-width: 0; }
.asset-label { position: relative; display: inline-flex; align-items: center; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.asset-label__info { margin-left: var(--xy-space-1); color: var(--xy-color-text-muted); }
.asset-label__hit { position: absolute; top: 50%; left: 0; width: 100% !important; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); transform: translateY(-50%); }
.asset-balance { display: flex; max-width: 56%; flex-wrap: wrap; align-items: baseline; gap: var(--xy-space-2); margin-top: var(--xy-space-4); }
.asset-balance__value { color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-operations-hero-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-operations-hero-line-height); }
.asset-balance__unit { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); }
.asset-desc { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.purpose-list { display: flex; flex-wrap: wrap; gap: var(--xy-space-3); margin-top: var(--xy-space-3); }
.purpose-list view { display: flex; min-width: 0; align-items: center; gap: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); white-space: nowrap; }
.purpose-list image { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.asset-visual { position: absolute; top: 0; right: 0; width: 44%; height: 100%; max-height: 164px; pointer-events: none; }

.month-strip, .action-rail, .ledger-list, .funds-overview, .withdraw-panel, .withdraw-records { border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); box-shadow: none; }
.month-strip { display: grid; min-height: 72px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: var(--xy-space-4); }
.month-item { display: flex; align-items: center; gap: var(--xy-space-3); padding: var(--xy-space-3); }
.month-item + .month-item { position: relative; }
.month-item + .month-item::before { position: absolute; top: var(--xy-space-3); bottom: var(--xy-space-3); left: 0; width: 1rpx; background: var(--xy-color-divider); content: ''; }
.month-item > view:last-child, .ledger-row__copy, .withdraw-record > view { display: flex; min-width: 0; flex-direction: column; }
.month-item text:first-child { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.month-mark { display: flex; width: var(--xy-size-icon-feature); height: var(--xy-size-icon-feature); align-items: center; justify-content: center; border-radius: var(--xy-radius-circle); font-size: var(--xy-text-item-title-size); font-weight: var(--xy-text-weight-semibold); }
.month-mark--income { background: var(--xy-color-brand-light); color: var(--xy-color-brand); }
.month-mark--expense { background: var(--xy-member-color-pink-surface); color: var(--xy-member-color-pink-text); }
.month-value { margin-top: var(--xy-space-1); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); }
.month-value--income { color: var(--xy-color-brand); }
.month-value--expense { color: var(--xy-member-color-pink-text); }

.action-rail { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--xy-space-3); overflow: hidden; }
.action-rail button { display: flex; min-width: 0; min-height: var(--xy-size-touch-min); align-items: center; flex-direction: column; justify-content: flex-start; padding: var(--xy-space-3) var(--xy-space-2); }
.action-rail button + button { position: relative; border-left: 0; }
.action-rail button + button::before { position: absolute; top: var(--xy-space-3); bottom: var(--xy-space-3); left: 0; width: 1rpx; background: var(--xy-color-divider); content: ''; }
.action-rail image { display: block; flex: none; width: var(--xy-size-icon-nav); height: var(--xy-size-icon-nav); }
.action-title, .action-note { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.action-title { margin-top: var(--xy-space-2); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); }
.action-note { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }

.ledger-section { margin-top: var(--xy-space-6); }
.section-head { display: flex; min-height: var(--xy-text-section-title-line-height); align-items: center; justify-content: space-between; gap: var(--xy-space-3); }
.section-head > view { min-width: 0; }
.section-title { display: block; }
.section-title { color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.section-title--small { font-size: var(--xy-text-item-title-size); }
.section-note { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.ledger-filter { margin-top: var(--xy-space-3); }
.ledger-content { padding-top: calc(var(--xy-space-1) + var(--xy-gap-label-value-compact)); }
.ledger-list { padding: 0 var(--xy-space-3); }
.ledger-row, .ledger-row__main, .withdraw-head, .withdraw-actions, .withdraw-record { display: flex; align-items: center; }
.ledger-row, .withdraw-record { min-height: 68px; justify-content: space-between; gap: var(--xy-space-3); border-bottom: 1rpx solid var(--xy-color-divider); }
.ledger-row:last-child, .withdraw-record:last-child { border-bottom: 0; }
.ledger-row__main { min-width: 0; flex: 1; }
.ledger-row__mark { display: flex; flex: none; width: var(--xy-size-icon-feature); height: var(--xy-size-icon-feature); align-items: center; justify-content: center; border-radius: var(--xy-radius-circle); font-weight: var(--xy-text-weight-bold); }
.ledger-row__mark--plus { background: var(--xy-color-brand-light); color: var(--xy-color-brand); }
.ledger-row__mark--minus { background: var(--xy-member-color-pink-surface); color: var(--xy-member-color-pink-text); }
.ledger-row__copy { margin-left: var(--xy-space-3); }
.ledger-row__title { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); }
.ledger-row__time, .withdraw-record__time { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.ledger-row__amount { flex: none; font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-bold); }
.ledger-row__amount--plus { color: var(--xy-color-brand); }
.ledger-row__amount--minus { color: var(--xy-member-color-pink-text); }
.footnote { display: block; margin: var(--xy-space-3) var(--xy-space-1) 0; color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }

.funds-overview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--xy-space-3); }
.funds-overview view { display: flex; min-width: 0; min-height: 64px; align-items: center; flex-direction: column; justify-content: center; padding: var(--xy-space-2); }
.funds-overview view + view { border-left: 1rpx solid var(--xy-color-divider); }
.funds-overview text:first-child { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.funds-overview text:last-child { margin-top: var(--xy-space-1); color: var(--xy-color-text-primary); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); }
.withdraw-panel { margin-top: var(--xy-layout-content-gap); padding: var(--xy-inset-card); }
.withdraw-head { align-items: flex-end; justify-content: space-between; gap: var(--xy-space-3); }
.withdraw-label, .withdraw-value, .withdraw-help, .withdraw-form__label { display: block; }
.withdraw-label { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.withdraw-value { margin-top: var(--xy-space-2); color: var(--xy-color-text-primary); font-family: var(--xy-font-family-numeric); font-size: var(--xy-price-value-size); font-weight: var(--xy-text-weight-bold); }
.withdraw-status { color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); }
.withdraw-help { margin-top: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.withdraw-actions { gap: var(--xy-space-2); margin-top: var(--xy-space-4); }
.withdraw-actions button { flex: 1; }
.primary-action, .secondary-action { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; border-radius: var(--xy-radius-container); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); }
.primary-action { background: var(--xy-color-brand); color: var(--xy-color-text-inverse); }
.secondary-action { border: 1rpx solid var(--xy-color-border); background: var(--xy-color-surface); color: var(--xy-color-text-primary); }
.withdraw-form { margin-top: var(--xy-space-4); padding-top: var(--xy-space-4); border-top: 1rpx solid var(--xy-color-divider); }
.withdraw-form__label { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); }
.withdraw-input { display: flex; min-height: var(--xy-size-touch-min); align-items: center; gap: var(--xy-space-2); margin-top: var(--xy-space-2); padding: 0 var(--xy-space-3); border: 1rpx solid var(--xy-color-border); border-radius: var(--xy-radius-container); }
.withdraw-input input { min-width: 0; flex: 1; font-family: var(--xy-font-family-numeric); }
.withdraw-records { margin-top: var(--xy-space-4); padding: 0 var(--xy-space-3); }
.section-head--compact { min-height: var(--xy-control-height-large); border-bottom: 1rpx solid var(--xy-color-divider); }
.withdraw-record__amount { color: var(--xy-color-text-primary); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); }
.withdraw-record__status { flex: none; color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); }
.powder-entry-source, .powder-entry-grant { min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); }
