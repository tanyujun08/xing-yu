.private-messages-page { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-space-4) calc(var(--xy-space-5) + env(safe-area-inset-bottom)); background: var(--xy-color-page); color: var(--xy-color-text-primary);
  padding-top: var(--xy-layout-card-stack-start-gap);
}
.conversation-list { overflow: hidden; border-radius: var(--xy-radius-md); background: var(--xy-color-surface); }
.conversation-row { display: flex; min-height: var(--xy-size-touch-min); align-items: flex-start; padding: var(--xy-inset-card); border: 0; background: var(--xy-color-surface); box-sizing: border-box; position: relative; }
.avatar { display: flex; width: var(--xy-size-icon-feature); height: var(--xy-size-icon-feature); flex: none; align-items: center; justify-content: center; border-radius: var(--xy-radius-circle); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); }
.avatar image { width: var(--xy-size-icon-nav); height: var(--xy-size-icon-nav); }
.conversation-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: var(--xy-space-3); }
.conversation-title-line { display: flex; align-items: flex-start; min-width: 0; }
.conversation-title { display: -webkit-box; overflow: hidden; min-width: 0; flex: 1; color: var(--xy-color-text-primary); font-size: var(--xy-text-item-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.conversation-meta { display: flex; min-width: 0; flex-wrap: wrap; gap: var(--xy-space-1); align-items: flex-start; margin-top: var(--xy-gap-title-description); }
.conversation-status { max-width: 100%; box-sizing: border-box; overflow-wrap: anywhere; flex: none; padding: 0 var(--xy-space-1); border-radius: var(--xy-radius-sm); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.conversation-device { min-width: 0; overflow: hidden; flex: 1; margin-left: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-body-small-line-height); text-overflow: ellipsis; white-space: nowrap; }
.conversation-last { display: -webkit-box; overflow: hidden; margin-top: var(--xy-gap-title-description); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.conversation-arrow { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); flex: none; margin-left: var(--xy-gap-related); }
.state-card { display: flex; align-items: center; flex-direction: column; margin-top: 0; padding: var(--xy-space-6) var(--xy-space-4); border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); box-shadow: none; text-align: center; }
.state-symbol { display: flex; align-items: center; justify-content: center; width: var(--xy-size-icon-lg); height: var(--xy-size-icon-lg); background: transparent; }
.state-symbol image { width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); }
.state-title { margin-top: var(--xy-gap-group); color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.state-button { display: flex; min-height: var(--xy-control-height); align-items: center; justify-content: center; margin-top: var(--xy-gap-content-action); padding: 0 var(--xy-button-padding-x); border-radius: var(--xy-radius-md); background: var(--xy-color-action-primary); color: var(--xy-color-text-inverse); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold);  line-height: var(--xy-text-body-line-height);}
.empty-card.xy-empty-page { padding: var(--xy-space-4) var(--xy-inset-card); }

.conversation-time { margin-left: 0; white-space: normal; font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); overflow-wrap: anywhere; }
.conversation-row:not(:last-child)::after { content: ""; position: absolute; bottom: 0; left: calc(var(--xy-inset-card) + var(--xy-size-icon-feature) + var(--xy-space-3)); right: var(--xy-inset-card); height: 1px; background: var(--xy-color-divider); }
.conversation-reference { display: flex; flex-direction: column; gap: var(--xy-space-1); margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); overflow-wrap: anywhere; }
