/* 私聊信息：会话合并成一张白卡，头像 40 圆形浅绿底，行间细线从文字左缘开始。 */
.private-messages-page { min-height:100vh; box-sizing:border-box; padding:var(--xy-layout-card-stack-start-gap) var(--xy-space-4) calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background:var(--xy-color-page); color:var(--xy-color-text-primary); }
.conversation-list { overflow:hidden; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.conversation-row { position:relative; display:flex; align-items:flex-start; min-height:var(--xy-size-touch-min); padding:var(--xy-space-4); box-sizing:border-box; border:0; background:var(--xy-color-surface); }
.conversation-row:active { background:var(--xy-color-surface-subtle); }
.conversation-row + .conversation-row::before { position:absolute; top:0; right:var(--xy-space-4); left:calc(var(--xy-space-4) + 40px + var(--xy-space-3)); height:1rpx; background:var(--xy-color-divider); content:''; }
.avatar { display:flex; flex:none; width:40px; height:40px; align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-brand-soft); }
.avatar image { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.conversation-copy { display:flex; flex:1; flex-direction:column; min-width:0; margin-left:var(--xy-space-3); }
.conversation-title-line { display:flex; align-items:flex-start; min-width:0; }
.conversation-title { display:-webkit-box; flex:1; min-width:0; overflow:hidden; color:var(--xy-color-text-strong); font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); font-weight:var(--xy-text-weight-semibold); -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.conversation-meta { display:flex; align-items:center; gap:var(--xy-space-2); min-width:0; margin-top:var(--xy-space-1); }
.conversation-status { flex:none; max-width:50%; padding:0 var(--xy-inset-chip-compact-x); box-sizing:border-box; border-radius:var(--xy-radius-sm); background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); overflow-wrap:anywhere; }
.conversation-device { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.conversation-last { display:-webkit-box; margin-top:var(--xy-space-2); overflow:hidden; color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.conversation-reference { display:flex; flex-wrap:wrap; justify-content:space-between; gap:var(--xy-space-2); margin-top:var(--xy-space-2); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); overflow-wrap:anywhere; }
.conversation-time { white-space:normal; }
.conversation-arrow { flex:none; width:var(--xy-size-icon-base); height:var(--xy-size-icon-base); margin:var(--xy-space-3) 0 0 var(--xy-space-2); opacity:.6; }

/* 未登录 / 空态 */
.state-card { display:flex; flex-direction:column; align-items:center; padding:var(--xy-space-6) var(--xy-space-4); border:0; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:none; text-align:center; }
.state-symbol { display:flex; align-items:center; justify-content:center; width:56px; height:56px; border-radius:50%; background:var(--xy-color-brand-soft); }
.state-symbol image { width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); }
.state-title { margin-top:var(--xy-space-3); color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.state-button { display:flex; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin-top:var(--xy-space-4); padding:0 var(--xy-space-6); border-radius:var(--xy-radius-md); background:var(--xy-color-action-primary); color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.empty-card.xy-empty-page { min-height:360px; padding:var(--xy-space-6) var(--xy-space-4); }
.empty-card .xy-empty-page__illustration { width:200px; height:150px; margin-bottom:var(--xy-space-3); }
