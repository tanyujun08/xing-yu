.fees-description { white-space:pre-wrap; overflow-wrap:anywhere; }
.fees-evidence { display:flex; flex-wrap:wrap; gap:var(--xy-space-2); margin:var(--xy-space-2) 0; }
.fees-proof-action { position:relative; width:var(--xy-order-thumbnail-size); min-height:var(--xy-size-touch-min); height:var(--xy-order-thumbnail-size); border-radius:var(--xy-radius-container); overflow:hidden; }
.fees-proof-action media-state { display:block; width:100%; height:100%; }
.fees-proof { max-width:100%; }
.fees-video-label { position:absolute; bottom:0; left:0; right:0; color:var(--xy-color-text-inverse); background:var(--xy-color-text-primary); text-align:center; font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); pointer-events:none; }
.fees-link { display:flex; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin:var(--xy-space-3) 0 0; padding:0 var(--xy-space-2); background:transparent; color:var(--xy-color-brand); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.fees-state { padding:var(--xy-space-6) var(--xy-space-4); text-align:center; background:var(--xy-color-surface); border-radius:var(--xy-radius-container); }
.fees-state > text { display:block; }
.fees-error { color:var(--xy-color-danger); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.fees-loss { padding: 0 0 var(--xy-space-3); }
.fees-loss-head { display: flex; justify-content: space-between; gap: var(--xy-space-3); color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.fees-page .xy-h-total { margin-top: var(--xy-space-1); }
