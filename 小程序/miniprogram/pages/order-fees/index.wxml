<page-meta root-font-size="system" />
<page-shell fixed-header has-footer>
  <page-header slot="header" variant="order" title="费用依据" bindback="returnToOrder" />
  <view class="xy-h-page">
    <view wx:if="{{loading}}" class="xy-h-blk xy-h-blk--pad xy-h-note" role="status">正在读取本单核定结果…</view>
    <block wx:elif="{{errorText}}"><status-hero tone="neutral" art="wallet" title="暂时读不到核定结果" description="{{errorText}}" /></block>
    <block wx:elif="{{unavailable}}"><status-hero tone="neutral" art="wallet" title="尚无最终核定" description="请返回订单查看当前进度。" /></block>
    <block wx:elif="{{loaded && fees}}">
      <status-hero tone="blue" art="wallet" title="费用已核定" description="本次归还费用已核定，押金按下面的结果处理。" />
      <view class="xy-h-blk">
        <view class="xy-h-key {{fees.hasSupplement ? 'xy-h-key--warn' : 'xy-h-key--brand'}}"><text class="xy-h-key__label">{{fees.hasSupplement ? '应补缴' : '应退押金'}}</text><text class="xy-h-key__amount">{{fees.hasSupplement ? fees.supplement : fees.refundDue}}</text><text class="xy-h-key__note">押金抵扣 {{fees.deducted}}<block wx:if="{{fees.cashExpense}}"> · 最终现金支出 {{fees.cashExpense}}</block></text></view>
      </view>
      <text class="xy-h-cap">怎么算的</text>
      <view class="xy-h-blk">
        <view class="xy-h-row"><text class="xy-h-row__k">约定归还</text><text class="xy-h-row__v xy-h-row__v--strong">{{fees.returnDeadline}}</text></view>
        <view class="xy-h-row"><text class="xy-h-row__k">实际收回</text><text class="xy-h-row__v xy-h-row__v--strong">{{fees.receivedAt}}</text></view>
        <view class="xy-h-row"><view class="xy-h-row__k"><text>超期费</text><text class="xy-h-row__sub">{{fees.units}} 个计费单位 × {{fees.unitPrice}} / {{fees.unit}}</text></view><text class="xy-h-row__v xy-h-row__v--strong">{{fees.overtime}}</text></view>
        <view class="xy-h-row"><view class="xy-h-row__k"><text>损失费用</text><text wx:if="{{!fees.lossItems.length}}" class="xy-h-row__sub">本次核定无损失项</text></view><text class="xy-h-row__v xy-h-row__v--strong">{{fees.loss}}</text></view>
        <view wx:for="{{fees.lossItems}}" wx:key="key" class="fees-loss">
          <view class="fees-loss-head"><text class="fees-description">{{item.description}}</text><text class="xy-h-row__v">{{item.amount}}</text></view>
          <view class="fees-evidence">
            <view wx:for="{{item.evidence}}" wx:for-item="proof" wx:key="key" class="fees-proof">
              <view wx:if="{{proof.available}}" class="fees-proof-action" data-key="{{proof.key}}" data-review="{{fees.reviewId}}" bindtap="previewProof" role="button" aria-label="{{proof.kind === 'PHOTO' ? '放大本项损失照片' : '播放本项凭证视频'}}"><media-state density="thumbnail" state="ready" src="{{proof.kind === 'PHOTO' ? proof.url : proof.poster}}" mode="aspectFill" alt="本项核定凭证" /><text wx:if="{{proof.kind === 'VIDEO'}}" class="fees-video-label">视频</text></view>
              <text wx:else class="xy-h-note">本项凭证暂不可用</text>
            </view>
          </view>
          <text wx:if="{{!item.evidence.length}}" class="xy-h-note">本项暂无可查看的凭证，请联系官方客服核实。</text>
        </view>
        <view class="xy-h-total fees-total"><text>合计</text><text>{{fees.total}}</text></view>
      </view>
      <text class="xy-h-note">计费规则：每{{fees.unit}}计费，归还宽限 {{fees.grace}}。{{fees.rounding}}</text>
      <block wx:if="{{fees.evidence.length}}">
        <text class="xy-h-cap">核定凭证</text>
        <view class="xy-h-blk xy-h-blk--pad">
          <view class="fees-evidence"><view wx:for="{{fees.evidence}}" wx:for-item="proof" wx:key="key" class="fees-proof">
            <view wx:if="{{proof.available}}" class="fees-proof-action" data-key="{{proof.key}}" data-review="{{fees.reviewId}}" bindtap="previewProof" role="button" aria-label="{{proof.kind === 'PHOTO' ? '放大核定凭证照片' : '播放核定凭证视频'}}"><media-state density="thumbnail" state="ready" src="{{proof.kind === 'PHOTO' ? proof.url : proof.poster}}" mode="aspectFill" alt="核定补充凭证" /><text wx:if="{{proof.kind === 'VIDEO'}}" class="fees-video-label">视频</text></view>
            <text wx:else class="xy-h-note">凭证暂不可用</text>
          </view></view>
        </view>
      </block>
      <text class="xy-h-cap">核定信息</text>
      <view class="xy-h-blk">
        <view class="xy-h-row"><text class="xy-h-row__k">订单编号</text><text class="xy-h-row__v" selectable>{{fees.orderNo}}</text></view>
        <view class="xy-h-row"><text class="xy-h-row__k">核定版本</text><text class="xy-h-row__v">第 {{fees.reviewNo}} 次</text></view>
        <view class="xy-h-row"><text class="xy-h-row__k">核定时间</text><text class="xy-h-row__v">{{fees.createdAt}}</text></view>
      </view>
      <text wx:if="{{fees.adjustment}}" class="xy-h-note">核定说明：{{fees.adjustment}}</text>
      <text class="xy-h-note">资金处理进度以订单内支付及退款结果为准。对核定有疑问，可点底部客服。</text>
      <text wx:if="{{previewError}}" class="fees-error" role="alert">{{previewError}}</text>
    </block>
  </view>
  <view slot="footer" class="xy-h-foot"><view class="xy-h-actions"><button class="xy-action-hit xy-h-kf" bindtap="demoSupport" aria-label="联系客服"><image src="{{supportIcon}}" mode="aspectFit" aria-hidden="true" /><text>客服</text></button><view class="xy-h-actions__main">
    <button wx:if="{{errorText || unavailable}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="returnToOrder">返回订单</button>
    <button wx:if="{{errorText || unavailable}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refresh">{{errorText ? '重新读取' : '刷新核定结果'}}</button>
    <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="returnToOrder">返回订单</button>
  </view></view></view>
</page-shell>
