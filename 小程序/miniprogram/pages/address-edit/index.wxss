.editor-page { padding:var(--xy-space-4); color:var(--xy-color-text-primary); }
.editor-card { padding:var(--xy-space-3); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.editor-card + .editor-card { margin-top:var(--xy-space-3); }
.field-label { display:block; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.region-row > .field-label { flex:none; }
.region-row .picker-value { width:100%; min-width:0; }
.picker-value > text:last-child { flex:0 0 16px; text-align:right; color:var(--xy-color-text-muted); }
.field-count { display:block; margin-top:var(--xy-space-1); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); text-align:right; color:var(--xy-color-text-muted); }
.switch { width:36px; height:22px; padding:calc(var(--xy-space-1) / 2); border-radius:var(--xy-radius-switch); background:var(--xy-color-disabled); box-sizing:border-box; }
.switch > view { width:18px; height:18px; border-radius:50%; background:var(--xy-color-surface); }
.switch.is-on { background:var(--xy-color-brand); }
.switch.is-on > view { margin-left:calc(var(--xy-space-3) + var(--xy-space-1) / 2); }
.form-error, .field-error { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-danger); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.form-error { margin-top:var(--xy-space-2); }
.editor-actions { display:flex; flex-wrap:wrap; gap:var(--xy-space-2) var(--xy-space-3); }
.save-primary, .save-secondary { display:flex; align-items:center; justify-content:center; min-height:44px; box-sizing:border-box; margin:0; padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-container); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.save-primary::after, .save-secondary::after { border:0; }
.save-primary { flex:1 1 120px; min-width:120px; background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.save-secondary { flex:0 0 96px; border:1rpx solid var(--xy-color-border-strong); background:var(--xy-color-surface); color:var(--xy-color-text-primary); }
.contact-field { display:flex; flex-direction:column; align-items:stretch; gap:var(--xy-space-2); padding:var(--xy-space-3) 0; min-height:0; }
.contact-field > .field-label { flex:none; color:var(--xy-color-text-primary); }
.contact-field input { flex:none; width:100%; min-width:0; height:var(--xy-text-body-line-height); margin:0; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.contact-field + .contact-field { margin-top:0; border-top:1rpx solid var(--xy-color-divider); }
.contact-field .field-error { margin:0; }
.region-row { display:flex; flex-direction:column; align-items:stretch; gap:var(--xy-space-2); min-height:0; }
.picker-value { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); min-height:0; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.detail-field { margin-top:var(--xy-space-3); padding-top:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); }
.detail-field textarea { box-sizing:border-box; width:100%; height:72px; margin-top:var(--xy-space-2); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.default-row { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-3); min-height:0; margin-top:var(--xy-space-3); padding:var(--xy-space-3); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }

.contact-field:first-child { padding-top:0; }
.contact-field:last-child { padding-bottom:0; }

.region-tabs { display:flex; gap:var(--xy-space-4); border-bottom:1rpx solid var(--xy-color-divider); }
.region-tab { padding:var(--xy-space-3) 0; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.region-tab.is-active { color:var(--xy-color-brand); box-shadow:inset 0 -2px var(--xy-color-brand); }
.region-options { padding-top:var(--xy-space-2); }
.region-option { display:flex; align-items:center; justify-content:space-between; min-height:44px; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.region-option.is-active { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }

/* Keep the existing visual carrier; constrain only its interaction box. */
.region-row, .default-row { box-sizing:border-box; min-height:var(--xy-size-touch-min); }

.region-tab { position:relative; }
.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }
