<page-meta root-font-size="system" />
<view class="pf-page pf-page--bar">
  <page-header title="{{secondaryNavigationTitle || '我要出租'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />

  <view class="pf-sum">
    <view class="pf-sum__t"><view class="pf-dot {{publishEnabled ? '' : 'is-warn'}}" /><text>{{headline}}</text></view>
    <text class="pf-sum__s">{{subline}}</text>
  </view>

  <view wx:if="{{errorText}}" class="pf-cd">
    <view class="pf-row pf-tap" bindtap="retry" role="button"><text class="pf-row__k pf-row__k--ink">{{errorText}}</text><text class="pf-row__v is-warn">重新读取</text></view>
  </view>

  <view wx:if="{{qualifications.length}}" class="pf-block">
    <text class="pf-gt">发布条件</text>
    <view class="pf-cd">
      <view wx:for="{{qualifications}}" wx:key="title" class="pf-row" data-route="{{item.route}}" data-title="{{item.title}}" bindtap="openCheck" role="button">
        <text class="pf-row__k pf-row__k--ink">{{item.title}}</text>
        <text class="pf-row__v {{item.done ? '' : 'is-warn'}}">{{item.value}}</text>
        <view wx:if="{{!item.done && item.route}}" class="pf-btn pf-btn--s">{{item.actionText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{service}}" class="pf-block">
    <view class="pf-gt-row"><text class="pf-gt">出租服务</text><text class="pf-link" data-route="{{service.route}}" bindtap="openCheck" role="button">去购买 ›</text></view>
    <view class="pf-cd">
      <view wx:for="{{service.services}}" wx:for-item="s" wx:key="label" class="pf-row">
        <text class="pf-row__k pf-row__k--ink">{{s.label}}</text>
        <text class="pf-row__v {{s.soon ? 'is-muted' : ''}}">{{s.value}}</text>
      </view>
    </view>
    <text class="pf-fnote">电子合同用完后，承租人无法签约。</text>
  </view>

  <view class="xy-bottom-action pf-foot">
    <view class="xy-action-secondary pf-foot__s" bindtap="buyRentalService" role="button" aria-label="购买出租服务">购买服务</view>
    <view class="xy-action-primary" bindtap="publish" role="button" aria-label="{{primaryLabel}}">{{primaryLabel}}</view>
  </view>
</view>
<login-sheet id="login-sheet" bindwechatlogin="onWechatLogin" bindphonelogin="onPhoneLogin" bindlegal="onLoginLegal" />
