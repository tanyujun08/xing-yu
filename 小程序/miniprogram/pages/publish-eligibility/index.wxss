.eligibility-page { min-height: 100vh; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-fixed-bottom-clearance); background: var(--xy-color-surface-subtle); 
  padding-top: var(--xy-layout-card-stack-start-gap);
}
.eligibility-header { display: flex; flex-direction: column; padding-bottom: 0; 
  margin-bottom: var(--xy-layout-card-stack-start-gap);
}
.page-eyebrow { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.page-title { margin-top: var(--xy-space-1); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); }
.page-status { margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.page-status.is-ready { color: var(--xy-color-success); }
.page-status.is-pending { color: var(--xy-color-warning); }
.check-list, .service-card { overflow: hidden; border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.check-card { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: space-between; padding: 0 var(--xy-space-3); border-bottom: 1rpx solid var(--xy-color-divider); }
.check-card:last-child { border-bottom: 0; }
.check-title { font-size: var(--xy-text-body-size); }
.check-right { display: flex; align-items: center; }
.check-value { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); }
.check-value.is-done { color: var(--xy-color-success); }
.check-value.is-warning { color: var(--xy-color-warning); }
.check-arrow { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-left: var(--xy-space-2); }
.service-section { margin-top: var(--xy-layout-section-gap); }
.section-title { display: block; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.service-copy { margin-top: var(--xy-space-1); margin-bottom: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.service-copy text { color: var(--xy-color-text-muted); }
.service-card { padding: 0 var(--xy-space-3); }
.service-row { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: space-between; border-bottom: 1rpx solid var(--xy-color-divider); font-size: var(--xy-text-body-size); }
.service-row:last-child { border-bottom: 0; }
.service-row text:last-child { color: var(--xy-color-text-secondary); }
.eligibility-bottom { padding-top: var(--xy-space-3); }
.eligibility-bottom > view { flex: 1; }
.service-button, .publish-button { border-radius: var(--xy-radius-md); }

.service-card {
  min-height: var(--xy-size-touch-min);
}
