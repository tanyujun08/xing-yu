/* 重设计 第 1 批：品牌区（Logo + 名称 + 介绍 + 版本）→ 协议列表 */
.about-page { min-height: 100vh; box-sizing: border-box; display: flex; flex-direction: column; gap: var(--xy-space-3); padding: 0 var(--xy-layout-page-padding-x) var(--xy-space-6); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.about-intro { display: flex; flex-direction: column; align-items: center; gap: var(--xy-space-2); padding: calc(var(--xy-space-4) * 2) var(--xy-space-4) var(--xy-space-6); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); text-align: center; }
.about-logo { width: 64px; height: 64px; margin-bottom: var(--xy-space-1); border-radius: calc(var(--xy-space-3) + var(--xy-space-0-5)); }
.brand { color: var(--xy-color-text-strong); font-size: var(--xy-text-order-navigation-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-order-navigation-line-height); }
.about-summary { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.about-version { height: 20px; margin-top: var(--xy-space-1); padding: 0 var(--xy-space-1-5); border-radius: var(--xy-radius-sm); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-body-line-height); }
.about-list { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.about-row { position: relative; display: flex; min-height: 52px; box-sizing: border-box; align-items: center; gap: var(--xy-space-2); padding: 0 var(--xy-space-4); }
.about-row + .about-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.about-row:active { background: var(--xy-color-surface-subtle); }
.about-label { min-width: 0; flex: 1; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.about-arrow { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); opacity: .6; }
