.about-page { min-height: 100vh; box-sizing: border-box; padding: var(--xy-layout-card-stack-start-gap) var(--xy-layout-page-padding-x) var(--xy-space-4); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.about-intro { display: flex; align-items: center; flex-direction: column; padding: var(--xy-inset-card); border-radius: var(--xy-radius-container); background: var(--xy-color-surface); text-align: center; }
.about-intro .brand { color: var(--xy-color-text-strong); font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-page-title-line-height); }
.about-summary { max-width: 100%; margin-top: var(--xy-gap-related); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); overflow-wrap: anywhere; }
.about-list { overflow: hidden; margin-top: var(--xy-layout-content-gap); border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.about-row { position: relative; display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: space-between; padding: var(--xy-space-2) var(--xy-inset-card); box-sizing: border-box; border-bottom: 0; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.about-row:not(:last-child)::after { position: absolute; right: 0; bottom: 0; left: 0; border-bottom: 1rpx solid var(--xy-color-divider); content: ''; }
.about-label { min-width: 0; color: var(--xy-color-text-primary); }
.about-arrow { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-left: var(--xy-space-3); }
.about-value { min-width: 0; margin-left: var(--xy-gap-group); color: var(--xy-color-text-secondary); overflow-wrap: anywhere; text-align: right; }
