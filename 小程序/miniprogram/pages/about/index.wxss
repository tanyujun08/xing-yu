/* 视觉规范 v1：品牌卡居中（标志字 20/700 + 简介 12），下方白卡列表行高 52 */
.about-page { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.about-intro { display: flex; align-items: center; flex-direction: column; padding: var(--xy-space-6) var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); text-align: center; }
.about-intro .brand { color: var(--xy-color-brand); font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-heavy); line-height: var(--xy-text-page-title-line-height); letter-spacing: 2px; }
.about-summary { max-width: 100%; margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; }
.about-list { overflow: hidden; margin-top: var(--xy-space-3); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.about-row { position: relative; display: flex; min-height: 52px; align-items: center; justify-content: space-between; padding: var(--xy-space-4); box-sizing: border-box; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.about-row + .about-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.about-row.xy-tap:active { background: var(--xy-color-surface-subtle); opacity: 1; }
.about-label { min-width: 0; color: var(--xy-color-text-primary); }
.about-arrow { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-left: var(--xy-space-3); opacity: .6; }
.about-value { min-width: 0; margin-left: var(--xy-space-3); color: var(--xy-color-text-secondary); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; text-align: right; }
