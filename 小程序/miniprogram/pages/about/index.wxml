<page-meta root-font-size="system" />
<view class="about-page">
<page-header title="{{secondaryNavigationTitle || '关于星遇'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <view class="about-intro xy-card"><text class="brand">星遇</text><text class="about-summary">个人设备租赁与出租平台，让闲置设备更高效流转。</text></view>
  <view class="about-list xy-card">
    <view class="about-row"><text class="about-label">当前版本</text><text class="about-value">{{version}}</text></view>
    <view class="about-row xy-tap" data-id="user-agreement" bindtap="openPolicy" role="button" aria-label="阅读用户协议"><text class="about-label">用户协议</text><image class="about-arrow" src="{{icons.arrowRight}}" mode="aspectFit" aria-hidden="true" /></view>
    <view class="about-row xy-tap" data-id="privacy-policy" bindtap="openPolicy" role="button" aria-label="阅读隐私政策"><text class="about-label">隐私政策</text><image class="about-arrow" src="{{icons.arrowRight}}" mode="aspectFit" aria-hidden="true" /></view>
  </view>
</view>
