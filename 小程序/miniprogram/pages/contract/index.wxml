<page-meta root-font-size="system" />
<page-shell surface="page" has-footer>
  <page-header variant="order" title="{{heading}}" bindback="onSecondaryNavigationBack" slot="header" />
  <view class="xy-h-page">
    <view wx:if="{{loading && !loaded}}" class="xy-h-blk xy-h-blk--pad xy-h-note" role="status">正在读取合同…</view>

    <!-- 读取失败 -->
    <block wx:if="{{!loaded && !loading && errorText}}">
      <status-hero tone="neutral" art="contract" title="暂时无法查看合同" description="{{errorText}}" />
      <view class="xy-h-blk"><button class="xy-h-link" bindtap="demoSupport"><text class="xy-h-link__k">联系官方客服</text><text class="xy-h-link__more" aria-hidden="true">›</text></button></view>
    </block>

    <block wx:if="{{loaded}}">
      <!-- 状态头 -->
      <status-hero tone="{{heroTone}}" art="{{heroArt}}" title="{{statusTitle}}" description="{{statusHint}}{{deadline && !resultPending && !renderFailed ? '请于 ' + deadline + ' 前完成。' : ''}}" />
      <view wx:if="{{errorText || resultPending || recoverRender}}" class="xy-h-blk">
        <text wx:if="{{errorText}}" class="xy-h-inote xy-h-alert" role="alert">{{errorText}}</text>
        <view wx:if="{{resultPending}}" class="xy-h-row"><text class="xy-h-row__k">最近查询</text><text class="xy-h-row__v">{{lastChecked}}</text></view>
        <button wx:if="{{errorText}}" class="xy-h-link" bindtap="refresh" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">重新查询</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <button wx:if="{{recoverRender}}" class="xy-h-link" bindtap="refresh" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">查询原生成结果</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
      </view>

      <!-- 结论 + 对象：本单设备与金额 -->
      <view wx:if="{{!renderFailed}}" class="xy-h-blk">
        <view class="xy-h-dev"><order-product-summary variant="order-list" title="{{title}}" secondary="{{resultPending ? '租赁合同' : term}}" media-src="{{image}}" media-state="{{image ? 'ready' : 'idle'}}" /></view>
        <block wx:if="{{!resultPending}}">
          <block wx:if="{{!artifactId}}">
            <view class="xy-h-row"><text class="xy-h-row__k">租金</text><text class="xy-h-row__v">{{rent}}</text></view>
            <view class="xy-h-row"><text class="xy-h-row__k">租赁押金</text><text class="xy-h-row__v">{{deposit}}</text></view>
          </block>
          <view wx:else class="xy-h-row"><text class="xy-h-row__k">本单应付</text><text class="xy-h-row__v xy-h-row__v--strong">{{total}}</text></view>
        </block>
      </view>

      <!-- 合同生成失败：签名预览 -->
      <block wx:if="{{renderFailed}}">
        <text class="xy-h-cap">本次签名</text>
        <view class="xy-h-blk xy-h-blk--pad">
          <button wx:if="{{!signatureImageFailed}}" class="xy-action-hit ct-media-btn" bindtap="previewSignature" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}" aria-label="放大查看本次保存的本人签名"><image class="ct-signature" src="{{signatureImageURL}}" mode="aspectFit" data-signature="{{signatureImageID}}" binderror="signatureImageFailed" aria-label="本次保存的本人签名" /></button>
          <view wx:else class="ct-signature ct-signature--error" role="alert"><text class="xy-h-row__sub">签名图片加载失败</text><button class="xy-action-hit xy-h-hit" bindtap="refresh" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">重新加载原签名</button></view>
        </view>
        <text class="xy-h-note">无需重新签名，可重试生成本次合同；生成成功后仍需核对完整合同并确认签署。<block wx:if="{{deadline}}">确认截止 {{deadline}}。</block></text>
      </block>

      <!-- 合同签名页：生成后核对 -->
      <block wx:elif="{{artifactId && !resultPending}}">
        <text class="xy-h-cap">合同签名页 · 第 {{signaturePage}} / {{pageCount}} 页</text>
        <view class="xy-h-blk xy-h-blk--pad">
          <button class="xy-action-hit ct-media-btn" bindtap="previewAll" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}" aria-label="放大查看完整合同"><image class="ct-preview" src="{{previewURL}}" mode="widthFix" data-artifact="{{artifactId}}" bindload="previewLoaded" binderror="previewFailed" aria-label="含承租人签名的合同页面" /></button>
          <view class="ct-doc-links">
            <button class="xy-h-link" bindtap="previewAll" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">查看完整合同</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
            <button class="xy-h-link" bindtap="download" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">{{tenantStatus === '已签署' ? '下载合同' : '预览 PDF'}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          </view>
        </view>
        <text class="xy-h-note">{{tenantStatus !== '已签署' ? '预览不代表已完成签署，点图片可放大查看全文。' : '本页为已保存合同，仅供查看。'}}</text>
      </block>

      <!-- 协议正文 -->
      <block wx:elif="{{!resultPending}}">
        <text class="xy-h-cap">{{docTitle || '设备租赁协议'}}</text>
        <view class="xy-h-blk xy-h-blk--pad">
          <view class="ct-paper {{fullText ? 'ct-paper--full' : ''}}"><text class="ct-copy" user-select="{{true}}">{{fullText ? agreementText : docBody}}</text></view>
          <button class="xy-h-link ct-toggle" bindtap="toggleText" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">{{fullText ? '收起全文' : '查看完整合同'}}</text><text class="xy-h-link__more" aria-hidden="true">{{fullText ? '⌃' : '›'}}</text></button>
        </view>
      </block>

      <!-- 签署方 -->
      <block wx:if="{{!resultPending && !renderFailed}}">
        <text class="xy-h-cap">签署方</text>
        <view class="xy-h-blk">
          <view class="xy-h-row"><text class="xy-h-row__k">出租方</text><text class="xy-h-row__v">{{lessorName}}</text><text class="xy-h-tag xy-h-tag--brand">已签署</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">承租人</text><text class="xy-h-row__v">{{tenantName}}</text><text class="xy-h-tag {{tenantStatus === '已签署' ? 'xy-h-tag--brand' : 'xy-h-tag--warn'}}">{{tenantStatus}}</text></view>
          <view wx:if="{{signedAt}}" class="xy-h-row"><text class="xy-h-row__k">签署时间</text><text class="xy-h-row__v">{{signedAt}}</text></view>
        </view>
      </block>
      <text wx:if="{{blockers}}" class="xy-h-note">{{blockers}}</text>
      <text class="xy-h-note">订单编号 {{orderNo}}</text>
    </block>
  </view>

  <view slot="footer" class="xy-h-foot">
    <button wx:if="{{canSign}}" class="xy-h-agree" role="checkbox" aria-checked="{{agreed}}" bindtap="toggleAgree" disabled="{{busy || loading || !fullText}}" aria-disabled="{{busy || loading || !fullText}}"><view class="xy-h-check {{agreed ? 'is-checked' : ''}}"><image wx:if="{{agreed}}" src="{{checkIcon}}" mode="aspectFit" /></view><text>{{fullText ? '我已阅读并同意本合同内容' : '请先查看完整合同，再勾选同意'}}</text></button>
    <button wx:if="{{canConfirm}}" class="xy-h-agree" role="checkbox" aria-checked="{{checkedPreview}}" bindtap="togglePreview" disabled="{{busy || loading || !previewLoaded}}" aria-disabled="{{busy || loading || !previewLoaded}}"><view class="xy-h-check {{checkedPreview ? 'is-checked' : ''}}"><image wx:if="{{checkedPreview}}" src="{{checkIcon}}" mode="aspectFit" /></view><text>我已核对完整合同与本人签名，确认签署</text></button>
    <view class="xy-h-actions">
      <button class="xy-action-hit xy-h-kf" bindtap="demoSupport" aria-label="联系客服"><image src="{{supportIcon}}" mode="aspectFit" aria-hidden="true" /><text>客服</text></button>
      <view class="xy-h-actions__main">
        <block wx:if="{{!loaded && !loading && errorText}}">
          <button class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="backToOrders" disabled="{{busy}}" aria-disabled="{{busy}}">返回订单列表</button>
          <button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refresh" disabled="{{busy}}" aria-disabled="{{busy}}">重新查询</button>
        </block>
        <button wx:if="{{canSign}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="sign" disabled="{{busy || loading || !fullText || !agreed}}" aria-disabled="{{busy || loading || !fullText || !agreed}}">去手写签名</button>
        <button wx:if="{{canRewrite}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="sign" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">重新签名</button>
        <button wx:if="{{canConfirm}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="confirmSignature" disabled="{{busy || loading || !checkedPreview || !previewLoaded}}" aria-disabled="{{busy || loading || !checkedPreview || !previewLoaded}}">{{busy ? '正在核实签署…' : recoverConfirm ? '重试确认' : '确认签署'}}</button>
        <button wx:if="{{canRetry}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="retryRender" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{recoverRender ? '恢复原生成请求' : '重试生成合同'}}</button>
        <button wx:if="{{recoverCreate}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="recover" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">恢复原签名请求</button>
        <button wx:if="{{hasUpload && !recoverCreate}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="sign" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">继续原签名上传</button>
        <button wx:if="{{requiresIdentity}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="goIdentity" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">填写实名信息</button>
        <button wx:if="{{loaded && !canSign && !requiresIdentity && !canConfirm && tenantStatus !== '已签署'}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="continueOrder" disabled="{{busy}}" aria-disabled="{{busy}}">返回订单</button>
        <button wx:if="{{loaded && !canSign && !canRetry && !requiresIdentity && !hasUpload && (unknown || !canConfirm) && tenantStatus !== '已签署'}}" class="xy-h-btn {{resultPending && !recoverCreate ? 'xy-h-btn--primary' : 'xy-h-btn--secondary'}} xy-action-hit" bindtap="refresh" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询签署结果</button>
        <button wx:if="{{tenantStatus === '已签署' && loaded}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="continueOrder" disabled="{{busy}}" aria-disabled="{{busy}}">返回订单</button>
      </view>
    </view>
  </view>
</page-shell>
