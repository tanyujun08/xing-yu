.contract-load-error { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-4); min-height: 50vh; text-align: center; }
.contract-load-error-symbol { display: flex; align-items: center; justify-content: center; width: var(--xy-control-height-large); height: var(--xy-control-height-large); border-radius: 50%; background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-semibold); }
.contract-load-error-copy { width: 100%; white-space: pre-line; }
.contract-error { color: var(--xy-color-danger); overflow-wrap: anywhere; }
.contract-last-query { color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.contract-device { padding: var(--xy-space-4) 0 var(--xy-space-3); }
.contract-device + .xy-h-row { border-top: 1rpx solid var(--xy-color-hairline); }
.contract-total-value { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); }
.contract-doc-head { display: flex; align-items: center; gap: var(--xy-space-2); }
.contract-doc-icon { flex: none; width: var(--xy-space-6); height: var(--xy-space-6); }
.contract-doc-title { flex: 1; min-width: 0; }
.contract-paper { max-height: calc(var(--xy-row-caption-line-height) * 3); overflow: hidden; margin: var(--xy-space-2) 0 var(--xy-space-3) calc(var(--xy-space-6) + var(--xy-space-2)); }
.contract-paper--full { max-height: none; }
.contract-copy { display: block; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.contract-outline { display: flex; align-items: center; justify-content: center; gap: var(--xy-space-1); width: 100%; min-height: var(--xy-size-touch-min); border: 1rpx solid var(--xy-color-border); border-radius: var(--xy-radius-md); color: var(--xy-color-text-primary); font-size: var(--xy-row-text-size); font-weight: var(--xy-text-weight-medium); box-sizing: border-box; }
.contract-chevron { color: var(--xy-color-text-muted); font-size: var(--xy-text-section-title-size); }
.contract-doc-actions { display: flex; gap: var(--xy-space-3); margin-top: var(--xy-space-3); }
.contract-doc-actions .contract-outline { flex: 1; }
.contract-gap { margin-top: var(--xy-space-3); }
.contract-party-state { flex: none; font-size: var(--xy-row-caption-size); }
.contract-preview-button { display: block; width: 100%; padding: 0; margin: 0; background: transparent; }
.contract-preview-button::after { border: 0; }
.contract-preview { display: block; width: 100%; margin-top: var(--xy-space-3); border: 1rpx solid var(--xy-color-divider); border-radius: var(--xy-radius-md); box-sizing: border-box; }
.contract-signature-image { display: block; width: 100%; height: var(--xy-contract-recovery-object-min-height); margin-top: var(--xy-space-3); border: 1rpx solid var(--xy-color-divider); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); box-sizing: border-box; }
.contract-signature-image--error { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--xy-color-text-secondary); }
.contract-button, .contract-button .contract-button-shell { min-height: var(--xy-control-height-large); font-size: var(--xy-text-section-title-size); line-height: var(--xy-text-section-title-line-height); }
.contract-button--secondary { order: -1; }
