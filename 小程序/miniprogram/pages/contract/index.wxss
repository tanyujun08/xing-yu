.contract-page { padding:var(--xy-space-3) var(--xy-space-4); display:flex; flex-direction:column; gap:var(--xy-space-3); color:var(--xy-color-text-primary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.contract-load-error { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:var(--xy-space-4); min-height:50vh; text-align:center; }
.contract-load-error-symbol { display:flex; align-items:center; justify-content:center; width:var(--xy-control-height-large); height:var(--xy-control-height-large); border-radius:50%; background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-page-title-size); font-weight:var(--xy-text-weight-semibold); }
.contract-load-error-copy { width:100%; white-space:pre-line; overflow-wrap:anywhere; }
.contract-card, .contract-status { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.contract-status { display:flex; align-items:center; gap:var(--xy-space-3); background:var(--xy-color-surface-subtle); min-height:var(--xy-contract-status-min-height); box-sizing:border-box; }
.contract-status--pending { flex-direction:column; text-align:center; min-height:var(--xy-contract-recovery-min-height); background:var(--xy-color-surface); }
.contract-status--pending .contract-status-icon { width:var(--xy-contract-recovery-icon-size); height:var(--xy-contract-recovery-icon-size); }
.contract-last-query { display:flex; justify-content:space-between; flex-wrap:wrap; gap:var(--xy-space-2); width:100%; border-top:1rpx solid var(--xy-color-divider); padding-top:var(--xy-space-3); color:var(--xy-color-text-secondary); }
.contract-summary { min-height:var(--xy-contract-summary-min-height); box-sizing:border-box; }
.contract-summary--pending { min-height:var(--xy-contract-recovery-object-min-height); display:flex; align-items:center; }
.contract-total { display:flex; align-items:baseline; flex-wrap:wrap; gap:var(--xy-space-2); margin-top:var(--xy-space-2); }
.contract-total-value { color:var(--xy-color-brand); font-size:var(--xy-order-amount-size); line-height:var(--xy-order-amount-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.contract-preview-card { min-height:var(--xy-contract-preview-min-height); }
.contract-readonly-note { display:block; padding:var(--xy-space-3); margin-top:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface-subtle); color:var(--xy-color-text-secondary); }
.contract-status-icon { width:var(--xy-control-height-large); height:var(--xy-control-height-large); flex:none; }
.contract-status-copy { flex:1; min-width:0; }
.contract-status--success { background:var(--xy-color-brand-soft); }
.contract-status--failure { min-height:var(--xy-contract-recovery-min-height); }
.contract-signature-card { min-height:var(--xy-contract-recovery-object-min-height); }
.contract-signature-image { display:block; width:100%; height:var(--xy-contract-recovery-object-min-height); margin-top:var(--xy-space-3); border:1rpx solid var(--xy-color-divider); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); box-sizing:border-box; }
.contract-signature-image--error { display:flex; flex-direction:column; align-items:center; justify-content:center; color:var(--xy-color-text-secondary); }
.contract-signature-explanation { margin-top:var(--xy-space-4); }
.contract-status--warning { background:var(--xy-color-warning-soft); }
.contract-status-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); }
.contract-status--success .contract-status-title, .contract-signed { color:var(--xy-color-brand); }
.contract-note { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.contract-product { display:flex; align-items:center; gap:var(--xy-space-3); }
.contract-product-image { width:var(--xy-order-thumbnail-size); height:var(--xy-order-thumbnail-size); flex:none; border-radius:var(--xy-radius-media); background:var(--xy-color-page); }
.contract-product-info { flex:1; min-width:0; }
.contract-title { font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.contract-facts { border-top:1rpx solid var(--xy-color-divider); margin-top:var(--xy-space-4); padding-top:var(--xy-space-3); }
.contract-fact { display:flex; align-items:flex-start; justify-content:space-between; gap:var(--xy-space-3); overflow-wrap:anywhere; }
.contract-fact + .contract-fact { margin-top:var(--xy-space-2); }
.contract-name { flex:1; min-width:0; }
.contract-section-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:var(--xy-space-2); }
.contract-link { padding:0; margin:0; min-width:var(--xy-size-touch-min); background:transparent; color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.contract-link::after { border:0; }
.contract-paper { max-height:var(--xy-contract-text-preview-height); overflow:hidden; padding:var(--xy-space-3); border:1rpx solid var(--xy-color-divider); border-radius:var(--xy-radius-md); margin-top:var(--xy-space-2); }
.contract-paper--full { max-height:none; }
.contract-copy { font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); display:block; white-space:pre-wrap; overflow-wrap:anywhere; color:var(--xy-color-text-secondary); }
.contract-preview { width:100%; display:block; margin-top:var(--xy-space-3); border:1rpx solid var(--xy-color-divider); border-radius:var(--xy-radius-md); box-sizing:border-box; }
.contract-warning { display:block; background:var(--xy-color-warning-soft); color:var(--xy-color-warning); padding:var(--xy-space-3); border-radius:var(--xy-radius-md); margin-top:var(--xy-space-2); }
.contract-agreement { display:flex; align-items:center; gap:var(--xy-space-2); min-height:var(--xy-size-touch-min); padding:var(--xy-space-2) 0; margin:var(--xy-space-2) 0 0; color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); text-align:left; background:transparent; }
.contract-agreement::after { border:0; }
.contract-checkbox { flex:none; width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); border:1rpx solid var(--xy-color-border-strong); border-radius:var(--xy-radius-sm); }
.contract-checkbox.is-checked { background:var(--xy-color-brand); border-color:var(--xy-color-brand); }
.contract-checkbox image { width:100%; height:100%; }
.contract-actions { display:flex; flex-direction:column; gap:var(--xy-space-2); }
.contract-button, .contract-button .contract-button-shell { min-height:var(--xy-control-height-large); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.contract-error { color:var(--xy-color-danger); overflow-wrap:anywhere; }

.contract-preview-button { display:block; width:100%; padding:0; margin:0; background:transparent; } .contract-preview-button::after { border:0; }
