.ct-media-btn { display: block; width: 100%; padding: 0; margin: 0; background: transparent; }
.ct-media-btn::after { border: 0; }
.ct-preview { display: block; width: 100%; border: 1rpx solid var(--xy-color-hairline); border-radius: var(--xy-radius-md); box-sizing: border-box; }
.ct-signature { display: block; width: 100%; height: var(--xy-contract-recovery-object-min-height); border: 1rpx solid var(--xy-color-hairline); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); box-sizing: border-box; }
.ct-signature--error { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-2); }
.ct-doc-links { margin-top: var(--xy-space-2); }
.ct-doc-links .xy-h-link + .xy-h-link { border-top: 1rpx solid var(--xy-color-hairline); }
.ct-paper { max-height: calc(var(--xy-row-caption-line-height) * 4); overflow: hidden; }
.ct-paper--full { max-height: none; }
.ct-copy { display: block; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.ct-toggle { margin-top: var(--xy-space-2); border-top: 1rpx solid var(--xy-color-hairline); }
