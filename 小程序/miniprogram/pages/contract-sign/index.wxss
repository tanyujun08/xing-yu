.signature-card { padding: 0 var(--xy-space-4) var(--xy-space-4); }
.signature-head { display: flex; align-items: center; gap: var(--xy-space-4); min-height: var(--xy-row-height); }
.signature-ask { flex: 1; min-width: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.signature-name { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); }
.signature-tool { flex: none; justify-content: center; min-width: var(--xy-size-touch-min); font-weight: var(--xy-text-weight-medium); }
.signature-tool.is-disabled { color: var(--xy-color-text-disabled); }
.signature-board { position: relative; height: var(--xy-contract-canvas-height); border: 1rpx dashed var(--xy-color-border); border-radius: var(--xy-radius-md); overflow: hidden; background: var(--xy-color-surface); box-sizing: border-box; }
.signature-canvas { position: relative; width: 100%; height: 100%; }
.signature-guide { position: absolute; left: var(--xy-space-4); right: var(--xy-space-4); top: 70%; border-top: 1rpx dashed var(--xy-color-border-strong); pointer-events: none; }
.signature-warn { color: var(--xy-color-key-warning); }
.signature-wait { color: var(--xy-color-key-warning); font-weight: var(--xy-text-weight-semibold); }
.signature-bad { color: var(--xy-color-danger); font-weight: var(--xy-text-weight-semibold); }
