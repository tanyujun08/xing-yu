.signature-page { display:flex; flex-direction:column; gap:var(--xy-space-3); padding:var(--xy-space-3) var(--xy-space-4); color:var(--xy-color-text-primary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.signature-notice { display:flex; align-items:center; gap:var(--xy-space-3); padding:var(--xy-space-4); background:var(--xy-color-brand-soft); border-radius:var(--xy-radius-md); }
.signature-notice-icon { width:var(--xy-control-height-large); height:var(--xy-control-height-large); flex:none; }
.signature-notice-copy { flex:1; min-width:0; }
.signature-title { display:block; color:var(--xy-color-brand); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.signature-note { display:block; color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.signature-notice .signature-note { margin-top:var(--xy-space-2); }
.signature-board { position:relative; height:var(--xy-contract-canvas-height); border:1rpx solid var(--xy-color-divider); border-radius:var(--xy-radius-md); overflow:hidden; background:var(--xy-color-surface); }
.signature-canvas { width:100%; height:100%; position:relative; }
.signature-guide { position:absolute; left:var(--xy-space-4); right:var(--xy-space-4); top:70%; border-top:1rpx dashed var(--xy-color-divider); pointer-events:none; }
.signature-tools { display:flex; gap:var(--xy-space-3); }
.signature-tools button { flex:1; min-width:0; min-height:var(--xy-size-touch-min); }
.signature-tools .signature-tool-shell { min-height:var(--xy-size-touch-min); gap:var(--xy-space-2); }
.signature-tool-icon { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); flex:none; }
.signature-tools .is-disabled .signature-tool-icon { opacity:var(--xy-opacity-quiet); }
.signature-actions { display:flex; flex-direction:column; gap:var(--xy-space-2); }
.signature-button, .signature-button .signature-button-shell { min-height:var(--xy-control-height-large); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.signature-back .signature-back-shell { color:var(--xy-color-brand); border-color:var(--xy-color-brand); }
.signature-back.is-disabled .signature-back-shell { color:var(--xy-color-text-disabled); border-color:var(--xy-color-brand-disabled); }
.signature-error { color:var(--xy-color-danger); overflow-wrap:anywhere; }
