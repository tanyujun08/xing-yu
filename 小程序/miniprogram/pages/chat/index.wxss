/* 订单沟通：顶部订单白卡 → 提示条 → 消息气泡（对方白底、自己浅绿底，靠头像一角收小）→ 底部输入栏。 */
.chat-content { padding:var(--xy-space-3) var(--xy-space-4) var(--xy-space-4); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }

/* 订单卡：图 56、圆角 8 白卡 */
.chat-order-card { display:flex; align-items:center; min-height:var(--xy-size-touch-min); gap:var(--xy-space-3); width:100%; margin:0; padding:var(--xy-space-3); box-sizing:border-box; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); text-align:left; }
.chat-order-card:active { background:var(--xy-color-surface-subtle); }
.chat-order-image { flex:none; width:56px; height:56px; overflow:hidden; border-radius:var(--xy-radius-media); background:var(--xy-color-surface-subtle); }
.chat-order-copy { flex:1; min-width:0; }
.chat-order-name { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.chat-order-status { display:block; margin-top:var(--xy-gap-label-value-compact); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.chat-order-status:last-child { margin-top:var(--xy-space-1); color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-semibold); }
.chat-order-link { flex:none; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }

/* 提示条：浅灰底，右侧客服入口 */
.chat-tools { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); margin-top:var(--xy-space-3); padding:0 0 0 var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-canvas-muted); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.chat-tools > text { flex:1; min-width:0; }
.chat-text-action { display:flex; flex:none; align-items:center; justify-content:center; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); margin:0; padding:0 var(--xy-space-3); background:transparent; color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-semibold); }
.chat-refresh { display:flex; justify-content:center; }
.chat-refresh .chat-text-action { color:var(--xy-color-text-muted); font-weight:var(--xy-text-weight-regular); }
.chat-history { margin:0 auto; color:var(--xy-color-text-muted); font-weight:var(--xy-text-weight-regular); }
.chat-empty { display:flex; flex-direction:column; align-items:center; gap:var(--xy-space-1); padding:var(--xy-space-6) 0; color:var(--xy-color-text-secondary); text-align:center; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.chat-empty.xy-empty-page { min-height:280px; }
.chat-empty .xy-empty-page__illustration { width:160px; height:120px; margin-bottom:var(--xy-space-3); }
.chat-empty-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }

/* 消息 */
.message-row { margin:var(--xy-space-4) 0; }
.message-read-marker { width:100%; height:1px; }
.message-time { display:block; margin-bottom:var(--xy-space-2); color:var(--xy-color-text-muted); text-align:center; font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.message-line { display:flex; align-items:flex-start; gap:var(--xy-space-2); }
.is-mine .message-line { justify-content:flex-end; }
.message-avatar { display:flex; flex:none; width:36px; height:36px; align-items:center; justify-content:center; overflow:hidden; border-radius:50%; background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); font-weight:var(--xy-text-weight-semibold); }
.message-avatar image { width:100%; height:100%; border-radius:inherit; }
.message-avatar.is-self { padding:var(--xy-space-2); box-sizing:border-box; background:var(--xy-color-surface); }
.message-bubble { min-width:0; max-width:248px; padding:var(--xy-space-2) var(--xy-space-3); box-sizing:border-box; border-radius:var(--xy-radius-compact) var(--xy-radius-container) var(--xy-radius-container) var(--xy-radius-container); background:var(--xy-color-surface); }
.is-mine .message-bubble { border-radius:var(--xy-radius-container) var(--xy-radius-compact) var(--xy-radius-container) var(--xy-radius-container); background:var(--xy-color-brand-light); }
.message-content { display:block; color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); white-space:pre-wrap; overflow-wrap:anywhere; word-break:break-word; }
.message-image { display:block; max-width:100%; border-radius:var(--xy-radius-sm); }
.message-outcome { display:flex; align-items:center; justify-content:flex-end; gap:var(--xy-space-1); margin:var(--xy-space-1) var(--xy-size-touch-min) 0 0; color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.message-outcome.is-failed { color:var(--xy-color-danger); }
.message-outcome-icon { flex:none; width:var(--xy-size-icon-base); height:var(--xy-size-icon-base); }
.message-failure-icon { flex:none; align-self:center; width:20px; height:20px; }
.chat-recovery { color:var(--xy-color-text-secondary); text-align:right; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.chat-recovery-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; }
.chat-error { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-danger); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); overflow-wrap:anywhere; }
.chat-delivery { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.chat-readonly { display:block; padding:var(--xy-space-4); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); text-align:center; }

/* 输入栏：输入框 40 灰底圆角 6，图片按钮，绿色发送 */
.chat-input-bar { display:flex; align-items:flex-end; gap:var(--xy-space-2); min-height:var(--xy-chat-composer-height); padding:var(--xy-space-2) var(--xy-space-4); box-sizing:border-box; border-top:1rpx solid var(--xy-color-divider); background:var(--xy-color-surface); }
.chat-input { flex:1; min-width:0; min-height:var(--xy-size-touch-min); max-height:var(--xy-chat-input-max-height); padding:calc((var(--xy-size-touch-min) - var(--xy-text-body-line-height)) / 2) var(--xy-space-3); box-sizing:border-box; border-radius:var(--xy-radius-md); background:var(--xy-color-control-surface); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.chat-image-action { display:flex; flex:none; align-items:center; justify-content:center; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); margin:0; padding:0; background:transparent; }
.chat-image-action image { width:var(--xy-size-tab-icon); height:var(--xy-size-tab-icon); }
.chat-image-action[disabled] { opacity:.45; }
.chat-send { display:flex; flex:none; align-items:center; justify-content:center; min-width:64px; min-height:var(--xy-size-touch-min); margin:0; padding:0 var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.chat-send:active { background:var(--xy-color-brand-pressed); }
.chat-send[disabled] { background:var(--xy-color-brand-disabled); color:var(--xy-color-text-inverse); }

/* 发送图片确认 */
.chat-image-confirmation { padding:var(--xy-space-4); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.chat-image-recipient { display:block; margin-bottom:var(--xy-space-3); color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); overflow-wrap:anywhere; }
.chat-image-preview-card { padding:var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.chat-image-preview { display:block; width:100%; height:300px; max-height:45vh; border-radius:var(--xy-radius-sm); background:var(--xy-color-surface-subtle); }
.chat-image-confirm-copy { display:block; margin-top:var(--xy-space-3); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); text-align:center; }
.chat-image-progress { display:block; margin-top:var(--xy-space-3); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); }
.chat-image-actions { display:flex; flex-direction:row-reverse; gap:var(--xy-space-3); padding:var(--xy-space-3) var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); background:var(--xy-color-surface); }
.chat-image-confirm-send, .chat-image-cancel { display:flex; flex:1; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin:0; padding:0 var(--xy-space-4); box-sizing:border-box; border-radius:var(--xy-radius-md); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.chat-image-confirm-send { flex:2; background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.chat-image-cancel { background:var(--xy-color-surface); box-shadow:inset 0 0 0 1px var(--xy-color-border); color:var(--xy-color-text-primary); }
.chat-image-confirm-send[disabled] { background:var(--xy-color-brand-disabled); color:var(--xy-color-text-inverse); }
