<page-meta root-font-size="system" />
<page-shell has-footer="{{false}}">
  <page-header slot="header" title="管理后台确认" bindback="onBack" />
  <view class="pf-page ap" aria-busy="{{busy}}">
    <block wx:if="{{status === 'CONSUMED' || status === 'APPROVED'}}">
      <view class="ap-head"><view class="ap-mark"><text>✓</text></view><text class="ap-title">已确认</text><text class="ap-sub">请返回电脑继续操作</text></view>
    </block>
    <block wx:elif="{{status === 'REJECTED'}}">
      <view class="ap-head"><view class="ap-mark is-off"><text>×</text></view><text class="ap-title">已拒绝</text><text class="ap-sub">本次请求已被拒绝</text></view>
    </block>
    <block wx:elif="{{status === 'EXPIRED'}}">
      <view class="ap-head"><view class="ap-mark is-off"><text>!</text></view><text class="ap-title">二维码已过期</text><text class="ap-sub">请返回电脑刷新二维码</text></view>
    </block>
    <block wx:else>
      <view class="ap-head"><view class="ap-mark"><text>?</text></view><text class="ap-title">{{purpose === 'BIND' ? '绑定后台账号' : '确认后台登录'}}</text><text class="ap-sub">请核对电脑上的管理后台，仅确认本人发起的请求</text></view>
    </block>

    <view wx:if="{{purpose === 'BIND' && (displayName || phoneMasked)}}" class="pf-cd">
      <view class="pf-row"><text class="pf-row__k">后台账号</text><text class="pf-row__v">{{displayName}} {{phoneMasked}}</text></view>
    </view>

    <text wx:if="{{error}}" class="ap-error" role="alert">{{error}}</text>
    <text wx:if="{{busy}}" class="pf-fnote ap-center">正在处理…</text>

    <view class="ap-actions">
      <button wx:if="{{!loggedIn}}" class="xy-action-primary xy-button-reset" disabled="{{busy}}" aria-disabled="{{busy}}" bindtap="login" role="button" aria-label="微信登录并查看确认请求">微信登录并查看</button>
      <block wx:elif="{{status === 'PENDING'}}">
        <button wx:if="{{uncertain}}" class="xy-action-primary xy-button-reset" disabled="{{busy}}" aria-disabled="{{busy}}" bindtap="retryDecision" role="button" aria-label="重试原确认请求">重试原请求</button>
        <block wx:else>
          <button class="xy-action-primary xy-button-reset" disabled="{{busy}}" aria-disabled="{{busy}}" bindtap="approve" role="button" aria-label="确认{{purpose === 'BIND' ? '绑定' : '登录'}}">确认{{purpose === 'BIND' ? '绑定' : '登录'}}</button>
          <button class="xy-action-secondary xy-button-reset" disabled="{{busy}}" aria-disabled="{{busy}}" bindtap="reject" role="button" aria-label="拒绝本次请求">拒绝</button>
        </block>
      </block>
      <button wx:if="{{loggedIn && error && !uncertain}}" class="xy-action-secondary xy-button-reset" disabled="{{busy}}" aria-disabled="{{busy}}" bindtap="inspect" role="button" aria-label="重新查询请求状态">重新查询</button>
    </view>
  </view>
</page-shell>
