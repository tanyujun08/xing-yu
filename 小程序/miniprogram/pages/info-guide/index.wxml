<page-meta root-font-size="system" />
<view class="info-guide-page">
<page-header title="{{secondaryNavigationTitle}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <view wx:if="{{missing}}" class="state-card xy-empty-page xy-empty-page--surface">
    <image class="xy-empty-page__illustration" src="{{icons.emptyGeneric}}" mode="aspectFit" aria-hidden="true" />
    <text class="xy-empty-page__title">说明内容不存在</text>
    <text class="xy-empty-page__copy">请返回上一页重新选择。</text>
    <view class="xy-empty-page__action xy-action-primary xy-action-text xy-tap" bindtap="goBack" role="button" aria-label="返回上一页">返回上一页</view>
  </view>
  <block wx:else>
    <view wx:if="{{tabs.length}}" class="guide-seg" role="tablist"><view wx:for="{{tabs}}" wx:key="id" class="guide-seg-item xy-tap {{item.id === activeId ? 'is-on' : ''}}" data-id="{{item.id}}" bindtap="chooseTab" role="tab" aria-selected="{{item.id === activeId}}">{{item.title}}</view></view>
    <view class="guide-header"><text class="guide-title" role="heading" aria-level="1">{{guide.title}}</text><text class="guide-summary">{{guide.summary}}</text></view>
    <view wx:if="{{legal}}" class="legal-body">
      <view wx:for="{{guide.sections}}" wx:key="title" class="legal-section"><text class="legal-title">{{item.title}}</text><text class="legal-text">{{item.body}}</text></view>
    </view>
    <view wx:else class="guide-list">
      <view wx:for="{{guide.sections}}" wx:key="title" class="guide-section">
        <view class="guide-index"><text>{{index + 1}}</text></view>
        <view class="guide-section-copy"><text class="guide-section-title">{{item.title}}</text><text class="guide-section-body">{{item.body}}</text></view>
      </view>
    </view>
    <view class="guide-foot"><text>没找到答案？</text><text class="guide-foot-link xy-tap" bindtap="openSupport" role="button" aria-label="联系官方客服">联系官方客服</text></view>
  </block>
</view>
