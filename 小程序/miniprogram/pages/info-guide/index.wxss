/* 租赁指南：目录是一张白卡分行；详情是标题白卡 + 绿竖条「说明要点」+ 要点合并一张白卡、绿色序号。 */
.info-guide-page { min-height:100vh; box-sizing:border-box; padding:var(--xy-layout-card-stack-start-gap) var(--xy-space-4) calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background:var(--xy-color-page); color:var(--xy-color-text-primary); }

/* 目录 */
.guide-directory { overflow:hidden; padding:0; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.guide-directory-row { position:relative; display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-3); min-height:52px; padding:var(--xy-space-3) var(--xy-space-4); box-sizing:border-box; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-medium); }
.guide-directory-row:active { background:var(--xy-color-surface-subtle); }
.guide-directory-row + .guide-directory-row::before { position:absolute; top:0; right:var(--xy-space-4); left:var(--xy-space-4); height:1rpx; background:var(--xy-color-divider); content:''; }
.guide-directory-arrow { flex:none; width:var(--xy-size-icon-base); height:var(--xy-size-icon-base); opacity:.6; }

/* 标题卡 */
.guide-header { display:flex; flex-direction:column; padding:var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.guide-kicker { align-self:flex-start; padding:0 var(--xy-inset-chip-compact-x); border-radius:var(--xy-radius-sm); background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-semibold); }
.guide-title { margin-top:var(--xy-space-2); color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-bold); }
.guide-title:first-child { margin-top:0; }
.guide-summary { margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }

/* 分组标题：区块间 24，标题到内容 12 */
.guide-section-heading { display:flex; align-items:center; justify-content:space-between; min-width:0; margin:var(--xy-space-6) 0 var(--xy-space-3); }
.guide-section-label { display:flex; align-items:center; color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.guide-section-label::before { display:inline-block; width:var(--xy-space-1); height:var(--xy-space-4); margin-right:var(--xy-space-2); border-radius:var(--xy-radius-pill); background:var(--xy-color-brand); content:''; }
.guide-section-count { flex:none; margin-left:var(--xy-space-2); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }

/* 要点列表 */
.guide-list { overflow:hidden; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.guide-section { position:relative; display:flex; align-items:flex-start; padding:var(--xy-space-4); }
.guide-section + .guide-section::before { position:absolute; top:0; right:var(--xy-space-4); left:calc(var(--xy-space-4) + 28px + var(--xy-space-3)); height:1rpx; background:var(--xy-color-divider); content:''; }
.guide-index { display:flex; flex:0 0 28px; width:28px; height:28px; align-items:center; justify-content:center; border-radius:var(--xy-radius-md); background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-family:var(--xy-font-family-numeric); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-bold); font-variant-numeric:tabular-nums; }
.guide-index text { color:inherit; font-family:inherit; }
.guide-section-copy { display:flex; flex:1; flex-direction:column; min-width:0; margin-left:var(--xy-space-3); }
.guide-section-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); padding-top:var(--xy-space-1); font-weight:var(--xy-text-weight-semibold); }
.guide-section-body { margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }

/* 内容不存在 */
.state-card { display:flex; flex-direction:column; align-items:center; padding:var(--xy-space-6) var(--xy-space-4); border:0; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:none; text-align:center; }
.state-card.xy-empty-page { min-height:360px; }
.state-card .xy-empty-page__illustration { width:200px; height:150px; margin-bottom:var(--xy-space-3); }
