/* 租赁指南：三篇合一页，顶部分段切换；要点是裸行加细线，协议/政策是纯正文排版。 */
.info-guide-page { min-height:100vh; box-sizing:border-box; padding:0 0 calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background:var(--xy-color-page); }
.guide-seg { display:flex; gap:var(--xy-space-0-5); margin:var(--xy-space-3) var(--xy-space-4) 0; padding:var(--xy-space-0-5); border-radius:var(--xy-radius-control); background:var(--xy-color-border); }
.guide-seg-item { position:relative; display:flex; flex:1; align-items:center; justify-content:center; min-height:var(--xy-button-height-small); border-radius:var(--xy-radius-sm); color:var(--xy-color-text-secondary); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-medium); }
.guide-seg-item.is-on { background:var(--xy-color-surface); color:var(--xy-color-text-primary); font-weight:var(--xy-text-weight-bold); box-shadow:var(--xy-shadow-segment); }
.guide-header { display:flex; flex-direction:column; gap:var(--xy-space-1); padding:var(--xy-space-4) var(--xy-space-4) var(--xy-space-2); }
.guide-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.guide-summary { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.guide-list { margin-top:var(--xy-space-3); padding-left:var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); border-bottom:1rpx solid var(--xy-color-divider); }
.guide-section { position:relative; display:flex; align-items:flex-start; padding:var(--xy-space-4) var(--xy-space-4) var(--xy-space-4) 0; }
.guide-section + .guide-section::before { content:""; position:absolute; top:0; right:0; left:calc(var(--xy-size-icon-feature) - var(--xy-space-1) + var(--xy-space-3)); height:1rpx; background:var(--xy-color-divider); }
.guide-index { display:flex; flex:none; width:calc(var(--xy-size-icon-feature) - var(--xy-space-1)); height:calc(var(--xy-size-icon-feature) - var(--xy-space-1)); align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); font-weight:var(--xy-text-weight-semibold); font-variant-numeric:tabular-nums; }
.guide-section-copy { display:flex; flex:1; flex-direction:column; min-width:0; margin-left:var(--xy-space-3); gap:var(--xy-space-1); }
.guide-section-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.guide-section-body { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.legal-body { padding:var(--xy-space-2) var(--xy-space-4) 0; }
.legal-section { display:flex; flex-direction:column; gap:var(--xy-space-1); padding:var(--xy-space-3) 0; }
.legal-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.legal-text { color:var(--xy-color-text-value); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.guide-foot { display:flex; justify-content:center; align-items:center; margin-top:var(--xy-space-6); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.guide-foot-link { display:flex; align-items:center; min-height:var(--xy-size-touch-min); color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.state-card { display:flex; flex-direction:column; align-items:center; padding:var(--xy-space-6) var(--xy-space-4); border:0; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:none; text-align:center; }
.state-card.xy-empty-page { min-height:360px; }
.state-card .xy-empty-page__illustration { width:200px; height:150px; margin-bottom:var(--xy-space-3); }
.hit-area { position:absolute; left:0; right:0; top:50%; min-height:var(--xy-size-touch-min); transform:translateY(-50%); }
