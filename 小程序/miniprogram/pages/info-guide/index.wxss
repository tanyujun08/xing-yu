.info-guide-page { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-3) var(--xy-space-4) calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background: var(--xy-color-page); color: var(--xy-color-text-primary); 
  padding-top: var(--xy-layout-card-stack-start-gap);
}
.guide-header { display: flex; flex-direction: column; }
.guide-directory { overflow: hidden; padding: 0; }
.guide-directory-row { display: flex; align-items: center; justify-content: space-between; gap: var(--xy-space-3); min-height: var(--xy-size-touch-min); padding: var(--xy-space-3); box-sizing: border-box; border-bottom: var(--xy-divider-hairline) solid var(--xy-color-divider); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.guide-directory-row:last-child { border-bottom: 0; }
.guide-directory-arrow { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.guide-kicker { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); letter-spacing: 2rpx; line-height: var(--xy-text-caption-line-height); }
.guide-title { margin-top: var(--xy-gap-title-description); color: var(--xy-color-text-strong); font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-page-title-line-height); }
.guide-title:first-child { margin-top: 0; }
.guide-summary { margin-top: var(--xy-gap-title-description); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.guide-section-heading { display: flex; min-width: 0; align-items: baseline; justify-content: space-between; margin-top: var(--xy-space-6); }
.guide-section-label { color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.guide-section-count { flex: none; margin-left: var(--xy-gap-related); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.guide-section { display: flex; align-items: flex-start; margin-top: var(--xy-space-4); padding: 0; background: transparent; }
.guide-section.is-first { margin-top: var(--xy-layout-card-stack-start-gap); }
.guide-index { width: var(--xy-size-icon-feature); flex: 0 0 var(--xy-size-icon-feature); color: var(--xy-color-text-muted); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.guide-index text { color: inherit; font-family: inherit; }
.guide-section-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; margin-left: var(--xy-gap-group); }
.guide-section-title { color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.guide-section-body { margin-top: var(--xy-gap-title-description); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.state-card { display: flex; align-items: center; flex-direction: column; margin-top: var(--xy-gap-group); padding: var(--xy-space-6) var(--xy-space-4); border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); box-shadow: none; text-align: center; }
.state-card.xy-empty-page { padding: var(--xy-space-4) var(--xy-inset-card); }
.state-symbol { display: flex; align-items: center; justify-content: center; width: var(--xy-size-icon-lg); height: var(--xy-size-icon-lg); background: transparent; }
.state-symbol image { width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); }
.state-title { margin-top: var(--xy-gap-group); color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.state-copy { margin-top: var(--xy-gap-title-description); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.state-button { display: flex; min-height: var(--xy-control-height); align-items: center; justify-content: center; margin-top: var(--xy-gap-content-action); padding: 0 var(--xy-button-padding-x); border-radius: var(--xy-radius-md); background: var(--xy-color-action-primary); color: var(--xy-color-text-inverse); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold);  line-height: var(--xy-text-body-line-height);}
