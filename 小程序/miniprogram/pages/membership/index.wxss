@import "../../shared/design/member-center.wxss";

.membership-page { --member-shortcut-spacing: 28px; }

.member-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 200px;
  padding: var(--xy-space-4);
  padding-bottom: var(--xy-space-3);
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--xy-radius-sheet);
  border: 1px solid var(--member-glint);
  color: var(--member-ink);
  background: radial-gradient(ellipse at 12% 20%, var(--member-light), transparent 72%), linear-gradient(125deg, var(--member-base) 35%, var(--member-deep));
  box-shadow: 0 10px 23px -12px var(--member-shade), inset 0 0 0 1px rgba(255,255,255,.22);
}
.member-card-wave {
  position: absolute;
  left: -15%;
  bottom: -132px;
  width: 140%;
  height: 208px;
  transform: rotate(-7deg);
  border-top: 1px solid var(--member-glint);
  border-radius: 46% 55% 0 0;
  background: linear-gradient(155deg, var(--member-wave), transparent 78%);
  pointer-events: none;
}
.member-card-art {
  position: absolute;
  right: 6px;
  top: 1px;
  width: 43%;
  max-width: 166px;
  height: 138px;
  pointer-events: none;
}
.member-identity, .member-stars, .member-card-footer { position: relative; z-index: 1; }
.member-identity { display: flex; align-items: center; gap: var(--xy-gap-related); min-height: var(--xy-size-icon-entry-block); }
.member-seal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--xy-size-icon-entry-block);
  height: var(--xy-size-icon-entry-block);
  flex: none;
  border-radius: var(--xy-radius-container);
  color: var(--xy-color-text-inverse);
  font-size: var(--xy-key-currency-size);
  background: linear-gradient(145deg, var(--member-shade), var(--member-accent));
  box-shadow: inset 0 1px 2px rgba(255,255,255,.65), 0 3px 7px rgba(27,39,39,.17);
}
.tier-bronze .member-seal, .tier-gold .member-seal { border-radius: var(--xy-radius-circle); }
.tier-royal .member-fill { background: var(--member-glint); }
.member-identity-copy { display: flex; flex-direction: column; }
.member-english { font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-weight: var(--xy-text-weight-semibold); }
.member-stars { margin-top: var(--xy-space-4); display: flex; align-items: baseline; gap: var(--xy-gap-label-value); white-space: nowrap; }
.member-card-footer { margin-top: auto; display: flex; gap: var(--xy-gap-group); align-items: center; justify-content: space-between; min-height: var(--xy-control-hit-size); }
.member-upgrade { flex: 1; min-width: 0; }
.member-upgrade-copy { display: block; margin-top: var(--xy-gap-label-value); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.member-upgrade-copy text { font-weight: var(--xy-text-weight-bold); }
.member-card .member-card-action {
  margin: 0;
  height: var(--xy-control-hit-size);
  flex: none;
  display: flex;
  align-items: center;
  color: var(--member-ink);
}
.member-card-action-shell {
  display: flex;
  align-items: center;
  gap: var(--xy-gap-related);
  min-height: var(--xy-button-height-standard);
  padding: 0 var(--xy-space-3);
  border-radius: var(--xy-radius-pill);
  border: 1px solid var(--member-glint);
  box-sizing: border-box;
  background: var(--member-wave);
  font-size: var(--xy-text-body-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-body-line-height);
}
.member-card-action .member-chevron { color: inherit; }
.member-card .member-track { background: var(--xy-color-hairline); }
.tier-royal .member-card .member-track { background: var(--xy-member-color-hero-progress-dark); }

.member-assets { display: flex; margin-top: var(--xy-layout-section-gap); }
.member-theme .member-asset, .member-theme .member-shortcut, .member-theme .member-row {
  margin: 0; min-width: 0; display: flex; align-items: center; gap: var(--xy-gap-related);
}
.member-theme .member-asset { flex: 1; padding: var(--xy-space-4); min-height: var(--xy-layout-membership-balance-row-height); text-align: left; position: relative; }
.member-asset + .member-asset::before { content:''; position: absolute; top: var(--xy-space-4); bottom: var(--xy-space-4); left: 0; width: 1px; background: var(--xy-color-divider); }
.member-asset-copy, .member-row-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.member-asset-copy {
  gap: var(--xy-gap-label-value-compact);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}
.member-asset-number {
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-page-title-size);
  line-height: var(--xy-text-page-title-line-height);
  font-weight: var(--xy-text-weight-bold);
  color: var(--xy-color-text-primary);
  font-variant-numeric: tabular-nums;
}
.member-icon {
  width: var(--xy-size-icon-entry-block-compact);
  height: var(--xy-size-icon-entry-block-compact);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--xy-radius-container);
  background: var(--xy-color-icon-carrier);
}
.member-icon image { width: var(--xy-size-icon-entry-glyph-compact); height: var(--xy-size-icon-entry-glyph-compact); }
.member-icon--pink { background: var(--xy-member-color-diamond-bg); }
.member-icon--gold { background: var(--xy-member-color-gold-surface-soft); }
.member-icon--mint { background: var(--xy-member-color-checkin-bg); }
.member-shortcuts { display: flex; margin-top: var(--member-shortcut-spacing); }
.member-theme .member-shortcut {
  flex: 1; flex-direction: column; justify-content: flex-start;
  gap: var(--xy-gap-related); min-height: var(--xy-control-hit-size); padding: 0; text-align: center;
}
.member-shortcut .member-icon { width: var(--xy-size-icon-entry-block); height: var(--xy-size-icon-entry-block); }
.member-shortcuts + .member-section { margin-top: var(--member-shortcut-spacing); }
.membership-page .member-list { padding: 0 var(--xy-space-4); }
.member-theme .member-row {
  min-height: calc(var(--xy-size-icon-entry-block-compact) + var(--xy-space-4));
  gap: var(--xy-gap-group);
  padding: var(--xy-space-2) 0;
  text-align: left;
}
.member-row:first-child { padding-top: var(--xy-space-4); }
.member-row:last-child { padding-bottom: var(--xy-space-4); }
.member-row + .member-row { border-top: 1px solid var(--xy-color-divider); }
.member-row-copy { gap: var(--xy-gap-label-value); }
.member-row > .member-secondary { margin-left: auto; }
@media (max-width: 345px) {
  .member-theme .member-asset { gap: var(--xy-gap-label-value); }
  .member-theme .member-asset:first-child { padding-right: var(--xy-space-2); }
  .member-theme .member-asset:last-child { padding-left: var(--xy-space-2); }
  .member-card-art { width: 40%; }
}
