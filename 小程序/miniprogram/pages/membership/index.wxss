@import "../../shared/design/member-tokens.wxss";

.membership-page {
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--xy-color-surface);
  color: var(--xy-color-text-primary);
}

.member-hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(117deg, var(--xy-member-color-hero-start), var(--xy-member-color-hero-end));
  color: var(--xy-member-color-hero-text);
}

.member-hero-body {
  position: relative;
  min-height: var(--xy-layout-membership-hero-height);
}

.member-hero-decoration {
  position: absolute;
  top: var(--xy-layout-membership-decoration-top);
  left: 50%;
  display: block;
  width: var(--xy-layout-membership-decoration-width);
  height: var(--xy-layout-membership-decoration-height);
  pointer-events: none;
  transform: translateX(-50%);
}

.member-summary {
  position: relative;
  z-index: var(--xy-z-local);
  padding: var(--xy-space-3) var(--xy-layout-page-padding-x) 0;
}

.member-growth-label,
.member-title-row,
.member-total-group,
.member-star-link,
.member-benefit-link,
.member-progress-meta,
.member-benefit-row {
  display: flex;
  align-items: center;
}

.member-growth-label {
  color: var(--xy-member-color-growth);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-star-mark {
  margin-right: var(--xy-space-1);
  color: var(--xy-member-color-growth);
  font-size: var(--xy-text-body-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-title-row {
  margin-top: calc(var(--xy-space-3) + var(--xy-gap-label-value-compact));
}

.member-level {
  color: var(--xy-member-color-green);
  font-size: var(--xy-text-membership-level-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-membership-level-line-height);
}

.member-level-code {
  display: flex;
  height: var(--xy-space-5);
  margin-left: var(--xy-space-2);
  padding: 0 var(--xy-space-2);
  align-items: center;
  box-sizing: border-box;
  border: var(--xy-border-object-card-width) solid var(--xy-member-color-hero-overlay);
  border-radius: var(--xy-radius-compact);
  background: var(--xy-member-color-hero-overlay);
  color: var(--xy-member-color-hero-text);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-total-row {
  display: flex;
  min-width: 0;
  margin-top: var(--xy-space-2);
  align-items: flex-end;
  justify-content: space-between;
}

.member-total-group {
  min-width: 0;
  align-items: flex-end;
}

.member-total {
  color: var(--xy-member-color-hero-text);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-membership-total-size);
  font-weight: var(--xy-text-weight-heavy);
  line-height: var(--xy-text-membership-total-line-height);
  letter-spacing: var(--xy-optical-text-frame-nudge);
}

.member-total-unit {
  margin-left: var(--xy-space-1);
  color: var(--xy-member-color-green);
  font-size: var(--xy-text-body-size);
  font-weight: var(--xy-text-weight-medium);
  line-height: var(--xy-text-body-line-height);
}

.member-today {
  display: flex;
  min-width: 0;
  padding-top: var(--xy-gap-label-value-compact);
  flex-direction: column;
  align-items: flex-end;
  align-self: flex-start;
  color: var(--xy-member-color-hero-muted);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-today-value {
  color: var(--xy-member-color-accent);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-membership-growth-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-membership-growth-line-height);
}

.member-star-link,
.member-benefit-link {
  position: relative;
  display: inline-flex;
  min-height: var(--xy-size-touch-min);
  color: var(--xy-member-color-accent);
  font-size: var(--xy-text-body-small-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-body-small-line-height);
}

.member-star-link {
  margin-top: calc(var(--xy-space-2) - (var(--xy-size-touch-min) - var(--xy-text-body-small-line-height)) / 2);
  margin-bottom: calc((var(--xy-text-body-small-line-height) - var(--xy-size-touch-min)) / 2);
}

.member-star-link image,
.member-benefit-link image {
  display: block;
  width: var(--xy-size-icon-base);
  height: var(--xy-size-icon-base);
  margin-left: var(--xy-space-1);
}

.member-hero-divider {
  height: var(--xy-divider-hairline);
  margin-top: var(--xy-space-3);
  background: var(--xy-member-color-divider);
}

.member-progress-meta {
  min-width: 0;
  margin-top: calc(var(--xy-space-3) - var(--xy-border-object-card-width));
  justify-content: space-between;
  color: var(--xy-member-color-hero-muted);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.member-next-level {
  color: var(--xy-member-color-hero-text);
  font-weight: var(--xy-text-weight-semibold);
}

.member-next-points {
  color: var(--xy-member-color-accent);
  font-family: var(--xy-font-family-numeric);
  font-weight: var(--xy-text-weight-semibold);
}

.progress-track {
  height: var(--xy-space-2);
  margin-top: var(--xy-space-2);
  overflow: hidden;
  border-radius: var(--xy-radius-pill);
  background: var(--xy-member-color-white);
}

.progress-fill {
  height: 100%;
  border-radius: var(--xy-radius-pill);
  background: var(--xy-member-color-accent);
}

.member-benefit-row {
  min-width: 0;
  margin-top: calc(var(--xy-space-2) - (var(--xy-size-touch-min) - var(--xy-text-body-small-line-height)) / 2);
  justify-content: space-between;
}

.member-progress-percent {
  color: var(--xy-member-color-hero-muted);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.balance-card {
  position: relative;
  z-index: var(--xy-z-sticky);
  height: var(--xy-layout-membership-card-height);
  min-height: var(--xy-layout-membership-card-height);
  margin: var(--xy-layout-membership-card-overlap-offset) var(--xy-layout-page-padding-x) 0;
  overflow: hidden;
  box-sizing: border-box;
  border: var(--xy-border-object-card-width) solid var(--xy-member-color-card-border);
  border-radius: var(--xy-radius-md);
  background: var(--xy-color-surface);
}

.balance-top {
  position: relative;
  min-height: var(--xy-layout-membership-balance-row-height);
}

.balance-icon {
  display: flex;
  width: var(--xy-size-icon-entry-block);
  height: var(--xy-size-icon-entry-block);
  flex: none;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--xy-radius-sm);
}

.balance-icon image {
  display: block;
}

.balance-icon-diamond {
  position: absolute;
  top: calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  left: calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  background: var(--xy-member-color-diamond-bg);
}

.balance-icon-diamond image {
  width: var(--xy-size-membership-diamond-width);
  height: var(--xy-size-membership-diamond-height);
}

.balance-copy {
  position: absolute;
  top: calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  left: calc(var(--xy-inset-card) - var(--xy-border-object-card-width) + var(--xy-size-icon-entry-block) + var(--xy-space-2));
}

.balance-label {
  display: block;
  color: var(--xy-color-text-strong);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.balance-amount {
  display: block;
  margin-top: var(--xy-space-1);
  color: var(--xy-member-color-diamond-accent);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-membership-growth-size);
  font-weight: var(--xy-text-weight-bold);
  line-height: var(--xy-text-membership-growth-line-height);
}

.balance-details {
  position: absolute;
  top: calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  right: var(--xy-space-2);
  display: flex;
  min-height: var(--xy-size-touch-min);
  padding-left: var(--xy-space-2);
  align-items: center;
  color: var(--xy-color-text-weak);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.balance-details image {
  display: block;
  width: var(--xy-size-icon-base);
  height: var(--xy-size-icon-base);
}

.balance-divider,
.balance-bottom-divider {
  position: absolute;
  background: var(--xy-member-color-card-border);
}

.balance-divider {
  top: calc(var(--xy-layout-membership-balance-row-height) - var(--xy-border-object-card-width));
  right: calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  left: calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  height: var(--xy-divider-hairline);
}

.balance-bottom {
  display: flex;
  min-height: var(--xy-layout-membership-balance-row-height);
}

.balance-item {
  display: flex;
  width: 50%;
  min-width: 0;
  min-height: var(--xy-size-touch-min);
  padding: calc(var(--xy-inset-card) - var(--xy-border-object-card-width)) 0 0 calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  align-items: flex-start;
  justify-content: flex-start;
  box-sizing: border-box;
}

.balance-icon-checkin,
.balance-icon-shop {
  margin-top: var(--xy-border-object-card-width);
}

.balance-icon-checkin {
  background: var(--xy-member-color-checkin-bg);
}

.balance-icon-shop {
  background: var(--xy-member-color-shop-bg);
}

.balance-icon-checkin image,
.balance-icon-shop image {
  width: var(--xy-size-icon-entry-block-compact);
  height: var(--xy-size-icon-entry-block-compact);
}

.balance-item-copy {
  min-width: 0;
  margin-left: var(--xy-space-2);
}

.balance-reward {
  display: flex;
  margin-top: var(--xy-space-1);
  align-items: baseline;
  white-space: nowrap;
}

.balance-reward-value {
  color: var(--xy-color-success);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-membership-growth-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-membership-growth-line-height);
}

.balance-reward-value--checkin { font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); white-space: normal; }

.balance-reward-shop {
  color: var(--xy-member-color-shop-accent);
}

.balance-reward-unit {
  margin-left: var(--xy-space-1);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}

.balance-bottom-divider {
  top: calc(var(--xy-layout-membership-balance-row-height) + var(--xy-inset-card) - var(--xy-border-object-card-width));
  bottom: calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  left: 50%;
  width: var(--xy-divider-hairline);
}

.member-content {
  padding: var(--xy-layout-section-gap) var(--xy-layout-page-padding-x) calc(var(--xy-layout-membership-content-tail) + env(safe-area-inset-bottom));
  background: var(--xy-color-surface);
}

.section-heading-row {
  display: flex;
  min-width: 0;
  min-height: var(--xy-text-section-title-line-height);
  align-items: flex-start;
  justify-content: space-between;
}

.section-title {
  color: var(--xy-color-text-strong);
  font-size: var(--xy-text-section-title-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-section-title-line-height);
}

.section-caption {
  padding-top: var(--xy-space-1);
  color: var(--xy-color-text-weak);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.task-list {
  display: flex;
  margin-top: var(--xy-layout-title-content-gap);
  padding-bottom: var(--xy-space-2);
  flex-direction: column;
  gap: var(--xy-space-6);
}

.task-entry-hit {
  position: relative;
  display: flex;
  width: 100%;
  min-height: var(--xy-size-touch-min);
}

.task-entry-hit::after {
  position: absolute;
  right: 0;
  bottom: calc(0px - var(--xy-space-3));
  left: 0;
  height: var(--xy-divider-hairline);
  background: var(--xy-color-divider);
  content: '';
}

.task-row {
  position: relative;
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: var(--xy-size-icon-entry-copy-compact);
  align-items: center;
}

.task-icon {
  border-radius: var(--xy-radius-sm);
  background: var(--xy-member-color-task-bg);
}

.task-icon .xy-icon-entry__glyph {
  width: var(--xy-size-icon-entry-glyph-compact);
  height: var(--xy-size-icon-entry-glyph-compact);
}

.task-section:not(.member-more-section) .task-entry-hit:first-child .task-icon .xy-icon-entry__glyph {
  width: calc(var(--xy-size-icon-entry-glyph-compact) - var(--xy-gap-label-value-compact) - var(--xy-border-object-card-width));
  height: calc(var(--xy-size-icon-entry-glyph-compact) - var(--xy-gap-label-value-compact) - var(--xy-border-object-card-width));
}

.task-copy {
  min-width: 0;
  flex: 1;
  margin-left: var(--xy-space-3);
}

.task-title {
  color: var(--xy-color-text-strong);
  font-size: var(--xy-text-item-title-size);
  font-weight: var(--xy-text-weight-medium);
  line-height: var(--xy-text-item-title-line-height);
}

.task-detail {
  margin-top: var(--xy-gap-title-description);
  color: var(--xy-color-text-weak);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
  overflow-wrap: anywhere;
}

.task-arrow {
  display: block;
  width: var(--xy-size-icon-base);
  height: var(--xy-size-icon-base);
  flex: 0 0 var(--xy-size-icon-base);
  margin-left: var(--xy-space-3);
}

.member-more-section {
  margin-top: var(--xy-layout-section-gap);
}

.invite-card {
  position: relative;
  min-height: var(--xy-layout-membership-invite-height);
  margin-top: var(--xy-layout-section-gap);
  padding: calc(var(--xy-inset-card) - var(--xy-border-object-card-width)) calc(var(--xy-control-width-membership-invite) + var(--xy-space-6)) calc(var(--xy-inset-card) - var(--xy-border-object-card-width)) calc(var(--xy-inset-card) - var(--xy-border-object-card-width));
  overflow: hidden;
  box-sizing: border-box;
  border: var(--xy-border-object-card-width) solid var(--xy-color-brand);
  border-radius: var(--xy-radius-md);
  background: var(--xy-color-brand-light);
}

.invite-title,
.invite-detail {
  display: block;
}

.invite-title {
  color: var(--xy-member-color-black);
  font-size: var(--xy-text-section-title-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-section-title-line-height);
}

.invite-highlight {
  color: var(--xy-member-color-invite-highlight);
}

.invite-detail {
  margin-top: var(--xy-space-1);
  color: var(--xy-member-color-invite-copy);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
  overflow-wrap: anywhere;
}

.invite-button {
  position: absolute;
  top: calc((var(--xy-layout-membership-invite-height) - var(--xy-size-touch-min)) / 2 - var(--xy-border-object-card-width));
  right: var(--xy-inset-card);
  display: flex;
  width: var(--xy-control-width-membership-invite);
  min-height: var(--xy-size-touch-min);
  align-items: center;
  justify-content: center;
}

.invite-button-shell {
  display: flex;
  width: var(--xy-control-width-membership-invite);
  height: calc(var(--xy-control-height-compact) + var(--xy-border-object-card-width));
  align-items: center;
  justify-content: center;
  border-radius: var(--xy-radius-sm);
  background: var(--xy-color-brand-pressed);
  color: var(--xy-color-text-inverse);
  font-size: var(--xy-text-body-size);
  font-weight: var(--xy-text-weight-medium);
  line-height: var(--xy-text-body-line-height);
}
