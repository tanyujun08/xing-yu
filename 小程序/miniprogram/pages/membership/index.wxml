<page-meta root-font-size="system" />
<view class="membership-page">
  <view class="member-hero">
    <page-header title="" aria-label="会员中心" inverse="{{true}}" background="transparent" bind:back="goBack" />
    <view class="member-hero-body">
      <image class="member-hero-decoration" src="{{icons.membershipHeroDecoration}}" mode="scaleToFill" aria-hidden="true" />
      <view class="member-summary">
      <view class="member-growth-label"><text class="member-star-mark">✦</text><text>会员成长</text></view>
      <view class="member-title-row">
        <text class="member-level">{{level}}</text>
        <view class="member-level-code"><text>{{levelCode}}</text></view>
      </view>
      <view class="member-total-row">
        <view class="member-total-group"><text class="member-total">{{starPoints}}</text><text class="member-total-unit">星光</text></view>
        <view class="member-today"><text>今日</text><text class="member-today-value">{{todayGrowth}}</text></view>
      </view>
      <view class="member-star-link xy-hit-target xy-tap" bindtap="openStarDetails" role="button" aria-label="查看星光明细"><text>查看星光明细</text><image src="{{icons.membershipLinkArrow}}" mode="aspectFit" /></view>
      <view class="member-hero-divider" aria-hidden="true"></view>
      <view class="member-progress-meta"><view>下一等级 · <text class="member-next-level">{{nextLevel}}</text></view><view>还差 <text class="member-next-points">{{nextLevelPoints}}</text> 星光</view></view>
      <view class="progress-track" aria-label="会员成长进度"><view class="progress-fill" style="width:{{progress}}%;"></view></view>
      <view class="member-benefit-row">
        <view class="member-benefit-link xy-hit-target xy-tap" bindtap="openDetails" role="button" aria-label="查看等级与特权"><text>查看等级与特权</text><image src="{{icons.membershipLinkArrow}}" mode="aspectFit" /></view>
        <text class="member-progress-percent">{{progressPercent}}</text>
      </view>
      </view>
    </view>
  </view>

  <view class="balance-card xy-elevation-overlap-card">
    <view class="balance-top">
      <view class="balance-icon balance-icon-diamond" role="img" aria-label="粉钻"><image src="{{icons.membershipBalanceDiamond}}" mode="aspectFit" /></view>
      <view class="balance-copy"><text class="balance-label">粉钻余额</text><text class="balance-amount">{{diamonds}}</text></view>
      <view class="balance-details xy-tap" bindtap="openBalanceDetails" role="button" aria-label="查看粉钻详情"><text>查看详情</text><image src="{{icons.membershipBalanceArrow}}" mode="aspectFit" /></view>
    </view>
    <view class="balance-divider" aria-hidden="true"></view>
    <view class="balance-bottom">
      <view class="balance-item xy-hit-target xy-tap" bindtap="openCheckIn" role="button" aria-label="每日签到">
        <view class="balance-icon balance-icon-checkin" role="img" aria-label="每日签到"><image src="{{icons.membershipBalanceCheckin}}" mode="aspectFit" /></view>
        <view class="balance-item-copy"><text class="balance-label">每日签到</text><view class="balance-reward"><text class="balance-reward-value balance-reward-value--checkin">{{dailyCheckInReward}}</text></view></view>
      </view>
      <view class="balance-item balance-item-shop xy-hit-target xy-tap" bindtap="openShop" role="button" aria-label="粉钻商城"><view class="balance-icon balance-icon-shop"><image src="{{icons.membershipBalanceShop}}" mode="aspectFit" /></view><view class="balance-item-copy"><text class="balance-label">粉钻商城</text><view class="balance-reward"><text class="balance-reward-value balance-reward-shop">{{shopCount}}</text><text class="balance-reward-unit">种好物</text></view></view></view>
    </view>
    <view class="balance-bottom-divider" aria-hidden="true"></view>
  </view>

  <view class="member-content"><text wx:if="{{errorText}}">{{errorText}}</text>
    <view class="task-section">
      <view class="section-heading-row"><text class="section-title">任务中心</text><text class="section-caption">任务规则暂未接入</text></view>
      <view class="task-list">
        <view wx:for="{{taskRows}}" wx:key="title" class="task-entry-hit xy-hit-target xy-tap" data-section="task" data-index="{{index}}" bindtap="openTask" role="button" aria-label="{{item.title}}，{{item.detail}}">
          <view class="task-row xy-icon-entry xy-icon-entry--compact">
            <view class="task-icon xy-icon-entry__carrier"><image class="xy-icon-entry__glyph" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" /></view>
            <view class="task-copy xy-icon-entry__copy"><text class="task-title xy-icon-entry__title">{{item.title}}</text><text class="task-detail xy-icon-entry__detail">{{item.detail}}</text></view>
            <image class="task-arrow" src="{{icons.membershipArrowRight}}" mode="aspectFit" aria-hidden="true" />
          </view>
        </view>
      </view>
    </view>

    <view class="task-section member-more-section">
      <view class="section-heading-row"><text class="section-title">更多</text></view>
      <view class="task-list">
        <view wx:for="{{moreRows}}" wx:key="title" class="task-entry-hit xy-hit-target xy-tap" data-section="more" data-index="{{index}}" bindtap="openTask" role="button" aria-label="{{item.title}}，{{item.detail}}">
          <view class="task-row xy-icon-entry xy-icon-entry--compact">
            <view class="task-icon xy-icon-entry__carrier"><image class="xy-icon-entry__glyph" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" /></view>
            <view class="task-copy xy-icon-entry__copy"><text class="task-title xy-icon-entry__title">{{item.title}}</text><text class="task-detail xy-icon-entry__detail">{{item.detail}}</text></view>
            <image class="task-arrow" src="{{icons.membershipArrowRight}}" mode="aspectFit" aria-hidden="true" />
          </view>
        </view>
      </view>
    </view>

    <view class="invite-card">
      <view class="invite-copy"><text class="invite-title">邀请好友 <text class="invite-highlight">暂未开放</text></text><text class="invite-detail">邀请规则与接口暂未接入。</text></view>
      <view class="invite-button xy-tap" bindtap="copyInvite" role="button" aria-label="去邀请"><view class="invite-button-shell">去邀请</view></view>
    </view>
  </view>
</view>
