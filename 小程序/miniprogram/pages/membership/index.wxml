<page-meta root-font-size="system" />
<view class="membership-page member-theme tier-{{tierKey}}">
  <view class="member-page-light" aria-hidden="true"></view>
  <page-header title="会员中心" background="{{headerScrolled ? 'var(--xy-color-page, #F5F5F7)' : 'transparent'}}" bind:back="goBack" />
  <view class="member-layout">
    <view class="member-card">
      <view class="member-card-wave" aria-hidden="true"></view>
      <image wx:if="{{art}}" class="member-card-art" src="{{art}}" mode="aspectFit" aria-hidden="true" />
      <view class="member-identity">
        <view class="member-seal" aria-hidden="true">✦</view>
        <view class="member-identity-copy">
          <text class="member-level member-tier-name">{{level}}</text>
          <text wx:if="{{levelEnglish}}" class="member-english">{{levelEnglish}}</text>
        </view>
      </view>
      <view class="member-stars"><text class="member-points-number">{{starPoints}}</text><text class="member-unit">星光</text></view>
      <view class="member-card-footer">
        <view wx:if="{{hasNextLevel}}" class="member-upgrade">
          <view class="member-track" aria-label="会员成长进度"><view class="member-fill" style="width:{{progress}}%;"></view></view>
          <text class="member-upgrade-copy">距{{nextLevel}}还差 <text>{{remainingPoints}}</text> 星光</text>
        </view>
        <text wx:elif="{{atMaxLevel}}" class="member-upgrade-copy">✦ 已达最高等级</text>
        <view wx:else></view>
        <button class="member-card-action xy-button-reset" bindtap="openDetails">
          <view class="member-card-action-shell">等级权益 <view class="member-chevron" aria-hidden="true"></view></view>
        </button>
      </view>
    </view>

    <text wx:if="{{errorText}}" class="member-notice" role="status">{{errorText}}</text>

    <view class="member-surface member-assets">
      <button class="xy-button-reset member-asset" bindtap="openBalanceDetails" aria-label="粉钻余额 {{diamonds}}，查看粉钻明细">
        <view class="member-icon member-icon--pink"><image src="{{icons.membershipBalanceDiamond}}" mode="aspectFit" /></view>
        <view class="member-asset-copy"><text>粉钻余额</text><text class="member-asset-number">{{diamonds}}</text></view>
        <view class="member-chevron" aria-hidden="true"></view>
      </button>
      <button class="xy-button-reset member-asset" bindtap="openStarDetails" aria-label="今日星光 {{todayGrowth}}，查看星光明细">
        <view class="member-icon member-icon--gold" aria-hidden="true"><image src="{{icons.checkInStar}}" mode="aspectFit" /></view>
        <view class="member-asset-copy"><text>今日星光</text><text class="member-asset-number">{{todayGrowth}}</text></view>
        <view class="member-chevron" aria-hidden="true"></view>
      </button>
    </view>

    <view class="member-shortcuts" aria-label="常用入口">
      <button class="xy-button-reset member-shortcut" bindtap="openCheckIn">
        <view class="member-icon member-icon--mint"><image src="{{icons.membershipBalanceCheckin}}" mode="aspectFit" /></view>
        <text class="member-row-title">每日签到</text>
      </button>
      <button class="xy-button-reset member-shortcut" bindtap="openLottery">
        <view class="member-icon member-icon--pink" aria-hidden="true"><image src="{{icons.membershipLottery}}" mode="aspectFit" /></view>
        <text class="member-row-title">每日抽奖</text>
      </button>
      <button class="xy-button-reset member-shortcut" bindtap="openShop">
        <view class="member-icon member-icon--gold"><image src="{{icons.membershipBalanceShop}}" mode="aspectFit" /></view>
        <text class="member-row-title">粉钻商城</text>
      </button>
    </view>

    <view class="member-section">
      <text class="member-section-title">任务中心</text>
      <view class="member-surface member-list">
        <button class="xy-button-reset xy-button-fluid member-row" bindtap="openTask">
          <view class="member-icon"><image src="{{icons.membershipTaskUpgrade}}" mode="aspectFit" /></view>
          <view class="member-row-copy"><text class="member-row-title">升级任务</text><text class="member-secondary">完成任务获得星光</text></view>
          <view class="member-chevron" aria-hidden="true"></view>
        </button>
        <button class="xy-button-reset xy-button-fluid member-row" bindtap="openDailyTasks">
          <view class="member-icon"><image src="{{icons.membershipTaskCheckin}}" mode="aspectFit" /></view>
          <view class="member-row-copy"><text class="member-row-title">每日星光任务</text><text class="member-secondary">查看每日任务和奖励</text></view>
          <view class="member-chevron" aria-hidden="true"></view>
        </button>
      </view>
    </view>

    <view id="membership-benefits" class="member-section">
      <text class="member-section-title">我的权益</text>
      <view class="member-surface member-list">
        <button class="xy-button-reset xy-button-fluid member-row" bindtap="openWaiver">
          <view class="member-icon"><image src="{{icons.membershipTaskWaiver}}" mode="aspectFit" /></view>
          <text class="member-row-title">信用免押</text>
          <text class="member-secondary">查看规则</text><view class="member-chevron" aria-hidden="true"></view>
        </button>
        <button class="xy-button-reset xy-button-fluid member-row" bindtap="openPublishAllowance">
          <view class="member-icon"><image src="{{icons.membershipTaskQuota}}" mode="aspectFit" /></view>
          <text class="member-row-title">出租发布额度</text>
          <text class="member-secondary">{{publishAllowance}}</text><view class="member-chevron" aria-hidden="true"></view>
        </button>
      </view>
    </view>
  </view>
</view>
