<page-meta root-font-size="system" />

<template name="task-list">
  <view class="task-list">
    <view wx:for="{{rows}}" wx:key="id" class="growth-task">
      <view class="growth-task__mark">
        <image class="growth-task__icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" />
      </view>
      <view class="growth-task__main">
        <text class="growth-task__title">{{item.title}}</text>
        <view class="growth-task__meta">
          <view wx:for="{{item.rewards}}" wx:for-item="reward" wx:key="label" class="task-reward task-reward--{{reward.tone}}">
            <image wx:if="{{reward.icon}}" class="task-reward__icon" src="{{reward.icon}}" mode="aspectFit" aria-hidden="true" />
            <text>{{reward.label}}</text>
          </view>
          <view wx:if="{{item.goal}}" class="task-goal" aria-label="阅读进度 {{item.goal.label}}">
            <view class="task-goal__track"><view class="task-goal__fill" style="width:{{item.goal.percent}}%;"></view></view>
            <text>{{item.goal.label}}</text>
          </view>
        </view>
      </view>
      <button wx:if="{{item.claimable}}" class="growth-task__action growth-task__action--claim xy-button-reset {{busy || loading || pendingBenefitCode ? 'growth-task__action--disabled' : ''}}" data-id="{{item.id}}" bindtap="openTask" disabled="{{busy || loading || pendingBenefitCode}}">领取</button>
      <button wx:elif="{{item.canBrowse || item.canRead}}" class="growth-task__action growth-task__action--next xy-button-reset {{browsing || busy || loading ? 'growth-task__action--disabled' : ''}}" bindtap="{{item.canRead ? 'openGuides' : 'browseDevice'}}" disabled="{{browsing || busy || loading}}">{{item.actionText}}</button>
      <text wx:else class="growth-task__status">{{item.actionText}}</text>
    </view>
  </view>
</template>

<view class="member-subpage task-center">
  <view class="task-masthead">
    <view class="task-masthead__light">
      <view class="task-masthead__beam"></view>
      <view class="task-masthead__sweep"></view>
    </view>
    <page-header title="任务中心" background="{{headerScrolled ? '#F3F4F6' : 'transparent'}}" bindback="onSecondaryNavigationBack" />
    <view class="task-hero">
      <view class="task-hero__copy">
        <text class="task-hero__title">完成任务，收获奖励</text>
        <text class="task-hero__subtitle">每一份成长，都有回报</text>
        <view class="task-hero__reward"><text class="task-hero__spark" aria-hidden="true">✦</text><text>星光与粉钻</text></view>
      </view>
      <view class="task-hero__glow"></view>
      <image class="task-hero__art" src="/assets/task-center/calendar.png" mode="aspectFit" aria-hidden="true" />
    </view>
  </view>

  <view class="task-center__body">
    <view wx:if="{{loading}}" class="task-feedback" role="status">正在加载任务…</view>
    <view wx:if="{{notice}}" class="task-feedback" role="status">{{notice}}</view>
    <view wx:if="{{errorText}}" class="task-feedback" role="alert">
      <text>{{errorText}}</text>
      <button class="task-link xy-button-reset" wx:if="{{!pendingBenefitCode}}" bindtap="retryTasks" disabled="{{busy || loading}}">重新读取</button>
    </view>
    <view wx:if="{{pendingBenefitCode}}" class="task-feedback">
      <text>上一笔奖励的领取结果待确认</text>
      <button id="growth-recover" class="task-link xy-button-reset" bindtap="recoverClaim" disabled="{{busy}}" loading="{{busy}}">继续核实</button>
    </view>
    <view wx:if="{{receiptText}}" class="task-feedback" role="status">
      <text class="task-feedback__title">{{receiptText}}</text>
      <text>当前 {{starPoints}} 星光 · {{balance}} 粉钻</text>
      <view class="task-receipt" wx:for="{{receiptGrants}}" wx:key="id">
        <text>{{item.label}}</text>
        <button class="task-link xy-button-reset" data-id="{{item.id}}" bindtap="openGrant">奖励凭证</button>
        <button class="task-link xy-button-reset" data-id="{{item.id}}" bindtap="openReward">查看明细</button>
      </view>
      <text wx:if="{{grantDetail}}">{{grantDetail}}</text>
    </view>

    <block wx:if="{{loggedIn && !notice}}">
      <view wx:for="{{groupOrder}}" wx:for-item="group" wx:key="*this" class="task-group">
        <view class="task-group__heading" role="heading" aria-level="2">
          <text class="task-group__title">{{group === 'daily' ? '每日任务' : '升级任务'}}</text>
          <text class="task-group__note">{{group === 'daily' ? '每日 00:00 刷新' : '完成指定任务，获取成长奖励'}}</text>
        </view>
        <template wx:if="{{group === 'daily' ? missions.length : tasks.length}}" is="task-list" data="{{rows: group === 'daily' ? missions : tasks, busy, loading, browsing, pendingBenefitCode}}" />
        <view wx:elif="{{!loading && !errorText}}" class="task-feedback" role="status">{{group === 'daily' ? '今天暂无每日任务' : '暂无升级任务'}}</view>
      </view>
    </block>
  </view>
</view>
