.service-page { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-4) var(--xy-layout-page-padding-x) var(--xy-space-6); background: var(--xy-color-surface-subtle); }
.service-head-row { display: flex; flex-wrap: wrap; gap: var(--xy-space-3); align-items: center; justify-content: space-between; }
.service-heading { font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.service-head-actions { display: flex; align-items: center; gap: var(--xy-space-3); }
.diamond-balance { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.record-link { position: relative; display: inline-flex; min-width: var(--xy-size-touch-min); align-items: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }

.service-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); 
  margin-top: var(--xy-space-3);
}
.service-stat { position: relative; display: flex; padding: var(--xy-space-3); align-items: center; flex-direction: column; justify-content: center; border-right: 0; }
.service-stat:not(:last-child)::after { position: absolute; top: var(--xy-inset-card); right: 0; bottom: var(--xy-inset-card); border-right: 1rpx solid var(--xy-color-divider); content: ''; }
.service-stat-value { font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.service-stat-label { margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.service-explain { margin-top: var(--xy-space-3); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.record-list { margin-top: var(--xy-space-3); overflow: hidden; border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.record-row { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: space-between; padding: var(--xy-space-2) var(--xy-space-3); border-bottom: 1rpx solid var(--xy-color-divider); }
.record-row:last-child { border-bottom: 0; }
.record-label, .record-time { display: block;  line-height: var(--xy-text-body-line-height);}
.record-label { font-size: var(--xy-text-body-size);  line-height: var(--xy-text-body-line-height);}
.record-time { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.record-value { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); }
.record-empty.xy-empty-section { padding: var(--xy-space-4) var(--xy-inset-card); }
.service-tabs { display: flex; width: 100%; gap: var(--xy-space-3); margin-top: var(--xy-space-4); overflow-x: auto; border-bottom: 0; white-space: nowrap; }
.service-tab { position: relative; display: inline-flex; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); flex: 0 0 auto; align-items: center; justify-content: flex-start; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); }
.service-tab.is-active { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); }
.service-tab.is-active::after { position: absolute; bottom: 0; left: 0; width: var(--xy-space-6); height: 2px; border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); content: ''; }
.service-list { overflow: hidden; margin-top: var(--xy-space-3); border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.service-package { position: relative; box-sizing: border-box; min-height: var(--xy-size-touch-min); padding: var(--xy-space-3) calc(var(--xy-size-touch-min) + var(--xy-button-height-standard) + var(--xy-space-4)) var(--xy-space-3) var(--xy-space-3); border-bottom: 1rpx solid var(--xy-color-divider); }
.service-package:last-child { border-bottom: 0; }
.package-head { display: flex; flex-direction: column; }
.package-title { display: block; font-size: var(--xy-text-item-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-item-title-line-height); }
.package-copy { display: block; margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.package-price-wrap { display: flex; flex-wrap: wrap; margin-top: var(--xy-space-1); gap: var(--xy-space-2); }
.package-price, .package-cost { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.package-button { position: absolute; top: 50%; right: var(--xy-space-3); display: flex; min-width: 72px; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-size); transform: translateY(-50%);  line-height: var(--xy-text-body-line-height);}
.package-button-shell { display: flex; min-width: 72px; min-height: var(--xy-button-height-standard); align-items: center; justify-content: center; box-sizing: border-box; border: 1rpx solid var(--xy-color-brand); border-radius: var(--xy-radius-md); }

.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }
