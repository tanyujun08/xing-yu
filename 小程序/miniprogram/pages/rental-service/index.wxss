/* 出租服务（设计稿 v5）：一张服务卡 = 标题+余额 / 说明 / 三档规格 / 需要粉钻 + 购买；其余样式见 shared/design/publish-flow.wxss */
.svc { padding: var(--xy-space-4); border-radius: var(--xy-pf-radius); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-raised); }
.svc__h { display: flex; align-items: baseline; justify-content: space-between; }
.svc__t { font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.svc__bal, .svc__need { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); }
.svc__b { margin: 0 var(--xy-space-0-5); color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); font-variant-numeric: tabular-nums; }
.svc__need .svc__b { margin-left: var(--xy-space-1); }
.svc__d { display: block; margin-top: var(--xy-space-0-5); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.svc__gap { margin-top: var(--xy-space-3); }
.sku { display: flex; gap: var(--xy-space-2); margin-top: var(--xy-space-3); }
.sku__i { display: flex; flex: 1; min-height: var(--xy-size-touch-min); padding: var(--xy-space-2-5) 0; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-0-5); border-radius: var(--xy-radius-md); box-shadow: inset 0 0 0 1px var(--xy-color-border); box-sizing: border-box; }
.sku__i:active { opacity: var(--xy-opacity-pressed); }
.sku__i.is-on { background: var(--xy-color-brand-soft); box-shadow: inset 0 0 0 1.5px var(--xy-color-brand); }
.sku__q { font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); }
.sku__p { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-variant-numeric: tabular-nums; }
.sku__i.is-on .sku__q, .sku__i.is-on .sku__p { color: var(--xy-color-brand); }
.svc__f { display: flex; align-items: center; margin-top: var(--xy-space-3); }
.svc__need { flex: 1; }
.svc__buy { padding: 0 var(--xy-space-5); font-size: var(--xy-text-body-size); }
.svc__buy::after { height: calc(var(--xy-pf-btn) + 4px); }
.svc__note { display: flex; align-items: center; margin-top: calc(var(--xy-space-3) * -1); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); }
.svc__note .pf-link { font-size: var(--xy-text-body-small-size); }
.svc__rec { flex: 1; min-width: 0; }
.svc__rec-t { display: block; }
