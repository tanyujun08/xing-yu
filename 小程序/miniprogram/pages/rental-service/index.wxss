/* 其余样式见 shared/design/publish-flow.wxss；规格格子：一行三个，选中为绿描边 */
.spec { position: relative; display: flex; flex: 1; min-height: var(--xy-size-touch-min); padding: var(--xy-space-3) 0; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-1); border-radius: var(--xy-radius-md); background: var(--xy-color-well); box-sizing: border-box; }
.spec.is-on { background: var(--xy-color-brand-soft); box-shadow: inset 0 0 0 2rpx var(--xy-color-brand); }
.spec__q { font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
.spec.is-on .spec__q { color: var(--xy-color-brand); }
.spec__p { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); }
