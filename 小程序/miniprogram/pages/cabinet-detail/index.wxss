@import "../../shared/design/return-flow.wxss";
@import "../../shared/design/components.wxss";
@import "../../shared/design/cabinet-flow.wxss";
.xy-discovery-icon-action { min-height: var(--xy-size-touch-min); }
.cabinet-illustration { position:absolute; left:var(--xy-space-3); bottom:var(--xy-space-3); border-radius:var(--xy-radius-pill); padding:var(--xy-space-1) var(--xy-space-2); background:var(--xy-color-surface); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); }
.cabinet-site, .cabinet-device-hint { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.cabinet-device-count { margin-left:var(--xy-space-2); color:var(--xy-color-brand); }
.cabinet-device { display:flex; min-height:var(--xy-size-touch-min); align-items:center; gap:var(--xy-space-3); padding:var(--xy-space-3) 0; border-bottom:var(--xy-divider-hairline) solid var(--xy-color-divider); }
.cabinet-device:last-child { border-bottom:0; }
.cabinet-device-media { width:96px; height:96px; flex:none; overflow:hidden; border-radius:var(--xy-radius-md); background:var(--xy-color-page); }
.cabinet-device-media media-state { display:block; width:100%; height:100%; }
.cabinet-device-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:var(--xy-space-1); overflow-wrap:anywhere; }
.cabinet-device-name { font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.cabinet-device-description, .cabinet-device-deposit { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.cabinet-device-price { display:flex; align-items:baseline; flex-wrap:wrap; color:var(--xy-color-brand); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.cabinet-device-unit { font-size:var(--xy-text-body-small-size); font-weight:var(--xy-text-weight-regular); }
.cabinet-device-arrow { flex:none; color:var(--xy-color-text-secondary); font-size:var(--xy-text-section-title-size); }
.cabinet-detail-page { min-height: 100%; box-sizing: border-box; padding: 0 var(--xy-layout-page-padding-x) var(--xy-layout-section-gap); color: var(--xy-color-text-primary); }
.cabinet-hero { display: block; width: 100%; height: auto; background: var(--xy-color-page); }
.empty-card { display: flex; align-items: center; justify-content: center; min-height: 96px; padding: var(--xy-space-3); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); text-align: center; }
.empty-card.xy-empty-page { min-height: var(--xy-empty-page-min-height); flex-direction: column; padding: var(--xy-space-4) var(--xy-inset-card); }
.empty-card.xy-empty-section { min-height: var(--xy-empty-section-min-height); flex-direction: column; padding: var(--xy-space-4) var(--xy-inset-card); }
.cabinet-detail-page--return .empty-card.xy-empty-section { padding-inline: 0; }
.cabinet-detail-page--return .xy-empty-section__title { color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); line-height: var(--xy-text-section-title-line-height); }
.cabinet-detail-page--return .xy-empty-section__copy { font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.return-actions--empty { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--xy-space-2); }
.return-actions--empty button { width: 100%; min-width: 0; min-height: var(--xy-size-touch-min); box-sizing: border-box; margin: 0; overflow-wrap: anywhere; }
.return-actions--empty .return-materials, .return-actions--empty .return-contact { grid-column: 1 / -1; }
.missing-actions { z-index: var(--xy-z-fab); }
.missing-back-button { display: flex; width: 100%; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; border-radius: var(--xy-radius-md); }

.intro-block { padding: var(--xy-space-4) 0 var(--xy-layout-card-stack-start-gap); }
.page-title { display: block; color: var(--xy-color-text-primary); font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-page-title-line-height); }
.body-copy { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.method-title-row { display: flex; min-width: 0; align-items: center; gap: var(--xy-gap-related); flex-wrap: wrap; }
.lock-badge { padding: var(--xy-space-0-5) var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-surface); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.privacy-note { margin-top: var(--xy-layout-content-gap); padding: var(--xy-inset-card); border-radius: var(--xy-radius-container); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.credential-card { margin-top: 0; }
.stage-hero { display: flex; align-items: center; flex-direction: column; justify-content: center; padding: var(--xy-layout-section-gap) var(--xy-space-4); text-align: center; }
.stage-symbol { display:flex; width:48px; height:48px; align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-page-title-size); font-weight:var(--xy-text-weight-semibold); }
.stage-symbol.is-success { background: var(--xy-color-brand); color: var(--xy-color-text-inverse); }
.stage-symbol.is-alert { border: var(--xy-divider-hairline) solid var(--xy-color-warning); background: var(--xy-color-surface); color: var(--xy-color-warning); }
.stage-spinner { width: var(--xy-size-icon-nav); height: var(--xy-size-icon-nav); border: var(--xy-divider-selected) solid var(--xy-color-brand-light); border-top-color: var(--xy-color-brand); border-radius: var(--xy-radius-circle); animation: spin .8s linear infinite; }
.stage-title { margin-top:var(--xy-space-3); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.stage-copy { max-width: 100%; margin-top: var(--xy-gap-related); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.progress-card { display:flex; flex-direction:column; gap:var(--xy-space-2); }
.progress-row { display:flex; align-items:center; gap:var(--xy-space-2); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.progress-dot { display:flex; width:20px; height:20px; flex:none; align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-divider); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.progress-row.is-active { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); }
.progress-row.is-active .progress-dot { background: var(--xy-color-brand); box-shadow: 0 0 0 var(--xy-space-1) var(--xy-color-brand-light); }
.progress-row.is-done .progress-dot { background: var(--xy-color-brand); }
.progress-row.is-error, .progress-row.is-error .progress-dot { color: var(--xy-color-danger); }
.progress-row.is-error .progress-dot { border: var(--xy-divider-hairline) solid var(--xy-color-danger); background: var(--xy-color-surface); }
.operation-card, .task-card { margin-top: var(--xy-layout-content-gap); }
.field-title { display: block; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.state-label, .media-count { color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.operation-ref { font-size: var(--xy-text-caption-size); }
.task-card .card-head { margin-bottom: 0; }
.check-row { display: flex; min-height: var(--xy-size-touch-min); align-items: flex-start; padding: var(--xy-space-3) 0; box-sizing: border-box; border-top: var(--xy-divider-hairline) solid var(--xy-color-divider); }
.check-control { width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); flex: none; margin-top: 0; }
.check-control .wx-checkbox-input { width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); margin: 0; box-sizing: border-box; border-radius: var(--xy-radius-sm); }
.check-control .wx-checkbox-input.wx-checkbox-input-checked::before { font-size: var(--xy-size-icon-base); }
.check-copy { display: flex; min-width: 0; flex-direction: column; margin-left: var(--xy-gap-group); }
.check-title { font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.check-hint, .field-hint { display: block; margin-top: var(--xy-gap-title-description); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.media-block { padding-top: var(--xy-space-4); border-top: var(--xy-divider-hairline) solid var(--xy-color-divider); }
.media-grid { display: flex; gap: var(--xy-gap-related); margin-top: var(--xy-gap-group); flex-wrap: wrap; }
.media-add, .media-thumb-wrap { width:64px; height:64px; min-height:44px; flex:0 0 64px; box-sizing:border-box; border-radius:var(--xy-radius-sm); }
.media-thumb-wrap { overflow: hidden; background: var(--xy-color-surface-subtle); }
.media-thumb { display: block; width: 100%; height: 100%; }
.media-add { display: flex; align-items: center; justify-content: center; padding: var(--xy-space-1); border: var(--xy-divider-hairline) dashed var(--xy-color-border-strong); background: var(--xy-color-surface-subtle); color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); text-align: center; }
.media-add.is-disabled { color: var(--xy-color-text-disabled); }

@keyframes spin { to { transform: rotate(360deg); } }

.cabinet-detail-page--browse { padding: 0 0 var(--xy-layout-section-gap); background: var(--xy-color-surface); }

.entity-hero { position:relative; }
.cabinet-hours { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.cabinet-view-action { color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.cabinet-detail-page--browse .xy-discovery-identity { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:var(--xy-space-2); }
.cabinet-detail-page--browse .xy-discovery-identity__title { grid-column:1 / -1; width:100%; overflow-wrap:anywhere; }
.operation-content { display:flex; flex-direction:column; }
.operation-content .task-card { order:0; }
.operation-content .operation-card { order:1; }
.operation-content .progress-card { order:2; }
.stage-hero--compact { display:grid; grid-template-columns:24px minmax(0,1fr); column-gap:var(--xy-space-3); row-gap:var(--xy-space-1); padding:var(--xy-space-4) 0; align-items:start; text-align:left; }
.stage-hero--compact .stage-symbol { grid-column:1; grid-row:1 / 3; width:24px; height:24px; }
.stage-hero--compact .stage-spinner { width:16px; height:16px; }
.stage-hero--compact .stage-title { grid-column:2; margin:0; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.stage-hero--compact .stage-copy { grid-column:2; margin:0; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.stage-failed .stage-symbol { color:var(--xy-color-danger); border-color:var(--xy-color-danger); }
@media(max-width:390px) {
  .info-row { grid-template-columns:minmax(0,1fr); row-gap:var(--xy-space-1); }
  .cabinet-detail-page--browse .xy-discovery-info { flex-wrap:wrap; gap:var(--xy-space-2); }
  .cabinet-detail-page--browse .xy-discovery-info__content { flex-basis:calc(100% - 28px); margin-left:calc(var(--xy-space-6) + var(--xy-space-1)); }
  .cabinet-detail-page--browse .xy-discovery-info__value { max-width:none; white-space:normal; overflow-wrap:anywhere; }
}
.entity-swiper { display:block; width:100%; height:50vw; max-height:240px; background:var(--xy-color-page); }
.entity-slide { display:block; width:100%; height:100%; }
.gallery-count { position:absolute; right:12px; bottom:12px; padding:calc(var(--xy-space-3) / 4) calc(var(--xy-space-3) - var(--xy-space-3) / 4); border-radius:var(--xy-radius-lg); background:var(--xy-color-gallery-counter); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }

.cabinet-detail-page--browse .xy-discovery-identity { display:flex; flex-wrap:wrap; gap:var(--xy-gap-chip-compact) calc(var(--xy-space-5) / 2); padding-top:calc(var(--xy-space-3) + var(--xy-space-1) / 2); padding-bottom:var(--xy-space-3); }
.cabinet-detail-page--browse .xy-discovery-identity__title { flex:1; width:auto; font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); }
.cabinet-detail-page--browse .cabinet-site { flex-basis:100%; }
.cabinet-hours { flex:none; padding:calc(var(--xy-space-1) / 2) var(--xy-gap-chip-compact); border-radius:var(--xy-radius-sm); background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-body-small-line-height); }
.cabinet-detail-page--browse .xy-discovery-info { min-height:54px; column-gap:calc(var(--xy-space-5) / 2); }

.media-thumb-wrap { position:relative; overflow:visible; }
.charge-photo-remove { position:absolute; top:-8px; right:-8px; display:flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; background:var(--xy-color-text-primary); color:var(--xy-color-text-inverse); font-size:var(--xy-size-icon-row); line-height:var(--xy-line-height-icon); }


.stage-cabinet_open .stage-symbol { background:var(--xy-color-surface); }

.charge-photo-remove-hit { position:absolute; top:0; right:0; width:var(--xy-size-touch-min); height:var(--xy-size-touch-min); min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); box-sizing:border-box; margin:0; padding:0; border:0; border-radius:0; background:transparent; }
.charge-photo-remove-hit::after { border:0; }

.slot-cabinet-context { display:flex; align-items:center; gap:var(--xy-space-2); }
.slot-cabinet-context image { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.slot-cabinet-context>view { min-width:0; flex:1; }
.slot-cabinet-context .return-link { font-size:var(--xy-text-body-small-size); }
.slot-heading { padding:0; }
.return-slot-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--xy-space-2); }
.return-slot { position:relative; min-height:var(--xy-return-slot-height); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:var(--xy-space-1); width:100% !important; margin:0; padding:var(--xy-space-2); border:1px solid var(--xy-color-border); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-return-line-body); }
.return-slot::after { border:0; }
.return-slot-number { font-size:var(--xy-return-title-size); font-weight:var(--xy-text-weight-semibold); }
.return-slot-grid .return-slot[disabled] { background:var(--xy-color-surface-subtle); color:var(--xy-color-text-muted); }
.return-slot-grid .return-slot.is-selected { border:2px solid var(--xy-color-brand); background:var(--xy-color-brand-light); color:var(--xy-color-brand); }
.slot-selection { margin-top:var(--xy-space-3); }

.return-slot-check { position:absolute; right:var(--xy-space-2); top:var(--xy-space-2); width:24px; height:24px; }

.slot-selection.return-note { padding:var(--xy-space-2); }
.return-slot-grid .return-slot { padding:var(--xy-space-1) var(--xy-space-2); }
