.listing-price-page {
  min-height: 100vh;
  padding: var(--xy-layout-first-block-gap-form) var(--xy-layout-page-padding-x) calc(var(--xy-fixed-bottom-clearance) + var(--xy-layout-first-block-gap-form));
  background: var(--xy-color-canvas-muted);
  color: var(--xy-color-text-primary);
}

.listing-price-card,
.price-section {
  box-sizing: border-box;
  margin-bottom: var(--xy-layout-first-block-gap-form);
  padding: var(--xy-inset-card);
  border: 0;
  border-radius: var(--xy-radius-md);
  background: var(--xy-color-surface);
  box-shadow: none;
}

.listing-summary-card { min-height: 68px; }
.price-reference-card { min-height: 102px; }
.price-settings-card { min-height: 380px; margin-bottom: 0; }

.listing-price-head {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--xy-layout-content-gap);
}

.listing-copy { min-width: 0; flex: 1; }
.listing-name {
  display: block;
  overflow: hidden;
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-section-title-size);
  font-weight: var(--xy-text-weight-bold);
  line-height: var(--xy-text-section-title-line-height);
  text-overflow: ellipsis;
  white-space: nowrap;
}
.listing-category {
  display: block;
  margin-top: var(--xy-gap-label-value-compact);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}
.approved {
  flex: none;
  padding: 0 var(--xy-space-1);
  border: 1rpx solid var(--xy-color-brand);
  border-radius: var(--xy-radius-compact);
  background: var(--xy-color-brand-light);
  color: var(--xy-color-brand);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}

.section-title {
  display: block;
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-section-title-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-section-title-line-height);
}
.guidance {
  display: flex;
  margin-top: var(--xy-layout-title-content-gap);
  min-width: 0;
  align-items: center;
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-size);
  line-height: var(--xy-text-body-line-height);
  white-space: nowrap;
}
.guidance-part { display: flex; min-width: 0; align-items: baseline; }
.guidance-label { color: var(--xy-color-text-secondary); }
.guidance-value { color: var(--xy-color-text-strong); }
.guidance-divider { width: 1rpx; height: var(--xy-text-body-line-height); margin: 0 var(--xy-space-3); flex: none; background: var(--xy-color-divider); }
.section-copy {
  display: block;
  margin-top: var(--xy-space-1);
  overflow: hidden;
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-field { margin-top: var(--xy-layout-first-block-gap-form); }
.settings-field--first { margin-top: var(--xy-layout-title-content-gap); }
.field-label {
  display: block;
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-body-size);
  line-height: var(--xy-text-body-line-height);
}
.input-wrap {
  display: flex;
  min-width: 0;
  height: var(--xy-button-height-standard);
  margin-top: var(--xy-layout-content-gap-compact);
  padding: 0 var(--xy-inset-card);
  box-sizing: border-box;
  align-items: center;
  justify-content: flex-start;
  border: 1rpx solid var(--xy-color-border);
  border-radius: var(--xy-radius-sm);
  background: var(--xy-color-control-surface);
  color: var(--xy-color-text-primary);
}
.price-entry { display: flex; width: 100%; min-width: 0; align-items: baseline; }
.price-input-cell { position: relative; display: block; min-width: 1ch; height: var(--xy-text-body-line-height); }
.price-input-cell input,
.price-measure { min-width: 1ch; margin: 0; }
.price-input-cell input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: var(--xy-text-body-line-height);
  padding: 0;
  text-align: left;
}
.price-measure { display: block; visibility: hidden; white-space: pre; }
.input-wrap .xy-price__value { font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.price-symbol { text-align: left; }
.price-unit { margin-left: auto; white-space: nowrap; }

.date-control {
  display: flex;
  height: var(--xy-fixed-bottom-height);
  margin-top: var(--xy-layout-content-gap-compact);
  padding: 0 var(--xy-inset-card);
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--xy-color-border);
  border-radius: var(--xy-radius-sm);
  background: var(--xy-color-control-surface);
}
.date-control picker { flex: 1; color: var(--xy-color-text-primary); }
.date-value-group { display: flex; flex-direction: column; align-items: flex-start; }
.date-value-group--end { align-items: flex-end; }
.date-label { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.date-value { margin-top: var(--xy-gap-label-value-compact); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.date-separator { flex: none; color: var(--xy-color-text-muted); }

.delivery-pills {
  display: flex;
  min-width: 0;
  margin-top: var(--xy-layout-content-gap-compact);
  gap: var(--xy-space-2);
  overflow: hidden;
}
.delivery-pill {
  display: flex;
  min-width: 88px;
  height: var(--xy-button-height-small);
  padding: 0 var(--xy-inset-card);
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--xy-color-border);
  border-radius: var(--xy-radius-sm);
  background: var(--xy-color-surface);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
}

.form-error {
  margin-top: var(--xy-space-2);
  padding: var(--xy-space-2) var(--xy-space-3);
  border: 1rpx solid var(--xy-color-danger);
  border-radius: var(--xy-radius-sm);
  background: var(--xy-color-surface-subtle);
  color: var(--xy-color-danger);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}
.listing-price-bottom { z-index: var(--xy-z-fab); border-top: 1rpx solid var(--xy-color-border-weak); }
.edit-button,
.confirm-button {
  height: var(--xy-control-height-standard);
  min-height: var(--xy-control-height-standard);
  flex: 1;
  border-radius: var(--xy-radius-sm);
  font-size: var(--xy-text-section-title-size);
}
.edit-button { border-color: var(--xy-color-border); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); }
.confirm-button { background: var(--xy-color-brand); }
.confirm-button.is-disabled { background: var(--xy-color-disabled); }

.missing-card {
  padding: var(--xy-inset-card);
  border: 0;
  border-radius: var(--xy-radius-md);
  background: var(--xy-color-surface);
  box-shadow: none;
  text-align: center;
}
.missing-card.xy-empty-page { padding: var(--xy-space-4) var(--xy-inset-card); }
.missing-title { display: block; color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.missing-copy { display: block; margin-top: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.missing-actions { z-index: var(--xy-z-fab); }
.missing-back-button { display: flex; width: 100%; min-height: var(--xy-control-height); align-items: center; justify-content: center; border-radius: var(--xy-radius-md); }

.edit-button, .confirm-button { position:relative; }

.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }
