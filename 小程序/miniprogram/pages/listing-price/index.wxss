/* 设价上架（设计稿 v5，只换样式）：设备卡 + 出租条件卡（卡内标题）；租金押金行内输入，右对齐。通用样式见 shared/design/publish-flow.wxss */
.listing-price-page { gap: var(--xy-space-3); }
.lp-after { margin-top: calc(var(--xy-space-1) * -1); }
.lp-pd { display: flex; align-items: center; gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-space-3) var(--xy-space-3) var(--xy-space-4); }
.lp-pic { display: flex; flex: none; width: var(--xy-pf-pic); height: var(--xy-pf-pic); align-items: center; justify-content: center; border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.lp-pic image { width: var(--xy-size-icon-lg); height: var(--xy-size-icon-lg); opacity: .6; }
.lp-pd__b { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.lp-pd__t { overflow: hidden; font-weight: var(--xy-text-weight-semibold); text-overflow: ellipsis; white-space: nowrap; }
.lp-pd__s { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.lp-val { display: flex; flex: 1; min-width: 0; align-items: center; justify-content: flex-end; gap: var(--xy-space-0-5); padding-right: calc(var(--xy-size-icon-base) + var(--xy-space-3)); }
.lp-input { flex: 1; min-width: 0; height: var(--xy-pf-row); text-align: right; font-size: var(--xy-row-text-size); font-weight: var(--xy-text-weight-medium); font-variant-numeric: tabular-nums; }
.lp-unit { flex: none; font-weight: var(--xy-text-weight-medium); }
.lp-ph { color: var(--xy-color-text-disabled); font-weight: var(--xy-text-weight-regular); }
.lp-v { font-weight: var(--xy-text-weight-medium); }
.lp-error { padding: var(--xy-space-3) var(--xy-space-4); border-radius: var(--xy-radius-md); background: var(--xy-color-key-warning-soft); color: var(--xy-color-key-warning); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-line-height); }
.is-disabled { opacity: .5; }
.lp-pad { padding-right: calc(var(--xy-size-icon-base) + var(--xy-space-3)); }
