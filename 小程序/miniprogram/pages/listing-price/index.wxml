<page-meta root-font-size="system" />
<view class="pf-page pf-page--bar listing-price-page">
  <page-header title="{{secondaryNavigationTitle || '设价上架'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <status-view wx:if="{{!loggedIn}}" state="empty" title="登录后设置发布价格" action-text="去登录" bindaction="openLogin" />
  <status-view wx:elif="{{loading}}" state="loading" title="正在读取发布草稿" />
  <status-view wx:elif="{{!listing && hasDraftTarget}}" state="error" title="发布草稿暂不可用" description="{{errorText || '请重新读取当前草稿。'}}" action-text="重新读取草稿" bindaction="handleErrorAction" />
  <status-view wx:elif="{{!listing}}" state="error" title="发布草稿暂不可用" description="{{errorText || '请从发布页重新进入。'}}" action-text="返回发布页" bindaction="goBack" />
  <block wx:else>
    <view class="pf-sum">
      <view class="pf-sum__t"><view class="pf-dot {{editable ? 'is-warn' : ''}}" /><text>{{listing.name}}</text></view>
      <text class="pf-sum__s">{{listing.category}} · {{editable ? '待提交' : '只读'}}</text>
    </view>

    <view class="pf-block">
      <text class="pf-gt">价格设置</text>
      <view class="pf-cd">
        <view class="pf-row"><text class="pf-row__k pf-row__k--ink">{{priceUnitLabel}}</text><text class="lp-unit">¥</text><input class="lp-input" type="digit" maxlength="20" data-field="rent" value="{{rent}}" placeholder="请输入" disabled="{{!editable || pendingUpdate || pendingSubmit}}" aria-disabled="{{!editable || pendingUpdate || pendingSubmit}}" bindinput="input" /><text class="lp-unit">{{priceUnitSuffix}}</text></view>
        <view class="pf-row"><text class="pf-row__k pf-row__k--ink">押金</text><text class="lp-unit">¥</text><input class="lp-input" type="digit" maxlength="20" data-field="deposit" value="{{deposit}}" placeholder="请输入" disabled="{{!editable || pendingUpdate || pendingSubmit}}" aria-disabled="{{!editable || pendingUpdate || pendingSubmit}}" bindinput="input" /></view>
        <picker mode="date" value="{{availabilityStart}}" start="{{availabilityStart}}" disabled="{{!editable || pendingUpdate || pendingSubmit}}" bindchange="changeStartDate"><view class="pf-row" role="button"><text class="pf-row__k pf-row__k--ink">开始时间</text><text class="pf-row__v {{availabilityStartLabel ? '' : 'is-muted'}}">{{availabilityStartLabel || '请选择'}}</text><image class="pf-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view></picker>
        <picker mode="date" value="{{availabilityEnd}}" start="{{availabilityStart}}" disabled="{{!editable || pendingUpdate || pendingSubmit}}" bindchange="changeEndDate"><view class="pf-row" role="button"><text class="pf-row__k pf-row__k--ink">结束时间</text><text class="pf-row__v {{availabilityEndLabel ? '' : 'is-muted'}}">{{availabilityEndLabel || '请选择'}}</text><image class="pf-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view></picker>
        <view class="pf-row"><text class="pf-row__k pf-row__k--ink">交付方式</text><text class="pf-row__v">{{deliveryItems.length ? deliveryText : (deliveryText || '未设置')}}</text></view>
      </view>
      <text class="pf-fnote">{{guidanceText}}</text>
    </view>

    <text wx:if="{{noticeText}}" class="pf-fnote">{{noticeText}}</text>
    <view wx:if="{{errorText}}" class="lp-error" role="alert">{{errorText}}</view>
    <view class="xy-bottom-action pf-foot">
      <view class="xy-action-secondary {{submitting || pendingUpdate || pendingSubmit ? 'is-disabled' : ''}}" bindtap="edit" role="button" aria-disabled="{{submitting || pendingUpdate || pendingSubmit}}" aria-label="返回修改">返回修改</view>
      <view class="xy-action-primary {{submitting || (!editable && !pendingUpdate && !pendingSubmit) ? 'is-disabled' : ''}}" bindtap="confirm" role="button" aria-disabled="{{submitting || (!editable && !pendingUpdate && !pendingSubmit)}}" aria-label="{{submitting ? '处理中' : primaryActionText}}">{{submitting ? '处理中…' : primaryActionText}}</view>
    </view>
  </block>
</view>
<login-sheet id="login-sheet" bindwechatlogin="onWechatLogin" bindphonelogin="onPhoneLogin" bindlegal="onLoginLegal" />
