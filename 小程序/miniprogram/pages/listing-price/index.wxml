<page-meta root-font-size="system" />
<view class="pf-page pf-page--bar listing-price-page">
  <page-header title="{{secondaryNavigationTitle || '设价上架'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <status-view wx:if="{{!loggedIn}}" state="empty" title="登录后设置发布价格" action-text="去登录" bindaction="openLogin" />
  <status-view wx:elif="{{loading}}" state="loading" title="正在读取发布草稿" />
  <status-view wx:elif="{{!listing && hasDraftTarget}}" state="error" title="发布草稿暂不可用" description="{{errorText || '请重新读取当前草稿。'}}" action-text="重新读取草稿" bindaction="handleErrorAction" />
  <status-view wx:elif="{{!listing}}" state="error" title="发布草稿暂不可用" description="{{errorText || '请从发布页重新进入。'}}" action-text="返回发布页" bindaction="goBack" />
  <block wx:else>
    <view class="pf-cd">
      <view class="lp-pd">
        <view class="lp-pic"><image src="{{icons.profileRentalCamera}}" mode="aspectFit" /></view>
        <view class="lp-pd__b"><text class="lp-pd__t">{{listing.name}}</text><text class="lp-pd__s">{{priceUnitLabel === '日租金' ? '按天计费' : '按小时计费'}}</text></view>
        <text class="pf-chip {{editable ? 'pf-chip--o' : 'pf-chip--n'}}">{{editable ? '待提交' : '只读'}}</text>
      </view>
    </view>

    <view class="pf-cd">
      <view class="pf-ch"><text class="pf-ch__t">出租条件</text></view>
      <view class="pf-row"><text class="pf-row__k">{{priceUnitLabel}}</text><view class="lp-val"><input class="lp-input" type="digit" maxlength="20" data-field="rent" value="{{rent}}" placeholder="请输入" placeholder-class="lp-ph" disabled="{{!editable || pendingUpdate || pendingSubmit}}" aria-disabled="{{!editable || pendingUpdate || pendingSubmit}}" aria-label="{{priceUnitLabel}}" bindinput="input" /><text class="lp-unit">{{priceUnitSuffix}}</text></view></view>
      <view class="pf-row"><text class="pf-row__k">押金</text><view class="lp-val"><input class="lp-input" type="digit" maxlength="20" data-field="deposit" value="{{deposit}}" placeholder="请输入" placeholder-class="lp-ph" disabled="{{!editable || pendingUpdate || pendingSubmit}}" aria-disabled="{{!editable || pendingUpdate || pendingSubmit}}" aria-label="押金" bindinput="input" /></view></view>
      <picker mode="date" value="{{availabilityStart}}" start="{{availabilityStart}}" disabled="{{!editable || pendingUpdate || pendingSubmit}}" bindchange="changeStartDate"><view class="pf-row" role="button" aria-label="选择可租开始日期"><text class="pf-row__k">可租开始</text><text class="pf-row__v lp-v {{availabilityStartLabel ? '' : 'is-muted'}}">{{availabilityStart || availabilityStartLabel || '请选择'}}</text><image class="pf-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view></picker>
      <picker mode="date" value="{{availabilityEnd}}" start="{{availabilityStart}}" disabled="{{!editable || pendingUpdate || pendingSubmit}}" bindchange="changeEndDate"><view class="pf-row" role="button" aria-label="选择可租截止日期"><text class="pf-row__k">可租截止</text><text class="pf-row__v lp-v {{availabilityEndLabel ? '' : 'is-muted'}}">{{availabilityEnd || availabilityEndLabel || '请选择'}}</text><image class="pf-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view></picker>
      <view class="pf-row"><text class="pf-row__k">交付方式</text><text class="pf-row__v lp-v lp-pad">{{deliveryItems.length ? deliveryText : (deliveryText || '未设置')}}</text></view>
    </view>
    <text class="pf-fnote lp-after">{{guidanceText}}</text>

    <text wx:if="{{noticeText}}" class="pf-fnote">{{noticeText}}</text>
    <view wx:if="{{errorText}}" class="lp-error" role="alert">{{errorText}}</view>
    <view class="xy-bottom-action pf-foot">
      <view class="xy-action-secondary pf-foot__s {{submitting || pendingUpdate || pendingSubmit ? 'is-disabled' : ''}}" bindtap="edit" role="button" aria-disabled="{{submitting || pendingUpdate || pendingSubmit}}" aria-label="返回修改">返回修改</view>
      <view class="xy-action-primary {{submitting || (!editable && !pendingUpdate && !pendingSubmit) ? 'is-disabled' : ''}}" bindtap="confirm" role="button" aria-disabled="{{submitting || (!editable && !pendingUpdate && !pendingSubmit)}}" aria-label="{{submitting ? '处理中' : primaryActionText}}">{{submitting ? '处理中…' : primaryActionText}}</view>
    </view>
  </block>
</view>
<login-sheet id="login-sheet" bindwechatlogin="onWechatLogin" bindphonelogin="onPhoneLogin" bindlegal="onLoginLegal" />
