<page-meta root-font-size="system" />
<page-shell surface="page" has-footer="{{false}}"><page-header title="发布额度" bindback="onSecondaryNavigationBack" slot="header" />
<view class="pf-page">
 <view wx:if="{{!loggedIn}}" class="pf-sum">
  <text class="pf-sum__t">登录后查看本人发布额度</text>
  <view class="pf-btn pf-btn--p quota-login" bindtap="openLogin" role="button">去登录</view>
 </view>
 <block wx:else>
  <view class="pf-sum">
   <text class="pf-k">可用发布额度</text>
   <view class="pf-n"><text class="pf-n__v">{{available}}</text><text class="pf-n__u">次</text></view>
   <view class="pf-sum__f"><text>已用<text>{{used}}</text>次</text><text>共发放<text>{{total}}</text>次</text><text>粉钻<text>{{diamondBalance}}</text></text></view>
   <view class="pf-row pf-tap quota-coupons" style="margin:var(--xy-space-3) calc(var(--xy-space-4) * -1) calc(var(--xy-space-4) * -1)" bindtap="openCoupons" role="button">
    <text class="pf-row__k pf-row__k--ink">发布一次券</text><text class="pf-row__v is-muted">1 张兑换 1 次</text><view class="pf-btn pf-btn--s">查看可用券</view>
   </view>
  </view>

  <status-view wx:if="{{loading}}" state="loading" title="正在读取发布额度" />
  <status-view wx:if="{{errorText}}" state="error" title="额度信息读取失败" description="{{errorText}}" action-text="重新读取" bindaction="refresh" />

  <view wx:if="{{pendingText}}" class="pf-cd"><view class="pf-row"><text class="pf-row__k pf-row__k--ink" style="flex:1">{{pendingText}}</text><view class="pf-btn pf-btn--s quota-pending" bindtap="openPendingCoupon" role="button">查询原券</view></view></view>

  <view wx:if="{{detail}}" class="pf-cd quota-movement-detail">
   <view class="pf-row"><text class="pf-row__k pf-row__k--ink">{{detail.title}}</text><text class="pf-row__v">{{detail.quantity}} 次</text></view>
   <view class="pf-row"><text class="pf-row__k">当时可用</text><text class="pf-row__v">{{detail.before}} → {{detail.after}}</text></view>
   <view class="pf-row"><text class="pf-row__k">时间</text><text class="pf-row__v">{{detail.time}}</text></view>
   <view wx:if="{{detail.redemptionId}}" class="pf-row pf-tap quota-movement-source" bindtap="openRedemptionSource" role="button"><text class="pf-row__k pf-row__k--ink">查看兑换来源</text><text class="pf-row__v" /></view>
  </view>

  <view class="pf-block">
   <text class="pf-gt">额度流水</text>
   <status-view wx:if="{{listState.phase === 'initial-loading'}}" state="loading" title="正在读取流水" /><status-view wx:elif="{{listState.phase === 'initial-error'}}" state="error" title="流水读取失败" action-text="重试" bindaction="retryMovements" />
   <text wx:elif="{{listState.phase === 'empty'}}" class="pf-fnote">暂无额度流水</text>
   <view wx:else class="pf-cd">
    <view wx:for="{{items}}" wx:key="id" class="pf-row pf-tap quota-movement" data-id="{{item.id}}" bindtap="openMovement" role="button">
     <view style="flex:1;min-width:0"><text style="display:block">{{item.title}}</text><text class="pf-k">{{item.time}}</text></view>
     <text style="font-variant-numeric:tabular-nums">{{item.quantity}}</text><image class="pf-arrow" src="/assets/figma-icons/arrow-right.svg" mode="aspectFit" />
    </view>
   </view>
   <status-view wx:if="{{listState.incremental === 'load-more-error'}}" state="error" density="compact-footer" title="加载失败" action-text="重试" bindaction="retryMore" /><status-view wx:elif="{{listState.incremental === 'done'}}" state="end" density="compact-footer" title="已显示全部流水" />
  </view>

  <view class="pf-block">
   <text class="pf-gt">券兑换记录</text>
   <status-view wx:if="{{redemptionListState.phase === 'initial-loading'}}" state="loading" title="正在读取兑换记录" /><status-view wx:elif="{{redemptionListState.phase === 'initial-error'}}" state="error" title="兑换记录读取失败" action-text="重试" bindaction="retryRedemptions" />
   <text wx:elif="{{redemptionListState.phase === 'empty'}}" class="pf-fnote">暂无兑换记录</text>
   <view wx:else class="pf-cd">
    <view wx:for="{{redemptions}}" wx:key="id" class="pf-row pf-tap quota-redemption" data-id="{{item.id}}" bindtap="openRedemption" role="button">
     <view style="flex:1;min-width:0"><text style="display:block">{{item.title}}</text><text class="pf-k">{{item.time}}</text></view>
     <text class="pf-link">查看原券</text>
    </view>
   </view>
   <status-view wx:if="{{redemptionListState.incremental === 'load-more-error'}}" state="error" density="compact-footer" title="加载失败" action-text="重试" bindaction="retryMore" /><status-view wx:elif="{{redemptionListState.incremental === 'done'}}" state="end" density="compact-footer" title="已显示全部记录" />
  </view>
 </block>
</view></page-shell>
<login-sheet id="login-sheet" bindwechatlogin="onWechatLogin" bindphonelogin="onPhoneLogin" bindlegal="onLoginLegal" />
