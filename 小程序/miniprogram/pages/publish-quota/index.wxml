<page-meta root-font-size="system" />
<page-shell surface="page" has-footer="{{false}}"><page-header title="发布额度" bindback="onSecondaryNavigationBack" slot="header" />
<view class="quota-page">
 <view wx:if="{{!loggedIn}}" class="quota-summary"><text class="summary-label">登录后查看本人发布额度</text><button class="quota-button xy-button-reset" bindtap="openLogin">去登录</button></view>
 <block wx:else>
 <view class="quota-summary"><text class="summary-label">可用发布额度</text><text class="summary-number">{{available}}</text><view class="summary-foot"><text>已用 {{used}} 次 / 共发放 {{total}} 次</text><text>粉钻 {{diamondBalance}}</text></view></view>
 <status-view wx:if="{{loading}}" state="loading" title="正在读取发布额度" />
 <status-view wx:if="{{errorText}}" state="error" title="额度信息读取失败" description="{{errorText}}" action-text="重新读取" bindaction="refresh" />
 <view class="quota-list"><view class="quota-card"><view class="quota-card-content"><text class="quota-title">发布一次券</text><text class="quota-copy">可用发布券可兑换 1 次额度；成功后查看兑换明细。</text></view><button class="quota-button quota-coupons xy-button-reset" bindtap="openCoupons">查看可用券</button></view><view wx:if="{{pendingText}}" class="quota-card"><text class="quota-copy">{{pendingText}}</text><button class="quota-button quota-pending xy-button-reset" bindtap="openPendingCoupon">查询原券</button></view></view>
 <view wx:if="{{detail}}" class="quota-list quota-movement-detail"><view class="quota-card"><view class="quota-card-content"><text class="quota-title">{{detail.title}} {{detail.quantity}} 次</text><text class="quota-copy">当时可用 {{detail.before}} → {{detail.after}}</text><text class="quota-copy">{{detail.time}}</text></view><button wx:if="{{detail.redemptionId}}" class="quota-button quota-movement-source xy-button-reset" bindtap="openRedemptionSource">查看兑换来源</button></view></view>
 <view class="quota-list"><view class="quota-card"><text class="quota-title">额度流水</text></view><status-view wx:if="{{listState.phase === 'initial-loading'}}" state="loading" title="正在读取流水" /><status-view wx:elif="{{listState.phase === 'initial-error'}}" state="error" title="流水读取失败" action-text="重试" bindaction="retryMovements" /><status-view wx:elif="{{listState.phase === 'empty'}}" state="empty" title="暂无额度流水" />
 <button wx:for="{{items}}" wx:key="id" class="quota-card quota-movement xy-button-reset" data-id="{{item.id}}" bindtap="openMovement"><view class="quota-card-content"><text class="quota-title">{{item.title}} · {{item.quantity}}</text><text class="quota-copy">{{item.time}}</text></view><text>查看明细</text></button>
 <status-view wx:if="{{listState.incremental === 'load-more-error'}}" state="error" density="compact-footer" title="加载失败" action-text="重试" bindaction="retryMore" /><status-view wx:elif="{{listState.incremental === 'done'}}" state="end" density="compact-footer" title="已显示全部流水" /></view>
 <view class="quota-list"><view class="quota-card"><text class="quota-title">券兑换记录</text></view><status-view wx:if="{{redemptionListState.phase === 'initial-loading'}}" state="loading" title="正在读取兑换记录" /><status-view wx:elif="{{redemptionListState.phase === 'initial-error'}}" state="error" title="兑换记录读取失败" action-text="重试" bindaction="retryRedemptions" /><status-view wx:elif="{{redemptionListState.phase === 'empty'}}" state="empty" title="暂无兑换记录" />
 <button wx:for="{{redemptions}}" wx:key="id" class="quota-card quota-redemption xy-button-reset" data-id="{{item.id}}" bindtap="openRedemption"><view class="quota-card-content"><text class="quota-title">{{item.title}}</text><text class="quota-copy">{{item.time}}</text></view><text>查看原券</text></button>
 <status-view wx:if="{{redemptionListState.incremental === 'load-more-error'}}" state="error" density="compact-footer" title="加载失败" action-text="重试" bindaction="retryMore" /><status-view wx:elif="{{redemptionListState.incremental === 'done'}}" state="end" density="compact-footer" title="已显示全部记录" /></view>
 </block>
</view></page-shell>
