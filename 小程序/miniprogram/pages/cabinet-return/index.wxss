/* 入柜归还（方向 H）：步骤条 → 状态头 → 柜格与凭证 → 三步说明/入柜照片 → 底栏 客服 + 次 + 主 */
.cr-page { padding-bottom: var(--xy-space-6); }
.cr-wide { max-width: 64%; }
.cr-ok { color: var(--xy-color-brand); }
.cr-warn { color: var(--xy-color-key-warning); font-weight: var(--xy-text-weight-semibold); }
.cr-body { display: block; font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); overflow-wrap: anywhere; }
.cr-num { flex: none; display: flex; align-items: center; justify-content: center; width: var(--xy-space-5); height: var(--xy-space-5); border-radius: var(--xy-radius-circle); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-row-caption-size); font-weight: var(--xy-text-weight-semibold); }
.cr-example { position: relative; min-height: var(--xy-size-touch-min); height: calc(var(--xy-space-6) * 7); margin: var(--xy-space-4) 0 var(--xy-space-2); border-radius: var(--xy-radius-md); overflow: hidden; }
.cr-example image { display: block; width: 100%; height: 100%; }
.cr-example__tag { position: absolute; left: var(--xy-space-2); top: var(--xy-space-2); padding: 0 var(--xy-space-2); border-radius: var(--xy-radius-sm); background: var(--xy-color-scrim-badge); color: var(--xy-color-text-inverse); font-size: var(--xy-text-caption-size); line-height: var(--xy-row-caption-line-height); }
.cr-example + .xy-h-row { border-top: 0; }
