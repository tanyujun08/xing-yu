.address-page { padding:var(--xy-space-3) var(--xy-space-4) var(--xy-space-4); color:var(--xy-color-text-primary); }
.address-intro { margin-bottom:var(--xy-space-3); }
.address-intro > text:first-child { display:block; font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.address-intro > text:last-child { display:block; margin-top:var(--xy-space-1); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-text-secondary); }
.address-card { padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.address-card + .address-card { margin-top:var(--xy-space-3); }
.address-person { display:flex; align-items:baseline; flex-wrap:wrap; gap:var(--xy-space-1) var(--xy-space-2); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.address-person > text:first-child { font-weight:var(--xy-text-weight-semibold); }
.address-person > text:nth-child(2) { color:var(--xy-color-text-secondary); }
.default-chip { padding:0 var(--xy-space-1); border-radius:var(--xy-radius-sm); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); color:var(--xy-color-brand); background:var(--xy-color-brand-light); }
.address-line { display:block; margin-top:var(--xy-space-1); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); overflow-wrap:anywhere; }
.actions-spacer { flex:1; }
.address-error { display:block; margin-top:var(--xy-space-2); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-danger); }
.address-page { padding-top:var(--xy-space-4); }
.address-intro > text:first-child { font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-regular); }
.address-phone { white-space:nowrap; }
.default-chip { font-size:var(--xy-text-micro-size); }
.address-actions { display:flex; align-items:center; gap:var(--xy-space-6); margin-top:var(--xy-space-4); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-line-height); color:var(--xy-color-text-secondary); }
.address-actions > .address-action { position:relative; display:block; min-height:0; line-height:var(--xy-text-body-line-height); }

.address-actions > .address-action:last-child { color:var(--xy-color-danger); }

/* Keep the existing visual carrier; constrain only its interaction box. */
.address-card { box-sizing:border-box; min-height:var(--xy-size-touch-min); }

.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }
