/* 重设计 第 1 批：地址卡（姓名电话 + 默认标签 / 地址 / 右侧编辑）；卡尾只留“默认地址”单选和“删除”；选择模式左侧单选圈 */
.address-page { padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); color: var(--xy-color-text-primary); }
.address-intro { display: block; margin-bottom: var(--xy-space-3); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.address-card { box-sizing: border-box; min-height: var(--xy-size-touch-min); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.address-card + .address-card { margin-top: var(--xy-space-3); }
.address-card--select:active { background: var(--xy-color-surface-subtle); }
.address-card.is-picked { box-shadow: inset 0 0 0 1.5px var(--xy-color-brand); }
.address-main { display: flex; align-items: center; gap: var(--xy-space-3); padding: var(--xy-space-4) var(--xy-space-4) var(--xy-space-3); }
.address-card--select .address-main { padding-bottom: var(--xy-space-4); }
.address-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-1); }
.address-person { display: flex; align-items: center; flex-wrap: wrap; gap: var(--xy-space-1) var(--xy-space-2); }
.address-name { color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.address-phone { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); font-variant-numeric: tabular-nums; line-height: var(--xy-text-body-line-height); white-space: nowrap; }
.default-chip { display: inline-flex; height: 20px; align-items: center; padding: 0 var(--xy-space-1-5); border-radius: var(--xy-radius-sm); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-caption-line-height); }
.address-line { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; }
.address-edit { position: relative; flex: none; align-self: flex-start; padding: var(--xy-space-0-5) 0 var(--xy-space-0-5) var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.radio { flex: none; width: calc(var(--xy-space-4) + var(--xy-space-0-5)); height: calc(var(--xy-space-4) + var(--xy-space-0-5)); box-sizing: border-box; border: 1.5px solid var(--xy-color-border); border-radius: var(--xy-radius-circle); }
.radio.is-on { border: 5px solid var(--xy-color-brand); }
.address-actions { position: relative; display: flex; min-height: var(--xy-size-touch-min); align-items: center; padding: 0 var(--xy-space-4); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.address-actions::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.address-default { position: relative; display: flex; align-items: center; gap: var(--xy-space-2); color: var(--xy-color-text-primary); }
.address-actions > .address-action { position: relative; }
.actions-spacer { flex: 1; }
.address-action + .address-action { margin-left: var(--xy-space-5); }
.address-error { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.touch-overlay { position: absolute; left: 50%; top: 50%; width: 100% !important; height: 100%; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); transform: translate(-50%,-50%); box-sizing: border-box; padding: 0; margin: 0; border: 0; border-radius: 0; background: transparent; }
.touch-overlay::after { border: 0; }
