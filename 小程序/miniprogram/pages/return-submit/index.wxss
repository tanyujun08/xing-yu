@import "../../shared/design/return-flow.wxss";
.card-title { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.card-copy,.error-copy { display:block; margin-top:var(--xy-space-2); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.error-copy { color:var(--xy-color-danger); }
.detail-input,.detail-textarea { box-sizing:border-box; width:100%; min-height:var(--xy-size-touch-min); margin:var(--xy-space-3) 0; padding:var(--xy-space-2) var(--xy-space-3); border:1px solid var(--xy-color-border); border-radius:var(--xy-radius-md); background:var(--xy-color-surface-subtle); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.detail-textarea { min-height:calc(var(--xy-size-touch-min) * 2); }

.evidence-product { display:flex; align-items:center; gap:var(--xy-space-3); min-height:60px; }
.evidence-product image { flex:none; width:88px; height:56px; border-radius:var(--xy-radius-md); }
.evidence-product>view { min-width:0; flex:1; }
.card-title { overflow-wrap:anywhere; }
.evidence-summary { display:flex; justify-content:space-between; gap:var(--xy-space-2); align-items:center; flex-wrap:nowrap; margin-top:var(--xy-space-3); font-size:var(--xy-text-page-title-size); font-weight:var(--xy-text-weight-semibold); }
.ready-count { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); display:flex; flex:none; gap:var(--xy-space-1); align-items:baseline; }
.ready-count>text:first-child { font-size:var(--xy-text-caption-size); font-weight:var(--xy-text-weight-regular); color:var(--xy-color-text-muted); }
.ready-number { font-size:var(--xy-return-title-size); }
.evidence-content { margin-top:var(--xy-space-2); }
.example-page { position:fixed; inset:0; z-index:var(--xy-z-modal); overflow-y:auto; background:var(--xy-color-page); }
.example-heading { display:flex; justify-content:space-between; align-items:center; }
.example-count { padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-lg); background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-section-title-size); }
.example-image { display:block; height:440px; min-height:0; width:100%; background:var(--xy-color-surface); border-radius:var(--xy-radius-lg); }
.example-video { width:100%; height:260px; border-radius:var(--xy-radius-lg); }
.example-navigation { display:grid; grid-template-columns:1fr 1fr; gap:var(--xy-space-3); }

.evidence-product { position:relative; padding-bottom:var(--xy-space-2); }
.evidence-product>.ready-count { position:absolute; right:0; bottom:var(--xy-space-1); }
.evidence-product .card-copy { padding-right:calc(var(--xy-space-4) + var(--xy-space-4) + var(--xy-space-4) + var(--xy-space-4)); }

.example-step { display:flex; gap:var(--xy-space-3); align-items:center; padding:var(--xy-space-2); margin-top:var(--xy-space-2); border-radius:var(--xy-radius-md); background:var(--xy-color-surface-subtle); font-size:var(--xy-text-body-small-size); line-height:var(--xy-return-line-body); }
.example-step-number { display:flex; flex:none; align-items:center; justify-content:center; width:24px; height:24px; border-radius:var(--xy-radius-circle); color:var(--xy-color-brand); background:var(--xy-color-brand-light); }
.example-step image,.example-page .return-actions image { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); flex:none; }
.example-page .return-actions button { gap:var(--xy-space-2); }
.example-page .return-primary image { filter:brightness(0) invert(1); }
.example-photo-steps .example-step { background:transparent; margin-top:0; padding:var(--xy-space-1) 0; }
/* 归还凭证（2026-11-12 设计稿第二版） */
.rs-head { display: flex; align-items: center; justify-content: space-between; gap: var(--xy-space-2); }
.rs-head__title { display: block; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); font-weight: var(--xy-text-weight-semibold); }
.rs-head__count { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.rs-head__count.is-ready { color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.rs-ship .rs-well { margin: var(--xy-space-3) 0 0; }
.rs-ship .rs-row { width: 100%; margin: 0; padding: 0; background: transparent; }
.rs-ship .rs-row + .rs-row { border-top: 1rpx solid var(--xy-color-hairline); }
.rs-ship .rs-well + .rs-row { margin-top: var(--xy-space-1); }
.rs-ok { color: var(--xy-color-brand); }
.rs-input { flex: 1; min-width: 0; min-height: var(--xy-size-touch-min); text-align: right; color: var(--xy-color-text-primary); font-size: var(--xy-row-text-size); }
.rs-placeholder { color: var(--xy-color-text-muted); }
.rs-label { margin-top: var(--xy-space-2); }
.rs-notes { display: flex; flex-direction: column; gap: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); line-height: var(--xy-row-caption-line-height); }
.return-actions.rs-footer { flex-direction: row; align-items: center; gap: var(--xy-space-3); }
.return-actions.rs-footer .return-primary, .return-actions.rs-footer .return-secondary { flex: 1; min-width: 0; width: auto !important; }
.return-actions.rs-footer .rs-kf { flex: none; width: auto !important; min-height: var(--xy-size-touch-min); background: transparent; border: 0; padding: 0; margin: 0; }
.return-actions.rs-footer .rs-kf { flex-direction: column; gap: 0; color: var(--xy-color-text-primary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-weight: var(--xy-text-weight-semibold); }
.rs-well .xa-well__title { font-weight: var(--xy-text-weight-medium); }
