<page-meta root-font-size="system" />
<view class="return-theme">
<page-shell surface="page" fixed-header has-footer>
  <page-header variant="return" title="{{recordOnly ? '归还记录' : supplementing ? '补交归还材料' : isAfterOpen ? '入柜摆放照片' : '归还凭证'}}" slot="header" bindback="onSecondaryNavigationBack" />
  <view class="xy-h-page rs-page">
    <view wx:if="{{!recordOnly && !supplementing}}" class="xy-h-steps" aria-label="归还进度"><view class="xy-h-step {{isAfterOpen ? 'is-done' : 'is-current'}}"><view class="xy-h-step__dot"></view><text>拍照留证</text></view><view class="xy-h-step {{isAfterOpen ? 'is-current' : ''}}"><view class="xy-h-step__dot"></view><text>{{method === 'CABINET' ? '入柜归还' : '寄回设备'}}</text></view><view class="xy-h-step"><view class="xy-h-step__dot"></view><text>核验结果</text></view></view>
    <view wx:if="{{loading}}" class="xy-h-blk xy-h-blk--pad xy-h-note" role="status">正在读取归还信息…</view>
    <view wx:if="{{errorText}}" class="xy-h-blk">
      <text class="xy-h-inote xy-h-alert" role="alert">{{errorText}}</text>
      <button class="xy-h-link xy-action-hit" bindtap="refresh" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}"><text class="xy-h-link__k">查询最新记录</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
      <button class="xy-h-link xy-action-hit" bindtap="demoSupport"><text class="xy-h-link__k">联系客服</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
    </view>
    <block wx:if="{{loaded}}">
      <status-hero wx:if="{{recordOnly}}" tone="neutral" art="contract" title="归还记录" description="实际收回：{{received || '暂无记录'}}。可查看本单已保存的照片、视频与补交历史。" />
      <status-hero wx:elif="{{supplementing}}" tone="orange" art="shield" title="补交归还材料" description="实际收回：{{received}}。按要求补充或更换，已有材料会保留。" />
      <view class="xy-h-blk rs-product">
        <image wx:if="{{media}}" class="rs-product__media" src="{{media}}" mode="aspectFit" />
        <view class="rs-product__copy"><text class="rs-product__title">{{title}}</text><text class="xy-h-row__sub">{{isAfterOpen ? '关门前拍清设备与全部配件' : photoCount + ' 张照片 + ' + videoCount + ' 段视频'}}</text></view>
        <view wx:if="{{!recordOnly && !isAfterOpen}}" class="rs-ready"><text class="rs-ready__num {{canProceed ? 'is-done' : ''}}">{{readyCount}}/{{totalCount}}</text><text class="xy-h-row__sub">已就绪</text></view>
      </view>
      <view wx:if="{{missing.length}}" class="xy-h-blk"><text wx:for="{{missing}}" wx:key="key" class="xy-h-inote xy-h-alert" role="alert">{{item.text}}</text></view>
      <return-evidence-grid focus-key="{{focusKey}}" tiles="{{tiles}}" busy="{{busy}}" read-only="{{recordOnly}}" single="{{isAfterOpen && !recordOnly && !supplementing}}" album-only="{{isAfterOpen}}" bindselect="selectEvidence" bindpreview="previewEvidence" bindexample="showExample" bindrecover="recoverEvidence" class="{{isAfterOpen && !recordOnly && !supplementing ? 'rs-single' : ''}}" />
      <text wx:if="{{recordOnly}}" class="xy-h-note">{{tiles.length ? '点击照片或视频查看原凭证' : '暂无已保存的归还凭证'}}</text>
      <text wx:elif="{{supplementing}}" class="xy-h-note">{{pendingCount ? '材料上传或保存尚未完成，请查看原请求进度。' : missing.length ? '请按缺项说明继续补交，费用仍以官方核定为准。' : '已保存的材料以订单审核进度为准，请返回订单查看。'}}</text>
      <text wx:elif="{{isAfterOpen}}" class="xy-h-note">请在关门前拍摄。已关门可从相册补传，不要再次开柜。</text>
      <text wx:else class="xy-h-note">{{pendingCount ? '有凭证尚未完成，请查看上传进度。' : canProceed ? '凭证已齐，提交后将保存本次凭证，后续更换会保留历史记录。' : '点击空格拍摄或上传，点击缩略图预览；还差 ' + (totalCount - readyCount) + ' 项。'}}{{blockers}}</text>
      <block wx:if="{{recordOnly}}">
        <text class="xy-h-cap">补交历史</text>
        <view class="xy-h-blk">
          <text wx:if="{{!history.length}}" class="xy-h-inote">暂无历史版本</text>
          <view wx:for="{{history}}" wx:key="id" class="xy-h-row"><view class="xy-h-row__k"><text>{{item.title}}</text><text class="xy-h-row__sub">{{item.time}}{{item.reason ? ' · ' + item.reason : ''}}</text></view><button wx:if="{{item.url}}" class="xy-h-hit rs-act xy-action-hit" data-id="{{item.id}}" bindtap="previewHistory">查看{{item.kind === 'VIDEO' ? '视频' : '照片'}}</button><text wx:else class="xy-h-row__v">暂不可用</text></view>
        </view>
      </block>
      <block wx:if="{{method === 'EXPRESS' && !canStart}}">
        <text class="xy-h-cap">返程快递</text>
        <view class="xy-h-blk">
          <view class="xy-h-row"><text class="xy-h-row__k">寄回地址</text><text class="xy-h-row__v rs-wide">{{address || '等待出租方设置返程地址，请勿寄往未经确认的地址'}}</text></view>
          <block wx:if="{{canShip || canCorrect}}">
            <button class="xy-h-agree xy-action-hit rs-agree" role="checkbox" aria-checked="{{addressConfirmed}}" bindtap="confirmAddress" disabled="{{busy}}" aria-disabled="{{busy}}"><view class="xy-h-check {{addressConfirmed ? 'is-checked' : ''}}"><image wx:if="{{addressConfirmed}}" src="{{icons.flowCheck}}" mode="aspectFit" aria-hidden="true" /></view><text>我已核对返程地址</text></button>
            <view class="xy-h-row"><text class="xy-h-row__k rs-field">快递单号</text><input class="rs-input" value="{{tracking}}" data-field="tracking" maxlength="64" bindinput="input" disabled="{{busy}}" aria-disabled="{{busy}}" placeholder="必填" aria-label="返程快递单号" /></view>
            <view class="xy-h-row"><text class="xy-h-row__k rs-field">快递公司</text><input class="rs-input" value="{{carrier}}" data-field="carrier" maxlength="64" bindinput="input" disabled="{{busy}}" aria-disabled="{{busy}}" placeholder="选填" aria-label="快递公司" /></view>
            <view wx:if="{{canCorrect}}" class="rs-reason"><textarea class="rs-textarea" value="{{correctionReason}}" data-field="correctionReason" maxlength="500" bindinput="input" disabled="{{busy}}" aria-disabled="{{busy}}" placeholder="更正原因（必填）" aria-label="快递单号更正原因" /></view>
          </block>
          <view wx:else class="xy-h-row"><text class="xy-h-row__k">快递单号</text><text class="xy-h-row__v">{{carrier}} {{tracking}}</text></view>
        </view>
      </block>
      <view wx:if="{{method !== 'CABINET' && !recordOnly && !supplementing}}" class="xy-h-blk">
        <view wx:if="{{received}}" class="xy-h-row"><text class="xy-h-row__k">实际收回</text><text class="xy-h-row__v">{{received}}</text></view>
        <text class="xy-h-inote">{{instructions}}{{instructions ? ' ' : ''}}租期超时不影响归还，费用由后台在退押审核时扣除或安排补缴。</text>
      </view>
    </block>
  </view>
  <view slot="footer" class="xy-h-foot"><view class="xy-h-actions__main">
    <button wx:if="{{recordOnly || supplementing}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="returnToOrder">{{supplementing ? '返回订单查看进度' : '返回订单'}}</button>
    <block wx:else>
      <button class="xy-h-btn xy-h-btn--secondary xy-action-hit rs-save" bindtap="onSecondaryNavigationBack">暂存</button>
      <button wx:if="{{method === 'CABINET'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="openCabinet" disabled="{{busy || !canProceed}}" aria-disabled="{{busy || !canProceed}}">{{isAfterOpen ? '返回归还核验' : '下一步：选择柜机'}}</button>
      <button wx:elif="{{canStart}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="start" disabled="{{busy}}" aria-disabled="{{busy}}">开始上传凭证</button>
      <button wx:elif="{{canShip || canCorrect}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="saveShipment" disabled="{{busy || !addressConfirmed}}" aria-disabled="{{busy || !addressConfirmed}}">{{canCorrect ? '确认更正' : '确认寄回'}}</button>
    </block>
  </view></view>
</page-shell>
<view wx:if="{{example}}" class="example-page">
  <page-shell surface="page" scroll-mode="viewport" has-footer>
    <page-header variant="return" title="{{example.kind === 'VIDEO' ? '验机视频示例' : '照片示例'}}" slot="header" bindback="closeExample" />
    <view class="return-page">
      <view wx:if="{{example.kind === 'PHOTO'}}" class="example-heading"><text class="return-title">{{example.title}}</text><text class="example-count">{{exampleIndex + 1}} / {{exampleCount}}</text></view>
      <view class="return-note return-note--success"><image class="return-status-icon" src="{{example.kind === 'VIDEO' ? icons.returnSound : icons.returnCamera}}" mode="aspectFit" />{{example.kind === 'PHOTO' ? '拍摄参考，不计入归还凭证' : '连续拍摄，清楚展示操作过程'}}</view>
      <image wx:if="{{example.kind === 'PHOTO'}}" class="example-image" src="{{example.example}}" mode="aspectFill" bindtap="previewExample" role="button" aria-label="放大{{example.title}}示例" />
      <video wx:else id="return-slot-example" class="example-video" src="{{example.example}}" poster="{{example.examplePoster}}" controls show-center-play-btn show-play-btn enable-play-gesture object-fit="contain" />
      <view class="{{example.kind === 'VIDEO' ? 'return-card' : 'example-photo-steps'}}"><text wx:if="{{example.kind === 'VIDEO'}}" class="return-subtitle">视频需要展示</text><view wx:for="{{exampleSteps}}" wx:key="key" class="example-step"><text class="example-step-number">{{item.number}}</text><image wx:if="{{example.kind === 'VIDEO'}}" src="{{item.icon}}" mode="aspectFit" /><text>{{item.label}}</text></view><text wx:if="{{example.kind === 'VIDEO'}}" class="card-copy">示例时长仅供参考，上传限制以本单要求为准</text></view>
      <view wx:if="{{example.kind === 'PHOTO'}}" class="example-navigation"><button class="return-secondary" data-direction="-1" bindtap="changeExample" disabled="{{exampleIndex === 0}}" aria-disabled="{{exampleIndex === 0}}">上一张</button><button class="return-secondary" data-direction="1" bindtap="changeExample" disabled="{{exampleIndex + 1 === exampleCount}}" aria-disabled="{{exampleIndex + 1 === exampleCount}}">下一张</button></view>
    </view>
    <view slot="footer" class="return-actions"><button class="return-primary" data-source="camera" bindtap="selectExample" disabled="{{busy || !example.editable}}" aria-disabled="{{busy || !example.editable}}"><image src="{{example.kind === 'VIDEO' ? icons.returnVideo : icons.returnCamera}}" mode="aspectFit" />{{example.kind === 'VIDEO' ? '录制验机视频' : '拍摄' + example.title}}</button><button class="return-secondary" data-source="album" bindtap="selectExample" disabled="{{busy || !example.editable}}" aria-disabled="{{busy || !example.editable}}"><image src="{{icons.returnAlbum}}" mode="aspectFit" />从相册选择</button></view>
  </page-shell>
</view>
</view>
