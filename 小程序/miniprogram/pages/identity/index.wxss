/* 重设计 第 1 批：标题 18 + 用途 → 两项字段一张白卡（标签 80 + 输入，错误跟在字段下）→ 隐私说明；已填写时显示完成卡 */
.identity-page { display: flex; flex-direction: column; gap: var(--xy-space-3); padding: var(--xy-space-4) var(--xy-layout-page-padding-x) var(--xy-space-6); color: var(--xy-color-text-primary); }
.identity-head { display: flex; flex-direction: column; gap: var(--xy-space-1); margin-bottom: var(--xy-space-1); }
.identity-title { color: var(--xy-color-text-strong); font-size: var(--xy-text-order-navigation-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-order-navigation-line-height); }
.identity-copy { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.identity-card { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.identity-row { position: relative; display: flex; flex-wrap: wrap; align-items: center; min-height: 52px; box-sizing: border-box; column-gap: var(--xy-space-3); padding: var(--xy-space-4); }
.identity-row + .identity-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.identity-label { flex: 0 0 calc(var(--xy-space-4) * 5); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.identity-row.is-error .identity-label { color: var(--xy-color-danger); }
.identity-row input { min-width: 0; flex: 1; height: var(--xy-text-body-line-height); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.identity-placeholder { color: var(--xy-color-text-weak); }
.field-error { flex-basis: 100%; margin: var(--xy-space-1) 0 0 calc(var(--xy-space-4) * 5 + var(--xy-space-3)); color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.privacy-note { display: flex; align-items: flex-start; gap: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.privacy-icon { flex: none; width: var(--xy-space-4); height: var(--xy-space-4); }
.done-card { display: flex; flex-direction: column; align-items: center; gap: var(--xy-space-2); padding: calc(var(--xy-space-4) * 2) var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); text-align: center; }
.done-title { color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.done-copy { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.alert-row { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--xy-space-2); }
.form-error { min-width: 0; flex: 1; color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.retry-button { display: flex; flex: none; min-height: var(--xy-size-touch-min); align-items: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.done-icon { width: calc(var(--xy-space-6) * 2 + var(--xy-space-2)); height: calc(var(--xy-space-6) * 2 + var(--xy-space-2)); }
.done-list { margin-top: var(--xy-space-3); padding: 0 var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.done-row { display: flex; min-height: calc(var(--xy-space-6) * 2 + var(--xy-space-1)); align-items: center; justify-content: space-between; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.done-row + .done-row { border-top: 1px solid var(--xy-color-divider); }
.done-label { color: var(--xy-color-text-secondary); }
.done-value { color: var(--xy-color-text-primary); font-variant-numeric: tabular-nums; }
.done-value--ok { color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.done-note { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
