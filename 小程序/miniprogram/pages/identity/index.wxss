/* 视觉规范 v1：标题 20/700 → 4 → 说明 12 灰 → 24 → 表单白卡（行高 52，标签 80）→ 24 → 主按钮 44 */
.identity-page { min-height: 100vh; box-sizing: border-box; padding: var(--xy-space-6) var(--xy-layout-page-padding-x) calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.identity-title { display: block; padding: 0; color: var(--xy-color-text-strong); font-size: var(--xy-text-page-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-page-title-line-height); }
.identity-copy { display: block; margin-top: var(--xy-space-1); padding: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.identity-card { margin-top: var(--xy-space-6); padding: 0 var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.identity-row { display: flex; flex-wrap: wrap; align-items: center; min-height: 52px; box-sizing: border-box; padding: var(--xy-space-4) 0; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.identity-row + .identity-row { border-top: 1px solid var(--xy-color-divider); }
.identity-label { flex: 0 0 80px; color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-regular); }
.identity-required { color: var(--xy-color-danger); }
.identity-row input { flex: 1; min-width: 0; height: var(--xy-text-body-line-height); box-sizing: border-box; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.identity-row .form-error { width: 100%; margin-top: var(--xy-space-1); padding-left: calc(var(--xy-space-4) * 5); }
.form-error { display: block; color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.identity-page > .form-error { margin-top: var(--xy-space-3); padding: 0; }
.retry-button { display: flex; min-height: var(--xy-size-touch-min); margin-top: var(--xy-space-2); align-items: center; justify-content: center; border: 0; border-radius: var(--xy-radius-md); background: var(--xy-color-surface); color: var(--xy-color-brand); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
.identity-actions { display: flex; flex-direction: column; gap: var(--xy-space-2); margin-top: var(--xy-space-6); }
.identity-submit, .identity-later { margin: 0; min-height: var(--xy-size-touch-min); border-radius: var(--xy-radius-md); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); }
.identity-later { display: flex; align-items: center; justify-content: center; padding: 0 var(--xy-space-3); background: transparent; border: 0; color: var(--xy-color-text-secondary); font-weight: var(--xy-text-weight-medium); }
.identity-later::after { border: 0; }
