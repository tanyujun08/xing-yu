.dispute-page { min-height: 100vh; padding: var(--xy-space-0-5) 0 calc(var(--xy-fixed-bottom-clearance) + var(--xy-space-4)); background: var(--xy-color-page); color: var(--xy-color-text-primary); padding-top: var(--xy-layout-card-stack-start-gap);
}
.dispute-card { margin: var(--xy-layout-content-gap) var(--xy-layout-page-padding-x) 0; padding: var(--xy-inset-card); background: var(--xy-color-surface); }
.status-title, .card-title { display: block; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.status-copy, .privacy-copy { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-info); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.resolution-inline { margin-top: var(--xy-space-3); padding-top: var(--xy-space-3); border-top: 1rpx solid var(--xy-color-surface-subtle); color: var(--xy-color-info); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.resolution-inline .detail-line { color: var(--xy-color-text-primary); }
.field-head { display: flex; align-items: center; justify-content: space-between; gap: var(--xy-space-2); }
.field-title { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); }
.field-hint { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.field-required { color: var(--xy-color-danger); font-size: var(--xy-text-caption-size); }
.evidence-section { margin-top: var(--xy-space-3); }
.media-type-section { margin-top: var(--xy-space-3); }
.media-type-section + .media-type-section { margin-top: var(--xy-space-3); padding-top: var(--xy-space-2-5); border-top: 1rpx solid var(--xy-color-divider); }
.media-type-head { display: flex; align-items: center; justify-content: space-between; }
.media-grid { display: flex; flex-wrap: wrap; gap: var(--xy-space-2); margin-top: var(--xy-space-1-5); }
.media-add, .media-thumb-wrap { position: relative; box-sizing: border-box; flex: 0 0 136rpx; width: 136rpx; height: 136rpx; min-height: 136rpx; }
.media-add { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-0-5); border: 2rpx dashed var(--xy-color-border); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); }
.media-add.is-disabled { opacity: .52; }
.media-add-symbol { color: var(--xy-color-brand-pressed); line-height: var(--xy-text-section-title-line-height); }
.media-add-label { font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-semibold); }
.media-add-count { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.media-thumb, .media-thumb-video { display: block; width: 136rpx; height: 136rpx; background: var(--xy-color-surface-subtle); }
.media-empty { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); text-align: center; }
.description-section { margin-top: var(--xy-space-3); padding-top: var(--xy-space-3); border-top: 1rpx solid var(--xy-color-divider); }
.description-input { box-sizing: border-box; width: 100%; min-height: calc(3 * var(--xy-text-body-line-height) + var(--xy-space-4)); margin-top: var(--xy-space-2); padding: var(--xy-space-2) var(--xy-space-2-5); background: var(--xy-color-page); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.proposal-amount-input { height: var(--xy-control-height); min-height: var(--xy-control-height); padding-top: 0; padding-bottom: 0; line-height: var(--xy-text-body-line-height); }
.description-copy { display: block; margin-top: var(--xy-space-2); padding: var(--xy-space-2-5); background: var(--xy-color-page); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-line-height); }
.privacy-copy { color: var(--xy-color-text-secondary); }
.card-title + .field-head { margin-top: var(--xy-space-2); }
.proposal-amount-input + .field-head { margin-top: var(--xy-space-4); }
.step { display: flex; align-items: center; padding: var(--xy-space-2-5) 0; color: var(--xy-color-brand-disabled); font-size: var(--xy-text-body-small-size); }
.step > text:first-child { width: 20rpx; height: 20rpx; margin-right: var(--xy-space-2-5); border-radius: 50%; background: var(--xy-color-border); }
.step.is-done { color: var(--xy-color-text-primary); }
.step.is-done > text:first-child { background: var(--xy-color-brand); }
.dispute-actions { z-index: var(--xy-z-fab); }
.dark-button, .secondary-button { box-sizing: border-box; display: flex; align-items: center; justify-content: center; height: var(--xy-control-height); min-height: var(--xy-control-height); background: var(--xy-color-brand); color: var(--xy-color-text-inverse); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); font-weight: var(--xy-text-weight-semibold); }
.dark-button { flex: 1; min-width: 0; }
.secondary-button { flex: 0 0 200rpx; min-width: 200rpx; background: var(--xy-color-brand-pressed); }
.dispute-card > .dark-button { margin-top: var(--xy-space-4); }

/* Batch 5: after-sales evidence, decision and platform-review states. */
.dispute-page { background: var(--xy-color-page); color: var(--xy-color-text-primary); padding-top: var(--xy-layout-card-stack-start-gap);
}
.dispute-card { border: 0; border-radius: var(--xy-radius-md); box-shadow: none; 
  margin: var(--xy-layout-content-gap) var(--xy-layout-page-padding-x) 0;
}
.status-title, .card-title, .field-title { color: var(--xy-color-text-primary); }
.status-copy, .privacy-copy, .field-hint, .resolution-inline { color: var(--xy-color-text-secondary); }
.resolution-inline, .description-section, .media-type-section + .media-type-section { border-color: var(--xy-color-divider); }
.field-required { color: var(--xy-color-danger); }
.media-add { border-color: var(--xy-color-border-strong); border-radius: var(--xy-radius-sm); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-secondary); }
.media-add-symbol { color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-caption-line-height); }
.description-input, .description-copy { border-radius: var(--xy-radius-sm); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-primary); }
.step { color: var(--xy-color-text-muted); }
.step.is-done { color: var(--xy-color-text-primary); }
.step > text:first-child { background: var(--xy-color-border-strong); }
.step.is-done > text:first-child { background: var(--xy-color-brand); }
.dispute-actions { border-top: 1rpx solid var(--xy-color-divider); background: var(--xy-color-surface); }
.dark-button, .light-button, .secondary-button { min-height: var(--xy-control-height); border-radius: var(--xy-radius-md); }
.dark-button { background: var(--xy-color-brand); }
.light-button { flex: 1; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 1rpx solid var(--xy-color-border-strong); background: var(--xy-color-surface); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); font-weight: var(--xy-text-weight-semibold); }
.dark-button.is-disabled { background: var(--xy-color-disabled); }

/* Final visual pass: cards follow 16px / 12px stacking and support is a
 * compact secondary action beside the primary submit action. */
.dispute-page > .dispute-card:first-of-type { margin-top: var(--xy-space-4); }
.dispute-page > .dispute-card + .dispute-card { margin-top: var(--xy-space-3); }
.dispute-actions {
  padding-top: var(--xy-space-3);
  padding-bottom: calc(var(--xy-space-3) + env(safe-area-inset-bottom));
}
.dispute-actions .dark-button,
.dispute-actions .light-button,
.dispute-actions .dispute-support-action {
  height: var(--xy-control-height);
  min-height: var(--xy-control-height);
  border-radius: var(--xy-radius-md);
}
.dispute-support-action {
  flex: 0 0 64px;
  box-sizing: border-box;
  padding: 0 var(--xy-space-3);
}

.submission-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--xy-space-2);
  margin-bottom: var(--xy-space-2);
}
.submission-actor {
  color: var(--xy-color-brand);
  font-size: var(--xy-text-body-small-size);
  font-weight: var(--xy-text-weight-semibold);
}
.submission-record + .submission-record {
  margin-top: var(--xy-space-3);
  padding-top: var(--xy-space-3);
  border-top: 1rpx solid var(--xy-color-divider);
}
.submission-record .detail-line {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--xy-space-1);
}
.submission-record .detail-line > text:last-child {
  min-width: 0;
  text-align: left;
  overflow-wrap: anywhere;
}
.dispute-page > .dispute-card:first-child,
.dispute-page > .empty-card:first-child { margin-top: 0; }
.dispute-card.xy-empty-page { padding: var(--xy-space-4) var(--xy-inset-card); }

/* A task introduction and submitted history are sections; the independent
 * proposal and the editable form retain their own single card boundary. */
.dispute-intro {
  margin: 0 var(--xy-layout-page-padding-x) var(--xy-space-3);
}
.dispute-intro + .dispute-card { margin-top: 0; }
.dispute-section {
  margin: var(--xy-space-6) var(--xy-layout-page-padding-x);
}
.proposal-summary { margin-top: var(--xy-space-3); }
.proposal-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--xy-space-2);
}
.proposal-currency {
  font-size: var(--xy-price-symbol-size);
  line-height: var(--xy-price-symbol-line-height);
}
.proposal-value {
  font-size: var(--xy-price-value-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-price-value-line-height);
}
.proposal-note {
  margin-top: var(--xy-space-3);
  padding-top: var(--xy-space-3);
  border-top: 1rpx solid var(--xy-color-divider);
}
.proposal-note > .field-hint { display: block; }
.proposal-note-copy {
  display: block;
  margin-top: var(--xy-space-1);
  color: var(--xy-color-text-primary);
  font-size: var(--xy-text-body-size);
  line-height: var(--xy-text-body-line-height);
  overflow-wrap: anywhere;
}
.proposal-time,
.proposal-summary > .field-hint {
  display: flex;
  flex-direction: column;
  gap: var(--xy-space-1);
  margin-top: var(--xy-space-3);
  padding-top: var(--xy-space-3);
  border-top: 1rpx solid var(--xy-color-divider);
  overflow-wrap: anywhere;
}
.dispute-intro .status-title,
.dispute-intro .status-copy { overflow-wrap: anywhere; }

/* Local touch contract for the shared draft-media target. */
.xy-media-remove { min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); }

.submitted-media { margin-top: var(--xy-space-3); }
.submitted-media > .field-hint { display: block; }
.result-copy { display: block; margin-top: var(--xy-space-3); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.dispute-intro > .field-hint + .status-title { margin-top: var(--xy-space-1); }

.submitted-party-card .submission-record > .field-hint,
.case-result .proposal-summary > .field-hint { display: block; margin: 0; padding: 0; border: 0; }
.submitted-party-card .submission-record + .submission-record .proposal-note { margin-top: var(--xy-space-2); padding-top: 0; border-top: 0; }
