<page-meta root-font-size="system" />
<page-shell surface="page" has-footer="{{!missing}}">
  <page-header title="{{secondaryNavigationTitle || '异常与纠纷'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" slot="header" />
  <view class="xy-h-page dp-page">
    <view wx:if="{{missing}}" class="xy-h-blk xy-empty-page xy-empty-page--surface"><image class="xy-empty-page__illustration" src="/assets/illustrations/empty-orders.webp" mode="aspectFit" aria-hidden="true" /><text class="xy-empty-page__title">订单暂不可用</text><text class="xy-empty-page__copy">请稍后再试或返回订单中心。</text><button class="xy-h-btn xy-h-btn--primary xy-action-hit dp-empty-btn" bindtap="goOrders">返回订单中心</button></view>
    <block wx:else>
      <status-hero tone="purple" art="shield" title="{{order.kind === 'c2c' && showSubmittedContext ? orderStatusTitle : modeTitle}}" description="{{modeCopy && (order.kind !== 'c2c' || editable) ? modeCopy : order.kind === 'c2c' && showSubmittedContext ? orderStatusGroup : ''}}" />

      <!-- 处理结果（结论） -->
      <view wx:if="{{showResolutionInline}}" class="xy-h-blk">
        <view wx:if="{{resolutionPlan.amountLabel}}" class="xy-h-key xy-h-key--warn"><text class="xy-h-key__label">{{resolutionPlan.amountLabel}}</text><text class="xy-h-key__amount">¥{{resolutionPlan.amountText}}</text></view>
        <view class="xy-h-row"><text class="xy-h-row__k">{{resolutionPlan.title}}</text><text class="xy-h-row__v xy-h-row__v--strong">{{resolutionPlan.status}}</text></view>
        <text wx:if="{{resolutionPlan.copy}}" class="xy-h-inote">{{resolutionPlan.copy}}</text>
      </view>
      <view wx:if="{{order.kind === 'c2c' && mode === 'platform_final'}}" class="xy-h-blk">
        <view class="xy-h-key xy-h-key--warn"><text class="xy-h-key__label">{{order.disputeDecision === 'platform_final' ? '平台裁决 · 已确认扣款' : '双方确认 · 已确认扣款'}}</text><text class="xy-h-key__amount">¥{{finalAmountText}}</text></view>
        <text class="xy-h-inote">{{order.disputeDecision === 'platform_final' ? '平台裁决已生效，双方可查看结果。' : '方案已确认，按确认金额处理押金及后续费用。'}}</text>
      </view>

      <!-- 当前方案 -->
      <block wx:if="{{order.kind !== 'c2c' && (mode === 'tenant_decision' || mode === 'lessor_review' || mode === 'platform_review' || mode === 'platform_final')}}">
        <text class="xy-h-cap">{{mode === 'platform_review' ? '处理进度' : mode === 'platform_final' ? modeTitle : proposal && proposal.actor === 'tenant' ? '承租方异议方案' : '出租方处理方案'}}</text>
        <view class="xy-h-blk">
          <block wx:if="{{proposal}}">
            <view class="xy-h-key xy-h-key--warn"><text class="xy-h-key__label">建议扣款</text><text class="xy-h-key__amount">¥{{proposal.amountFen / 100}}</text></view>
            <view class="xy-h-row"><view class="xy-h-row__k"><text class="xy-h-row__sub">处理说明</text><text>{{proposal.note}}</text></view></view>
            <view class="xy-h-row"><text class="xy-h-row__k">提交时间</text><text class="xy-h-row__v">{{proposal.createdText}}</text></view>
          </block>
          <view wx:if="{{mode === 'platform_final'}}" class="xy-h-row"><text class="xy-h-row__k">最终扣款</text><text class="xy-h-row__v xy-h-row__v--strong">{{finalAmountText ? '¥' + finalAmountText : '详情未提供'}}</text></view>
          <text wx:if="{{!proposal && mode !== 'platform_final'}}" class="xy-h-inote">平台正在处理，结果会在此更新。</text>
        </view>
      </block>

      <!-- 已提交内容 -->
      <block wx:if="{{order.kind !== 'c2c' && submittedRecords.length > 0}}">
        <text class="xy-h-cap">已提交内容</text>
        <view wx:for="{{submittedRecords}}" wx:key="id" class="xy-h-blk">
          <view class="xy-h-row"><text class="xy-h-row__k xy-h-row__v--strong">{{item.actor === 'lessor' ? '出租方提交' : '承租方提交'}}</text><text class="xy-h-row__v">{{item.kind === 'initial' ? '首次提交' : '补充材料'}}</text></view>
          <view wx:if="{{item.description}}" class="xy-h-row"><view class="xy-h-row__k"><text class="xy-h-row__sub">{{item.kind === 'initial' ? '问题说明' : '补充说明'}}</text><text>{{item.description}}</text></view></view>
          <view wx:if="{{item.imagePaths.length > 0 || item.videoPaths.length > 0}}" class="dp-media"><image wx:for="{{item.imagePaths}}" wx:for-item="path" wx:for-index="pathIndex" wx:key="id" class="dp-thumb" src="{{path.path}}" mode="aspectFill" data-submission="{{item.id}}" data-index="{{pathIndex}}" bindtap="previewSubmittedEvidence" role="button" aria-label="预览已提交凭证图片" /><video wx:for="{{item.videoPaths}}" wx:for-item="path" wx:for-index="pathIndex" wx:key="id" class="dp-thumb" src="{{path.path}}" controls="false" object-fit="cover" data-submission="{{item.id}}" data-index="{{pathIndex}}" bindtap="previewSubmittedVideo" role="button" aria-label="预览已提交凭证视频"></video></view>
          <view class="xy-h-row"><text class="xy-h-row__k">提交时间</text><text class="xy-h-row__v">{{item.createdText}}</text></view>
        </view>
      </block>
      <block wx:for="{{submissionGroups}}" wx:for-item="group" wx:key="actor">
        <text class="xy-h-cap">{{group.title}}</text>
        <view wx:for="{{group.records}}" wx:for-item="record" wx:for-index="recordIndex" wx:key="id" class="xy-h-blk">
          <view wx:if="{{record.amountText !== ''}}" class="xy-h-row"><text class="xy-h-row__k">{{group.actor === 'lessor' ? '建议扣款' : '异议金额'}}{{recordIndex > 0 ? ' · 补充' : ''}}</text><text class="xy-h-row__v dp-amount">¥{{record.amountText}}</text></view>
          <view wx:if="{{record.description}}" class="xy-h-row"><view class="xy-h-row__k"><text class="xy-h-row__sub">处理说明</text><text>{{record.description}}</text></view></view>
          <view wx:if="{{record.imagePaths.length || record.videoPaths.length}}" class="dp-media">
            <image wx:for="{{record.imageViews}}" wx:for-item="media" wx:key="id" class="dp-thumb" src="{{media.path}}" mode="aspectFill" data-submission="{{record.id}}" data-index="{{media.index}}" bindtap="previewSubmittedEvidence" role="button" aria-label="预览已提交图片" />
            <video wx:for="{{record.videoViews}}" wx:for-item="media" wx:key="id" class="dp-thumb" src="{{media.path}}" controls="false" object-fit="cover" data-submission="{{record.id}}" data-index="{{media.index}}" bindtap="previewSubmittedVideo" role="button" aria-label="预览已提交视频"></video>
          </view>
          <view class="xy-h-row"><text class="xy-h-row__k">提交时间</text><text class="xy-h-row__v">{{record.createdText}}</text></view>
        </view>
      </block>

      <!-- 填写方案 -->
      <block wx:if="{{mode === 'lessor_proposal' || mode === 'tenant_objection'}}">
        <text class="xy-h-cap">{{mode === 'lessor_proposal' ? '扣款方案' : '异议方案'}}</text>
        <view class="xy-h-blk">
          <view class="xy-h-row"><text class="xy-h-row__k dp-field">金额（元）<text class="dp-req">*</text></text><input class="dp-input" type="digit" value="{{proposalAmount}}" placeholder="{{mode === 'lessor_proposal' ? '请输入大于 0 的金额' : '可填写 0'}}" bindinput="inputProposalAmount" aria-label="金额" /></view>
          <view class="dp-text"><text class="xy-h-row__sub">说明<text class="dp-req">*</text></text><textarea class="dp-textarea" value="{{proposalNote}}" placeholder="请填写设备、配件或费用处理说明" maxlength="500" auto-height="true" bindinput="inputProposalNote"></textarea></view>
          <view class="dp-text"><text class="xy-h-row__sub">图片和视频（选填）</text>
            <view class="media-grid xy-draft-media-grid"><view wx:if="{{proposalImagePaths.length < 9}}" class="xy-draft-media-tile xy-draft-media-add" data-scope="proposal" data-kind="image" bindtap="addEvidence" role="button"><text class="xy-draft-media-symbol">+</text><text class="xy-draft-media-label">图片</text><text class="xy-draft-media-count">{{proposalImagePaths.length}}/9</text></view><view wx:for="{{proposalImagePaths}}" wx:key="id" class="xy-draft-media-tile"><image class="dp-thumb" src="{{item.path}}" mode="aspectFill" data-scope="proposal" data-index="{{index}}" bindtap="previewEvidence" role="button" aria-label="预览扣款方案图片" /><view class="xy-media-remove" data-scope="proposal" data-index="{{index}}" catchtap="deleteEvidence" role="button" aria-label="删除这张草稿图片"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view><view class="xy-draft-media-tile xy-draft-media-add" data-scope="proposal" data-kind="video" bindtap="addEvidence" role="button"><text class="xy-draft-media-symbol">+</text><text class="xy-draft-media-label">视频</text><text class="xy-draft-media-count">{{proposalVideoPaths.length ? '已添加' : '0/1'}}</text></view><view wx:for="{{proposalVideoPaths}}" wx:key="id" class="xy-draft-media-tile"><video class="dp-thumb" src="{{item.path}}" controls="false" object-fit="cover" data-scope="proposal" bindtap="previewVideo" role="button" aria-label="预览扣款方案视频"></video><view class="xy-media-remove" data-scope="proposal" data-index="{{index}}" catchtap="deleteVideo" role="button" aria-label="删除这段草稿视频"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view>
          </view>
        </view>
      </block>
      <block wx:if="{{mode === 'lessor_review'}}">
        <text class="xy-h-cap">补充说明或材料（至少一项）</text>
        <view class="xy-h-blk">
          <view class="dp-text dp-text--first"><textarea class="dp-textarea" value="{{proposalNote}}" placeholder="请补充处理说明，或添加新的材料" maxlength="500" auto-height="true" bindinput="inputProposalNote"></textarea></view>
          <view class="dp-text"><text class="xy-h-row__sub">新增材料</text>
            <view class="media-grid xy-draft-media-grid"><view class="xy-draft-media-tile xy-draft-media-add" data-scope="proposal" data-kind="image" bindtap="addEvidence" role="button"><text class="xy-draft-media-symbol">+</text><text class="xy-draft-media-label">图片</text></view><view wx:for="{{proposalImagePaths}}" wx:key="id" class="xy-draft-media-tile"><image class="dp-thumb" src="{{item.path}}" mode="aspectFill" data-scope="proposal" data-index="{{index}}" bindtap="previewEvidence" role="button" aria-label="预览补充材料图片" /><view class="xy-media-remove" data-scope="proposal" data-index="{{index}}" catchtap="deleteEvidence" role="button" aria-label="删除这张草稿图片"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view>
          </view>
        </view>
      </block>
      <block wx:if="{{(mode === 'generic' && (order.axes.dispute === 'none' || order.axes.dispute === 'evidence_pending')) || canSupplement}}">
        <text class="xy-h-cap">{{canSupplement ? '补充材料（说明或凭证至少一项）' : order.axes.dispute === 'evidence_pending' ? '验机材料' : '问题说明'}}</text>
        <view class="xy-h-blk">
          <view class="dp-text dp-text--first"><textarea class="dp-textarea" value="{{description}}" placeholder="{{canSupplement ? '填写新的补充说明' : '请描述设备、配件或费用问题'}}" maxlength="500" auto-height="true" bindinput="inputDescription"></textarea></view>
          <view class="dp-text"><text class="xy-h-row__sub">{{canSupplement ? '新增凭证' : '凭证'}}<text wx:if="{{!canSupplement}}" class="dp-req">*</text></text>
            <view class="media-grid xy-draft-media-grid"><view class="xy-draft-media-tile xy-draft-media-add" data-kind="image" bindtap="addGenericEvidence" role="button"><text class="xy-draft-media-symbol">+</text><text class="xy-draft-media-label">图片</text></view><view wx:for="{{evidencePaths}}" wx:key="id" class="xy-draft-media-tile"><image class="dp-thumb" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="previewEvidence" role="button" aria-label="预览问题凭证图片" /><view class="xy-media-remove" data-index="{{index}}" catchtap="deleteEvidence" role="button" aria-label="删除这张草稿图片"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view><view class="xy-draft-media-tile xy-draft-media-add" data-kind="video" bindtap="addGenericEvidence" role="button"><text class="xy-draft-media-symbol">+</text><text class="xy-draft-media-label">视频</text></view><view wx:for="{{videoPaths}}" wx:key="id" class="xy-draft-media-tile"><video class="dp-thumb" src="{{item.path}}" controls="false" object-fit="cover" data-scope="generic" bindtap="previewVideo" role="button" aria-label="预览问题凭证视频"></video><view class="xy-media-remove" data-scope="generic" catchtap="deleteVideo" role="button" aria-label="删除这段草稿视频"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view>
          </view>
        </view>
      </block>
    </block>
  </view>
  <view wx:if="{{!missing}}" slot="footer" class="xy-h-foot"><view class="xy-h-actions">
    <button class="xy-action-hit xy-h-kf" bindtap="openSupport" aria-label="联系客服"><image src="{{supportIcon}}" mode="aspectFit" aria-hidden="true" /><text>客服</text></button>
    <view class="xy-h-actions__main">
      <block wx:if="{{mode === 'tenant_decision'}}"><button class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="startObjection">提出异议</button><button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="acceptProposal">同意方案</button></block>
      <block wx:elif="{{mode === 'lessor_review'}}"><button class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="rejectTenantProposal">交平台处理</button><button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="acceptTenantProposal">接受承租方方案</button></block>
      <button wx:elif="{{mode === 'lessor_proposal'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="submitProposal" disabled="{{submitting}}" aria-disabled="{{submitting}}">{{submitting ? '提交中…' : '提交扣款方案'}}</button>
      <button wx:elif="{{mode === 'tenant_objection'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="submitObjection" disabled="{{submitting}}" aria-disabled="{{submitting}}">{{submitting ? '提交中…' : '提交异议方案'}}</button>
      <button wx:elif="{{(mode === 'generic' && (order.axes.dispute === 'none' || order.axes.dispute === 'evidence_pending')) || canSupplement}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="submitGenericEvidence" disabled="{{submitting}}" aria-disabled="{{submitting}}">{{submitting ? '提交中…' : canSupplement ? '提交补充材料' : order.axes.dispute === 'evidence_pending' ? '提交验机材料' : '提交售后问题'}}</button>
      <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="goDetail">返回订单详情</button>
    </view>
  </view></view>
</page-shell>
