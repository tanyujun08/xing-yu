<page-meta root-font-size="system" />
<view class="dispute-page">
<page-header title="{{secondaryNavigationTitle || '异常与纠纷'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <view wx:if="{{missing}}" class="dispute-card xy-empty-page xy-empty-page--surface"><image class="xy-empty-page__illustration" src="/assets/illustrations/empty-orders.webp" mode="aspectFit" aria-hidden="true" /><text class="xy-empty-page__title">订单暂不可用</text><text class="xy-empty-page__copy">请稍后再试或返回订单中心。</text><view class="xy-empty-page__action xy-action-primary xy-action-text xy-tap" bindtap="goOrders" role="button">返回订单中心</view></view>
  <block wx:else>
    <view class="dispute-intro"><text wx:if="{{order.kind === 'c2c' && showSubmittedContext}}" class="field-hint">{{orderStatusGroup}}</text><text class="status-title">{{order.kind === 'c2c' && showSubmittedContext ? orderStatusTitle : modeTitle}}</text><text wx:if="{{modeCopy && (order.kind !== 'c2c' || editable)}}" class="status-copy">{{modeCopy}}</text><view wx:if="{{showResolutionInline}}" class="resolution-inline"><view class="detail-line"><text>{{resolutionPlan.title}}</text><text>{{resolutionPlan.status}}</text></view><text>{{resolutionPlan.copy}}</text><view wx:if="{{resolutionPlan.amountLabel}}" class="detail-line"><text>{{resolutionPlan.amountLabel}}</text><text>¥{{resolutionPlan.amountText}}</text></view></view></view>
    <view wx:if="{{order.kind !== 'c2c' && (mode === 'tenant_decision' || mode === 'lessor_review' || mode === 'platform_review' || mode === 'platform_final')}}" class="dispute-card"><text class="card-title">{{mode === 'platform_review' ? '处理进度' : mode === 'platform_final' ? modeTitle : proposal && proposal.actor === 'tenant' ? '承租方异议方案' : '出租方处理方案'}}</text><view wx:if="{{proposal}}" class="proposal-summary"><view class="proposal-amount"><text class="field-hint">建议扣款</text><view class="xy-price-group"><text class="proposal-currency">¥</text><text class="proposal-value">{{proposal.amountFen / 100}}</text></view></view><view class="proposal-note"><text class="field-hint">处理说明</text><text class="proposal-note-copy">{{proposal.note}}</text></view><view class="proposal-time"><text class="field-hint">提交时间</text><text class="field-hint">{{proposal.createdText}}</text></view></view><view wx:if="{{mode === 'platform_final'}}" class="final-result"><view class="proposal-note"><text class="field-hint">最终扣款</text><text class="proposal-note-copy">{{finalAmountText ? '¥' + finalAmountText : '详情未提供'}}</text></view></view></view>
    <view wx:if="{{order.kind !== 'c2c' && submittedRecords.length > 0}}" class="dispute-section"><text class="card-title">{{order.kind === 'c2c' ? '双方提交内容' : '已提交内容'}}</text><view wx:for="{{submittedRecords}}" wx:key="id" class="proposal-summary submission-record"><view class="submission-head"><text class="submission-actor">{{item.actor === 'lessor' ? '出租方提交' : '承租方提交'}}</text><text class="field-hint">{{item.kind === 'initial' ? '首次提交' : '补充材料'}}</text></view><view wx:if="{{item.description}}" class="detail-line"><text>{{item.kind === 'initial' ? '问题说明' : '补充说明'}}</text><text>{{item.description}}</text></view><view wx:if="{{item.imagePaths.length > 0 || item.videoPaths.length > 0}}" class="media-grid xy-draft-media-grid"><image wx:for="{{item.imagePaths}}" wx:for-item="path" wx:for-index="pathIndex" wx:key="id" class="media-thumb" src="{{path.path}}" mode="aspectFill" data-submission="{{item.id}}" data-index="{{pathIndex}}" bindtap="previewSubmittedEvidence" role="button" aria-label="预览已提交凭证图片" /><video wx:for="{{item.videoPaths}}" wx:for-item="path" wx:for-index="pathIndex" wx:key="id" class="media-thumb-video" src="{{path.path}}" controls="false" object-fit="cover" data-submission="{{item.id}}" data-index="{{pathIndex}}" bindtap="previewSubmittedVideo" role="button" aria-label="预览已提交凭证视频"></video></view><text class="field-hint">提交时间 {{item.createdText}}</text></view></view>
    <view wx:if="{{order.kind === 'c2c' && mode === 'platform_final'}}" class="dispute-card case-result">
      <text class="card-title">{{order.disputeDecision === 'platform_final' ? '平台裁决结果' : '双方确认结果'}}</text>
      <view class="proposal-summary"><text class="field-hint">已确认扣款</text><view class="xy-price-group"><text class="proposal-currency">¥</text><text class="proposal-value">{{finalAmountText}}</text></view></view>
      <text class="result-copy">{{order.disputeDecision === 'platform_final' ? '平台裁决已生效，双方可查看结果。' : '方案已确认，按确认金额处理押金及后续费用。'}}</text>
    </view>
    <view wx:for="{{submissionGroups}}" wx:for-item="group" wx:key="actor" class="dispute-card submitted-party-card">
      <text class="card-title">{{group.title}}</text>
      <view wx:for="{{group.records}}" wx:for-item="record" wx:for-index="recordIndex" wx:key="id" class="proposal-summary submission-record">
        <text wx:if="{{recordIndex > 0}}" class="field-hint">补充材料</text>
        <view wx:if="{{record.amountText !== ''}}" class="proposal-amount"><text class="field-hint">{{group.actor === 'lessor' ? '建议扣款' : '异议金额'}}</text><view class="xy-price-group"><text class="proposal-currency">¥</text><text class="proposal-value">{{record.amountText}}</text></view></view>
        <view wx:if="{{record.description}}" class="proposal-note"><text class="field-hint">处理说明</text><text class="proposal-note-copy">{{record.description}}</text></view>
        <view wx:if="{{record.imagePaths.length || record.videoPaths.length}}" class="submitted-media"><text class="field-hint">图片和视频</text><view class="media-grid">
          <image wx:for="{{record.imageViews}}" wx:for-item="media" wx:key="id" class="media-thumb" src="{{media.path}}" mode="aspectFill" data-submission="{{record.id}}" data-index="{{media.index}}" bindtap="previewSubmittedEvidence" role="button" aria-label="预览已提交图片" />
          <video wx:for="{{record.videoViews}}" wx:for-item="media" wx:key="id" class="media-thumb-video" src="{{media.path}}" controls="false" object-fit="cover" data-submission="{{record.id}}" data-index="{{media.index}}" bindtap="previewSubmittedVideo" role="button" aria-label="预览已提交视频"></video>
        </view></view>
        <view class="proposal-time"><text class="field-hint">提交时间</text><text class="field-hint">{{record.createdText}}</text></view>
      </view>
    </view>
    <view wx:if="{{mode === 'lessor_proposal' || mode === 'tenant_objection'}}" class="dispute-card"><text class="card-title">{{mode === 'lessor_proposal' ? '扣款方案' : '异议方案'}}</text><view class="field-head"><text class="field-title">金额（元）</text><text class="field-required">必填</text></view><input class="description-input proposal-amount-input" type="digit" value="{{proposalAmount}}" placeholder="{{mode === 'lessor_proposal' ? '请输入大于0的金额' : '可填写0'}}" bindinput="inputProposalAmount" /><view class="field-head"><text class="field-title">说明</text><text class="field-required">必填</text></view><textarea class="description-input" value="{{proposalNote}}" placeholder="请填写设备、配件或费用处理说明" maxlength="500" auto-height="true" bindinput="inputProposalNote"></textarea><view class="evidence-section"><view class="field-head"><text class="field-title">图片和视频</text><text class="field-hint">可选</text></view><view class="media-grid xy-draft-media-grid"><view wx:if="{{proposalImagePaths.length < 9}}" class="media-add xy-draft-media-tile xy-draft-media-add" data-scope="proposal" data-kind="image" bindtap="addEvidence" role="button"><text class="media-add-symbol xy-draft-media-symbol">添加</text><text class="media-add-label xy-draft-media-label">添加图片</text><text class="media-add-count xy-draft-media-count">{{proposalImagePaths.length}}/9</text></view><view wx:for="{{proposalImagePaths}}" wx:key="id" class="media-thumb-wrap xy-draft-media-tile"><image class="media-thumb" src="{{item.path}}" mode="aspectFill" data-scope="proposal" data-index="{{index}}" bindtap="previewEvidence" role="button" aria-label="预览扣款方案图片" /><view class="xy-media-remove" data-scope="proposal" data-index="{{index}}" catchtap="deleteEvidence" role="button" aria-label="删除这张草稿图片"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view><view class="media-grid xy-draft-media-grid"><view class="media-add xy-draft-media-tile xy-draft-media-add" data-scope="proposal" data-kind="video" bindtap="addEvidence" role="button"><text class="media-add-symbol xy-draft-media-symbol">添加</text><text class="media-add-label xy-draft-media-label">添加视频</text><text class="media-add-count xy-draft-media-count">{{proposalVideoPaths.length ? '已添加' : '0/1'}}</text></view><view wx:for="{{proposalVideoPaths}}" wx:key="id" class="media-thumb-wrap xy-draft-media-tile"><video class="media-thumb-video" src="{{item.path}}" controls="false" object-fit="cover" data-scope="proposal" bindtap="previewVideo" role="button" aria-label="预览扣款方案视频"></video><view class="xy-media-remove" data-scope="proposal" data-index="{{index}}" catchtap="deleteVideo" role="button" aria-label="删除这段草稿视频"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view></view></view>
    <view wx:if="{{mode === 'lessor_review'}}" class="dispute-card"><text class="card-title">补充说明或材料</text><textarea class="description-input" value="{{proposalNote}}" placeholder="请补充处理说明，或添加新的材料" maxlength="500" auto-height="true" bindinput="inputProposalNote"></textarea><view class="evidence-section"><view class="field-head"><text class="field-title">新增材料</text><text class="field-hint">说明或材料至少一项</text></view><view class="media-grid xy-draft-media-grid"><view class="media-add xy-draft-media-tile xy-draft-media-add" data-scope="proposal" data-kind="image" bindtap="addEvidence" role="button"><text class="media-add-symbol xy-draft-media-symbol">添加</text><text class="media-add-label xy-draft-media-label">添加图片</text></view><view wx:for="{{proposalImagePaths}}" wx:key="id" class="media-thumb-wrap xy-draft-media-tile"><image class="media-thumb" src="{{item.path}}" mode="aspectFill" data-scope="proposal" data-index="{{index}}" bindtap="previewEvidence" role="button" aria-label="预览补充材料图片" /><view class="xy-media-remove" data-scope="proposal" data-index="{{index}}" catchtap="deleteEvidence" role="button" aria-label="删除这张草稿图片"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view></view></view>
    <view wx:if="{{(mode === 'generic' && (order.axes.dispute === 'none' || order.axes.dispute === 'evidence_pending')) || canSupplement}}" class="dispute-card"><text class="card-title">{{canSupplement ? '补充材料' : order.axes.dispute === 'evidence_pending' ? '验机材料' : '问题说明'}}</text><textarea class="description-input" value="{{description}}" placeholder="{{canSupplement ? '填写新的补充说明' : '请描述设备、配件或费用问题'}}" maxlength="500" auto-height="true" bindinput="inputDescription"></textarea><view class="evidence-section"><view class="field-head"><text class="field-title">{{canSupplement ? '新增凭证' : '凭证'}}</text><text class="{{canSupplement ? 'field-hint' : 'field-required'}}">{{canSupplement ? '说明或凭证至少一项' : '必填'}}</text></view><view class="media-grid xy-draft-media-grid"><view class="media-add xy-draft-media-tile xy-draft-media-add" data-kind="image" bindtap="addGenericEvidence" role="button"><text class="media-add-symbol xy-draft-media-symbol">添加</text><text class="media-add-label xy-draft-media-label">添加图片</text></view><view wx:for="{{evidencePaths}}" wx:key="id" class="media-thumb-wrap xy-draft-media-tile"><image class="media-thumb" src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="previewEvidence" role="button" aria-label="预览问题凭证图片" /><view class="xy-media-remove" data-index="{{index}}" catchtap="deleteEvidence" role="button" aria-label="删除这张草稿图片"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view><view class="media-grid xy-draft-media-grid"><view class="media-add xy-draft-media-tile xy-draft-media-add" data-kind="video" bindtap="addGenericEvidence" role="button"><text class="media-add-symbol xy-draft-media-symbol">添加</text><text class="media-add-label xy-draft-media-label">添加视频</text></view><view wx:for="{{videoPaths}}" wx:key="id" class="media-thumb-wrap xy-draft-media-tile"><video class="media-thumb-video" src="{{item.path}}" controls="false" object-fit="cover" data-scope="generic" bindtap="previewVideo" role="button" aria-label="预览问题凭证视频"></video><view class="xy-media-remove" data-scope="generic" catchtap="deleteVideo" role="button" aria-label="删除这段草稿视频"><view class="xy-media-remove__mark" aria-hidden="true"><text class="xy-media-remove__glyph">×</text></view></view></view></view></view></view>
    <view wx:if="{{mode === 'tenant_decision'}}" class="dispute-actions xy-bottom-action"><view class="dark-button xy-action-primary" bindtap="acceptProposal" role="button">同意方案</view><view class="light-button xy-action-secondary" bindtap="startObjection" role="button">提出异议</view></view>
    <view wx:elif="{{mode === 'lessor_review'}}" class="dispute-actions xy-bottom-action"><view class="dark-button xy-action-primary" bindtap="acceptTenantProposal" role="button">接受承租方方案</view><view class="light-button xy-action-secondary" bindtap="rejectTenantProposal" role="button">提交平台最终处理</view></view>
    <view wx:elif="{{mode === 'lessor_proposal'}}" class="dispute-actions xy-bottom-action"><view class="dispute-support-action xy-action-secondary" bindtap="openSupport" role="button" aria-label="联系客服">客服</view><view class="dark-button xy-action-primary {{submitting ? 'is-disabled' : ''}}" bindtap="submitProposal" role="button">{{submitting ? '提交中…' : '提交扣款方案'}}</view></view>
    <view wx:elif="{{mode === 'tenant_objection'}}" class="dispute-actions xy-bottom-action"><view class="dispute-support-action xy-action-secondary" bindtap="openSupport" role="button" aria-label="联系客服">客服</view><view class="dark-button xy-action-primary {{submitting ? 'is-disabled' : ''}}" bindtap="submitObjection" role="button">{{submitting ? '提交中…' : '提交异议方案'}}</view></view>
    <view wx:elif="{{(mode === 'generic' && (order.axes.dispute === 'none' || order.axes.dispute === 'evidence_pending')) || canSupplement}}" class="dispute-actions xy-bottom-action"><view class="dispute-support-action xy-action-secondary" bindtap="openSupport" role="button" aria-label="联系客服">客服</view><view class="dark-button xy-action-primary {{submitting ? 'is-disabled' : ''}}" bindtap="submitGenericEvidence" role="button">{{submitting ? '提交中…' : canSupplement ? '提交补充材料' : order.axes.dispute === 'evidence_pending' ? '提交验机材料' : '提交售后问题'}}</view></view>
    <view wx:else class="dispute-actions xy-bottom-action"><view class="dark-button xy-action-primary" bindtap="goDetail" role="button">返回订单详情</view></view>
  </block>
</view>
