/* 重设计 第 1 批：概览卡两格（粉钻余额 / 本期可免押）→ 说明 → 免押次数（每周期四格）→ 押金规则 */
.no-deposit-page { display: flex; flex-direction: column; gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); color: var(--xy-color-text-primary); }
.summary-card { display: flex; padding: var(--xy-space-5) 0; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-card); }
.summary-cell { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-0-5); padding: 0 var(--xy-space-4); }
.summary-cell + .summary-cell { border-left: 1px solid var(--xy-color-divider); }
.summary-label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.summary-value { color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-order-navigation-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-order-navigation-line-height); }
.summary-unit { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-regular); }
.no-deposit-intro, .empty-note { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.section-title { display: flex; align-items: center; margin-top: var(--xy-space-1); color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.section-title::before { display: inline-block; width: var(--xy-space-1); height: var(--xy-space-4); margin-right: var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); content: ''; }
.service-list { display: flex; flex-direction: column; gap: var(--xy-space-3); }
.service-card { display: flex; flex-direction: column; gap: var(--xy-space-1); padding: var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.service-title { color: var(--xy-color-text-strong); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); }
.service-detail { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; }
.allowance-card { gap: var(--xy-space-3); }
.allowance-grid { display: flex; }
.allowance-cell { display: flex; flex: 1; flex-direction: column; align-items: center; gap: var(--xy-space-0-5); }
.allowance-num { color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-section-title-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.allowance-num--brand { color: var(--xy-color-brand); }
.allowance-label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.form-error { color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
