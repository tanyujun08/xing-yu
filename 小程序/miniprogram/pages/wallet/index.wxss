/* 视觉规范 v1：去掉绿色渐变大块；收益总览改白卡（标签 12 灰 → 4 → 金额 28/800 → 12 → 1px 线 → 预计收益）→ 24 → 区块标题 + 明细白卡 */
.wallet-page { padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); color: var(--xy-color-text-primary); }
.wallet-section + .wallet-section { margin-top: var(--xy-layout-section-gap); }
.wallet-page > .xy-action-hit { width: 100% !important; margin-top: var(--xy-space-6); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-medium); }
.section-head { display: flex; align-items: center; margin-bottom: var(--xy-layout-title-content-gap); color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.section-head > text { display: flex; align-items: center; }
.section-head > text::before { display: inline-block; width: var(--xy-space-1); height: var(--xy-space-4); margin-right: var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); content: ''; }
.income-summary { padding: var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.income-summary--hero { box-shadow: var(--xy-shadow-key); color: var(--xy-color-text-primary); }
.summary-label-row { display: flex; align-items: center; gap: var(--xy-space-2); }
.summary-label { display: block; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.income-summary-top { display: flex; align-items: center; justify-content: space-between; gap: var(--xy-space-3); margin-top: var(--xy-space-1); }
.summary-main { flex: 1 0 auto; min-width: 0; max-width: 100%; }
.summary-amount { display: flex; align-items: baseline; gap: var(--xy-gap-label-value-compact); color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-heavy); }
.summary-value { min-width: 0; font-size: var(--xy-text-asset-summary-size); line-height: var(--xy-text-asset-summary-line-height); white-space: nowrap; }
.summary-kpis { display: grid; grid-template-columns: minmax(0, 1fr); margin-top: var(--xy-space-3); padding-top: var(--xy-space-3); border-top: 1px solid var(--xy-color-divider); }
.summary-kpis view { min-width: 0; }
.summary-kpi-label { display: block; overflow-wrap: anywhere; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.summary-kpi-value { display: flex; align-items: baseline; gap: var(--xy-gap-label-value-compact); margin-top: var(--xy-space-1); color: var(--xy-color-text-secondary); font-family: var(--xy-font-family-numeric); font-variant-numeric: tabular-nums; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.money-detail { display: block; margin-top: var(--xy-space-1); overflow-wrap: anywhere; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.income-summary--hero .money-detail { margin-top: var(--xy-space-3); padding: var(--xy-space-2) var(--xy-space-3); border-radius: var(--xy-radius-sm); background: var(--xy-color-surface-subtle); color: var(--xy-color-text-muted); }
.income-list { padding: 0 var(--xy-space-4); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.income-list > .money-detail { padding: var(--xy-space-3) 0; margin-top: 0; text-align: center; }
.income-list > .xy-action-hit { width: 100% !important; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); }
.income-row { position: relative; display: block; padding: var(--xy-space-4) 0; }
.income-row.xy-action-hit { width: 100% !important; text-align: left; font-weight: var(--xy-text-weight-regular); }
.income-row:not(.is-last)::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: var(--xy-color-divider); content: ''; }
.income-line { display: flex; align-items: baseline; justify-content: space-between; gap: var(--xy-space-3); }
.income-name { flex: 1; min-width: 0; overflow: hidden; color: var(--xy-color-text-strong); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); text-overflow: ellipsis; white-space: nowrap; }
.income-money { flex: none; color: var(--xy-color-brand); font-family: var(--xy-font-family-numeric); font-variant-numeric: tabular-nums; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-body-line-height); white-space: nowrap; }
.income-meta { display: flex; flex-wrap: wrap; gap: 0 var(--xy-space-3); margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.income-meta text { overflow-wrap: anywhere; }
.income-state-label { display: inline-flex; height: 20px; align-items: center; margin-top: var(--xy-space-2); padding: 0 var(--xy-space-1); border-radius: var(--xy-radius-sm); background: var(--xy-color-control-surface); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-caption-line-height); }
.income-state-label.is-settled { background: var(--xy-color-brand-light); color: var(--xy-color-brand); }
.empty-note.xy-empty-section { padding: var(--xy-space-6) 0; }
/* 收益明细弹层 */
.money-title { display: block; color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.money-row { position: relative; display: flex; min-height: var(--xy-size-touch-min); align-items: center; gap: var(--xy-space-3); padding: var(--xy-space-3) 0; box-sizing: border-box; }
.money-row:not(:last-child)::after { position: absolute; right: 0; bottom: 0; left: 0; height: 1px; background: var(--xy-color-divider); content: ''; }
.money-copy { flex: 1; min-width: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.money-amount { flex: none; color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-variant-numeric: tabular-nums; font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-line-height); white-space: nowrap; }
