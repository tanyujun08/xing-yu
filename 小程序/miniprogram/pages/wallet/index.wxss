/* 钱包 第 3 稿：主视觉卡（浅绿底 + 钱包插画，已入账收益 24）→ 卡内两格（预计收益 / 微信提现）→ 说明 → 收入明细白卡 */
.wallet-page { display: flex; flex-direction: column; gap: var(--xy-space-3); padding: var(--xy-space-3) var(--xy-layout-page-padding-x) var(--xy-space-6); color: var(--xy-color-text-primary); }
.wallet-hero { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-brand-light); }
.hero-main { display: flex; align-items: center; gap: var(--xy-space-2); padding: var(--xy-space-5) var(--xy-space-4) var(--xy-space-3); }
.hero-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-1); }
.hero-label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.hero-amount { color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-task-amount-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-task-amount-line-height); overflow-wrap: anywhere; }
.hero-action { display: flex; min-height: var(--xy-size-touch-min); align-self: flex-start; align-items: center; margin-top: calc(var(--xy-space-1) * -1); }
.hero-action__pill { padding: var(--xy-space-1) var(--xy-space-4); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); color: var(--xy-color-text-inverse); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.hero-action:active .hero-action__pill { opacity: .85; }
.hero-art { flex: none; width: calc(var(--xy-space-6) * 5); height: calc(var(--xy-space-6) * 3 + var(--xy-space-4)); margin: calc(var(--xy-space-2) * -1) calc(var(--xy-space-2) * -1) calc(var(--xy-space-2) * -1) 0; }
.hero-stats { display: flex; margin: 0 var(--xy-space-2) var(--xy-space-2); padding: var(--xy-space-3) 0; border-radius: var(--xy-radius-md); background: var(--xy-color-surface); }
.hero-stat { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-0-5); padding: 0 var(--xy-space-3); }
.hero-stat + .hero-stat { border-left: 1px solid var(--xy-color-divider); }
.hero-stat-label { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.hero-stat-value { color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-section-title-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.money-note { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.alert-row { display: flex; align-items: center; gap: var(--xy-space-2); }
.alert-copy { min-width: 0; flex: 1; color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.text-action { display: flex; flex: none; min-height: var(--xy-size-touch-min); align-items: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.section-title { display: flex; align-items: center; margin-top: var(--xy-space-1); color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.section-title::before { display: inline-block; width: var(--xy-space-1); height: var(--xy-space-4); margin-right: var(--xy-space-2); border-radius: var(--xy-radius-pill); background: var(--xy-color-brand); content: ''; }
.income-card { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.income-status { padding: var(--xy-space-4); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.income-row { position: relative; display: flex; width: 100%; min-height: var(--xy-size-touch-min); box-sizing: border-box; align-items: center; gap: var(--xy-space-2); padding: var(--xy-space-4); background: var(--xy-color-surface); text-align: left; }
.income-row + .income-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.income-row:active { background: var(--xy-color-surface-subtle); }
.income-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-0-5); }
.income-name { overflow: hidden; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); text-overflow: ellipsis; white-space: nowrap; }
.income-meta { overflow: hidden; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); font-variant-numeric: tabular-nums; line-height: var(--xy-text-body-small-line-height); text-overflow: ellipsis; white-space: nowrap; }
.income-money { flex: none; color: var(--xy-color-brand); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-body-size); font-variant-numeric: tabular-nums; font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-body-line-height); }
.income-arrow { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); opacity: .6; }
.load-more { display: flex; width: 100%; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; border-top: 1px solid var(--xy-color-divider); color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.support-row { display: flex; align-items: center; justify-content: center; }
.support-copy { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.detail-sheet { display: flex; flex-direction: column; gap: var(--xy-space-1); padding-bottom: var(--xy-space-4); }
.detail-title { color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.detail-order { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); font-variant-numeric: tabular-nums; line-height: var(--xy-text-body-small-line-height); }
.detail-rows { margin-top: var(--xy-space-2); }
.detail-row { display: flex; min-height: calc(var(--xy-space-6) + var(--xy-space-4)); align-items: center; justify-content: space-between; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.detail-label { color: var(--xy-color-text-secondary); }
.detail-value { font-variant-numeric: tabular-nums; }
.detail-row--total { margin-top: var(--xy-space-1); border-top: 1px solid var(--xy-color-divider); font-weight: var(--xy-text-weight-bold); }
.detail-row--total .detail-label, .detail-row--total .detail-value { color: var(--xy-color-brand); }
.detail-link { display: flex; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; margin-top: var(--xy-space-2); border-radius: var(--xy-radius-md); box-shadow: inset 0 0 0 1px var(--xy-color-border); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
