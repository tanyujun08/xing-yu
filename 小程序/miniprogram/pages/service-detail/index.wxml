<page-meta root-font-size="system" />
<page-shell surface="page" has-footer="{{!missing}}">
<page-header title="{{secondaryNavigationTitle || '服务详情'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" slot="header" />
<view class="xy-h-page sd-page">

  <!-- 下单前预览 -->
  <block wx:if="{{preview}}">
    <status-hero tone="green" art="{{service === 'guard' ? 'shield-green' : 'shield'}}" title="{{previewTitle}}" description="{{service === 'guard' ? '租赁期间遇到问题，优先处理、进度主动通知。' : '租赁期间意外损坏，可按本单保障规则申请审核。'}}" />
    <view class="xy-h-blk">
      <view class="xy-h-key"><text class="xy-h-key__label">服务费用</text><text class="xy-h-key__amount">{{previewPrice === '—' ? '下单页显示价格' : '¥' + previewPrice}}<text wx:if="{{previewPrice !== '—'}}" class="sd-unit"> / 单</text></text><text class="xy-h-row__sub">下单时选择，费用计入订单</text></view>
    </view>
    <text class="xy-h-cap">{{service === 'guard' ? '服务内容' : '保障说明'}}</text>
    <view wx:if="{{service === 'guard'}}" class="xy-h-blk">
      <view class="xy-h-row sd-check"><image src="{{checkIcon}}" mode="aspectFit" aria-hidden="true" /><text class="xy-h-row__k">售后问题优先排队处理</text></view>
      <view class="xy-h-row sd-check"><image src="{{checkIcon}}" mode="aspectFit" aria-hidden="true" /><text class="xy-h-row__k">关键处理进度消息提醒</text></view>
      <view class="xy-h-row sd-check"><image src="{{checkIcon}}" mode="aspectFit" aria-hidden="true" /><text class="xy-h-row__k">一次人工主动跟进</text></view>
    </view>
    <view wx:else class="xy-h-blk">
      <view class="xy-h-row"><view class="xy-h-row__k"><text>适用范围</text><text class="xy-h-row__sub">租赁期间意外碰撞、跌落、进液等意外损坏。</text></view></view>
      <view class="xy-h-row"><view class="xy-h-row__k"><text>不包含</text><text class="xy-h-row__sub">故意损坏、遗失、盗抢、正常磨损、耗材损耗、未经允许拆修。</text></view></view>
      <view class="xy-h-row"><view class="xy-h-row__k"><text>生效及申请</text><text class="xy-h-row__sub">实际交接至有效归还期间；需提供订单、设备与事故证据。保障上限与期限以本单快照为准。</text></view></view>
      <view class="xy-h-row"><view class="xy-h-row__k"><text>取消与退款</text><text class="xy-h-row__sub">履约开始前取消按订单退款规则处理；开始后按已生效保障条款处理。</text></view></view>
    </view>
    <text wx:if="{{service === 'guard'}}" class="xy-h-note">不改变押金、租金或赔偿金额。</text>
  </block>

  <!-- 读取失败 -->
  <block wx:elif="{{missing}}">
    <view class="xy-empty-page xy-empty-page--surface"><image class="xy-empty-page__illustration" src="/assets/illustrations/empty-generic.png" mode="aspectFit" aria-hidden="true" /><text class="xy-empty-page__title">服务详情暂不可查询</text><text class="xy-empty-page__copy">请稍后再试或返回订单。</text><view class="xy-empty-page__action xy-action-primary xy-action-text xy-tap" bindtap="goBack" role="button" aria-label="返回订单">返回订单</view></view>
  </block>

  <!-- 本单未购买 -->
  <block wx:elif="{{unavailable}}">
    <status-hero tone="neutral" art="shield" title="本单未购买此服务" description="可返回订单查看已购买的服务。" />
    <view class="xy-h-blk">
      <view class="xy-h-row"><text class="xy-h-row__k">服务</text><text class="xy-h-row__v">{{detail.title}}</text></view>
      <view class="xy-h-row"><text class="xy-h-row__k">关联订单</text><view class="xy-h-row__v sd-order"><text>{{detail.deviceName}}</text><text class="xy-h-row__sub">{{detail.productModel}} · {{detail.orderId}}</text></view></view>
    </view>
  </block>

  <!-- 已购买 -->
  <block wx:else>
    <status-hero tone="green" art="{{service === 'guard' ? 'shield-green' : 'shield'}}" title="{{detail.title}}" description="{{service === 'guard' ? detail.summary : detail.statusText}}" />
    <view class="xy-h-blk">
      <view class="xy-h-key"><text class="xy-h-key__label">{{service === 'guard' ? '服务费用' : '保障费用'}}</text><text class="xy-h-key__amount">{{detail.priceText}}</text><text wx:if="{{service === 'guard'}}" class="xy-h-row__sub sd-ok">{{detail.statusText}}</text></view>
      <block wx:if="{{service === 'insurance'}}">
        <view class="xy-h-row"><text class="xy-h-row__k">保障期间</text><text class="xy-h-row__v">{{detail.periodText}}</text></view>
        <view class="xy-h-row"><text class="xy-h-row__k">保障上限</text><text class="xy-h-row__v">{{detail.maximumText}}</text></view>
      </block>
    </view>

    <block wx:if="{{service === 'guard'}}">
      <text class="xy-h-cap">本单权益</text>
      <view class="xy-h-blk">
        <view wx:for="{{detail.benefits}}" wx:key="id" class="xy-h-row sd-check"><image src="{{checkIcon}}" mode="aspectFit" aria-hidden="true" /><view class="xy-h-row__k"><text>{{item.title}}</text><text class="xy-h-row__sub">{{item.copy}}</text></view></view>
      </view>
    </block>
    <block wx:else>
      <text class="xy-h-cap">保障范围</text>
      <view class="xy-h-blk">
        <view class="xy-h-row"><view class="xy-h-row__k"><text>可申请审核</text><text class="xy-h-row__sub">{{detail.scopeText}}</text></view></view>
        <view class="xy-h-row"><view class="xy-h-row__k"><text>不保障</text><text class="xy-h-row__sub">{{detail.exclusionsText}}</text></view></view>
        <view class="xy-h-row"><view class="xy-h-row__k"><text>申请条件</text><text class="xy-h-row__sub">{{detail.claimConditionsText}}</text></view></view>
        <view class="xy-h-row"><view class="xy-h-row__k"><text>证据要求</text><text class="xy-h-row__sub">{{detail.evidenceText}}</text></view></view>
      </view>
      <text class="xy-h-cap">处理流程</text>
      <view class="xy-h-blk">
        <view wx:for="{{detail.processSteps}}" wx:key="id" class="xy-h-row sd-step"><text class="sd-num">{{item.index}}</text><view class="xy-h-row__k"><text>{{item.title}}</text><text class="xy-h-row__sub">{{item.copy}}</text></view></view>
      </view>
    </block>

    <text class="xy-h-cap">更多记录</text>
    <view class="xy-h-blk">
      <button class="xy-h-link" bindtap="goBack" aria-label="返回关联订单"><text class="xy-h-link__k">关联订单</text><text class="xy-h-link__v">{{detail.deviceName}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
    </view>
    <text class="xy-h-note">{{detail.cancellationText}}</text>
    <text class="xy-h-note">{{detail.providerText}} {{detail.contactText}}</text>
  </block>
</view>
<view wx:if="{{!missing}}" slot="footer" class="xy-h-foot"><view class="xy-h-actions"><view class="xy-h-actions__main">
  <button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="goBack">{{preview ? '返回确认订单' : '返回订单'}}</button>
</view></view></view>
</page-shell>
