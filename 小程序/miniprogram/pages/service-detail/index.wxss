.back-action { display:block; position:relative; margin-top:var(--xy-space-4); min-height:0; color:var(--xy-color-brand); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }


.preview-card { padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.preview-card + .preview-card { margin-top:var(--xy-space-3); }
