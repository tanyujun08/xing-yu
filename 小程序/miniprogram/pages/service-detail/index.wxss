.preview-price { display:block; margin-top:var(--xy-space-1); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-section-title-line-height); color:var(--xy-color-brand); }
.preview-heading { display:block; margin-top:var(--xy-space-4); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); font-weight:var(--xy-text-weight-semibold); }
.preview-heading:first-child { margin-top:0; }
.preview-copy { display:block; margin-top:var(--xy-space-1); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); color:var(--xy-color-text-secondary); }

/* Keep the existing visual carrier; constrain only its interaction box. */
.order-link { box-sizing:border-box; min-height:var(--xy-size-touch-min); }

.back-action { position:relative; }
.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }
