.order-link-label, .order-link-number { display:block; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.order-link-device { display:block; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); margin:var(--xy-space-1) 0; }
.order-link-arrow { font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-brand); }
.unavailable-title { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.unavailable-copy, .unavailable-order text { display:block; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); }
.unavailable-order { margin-top:var(--xy-space-3); }
.unavailable-overview { display:flex; align-items:flex-start; gap:var(--xy-space-3); padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
