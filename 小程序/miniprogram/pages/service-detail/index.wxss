.guard-boundary > text:last-child, .rule-panel > text:last-child, .rule-line > text:last-child, .insurance-note > text:last-child { display:block; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); color:var(--xy-color-text-secondary); }
.rule-label, .rule-line > text:first-child { display:block; margin-bottom:var(--xy-space-1); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-text-secondary); }
.insurance-meta { padding:0 var(--xy-space-3) var(--xy-space-3); border-radius:0 0 var(--xy-radius-md) var(--xy-radius-md); background:var(--xy-color-surface); }
.insurance-meta > view { display:flex; flex-wrap:wrap; gap:var(--xy-space-1) var(--xy-space-3); justify-content:space-between; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.insurance-meta > view + view { margin-top:var(--xy-space-2); }
.insurance-note { margin-top:var(--xy-space-3); }
.provider-line { margin-top:var(--xy-space-3); }
.provider-line text { display:block; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); color:var(--xy-color-text-secondary); }
