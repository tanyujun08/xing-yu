.sd-unit { color: var(--xy-color-text-secondary); font-size: var(--xy-row-caption-size); font-weight: var(--xy-text-weight-regular); }
.sd-ok { color: var(--xy-color-brand); }
.sd-order { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
.sd-check { align-items: flex-start; gap: var(--xy-space-2); }
.sd-check > image { flex: none; width: var(--xy-space-5); height: var(--xy-row-text-line-height); margin-top: 0; }
.sd-step { align-items: flex-start; gap: var(--xy-space-3); }
.sd-num { flex: none; display: flex; align-items: center; justify-content: center; width: var(--xy-space-5); height: var(--xy-space-5); border-radius: 50%; background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-row-caption-size); font-weight: var(--xy-text-weight-semibold); }
