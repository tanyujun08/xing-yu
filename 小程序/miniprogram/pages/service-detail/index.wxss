.section-title { display:block; margin:var(--xy-space-4) 0 var(--xy-space-2); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.guard-benefit-list, .rule-panel, .rule-line, .insurance-process, .insurance-note, .guard-boundary, .unavailable-card { padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.guard-benefit, .process-step { display:flex; align-items:flex-start; gap:var(--xy-space-2); }
.guard-benefit + .guard-benefit, .process-step + .process-step { margin-top:var(--xy-space-3); }
.benefit-index, .process-index { flex:0 0 20px; text-align:center; border-radius:var(--xy-radius-step-marker); background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-line-height); }
.benefit-copy { flex:1; min-width:0; }
.benefit-title, .process-title { display:block; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.benefit-detail, .process-copy { display:block; margin-top:var(--xy-space-1); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-line-height); color:var(--xy-color-text-secondary); }
.guard-boundary { margin-top:var(--xy-space-3); }
