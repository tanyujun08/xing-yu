<page-meta root-font-size="system" />
<page-shell surface="page" has-footer>
  <page-header title="{{title}}" bindback="onSecondaryNavigationBack" slot="header" />
  <view class="xy-h-page cabinet-open-page {{loaded ? 'cabinet-open-page--a' : ''}}">
    <view wx:if="{{loading}}" class="xy-h-note" role="status">正在查询原任务…</view>
    <view wx:if="{{loaded}}" class="xa-page">
      <status-hero class="xa-hero" variant="band" step="{{pickup ? 1 : 3}}" step-note="{{pickup ? (step > 2 ? '已取出' : '开柜') : '归还'}}" tone="{{heroTone}}" art="{{heroArt}}" title="{{status}}" description="{{copy}}" />
      <view wx:if="{{pickup}}" class="xa-card">
        <view class="xa-tl" aria-label="取件步骤">
          <view class="xa-tl__item {{step > 1 ? 'is-done' : 'is-current'}}"><view class="xa-tl__dot" aria-hidden="true" /><view class="xa-tl__body"><text class="xa-tl__title">开柜</text><text class="xa-tl__sub">柜门状态：{{door}}</text></view></view>
          <view class="xa-tl__item {{step > 2 ? 'is-done' : step === 2 ? 'is-current' : ''}}"><view class="xa-tl__dot" aria-hidden="true" /><view class="xa-tl__body"><text class="xa-tl__title">取出设备</text><text class="xa-tl__sub">核对设备与配件后关好柜门</text></view></view>
          <view class="xa-tl__item {{step === 3 ? 'is-current' : ''}}"><view class="xa-tl__dot" aria-hidden="true" /><view class="xa-tl__body"><text class="xa-tl__title">完成取件</text><text class="xa-tl__sub">完成时间：{{confirmed}}</text></view></view>
        </view>
      </view>
      <text wx:if="{{monitoring}}" class="xa-note" role="status">正在自动同步取件结果，无需刷新。请勿重复开柜。</text>
      <text class="xa-cap">柜机记录</text>
      <view class="xa-list">
        <view wx:if="{{!pickup}}" class="xa-row"><text class="xa-row__k">柜门状态</text><text class="xa-row__v xa-row__v--strong">{{door}}</text></view>
        <view class="xa-row"><text class="xa-row__k">设备识别</text><text class="xa-row__v">{{rfid}}</text></view>
        <view class="xa-row"><text class="xa-row__k">格口状态</text><text class="xa-row__v">{{occupancy}}</text></view>
        <view class="xa-row"><text class="xa-row__k">检查时间</text><text class="xa-row__v">{{observed}}</text></view>
        <view wx:if="{{!pickup}}" class="xa-row"><text class="xa-row__k">完成时间</text><text class="xa-row__v">{{confirmed}}</text></view>
        <button class="xa-row xy-action-hit" bindtap="showResultFeedback" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xa-row__k">查看结果提示</text><text class="xa-row__v"></text><text class="xa-row__more" aria-hidden="true">›</text></button>
      </view>
    </view>
  </view>
  <bottom-actions slot="footer" layout="custom">
    <view slot="actions" class="xy-h-actions">
      <button class="xy-action-hit xy-h-kf" bindtap="demoSupport" aria-label="联系客服"><image src="{{supportIcon}}" mode="aspectFit" aria-hidden="true" /><text>客服</text></button>
      <view class="xy-h-actions__main">
        <button wx:if="{{orderId}}" class="xy-action-hit xy-button-reset xy-button-fluid" bindtap="goDetail"><view class="xy-action-secondary xy-action-shell">返回订单</view></button>
        <button wx:if="{{canResumePickup}}" class="xy-action-hit xy-button-reset xy-button-fluid" bindtap="goPickup" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><view class="xy-action-primary xy-action-shell">继续取件</view></button>
        <button wx:elif="{{canQuery && !pickup}}" class="xy-action-hit xy-button-reset xy-button-fluid" bindtap="query" disabled="{{busy || !canQuery}}" aria-disabled="{{busy || !canQuery}}"><view class="xy-action-primary xy-action-shell">查询归还结果</view></button>
        <button wx:elif="{{!pickup || monitorPaused}}" class="xy-action-hit xy-button-reset xy-button-fluid" bindtap="refresh" disabled="{{busy}}" aria-disabled="{{busy}}"><view class="xy-action-primary xy-action-shell">{{pickup ? '继续核实' : '刷新状态'}}</view></button>
      </view>
    </view>
  </bottom-actions>
</page-shell>
<confirmation-dialog visible="{{feedbackVisible || !!errorText}}" tone="{{errorText ? 'error' : feedbackTone}}" symbol="{{pickup && !errorText ? feedbackSymbol : ''}}" eyebrow="{{pickup && !errorText ? feedbackEyebrow : ''}}" hint="{{pickup && !errorText ? feedbackHint : ''}}" steps="{{pickup && !errorText ? feedbackSteps : []}}" quiet-confirm="{{pickup && !errorText && feedbackQuiet}}" show-contact="{{pickup && !errorText && feedbackContact}}" title="{{errorText ? '暂时无法查询' : feedbackTitle}}" content="{{errorText || feedbackContent}}" confirm-text="{{errorText ? '知道了' : feedbackPrimary}}" show-cancel="{{!errorText && (pickup ? feedbackPhase === 'done' : feedbackPrimary !== '知道了')}}" cancel-text="{{pickup ? '完成' : '稍后查看'}}" busy="{{busy}}" bindconfirm="confirmFeedback" bindcancel="dismissFeedback" />
