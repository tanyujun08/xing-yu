.profile-page { min-height: 100vh; padding-bottom: var(--xy-fixed-bottom-clearance); background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.profile-card { overflow: hidden; margin: var(--xy-space-3) var(--xy-layout-page-padding-x) 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.profile-hero { position: relative; box-sizing: border-box; padding: var(--xy-space-4); background: transparent; }
.profile-scene { display: none; position: absolute; z-index: var(--xy-z-local); right: 0; bottom: -9px; width: 100%; height: 125px; object-fit: cover; object-position: right bottom; opacity: .5; }
.profile-welcome { position: relative; z-index: var(--xy-z-local-raised); }
.profile-user-row { position: relative; z-index: var(--xy-z-local-raised); display: flex; width: 100%; box-sizing: border-box; align-items: center; justify-content: space-between; gap: var(--xy-space-2); padding-right: calc(var(--xy-control-width-membership-entry) + var(--xy-space-3)); }
.profile-entry { display: flex; min-width: 0; min-height: var(--xy-size-touch-min); flex: 1; align-items: center; gap: var(--xy-space-2); }
.avatar { flex: 0 0 56px; width: 56px; height: 56px; margin-right: var(--xy-space-1); border-radius: var(--xy-radius-circle); background: var(--xy-color-brand-light); }
.profile-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.profile-name { overflow: hidden; color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); text-overflow: ellipsis; white-space: nowrap; }
.profile-state { margin-top: var(--xy-gap-title-description); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; white-space: normal; }
.member-entry { position: absolute; z-index: var(--xy-z-local-raised); top: 22px; right: var(--xy-layout-page-padding-x); display: flex; width: var(--xy-control-width-membership-entry); min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; }
.member-entry-shell { display: flex; width: var(--xy-control-width-membership-entry); height: var(--xy-control-height-compact); min-height: var(--xy-control-height-compact); align-items: center; justify-content: center; gap: var(--xy-gap-label-value-compact); box-sizing: border-box; padding: 0 var(--xy-space-2); border: 0; border-radius: var(--xy-radius-pill); background: var(--xy-color-text-strong); color: var(--xy-color-text-inverse); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); white-space: nowrap; }
.member-entry-shell image { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.profile-welcome { display: none; position: relative; z-index: var(--xy-z-local-raised); width: 220px; margin-top: var(--xy-space-2); color: var(--xy-color-text-weak); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); overflow-wrap: anywhere; }
.profile-content { position: relative; z-index: var(--xy-z-local-raised); margin-top: var(--xy-space-6); padding: 0 var(--xy-layout-page-padding-x) var(--xy-space-5); }
.asset-strip, .rental-card, .rentout-card, .service-list { overflow: hidden; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); box-shadow: none; }
.asset-strip { display: grid; min-height: 64px; border-top: 1rpx solid var(--xy-color-divider); border-radius: 0; background: var(--xy-color-surface-subtle); grid-template-columns: repeat(4, minmax(0, 1fr)); }
.asset-item { position: relative; display: flex; min-width: 0; min-height: 64px; align-items: center; flex-direction: column; justify-content: center; gap: var(--xy-gap-label-value-compact); padding: var(--xy-space-3) var(--xy-space-2); box-sizing: border-box; text-align: center; }
.asset-item + .asset-item::before { display: none; position: absolute; top: var(--xy-space-3); bottom: var(--xy-space-3); left: 0; width: 1rpx; background: var(--xy-color-divider); content: ''; }
.asset-label { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.asset-value { max-width: 100%; color: var(--xy-color-text-strong); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-item-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-item-title-line-height); overflow-wrap: anywhere; }
.asset-value--pink { color: var(--xy-color-promo); }
.asset-value--green { color: var(--xy-color-success); font-size: var(--xy-text-body-small-size); }
.profile-section { margin-top: var(--xy-layout-section-gap); }
.section-head { position: relative; display: flex; min-height: var(--xy-text-section-title-line-height); align-items: center; justify-content: space-between; margin-bottom: var(--xy-layout-title-content-gap); }
.section-head--action { min-height: var(--xy-text-section-title-line-height); }
.section-head > text:first-child, .section-title { color: var(--xy-color-text-strong); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.section-link { display: flex; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); align-items: center; justify-content: flex-end; gap: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.section-head--action .section-link { position: absolute; top: 50%; right: 0; transform: translateY(-50%); }
.section-link image { display: block; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); flex: none; }
.rental-card { display: flex; min-height: 92px; align-items: center; gap: var(--xy-space-3); box-sizing: border-box; padding: var(--xy-inset-card); }
.rental-card--empty { justify-content: center; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); }
.rental-card--empty.xy-empty-section { min-height: var(--xy-empty-section-min-height); padding: var(--xy-space-4) var(--xy-inset-card); }
.rental-image { flex: 0 0 56px; width: 56px; height: 56px; border-radius: var(--xy-radius-media); background: var(--xy-color-canvas-muted); }
.rental-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.rental-top { display: flex; align-items: center; gap: var(--xy-space-2); }
.rental-name { overflow: hidden; color: var(--xy-color-text-strong); font-size: var(--xy-text-item-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-item-title-line-height); text-overflow: ellipsis; white-space: nowrap; }
.rental-tag { padding: 0 var(--xy-space-1); border-radius: var(--xy-radius-sm); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); white-space: nowrap; }
.rental-meta, .rental-time { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.rental-meta { margin-top: var(--xy-space-1); }
.rental-time { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); }
.rentout-card { display: block; }
.publish-entry, .rent-row, .service-row { display: flex; min-height: var(--xy-size-touch-min); align-items: center; padding: var(--xy-space-3); background: var(--xy-color-surface); }
.publish-entry { box-sizing: border-box; gap: var(--xy-space-3); margin-bottom: var(--xy-space-3); border-radius: var(--xy-radius-container); }
.publish-entry > image:first-child { flex: 0 0 var(--xy-size-icon-entry-block); width: var(--xy-size-icon-entry-block); height: var(--xy-size-icon-entry-block); }
.publish-entry > view { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.publish-entry > view text:first-child { color: var(--xy-color-text-strong); font-size: var(--xy-text-item-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-item-title-line-height); }
.publish-entry > view text:last-child { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.rent-list { padding: 0; }
.rent-row, .service-row { position: relative; min-height: calc(var(--xy-size-touch-min) + var(--xy-space-2)); padding: var(--xy-space-3); }
.rent-row:not(:last-child), .service-row:not(:last-child) { border-bottom: 1rpx solid var(--xy-color-divider); }
.rent-row > text:first-child, .service-title { min-width: 0; flex: 1; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.row-value { min-width: 0; margin-right: var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); overflow-wrap: anywhere; text-align: right; }
.row-value--green { color: var(--xy-color-success); }
.service-icon { flex: 0 0 var(--xy-size-icon-row); width: var(--xy-size-icon-row); height: var(--xy-size-icon-row); margin-right: var(--xy-space-3); }
.row-arrow { flex: 0 0 var(--xy-size-icon-base); width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.service-list { padding: 0; }
.logout-button { display: flex; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; margin: var(--xy-space-3) auto 0; padding: var(--xy-space-2) var(--xy-space-4); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-regular); line-height: var(--xy-text-body-line-height); text-align: center; }

/* 第 3 批重排：资产数字在上、发布出租与出租管理合为一卡、我的服务改宫格 */
.asset-label { order:2; }
.asset-value { order:1; }
.publish-entry { margin-bottom:0; padding:var(--xy-space-4); border-radius:var(--xy-radius-container) var(--xy-radius-container) 0 0; border-bottom:1rpx solid var(--xy-color-divider); }
.publish-entry + .rentout-card { border-radius:0 0 var(--xy-radius-container) var(--xy-radius-container); }
.service-list { display:grid; grid-template-columns:repeat(4, minmax(0, 1fr)); padding:var(--xy-space-2) 0; }
.service-list .service-row { flex-direction:column; justify-content:center; gap:var(--xy-space-2); min-height:calc(var(--xy-size-touch-min) + var(--xy-space-6)); padding:var(--xy-space-3) var(--xy-space-1); border-bottom:0; }
.service-list .service-row .service-title { flex:none; text-align:center; font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); color:var(--xy-color-text-secondary); }
.service-list .service-row .row-arrow { display:none; }
.service-list .service-row .row-value { position:absolute; top:var(--xy-space-2); right:var(--xy-space-2); font-size:var(--xy-text-micro-size); line-height:var(--xy-text-micro-line-height); }
.service-list .service-row .service-icon { flex:none; margin-right:0; }
.service-list .service-row .row-value--green { top:var(--xy-space-3); right:calc(50% - var(--xy-space-4)); width:var(--xy-space-2); height:var(--xy-space-2); overflow:hidden; border-radius:50%; background:var(--xy-color-brand); font-size:0; line-height:0; }
