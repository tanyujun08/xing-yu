<page-meta root-font-size="system" />
<view class="profile-page">
  <page-header title="我的" show-back="{{false}}" variant="{{headerScrolled ? 'primary' : 'profile-hero'}}" />
  <view class="profile-hero">
    <image class="profile-scene" src="{{icons.profileScene}}" mode="aspectFill" aria-hidden="true" />
    <view class="profile-user-row">
      <view wx:if="{{loggedIn}}" class="profile-entry xy-tap" bindtap="openProfileEdit" role="button" aria-label="编辑个人资料"><image wx:if="{{!avatarReloading}}" class="avatar" src="{{localProfile.avatarPath || icons.profileAvatarDefault}}" mode="aspectFill" data-src="{{localProfile.avatarPath}}" data-owner="{{currentAccount.id}}" data-epoch="{{avatarEpoch}}" binderror="onAvatarImageError" /><view class="profile-copy"><text class="profile-name">{{localProfile.name}}</text><text class="profile-state">{{identityText}}</text></view></view>
      <view wx:else class="profile-entry xy-tap" bindtap="openLogin" role="button" aria-label="点击登录"><image class="avatar" src="{{icons.profileAvatarDefault}}" mode="aspectFill" /><view class="profile-copy"><text class="profile-name">点击登录</text><text class="profile-state">登录后查看账户信息</text></view></view>
      <view wx:if="{{loggedIn}}" class="member-entry xy-tap" bindtap="openMember" role="button" aria-label="查看会员等级：{{memberLevel}} {{memberLevelCode}}"><view class="member-entry-shell"><text>会员中心</text><image src="{{icons.arrowRight}}" mode="aspectFit" /></view></view>
    </view>
    <button wx:if="{{loggedIn && avatarFailed}}" class="xy-button-reset xy-action-secondary xy-tap" data-src="{{localProfile.avatarPath}}" data-owner="{{currentAccount.id}}" data-epoch="{{avatarEpoch}}" catchtap="retryAvatarImage" disabled="{{avatarReloading}}" aria-disabled="{{avatarReloading}}" aria-label="重试当前头像">头像加载失败，重试</button>
    <text class="profile-welcome">欢迎回来，接着探索更多美好瞬间</text>
  </view>
  <view class="profile-content"><text wx:if="{{errorText}}" role="alert">{{errorText}}</text>
    <view class="asset-strip" aria-label="我的资产与权益"><view wx:for="{{assetItems}}" wx:key="label" class="asset-item xy-tap" data-route="{{item.route}}" bindtap="openItem" role="button" aria-label="{{item.accessibilityLabel || ('查看' + item.label + '：' + item.value)}}"><text class="asset-label">{{item.label}}</text><text class="asset-value {{item.valueTone ? 'asset-value--' + item.valueTone : ''}}">{{item.value}}</text></view></view>
    <view class="profile-section"><view class="section-head section-head--action"><view class="section-title">我的租用</view><view class="section-link xy-tap" data-route="/pages/device-orders/index?mode=rent" bindtap="openItem" role="button" aria-label="查看全部租用订单"><text>查看全部</text><image src="{{icons.arrowRight}}" mode="aspectFit" aria-hidden="true" /></view></view><view wx:if="{{rentalSummary}}" class="rental-card xy-tap" data-route="{{rentalSummary.route}}" bindtap="openItem" role="button" aria-label="查看{{rentalSummary.deviceName}}订单"><image class="rental-image" src="{{icons.profileRentalCamera}}" mode="aspectFit" /><view class="rental-copy"><view class="rental-top"><text class="rental-name">{{rentalSummary.deviceName}}</text><text class="rental-tag">{{rentalSummary.statusText}}</text></view><text class="rental-meta">{{rentalSummary.rentText}}</text><text class="rental-time">{{rentalSummary.timeText}}</text></view><image class="row-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view><view wx:else class="rental-card rental-card--empty xy-empty-section"><text class="xy-empty-section__title">{{rentalEmptyTitle}}</text><text class="xy-empty-section__copy">{{rentalEmptyCopy}}</text></view></view>
    <view wx:if="{{showLendSection}}" class="profile-section"><view class="section-head"><text>我的出租</text></view><view class="publish-entry xy-tap" data-route="/pages/publish-eligibility/index" bindtap="openItem" role="button" aria-label="发布出租设备"><image src="{{icons.profilePublishFilled}}" mode="aspectFit" aria-hidden="true" /><view><text>发布出租</text><text>发布设备，设置租金与可租时间</text></view><image class="row-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view><view class="rentout-card"><view class="rent-list"><view wx:for="{{rentoutManagementItems}}" wx:key="title" class="rent-row xy-tap" data-route="{{item.route}}" bindtap="openItem" role="button" aria-label="查看{{item.title}}"><image class="service-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" /><text class="service-title">{{item.title}}</text><text class="row-value">{{index === 0 ? lendStatus.listingStatus : index === 1 ? lendStatus.lendOrderStatus : index === 2 ? lendStatus.quotaStatus : lendStatus.serviceStatus}}</text><image class="row-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view></view></view></view>
    <view class="profile-section"><view class="section-head"><text>我的服务</text></view><view class="service-list"><view wx:for="{{services}}" wx:key="title" class="service-row xy-tap" data-route="{{item.route}}" bindtap="openItem" role="button" aria-label="打开{{item.title}}"><image class="service-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" /><text class="service-title">{{item.title}}</text><text wx:if="{{item.title === '实名认证' && identityRegistered}}" class="row-value row-value--green">已填写</text><image class="row-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view></view><text wx:if="{{loggedIn}}" class="logout-button xy-tap" bindtap="logout" role="button">退出登录</text></view>
  </view>
</view>
