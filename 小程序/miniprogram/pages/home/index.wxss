.store-mini-arrow { flex:none; width:12px; height:12px; }
.home-page .device-category-scroll { margin-top:var(--xy-space-6); }

/* 热区：可点元素至少 44px，较小的按钮用 ::before 画出视觉尺寸 */
.search-clear { display:flex; align-items:center; justify-content:center; flex:none; min-width:var(--xy-space-6); min-height:var(--xy-size-touch-min); }
.cabinet-title-row,.cabinet-head .section-more,.cabinet-slot,.store-main-body,.store-mini { min-height:var(--xy-size-touch-min); }
.cabinet-action,.store-mini-btn { position:relative; z-index:0; min-height:var(--xy-size-touch-min); background:transparent; box-shadow:none; }
.cabinet-action::before,.store-mini-btn::before { position:absolute; z-index:var(--xy-z-behind); top:var(--xy-space-1); right:0; bottom:var(--xy-space-1); left:0; border-radius:var(--xy-radius-control); background:var(--xy-color-control-surface); content:''; }
.store-mini-btn::before { top:var(--xy-space-1); bottom:var(--xy-space-1); }
.cabinet-action--primary::before { background:var(--xy-color-brand); }
.cabinet-action--outline::before,.store-mini-btn--outline::before { background:var(--xy-color-surface); box-shadow:inset 0 0 0 1rpx var(--xy-color-border); }
.store-main-actions { gap:0; }
