/* 首页：数值逐项对齐第十四轮画布（390 宽）。
 * 小按钮的 44px 热区用负外边距抵消，视觉间距与画布一致。 */
.home-page { min-height:100vh; padding:0 0 var(--xy-fixed-tab-clearance); background:var(--xy-color-page); color:var(--xy-color-text-primary); }

/* 顶部：状态栏 + 44 标题行 + 8 + 40 搜索行 */
.home-header { position:sticky; top:0; z-index:var(--xy-z-sticky); padding-bottom:var(--xy-space-3); background:var(--xy-color-page); }
.page-navigation { box-sizing:border-box; }
.page-navigation-title { display:flex; align-items:center; height:44px; padding:0 var(--xy-space-4); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-bold); }
.home-search-row { display:flex; align-items:center; gap:var(--xy-space-2); padding:var(--xy-space-2) var(--xy-space-4) 0; }
.home-search-row--stacked { flex-wrap:wrap; }
.home-search-row--stacked .search-pill { flex-basis:100%; }
.search-pill { display:flex; align-items:center; gap:var(--xy-space-2); flex:1; min-width:0; height:40px; padding:0 var(--xy-space-3); box-sizing:border-box; border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); }
.location-copy { display:flex; align-items:center; gap:var(--xy-space-1); flex:none; max-width:40%; min-height:var(--xy-size-touch-min); }
.location-value { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.location-chevron { flex:none; width:16px; height:16px; }
.search-divider { flex:none; width:1px; height:16px; background:var(--xy-color-border); }
.search-field { display:flex; align-items:center; gap:var(--xy-space-1); flex:1; min-width:0; }
.search-icon { flex:none; display:flex; }
.search-input { flex:1; min-width:0; min-height:var(--xy-size-touch-min); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.search-placeholder { color:var(--xy-color-text-muted); }
.search-clear { display:flex; align-items:center; justify-content:center; flex:none; min-width:var(--xy-space-6); min-height:var(--xy-size-touch-min); }
.check-in-hit { position:relative; z-index:0; display:flex; align-items:center; flex:none; min-height:var(--xy-size-touch-min); padding:0 var(--xy-space-3); margin:calc(var(--xy-space-1) / -2) 0; }
.check-in-hit::before { position:absolute; z-index:var(--xy-z-behind); top:calc(var(--xy-space-1) / 2); right:0; bottom:calc(var(--xy-space-1) / 2); left:0; border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); content:''; }
.check-in { display:flex; align-items:center; gap:var(--xy-space-1); color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.check-in-star { color:var(--xy-color-warning); }

/* 租赁柜卡：p16，标题 20，地址 12，格口 96，底栏 py12 + 36 按钮 */
.cabinet-module { margin:var(--xy-space-1) var(--xy-space-4) 0; overflow:hidden; border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); }
.cabinet-head { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-3); padding:var(--xy-space-4) var(--xy-space-4) 0; }
.cabinet-title-row { display:flex; align-items:center; gap:var(--xy-space-2); min-width:0; min-height:var(--xy-size-touch-min); margin:calc(var(--xy-space-2) * -1) 0; }
.cabinet-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-bold); }
.cabinet-address { display:block; padding:var(--xy-space-1) var(--xy-space-4) 0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.cabinet-strip-scroll { width:100%; margin-top:var(--xy-space-4); white-space:nowrap; }
.cabinet-strip { display:inline-flex; gap:var(--xy-space-2); padding:0 var(--xy-space-4); }
.cabinet-slot { display:inline-flex; flex-direction:column; flex:none; width:96px; min-height:var(--xy-size-touch-min); box-sizing:border-box; overflow:hidden; border:1px solid var(--xy-color-border-weak); border-radius:var(--xy-radius-sm); background:var(--xy-color-surface); white-space:normal; }
.cabinet-slot-media { position:relative; width:100%; height:0; padding-bottom:100%; background:var(--xy-color-canvas-muted); }
.cabinet-slot-media .media-fill { position:absolute; inset:0; width:100%; height:100%; }
.cabinet-slot-copy { display:flex; flex-direction:column; gap:calc(var(--xy-space-1) / 2); padding:var(--xy-space-2); }
.cabinet-slot-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-bold); }
.cabinet-slot-price { display:flex; align-items:baseline; gap:calc(var(--xy-space-1) / 2); }
.cabinet-slot-amount { color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-heavy); }
.cabinet-slot-unit { color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.cabinet-foot { margin-top:var(--xy-space-4); padding:var(--xy-space-3) var(--xy-space-4); border-top:1px solid var(--xy-color-border-weak); background:var(--xy-color-surface-subtle); }
.cabinet-stats { display:flex; align-items:center; gap:var(--xy-space-3); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.cabinet-stats-total { color:var(--xy-color-text-strong); font-weight:var(--xy-text-weight-semibold); }
.cabinet-stats-dot { flex:none; width:var(--xy-space-2); height:var(--xy-space-2); margin-right:calc(var(--xy-space-2) * -1); border-radius:50%; background:var(--xy-color-brand); }
.cabinet-actions { display:flex; gap:var(--xy-space-2); margin:var(--xy-space-2) 0 calc(var(--xy-space-1) * -1); }
.cabinet-action { position:relative; z-index:0; display:flex; align-items:center; justify-content:center; gap:var(--xy-space-1); min-height:var(--xy-size-touch-min); padding:0 var(--xy-space-3); box-sizing:border-box; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-semibold); white-space:nowrap; }
.cabinet-action::before { position:absolute; z-index:var(--xy-z-behind); top:var(--xy-space-1); right:0; bottom:var(--xy-space-1); left:0; border-radius:var(--xy-radius-md); background:var(--xy-color-control-surface); content:''; }
.cabinet-action--primary { flex:1; color:var(--xy-color-text-inverse); }
.cabinet-action--primary::before { background:var(--xy-color-brand); }
.cabinet-action--outline { color:var(--xy-color-text-strong); }
.cabinet-action--outline::before { background:var(--xy-color-surface); box-shadow:inset 0 0 0 1px var(--xy-color-border); }
.cabinet-action--soft { color:var(--xy-color-text-secondary); font-weight:var(--xy-text-weight-medium); }
.cabinet-nav-icon { width:12px; height:12px; }

/* 无柜机时的兜底横幅 */
.cabinet-banner { position:relative; z-index:0; min-height:128px; margin:var(--xy-space-1) var(--xy-space-4) 0; overflow:hidden; border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); }
.banner-media { position:absolute; z-index:0; inset:0; width:100%; height:100%; }
.banner-content { position:relative; z-index:var(--xy-z-local); display:flex; flex-direction:column; align-items:flex-start; gap:var(--xy-space-1); box-sizing:border-box; width:60%; padding:var(--xy-space-4); }
.banner-head { display:flex; align-items:center; gap:var(--xy-space-2); }
.banner-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-bold); }
.banner-copy,.banner-meta { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.banner-more { position:absolute; z-index:var(--xy-z-local-raised); top:var(--xy-space-4); right:var(--xy-space-4); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.cabinet-banner--stacked .banner-content { width:100%; padding-bottom:var(--xy-space-2); }
.cabinet-banner--stacked .banner-media { position:relative; display:block; height:calc(var(--xy-space-6) * 4); }

/* 区块标题：16 粗 + 12 灰，与内容间隔 12；区块之间 24 */
.section-head { display:flex; align-items:center; justify-content:space-between; margin:var(--xy-space-6) var(--xy-space-4) var(--xy-space-3); }
.section-title { color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.section-more { display:flex; align-items:center; flex:none; gap:calc(var(--xy-space-1) / 2); min-height:var(--xy-size-touch-min); margin:calc(var(--xy-space-3) * -1) 0; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-medium); white-space:nowrap; }
.section-more image { width:12px; height:12px; }

/* 附近门店：主店 p16 + 56 缩略图；两家分店并排 */
.store-panel { margin:0 var(--xy-space-4); overflow:hidden; border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); }
.store-main { display:flex; align-items:center; gap:var(--xy-space-3); padding:var(--xy-space-4); }
.store-main-body { display:flex; align-items:center; gap:var(--xy-space-3); flex:1; min-width:0; min-height:var(--xy-size-touch-min); }
.store-thumb { position:relative; flex:none; width:56px; height:56px; overflow:hidden; border-radius:var(--xy-radius-sm); background:var(--xy-color-canvas-muted); }
.store-thumb .media-fill { position:absolute; inset:0; width:100%; height:100%; }
.store-main-copy { display:flex; flex-direction:column; flex:1; min-width:0; }
.store-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.store-line { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-main-copy .store-line { margin-top:calc(var(--xy-space-1) / 2); }
.store-main-copy .store-name + .store-line { margin-top:var(--xy-space-1); }
.store-open { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.store-main-actions { display:flex; flex-direction:column; flex:none; margin:calc(var(--xy-space-2) * -1) 0; }
.store-mini-btn { position:relative; z-index:0; display:flex; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); padding:0 var(--xy-space-3); box-sizing:border-box; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-medium); }
.store-mini-btn + .store-mini-btn { margin-top:calc(var(--xy-space-2) * -1); }
.store-mini-btn::before { position:absolute; z-index:var(--xy-z-behind); top:var(--xy-space-2); right:0; bottom:var(--xy-space-2); left:0; border-radius:var(--xy-radius-md); background:var(--xy-color-control-surface); content:''; }
.store-mini-btn--outline { font-weight:var(--xy-text-weight-semibold); }
.store-mini-btn--outline::before { background:var(--xy-color-surface); box-shadow:inset 0 0 0 1px var(--xy-color-border); }
.store-more-grid { display:flex; border-top:1px solid var(--xy-color-border-weak); background:var(--xy-color-surface-subtle); }
.store-mini { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); flex:1; min-width:0; min-height:var(--xy-size-touch-min); padding:var(--xy-space-3) var(--xy-space-4); }
.store-mini + .store-mini { border-left:1px solid var(--xy-color-border-weak); }
.store-mini-copy { display:flex; flex-direction:column; gap:calc(var(--xy-space-1) / 2); flex:1; min-width:0; }
.store-mini-name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-bold); }
.store-mini-arrow { flex:none; width:12px; height:12px; }
.store-empty { margin:0 var(--xy-space-4); padding:var(--xy-space-3); border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); }

/* 分类：16 字、间隔 24、44 高，选中下划线 2px；下方 1px 分隔线 */
.device-category-scroll { position:relative; width:100%; margin-top:var(--xy-space-6); white-space:nowrap; }
.device-category-scroll::after { position:absolute; right:var(--xy-space-4); bottom:0; left:var(--xy-space-4); height:1px; background:var(--xy-color-border-weak); content:''; }
.category-tab-list { display:inline-flex; gap:var(--xy-space-6); padding:0 var(--xy-space-8, 32px) 0 var(--xy-space-4); }
.category-tab { position:relative; z-index:var(--xy-z-local); display:flex; align-items:center; min-height:var(--xy-size-touch-min); color:var(--xy-color-text-muted); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-medium); }
.category-tab.is-active { color:var(--xy-color-text-strong); font-weight:var(--xy-text-weight-bold); }
.category-tab.is-active::after { position:absolute; right:0; bottom:0; left:0; height:2px; background:var(--xy-color-brand); content:''; }

/* 来源筛选：28 高胶囊，间隔 8；上下各 12 */
.filter-scroll { width:100%; margin-top:var(--xy-space-3); white-space:nowrap; }
.filter-list { display:inline-flex; align-items:center; gap:var(--xy-space-2); padding:0 var(--xy-space-4); margin:calc(var(--xy-space-2) * -1) 0; }
.filter-chip { display:flex; align-items:center; min-height:var(--xy-size-touch-min); }
.filter-chip-label { display:flex; align-items:center; height:28px; padding:0 var(--xy-space-3); border-radius:var(--xy-radius-sm); background:var(--xy-color-surface); box-shadow:inset 0 0 0 1px var(--xy-color-border); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-medium); }
.filter-chip.is-active .filter-chip-label { background:var(--xy-color-text-strong); box-shadow:none; color:var(--xy-color-text-inverse); font-weight:var(--xy-text-weight-semibold); }

/* 瀑布流：两列各自排，间隔 12；卡片 px16 py12 */
.device-list { display:flex; align-items:flex-start; gap:var(--xy-space-3); padding:var(--xy-space-3) var(--xy-space-4) 0; }
.device-col { display:flex; flex-direction:column; gap:var(--xy-space-3); flex:1; min-width:0; }
.device-row { display:flex; flex-direction:column; min-height:var(--xy-size-touch-min); overflow:hidden; border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); }
.device-thumb { position:relative; width:100%; height:0; padding-bottom:100%; background:var(--xy-color-canvas-muted); }
.device-thumb .media-fill { position:absolute; inset:0; width:100%; height:100%; }
.device-copy { display:flex; flex-direction:column; padding:var(--xy-space-3) var(--xy-space-4); }
.device-name { display:-webkit-box; overflow:hidden; -webkit-box-orient:vertical; -webkit-line-clamp:2; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.device-meta { display:block; margin-top:var(--xy-space-1); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.device-source { font-weight:var(--xy-text-weight-semibold); color:var(--xy-color-brand); }
.device-source--store { color:var(--xy-color-warning); }
.device-source--personal { color:var(--xy-color-source-personal); }
.device-price-row { display:flex; align-items:baseline; justify-content:space-between; gap:var(--xy-space-2); margin-top:var(--xy-space-3); }
.device-price { display:flex; align-items:baseline; gap:calc(var(--xy-space-1) / 2); flex:none; }
.device-price-symbol { color:var(--xy-color-text-strong); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-bold); }
.device-price-amount { color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-heavy); }
.device-price-unit,.device-deposit { color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.device-price-missing { color:var(--xy-color-warning); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-bold); }
.device-deposit { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.device-deposit-value { color:var(--xy-color-text-secondary); }
.device-empty { margin:var(--xy-space-3) var(--xy-space-4) 0; }
.load-more { display:flex; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin-top:var(--xy-space-3); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.notice-copy { padding:var(--xy-space-3) var(--xy-space-4); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); text-align:center; }
