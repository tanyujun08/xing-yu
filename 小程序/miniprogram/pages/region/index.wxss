/* 重设计 第 1 批：灰底页；白色搜索框 → 快速选择（全部城市 + 热门城市，四列，当前选择绿框）→ 按字母分组的白卡列表 + 右侧字母索引 */
.region-page { display: flex; flex-direction: column; height: 100vh; min-height: 0; background: var(--xy-color-page); color: var(--xy-color-text-primary); }
.region-search { display: flex; align-items: center; height: var(--xy-size-touch-min); padding-left: var(--xy-space-3); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.city-section-title { display: block; margin: var(--xy-space-1) 0 var(--xy-space-2); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.city-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 var(--xy-space-2); }
.city-option { display: flex; align-items: stretch; min-width: 0; min-height: var(--xy-size-touch-min); padding: var(--xy-space-1) 0; box-sizing: border-box; }
.city-option-label { display: flex; align-items: center; justify-content: center; width: 100%; min-height: calc(var(--xy-space-6) + var(--xy-space-3)); box-sizing: border-box; padding: 0 var(--xy-space-1); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); overflow-wrap: anywhere; text-align: center; }
.city-option:active .city-option-label { background: var(--xy-color-surface-subtle); }
.city-option.is-current .city-option-label { box-shadow: inset 0 0 0 1px var(--xy-color-brand); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-weight: var(--xy-text-weight-semibold); }
.city-status { margin-top: var(--xy-space-4); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.city-error { display: flex; align-items: center; gap: var(--xy-space-2); margin-top: var(--xy-space-4); color: var(--xy-color-danger); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.city-retry { display: flex; min-height: var(--xy-size-touch-min); align-items: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.city-directory { margin-top: var(--xy-space-3); }
.city-group { overflow: hidden; border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); }
.city-group + .city-group { margin-top: var(--xy-space-3); }
.city-letter { display: block; padding: var(--xy-space-3) var(--xy-space-4) 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
.city-row { position: relative; display: flex; align-items: center; justify-content: space-between; gap: var(--xy-space-3); min-height: var(--xy-size-touch-min); box-sizing: border-box; padding: var(--xy-space-3) var(--xy-space-4); }
.city-row + .city-row::before { position: absolute; top: 0; right: 0; left: var(--xy-space-4); height: 1px; background: var(--xy-color-divider); content: ''; }
.city-row:active { background: var(--xy-color-surface-subtle); }
.region-search-wrap { flex: none; padding: var(--xy-space-2) var(--xy-layout-page-padding-x) var(--xy-space-3); }
.region-search > image { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-right: var(--xy-space-2); opacity: .6; }
.region-search input { flex: 1; min-width: 0; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.search-clear { display: flex; align-items: center; justify-content: center; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); }
.search-clear image { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.region-body { position: relative; flex: 1; min-height: 0; }
.region-scroll { width: 100%; height: 100%; }
.city-content { padding: 0 var(--xy-layout-page-padding-x) calc(var(--xy-space-6) + env(safe-area-inset-bottom)); }
.city-content.has-alpha-index { padding-right: calc(var(--xy-space-6) + var(--xy-space-2)); }
.search-title { margin-bottom: var(--xy-space-2); }
.city-row-name { min-width: 0; overflow-wrap: anywhere; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.city-current-mark { flex: none; display: inline-flex; height: 20px; align-items: center; padding: 0 var(--xy-space-1); border-radius: var(--xy-radius-sm); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-caption-line-height); }
.city-empty { display: flex; flex-direction: column; align-items: center; padding: var(--xy-space-6) 0; text-align: center; }
.city-empty-title { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.city-empty-help { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.alpha-index { position: absolute; top: 0; right: 0; bottom: calc(var(--xy-space-4) + env(safe-area-inset-bottom)); width: calc(var(--xy-space-6) + var(--xy-space-2)); }
.alpha-index-track { width: 100%; min-height: var(--xy-size-touch-min); }
.alpha-index-item { display: flex; align-items: center; justify-content: center; min-height: 20px; color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-caption-line-height); }
.locate-row { display: flex; min-height: calc(var(--xy-space-6) * 2); align-items: center; gap: var(--xy-space-3); margin-bottom: var(--xy-space-3); padding: 0 var(--xy-space-2) 0 var(--xy-space-4); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); }
.locate-city, .locate-status { display: flex; min-width: 0; min-height: var(--xy-size-touch-min); flex: 1; align-items: center; gap: var(--xy-space-2); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.locate-city { color: var(--xy-color-text-strong); font-weight: var(--xy-text-weight-semibold); }
.locate-status { color: var(--xy-color-text-muted); }
.locate-icon { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.locate-icon--muted { opacity: .5; }
.locate-retry { display: flex; flex: none; min-height: var(--xy-size-touch-min); align-items: center; padding: 0 var(--xy-space-2); color: var(--xy-color-brand); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); }
