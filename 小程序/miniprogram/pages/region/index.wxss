/* 视觉规范 v1：白底整页；搜索框 40 高圆角 8 灰底；当前城市行 → 24 → 热门城市（标题 12 灰 → 12 → 三列城市块 36 高圆角 4）→ 24 → 字母分组列表 */
.region-page { display: flex; flex-direction: column; height: 100vh; min-height: 0; background: var(--xy-color-surface); color: var(--xy-color-text-primary); }
.region-search-wrap { flex: none; padding: var(--xy-space-2) var(--xy-layout-page-padding-x) var(--xy-space-3); }
.region-search { display: flex; align-items: center; height: 40px; padding-left: var(--xy-space-3); border-radius: var(--xy-radius-lg); background: var(--xy-color-page); }
.region-search > image { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); margin-right: var(--xy-space-2); opacity: .6; }
.region-search input { flex: 1; min-width: 0; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.search-clear { display: flex; align-items: center; justify-content: center; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); }
.search-clear image { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.region-body { position: relative; flex: 1; min-height: 0; }
.region-scroll { width: 100%; height: 100%; }
.city-content { padding: 0 var(--xy-layout-page-padding-x) calc(var(--xy-space-6) + env(safe-area-inset-bottom)); }
.city-content.has-alpha-index { padding-right: calc(var(--xy-size-touch-min) + var(--xy-space-1)); }
.current-city { display: flex; align-items: center; gap: var(--xy-space-2); min-height: var(--xy-size-touch-min); }
.current-city-label { color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.current-city-value { flex: 1; min-width: 0; overflow-wrap: anywhere; color: var(--xy-color-brand); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-section-title-line-height); }
.current-city image { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); opacity: .6; }
.city-section { margin-top: var(--xy-space-4); }
.city-section-title { display: block; color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-medium); line-height: var(--xy-text-body-small-line-height); }
.city-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--xy-space-2); margin-top: var(--xy-space-2); }
.city-option { display: flex; align-items: stretch; min-width: 0; min-height: var(--xy-size-touch-min); padding: var(--xy-space-1) 0; box-sizing: border-box; }
.city-option-label { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 36px; box-sizing: border-box; padding: 0 var(--xy-space-2); border-radius: var(--xy-radius-sm); background: var(--xy-color-page); color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); overflow-wrap: anywhere; text-align: center; }
.city-option:active .city-option-label { background: var(--xy-color-border); }
.city-default-sections + .city-directory { margin-top: var(--xy-space-6); }
.city-directory { margin-top: var(--xy-space-6); }
.city-group + .city-group { margin-top: var(--xy-space-4); }
.is-searching .city-group + .city-group { margin-top: 0; }
.search-title { margin-bottom: var(--xy-space-2); }
.city-letter { display: block; margin-bottom: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-body-small-line-height); }
.city-row { display: flex; align-items: center; justify-content: space-between; gap: var(--xy-space-3); min-height: var(--xy-size-touch-min); box-sizing: border-box; padding: var(--xy-space-3) 0; border-bottom: 1px solid var(--xy-color-divider); }
.city-row:active { background: var(--xy-color-surface-subtle); }
.city-row-name { min-width: 0; overflow-wrap: anywhere; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.city-current-mark { flex: none; display: inline-flex; height: 20px; align-items: center; padding: 0 var(--xy-space-1); border-radius: var(--xy-radius-sm); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-caption-line-height); }
.city-empty { display: flex; flex-direction: column; align-items: center; padding: var(--xy-space-6) 0; text-align: center; }
.city-empty-title { color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.city-empty-help { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.alpha-index { position: absolute; top: 0; right: 0; bottom: calc(var(--xy-space-4) + env(safe-area-inset-bottom)); width: var(--xy-size-touch-min); }
.alpha-index-track { width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); }
.alpha-index-item { display: flex; align-items: center; justify-content: center; min-height: 20px; color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-caption-line-height); }
.city-content > .xy-action-hit { justify-content: flex-start; margin-top: var(--xy-space-3); color: var(--xy-color-brand); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
