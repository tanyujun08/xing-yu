<page-meta root-font-size="system" />
<import src="../../shared/design/discovery-device.wxml" />
<view class="stores-page {{largeType ? 'page--large' : ''}}">
<page-header title="{{secondaryNavigationTitle || '门店列表'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <view class="location-bar"><view class="location-row xy-tap" bindtap="chooseRegion" role="button" aria-label="选择城市"><image class="location-icon" src="{{icons.homeLocation}}" mode="aspectFit" /><text>{{regionCity}}</text><image class="location-caret" src="{{icons.homeChevronDown}}" mode="aspectFit" /></view><view class="mode-switch xy-tabs"><view class="mode-option xy-tab xy-tap"><text>柜机</text><button class="touch-overlay" hover-class="none" bindtap="openCabinets" aria-label="切换到柜机"></button></view><view class="mode-option xy-tab is-active" role="button" aria-label="当前为门店">门店<view class="xy-tab__indicator"></view></view></view></view>
  <view class="store-content">
    <scroll-view class="region-list" scroll-y="true" show-scrollbar="false"><view class="rail-label">区域</view><view wx:for="{{regions}}" wx:key="id" class="region-item xy-tap {{item.label === regionShort ? 'is-active' : ''}}" data-region="{{item.label}}" bindtap="selectRegion" role="button">{{item.label}}</view></scroll-view>
    <scroll-view class="store-panel" scroll-y="true" show-scrollbar="false" bindscrolltolower="loadMore">
      <block wx:if="{{stores.length}}">
        <view class="panel-context"><text class="panel-context-title">{{regionShort}}</text><text class="panel-context-count">{{stores.length}}家</text></view>
        <view wx:for="{{stores}}" wx:key="id" class="store-section">
          <view class="store-item-main xy-tap" data-id="{{item.id}}" bindtap="openStore" role="button" aria-label="查看{{item.name}}">
            <view class="store-gallery"><media-state class="store-gallery-image" state="{{item.gallery.length ? 'loading' : 'idle'}}" src="{{item.gallery[0] || ''}}" density="thumbnail" mode="aspectFill" placeholder-src="{{icons.deviceMark}}" empty-label="" alt="{{item.name}}图片" /></view>
            <view class="store-title-row"><text class="store-name">{{item.name}}</text><image class="store-open-arrow" src="{{icons.arrowRight}}" mode="aspectFit" /></view>
            <text class="store-address">{{item.addressLabel}}</text><text class="store-hours">{{item.hours || '营业时间待补充'}}</text>
            <view class="store-availability-row"><text class="store-availability">{{item.availabilityLabel}}</text><text>{{item.distance}}</text></view>
          </view>
          <view wx:if="{{item.featuredDevice}}" class="store-preview"><text class="preview-title">设备预览</text><block wx:for="{{item.devices}}" wx:for-item="previewDevice" wx:key="id"><template is="discovery-device" data="{{device: previewDevice, preview: true, narrow: true}}" /></block><view class="store-more xy-tap" data-id="{{item.id}}" bindtap="openStore" role="button">查看更多<image src="{{icons.arrowRight}}" mode="aspectFit" /></view></view>
          <view wx:else class="store-empty-copy">{{item.previewCopy}}</view>
        </view>
      </block>
      <view wx:if="{{errorText}}" class="xy-empty-page" role="alert"><text class="xy-empty-page__title">门店加载失败</text><text class="xy-empty-page__copy">{{errorText}}</text><button class="xy-action-primary xy-tap" bindtap="refreshStores">重新加载</button></view>
      <view wx:elif="{{loading}}" class="xy-empty-section">正在加载门店…</view>
      <view wx:elif="{{!stores.length && !hasMore}}" class="xy-empty-page xy-empty-page--surface"><image class="xy-empty-page__illustration" src="{{icons.emptyLocation}}" mode="aspectFit" /><text class="xy-empty-page__title">当前地区暂无门店</text><text class="xy-empty-page__copy">可以切换城市继续查看。</text><view class="xy-empty-page__action xy-action-primary xy-action-text xy-tap" bindtap="chooseRegion" role="button">切换城市</view></view>
      <button wx:if="{{hasMore && !loading}}" class="xy-action-secondary xy-tap" bindtap="loadMore">加载更多门店</button>
    </scroll-view>
  </view>
  <login-sheet id="login-sheet" bindwechatlogin="onWechatLogin" bindphonelogin="onPhoneLogin" bindlegal="onLoginLegal" />
</view>
