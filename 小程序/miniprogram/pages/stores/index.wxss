@import "../../shared/design/discovery-rail.wxss";
.stores-page { display:flex; flex-direction:column; height:100vh; min-height:0; background:var(--xy-color-surface); }
.location-bar { display:flex; flex:none; align-items:center; justify-content:space-between; min-height:56px; padding:0 var(--xy-space-4); border-bottom:1rpx solid var(--xy-color-divider); }
.location-row { display:flex; align-items:center; min-width:0; min-height:44px; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.location-icon { flex:none; width:20px; height:20px; margin-right:var(--xy-space-2); }
.location-caret { flex:none; width:16px; height:16px; margin-left:var(--xy-space-1); }
.mode-switch { display:flex; flex:none; gap:var(--xy-space-2); border:0; padding:0; }
.mode-option { position:relative; display:flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; padding:0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.mode-option.is-active { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.store-content { display:flex; flex:1; min-height:0; }
.store-panel { flex:1; width:0; min-width:0; height:100%; box-sizing:border-box; padding-bottom:calc(var(--xy-space-4) + env(safe-area-inset-bottom)); }
.panel-context { display:flex; align-items:baseline; justify-content:space-between; gap:var(--xy-space-2); padding:var(--xy-space-3) var(--xy-space-4); }
.panel-context-title { font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.panel-context-count { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.store-section { padding:var(--xy-space-4) var(--xy-space-4) 0; border-bottom:8px solid var(--xy-color-page); }
.store-section:last-child { border-bottom:0; }
.store-item-main { display:grid; grid-template-columns:72px minmax(0,1fr); grid-template-areas:'media name' 'media address' 'media hours' 'media count'; column-gap:var(--xy-space-3); row-gap:var(--xy-space-1); align-items:start; min-height:44px; }
.store-gallery { grid-area:media; position:relative; width:72px; height:72px; overflow:hidden; border-radius:var(--xy-radius-sm); }
.store-gallery-image { display:block; width:100%; height:100%; }
.store-title-row { grid-area:name; display:flex; align-items:flex-start; min-width:0; gap:var(--xy-space-2); }
.store-name { flex:1; min-width:0; overflow-wrap:anywhere; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.store-open-arrow { flex:none; width:16px; height:16px; margin-top:var(--xy-space-1); }
.store-address { grid-area:address; }
.store-hours { grid-area:hours; }
.store-address,.store-hours,.store-availability-row { min-width:0; overflow-wrap:anywhere; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-availability-row { grid-area:count; display:flex; flex-wrap:wrap; gap:var(--xy-space-1) var(--xy-space-2); }
.store-availability { color:var(--xy-color-text-primary); }
.store-preview { margin-top:var(--xy-space-3); padding-top:0; }
.preview-title { display:block; margin-bottom:0; color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.store-empty-copy { margin-top:var(--xy-space-3); padding:var(--xy-space-3) 0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.page--large .location-bar { flex-wrap:wrap; }
.page--large .location-row { flex-basis:100%; }
.page--large .mode-switch { margin-left:auto; }
.page--large .store-item-main { grid-template-columns:66px minmax(0,1fr); grid-template-areas:'media name' 'media address' 'media hours' 'media count'; }
.page--large .store-gallery { width:66px; height:66px; }
@media(max-width:390px) {  .store-item-main { grid-template-columns:66px minmax(0,1fr); grid-template-areas:'media name' 'media address' 'media hours' 'media count'; } .store-gallery { width:66px; height:66px; } }


.store-item-main { row-gap:var(--xy-space-1); }
.store-preview .xy-discovery-device { padding:var(--xy-space-3) 0; }
.store-more { margin:0; padding:var(--xy-space-4) 0; display:flex; justify-content:center; align-items:center; gap:var(--xy-space-1); min-height:0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.store-more image { width:12px; height:12px; }
/* Keep the existing visual carrier; constrain only its interaction box. */
.store-more { box-sizing:border-box; min-height:var(--xy-size-touch-min); }

.location-bar .mode-option::before { content:none; }

.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }
