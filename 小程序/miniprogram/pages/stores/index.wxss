.stores-page { display:flex; flex-direction:column; height:100vh; min-height:0; background:var(--xy-color-page); }
.location-bar { display:flex; flex:none; align-items:center; justify-content:space-between; background:var(--xy-color-surface); min-height:56px; padding:0 var(--xy-space-4); border-bottom:1rpx solid var(--xy-color-divider); }
.location-row { display:flex; align-items:center; min-width:0; min-height:44px; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.location-icon { flex:none; width:20px; height:20px; margin-right:var(--xy-space-2); }
.location-caret { flex:none; width:16px; height:16px; margin-left:var(--xy-space-1); }
.mode-switch { display:flex; flex:none; gap:var(--xy-space-2); border:0; padding:0; }
.mode-option { position:relative; display:flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; padding:0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.mode-option.is-active { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.page--large .location-bar { flex-wrap:wrap; }
.page--large .location-row { flex-basis:100%; }
.page--large .mode-switch { margin-left:auto; }
.location-bar .mode-option::before { content:none; }
.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }

.store-scroll { box-sizing:border-box; flex:1; min-height:0; width:100%; padding-bottom:calc(var(--xy-space-4) + env(safe-area-inset-bottom)); }
.chips { white-space:nowrap; padding:var(--xy-space-3) 0 0; }
.chips__row { display:inline-flex; gap:var(--xy-space-2); padding:0 var(--xy-layout-page-padding-x); }
.chip { position:relative; display:inline-flex; align-items:center; gap:var(--xy-space-1); padding:var(--xy-space-1) var(--xy-space-3); border-radius:var(--xy-radius-pill); background:var(--xy-color-surface); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-body-line-height); }
.chip.is-on { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-weight:var(--xy-text-weight-semibold); }
.chip__n { font-size:var(--xy-text-caption-size); opacity:.7; }
.sortbar { display:flex; align-items:baseline; justify-content:space-between; padding:var(--xy-space-2) var(--xy-layout-page-padding-x) var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.sortbar text:first-child { color:var(--xy-color-text-primary); font-weight:var(--xy-text-weight-semibold); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.shop { margin:0 var(--xy-layout-page-padding-x) var(--xy-space-3); padding:var(--xy-space-3); border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-raised); }
.shop__head { display:flex; min-height:var(--xy-size-touch-min); align-items:center; gap:var(--xy-space-3); }
.shop__thumb { position:relative; flex:none; width:calc(var(--xy-space-6) * 3); height:calc(var(--xy-space-6) * 3); overflow:hidden; border-radius:var(--xy-radius-md); background:var(--xy-color-brand-soft); }
.shop__info { display:flex; min-width:0; flex:1; flex-direction:column; gap:var(--xy-space-1); }
.shop__line { display:flex; align-items:center; gap:var(--xy-space-2); min-width:0; }
.shop__title { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); font-weight:var(--xy-text-weight-semibold); color:var(--xy-color-text-primary); }
.shop__count { flex:none; color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.shop__sub { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.shop__chip { flex:none; padding:0 var(--xy-space-1); border-radius:var(--xy-radius-sm); background:var(--xy-color-well); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.shop__chip.is-ok { background:var(--xy-color-brand-soft); color:var(--xy-color-brand); }
.shop__body { padding:0; }
.shelf { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:var(--xy-space-3) var(--xy-space-2); padding:var(--xy-space-3) 0 var(--xy-space-3); border-bottom:var(--xy-space-0-5) solid var(--xy-color-border-weak); }
.slot { display:flex; min-width:0; min-height:var(--xy-size-touch-min); flex-direction:column; gap:var(--xy-space-1); }
.sq { position:relative; width:100%; aspect-ratio:1; overflow:hidden; border-radius:var(--xy-radius-md); background:var(--xy-color-well); }
.sq__img { position:absolute; left:0; top:0; display:block; width:100%; height:100%; }
.slot__name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-semibold); }
.slot__price { color:var(--xy-color-text-primary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-bold); font-variant-numeric:tabular-nums; white-space:nowrap; }
.slot__yen,.slot__unit { font-size:var(--xy-text-caption-size); }
.slot__unit { color:var(--xy-color-text-secondary); font-weight:var(--xy-text-weight-regular); }
.slot--low .slot__price { color:var(--xy-color-brand); }
.shop__empty { padding:var(--xy-space-4) 0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.shop__more { display:flex; align-items:center; gap:var(--xy-space-2); padding-top:var(--xy-space-3); }
.shop__order { flex:1; min-width:0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.shop__pill { position:relative; display:flex; align-items:center; gap:var(--xy-space-1); padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-pill); background:var(--xy-color-well); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-medium); }
.shop__pill image { width:var(--xy-size-icon-xs); height:var(--xy-size-icon-xs); }
.shop__pill--main { background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.page--large .shelf { grid-template-columns:repeat(2, minmax(0, 1fr)); }
.hit-area { position:absolute; left:0; right:0; top:50%; min-height:var(--xy-size-touch-min); transform:translateY(-50%); }

.mini { position:relative; display:flex; min-height:var(--xy-size-touch-min); align-items:center; gap:var(--xy-space-3); margin:0 var(--xy-layout-page-padding-x) var(--xy-space-3); padding:var(--xy-space-2); border-radius:var(--xy-radius-lg); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-raised); box-sizing:border-box; }
.mini__thumb { position:relative; flex:none; width:calc(var(--xy-space-6) * 2 + var(--xy-space-2)); height:calc(var(--xy-space-6) * 2 + var(--xy-space-2)); overflow:hidden; border-radius:var(--xy-radius-md); background:var(--xy-color-brand-soft); }
.mini__info { display:flex; min-width:0; flex:1; flex-direction:column; gap:var(--xy-space-1); }
.mini__name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.mini__meta { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.mini__status.is-ok { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.mini__price { display:flex; flex:none; flex-direction:column; align-items:flex-end; gap:var(--xy-space-1); }
.mini__from { color:var(--xy-color-brand); font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); font-weight:var(--xy-text-weight-bold); font-variant-numeric:tabular-nums; white-space:nowrap; }
.mini__yen,.mini__unit { font-size:var(--xy-text-caption-size); font-weight:var(--xy-text-weight-regular); }
.mini__count { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.mini__chev { flex:none; width:var(--xy-size-icon-base); height:var(--xy-size-icon-base); }

.mini__open { position:relative; flex:none; display:flex; align-items:center; justify-content:center; width:var(--xy-size-icon-base); height:var(--xy-size-icon-base); }
.hit-area--chev { left:50%; right:auto; width:var(--xy-size-touch-min); transform:translate(-50%, -50%); }
.sortbar--sub { padding-top:var(--xy-space-1); }
.slot__tag { margin-left:var(--xy-space-1); padding:0 var(--xy-space-1); border-radius:var(--xy-radius-sm); background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); font-weight:var(--xy-text-weight-semibold); }

.mode-seg { display:flex; flex:none; width:calc(var(--xy-space-6) * 6 + var(--xy-space-3)); padding:var(--xy-space-0-5); border-radius:var(--xy-radius-md); background:var(--xy-color-border); box-sizing:border-box; }
.mode-seg__item { position:relative; display:flex; flex:1; align-items:center; justify-content:center; min-height:var(--xy-button-height-small); border-radius:var(--xy-radius-sm); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-medium); }
.mode-seg__item.is-on { background:var(--xy-color-surface); color:var(--xy-color-text-strong); font-weight:var(--xy-text-weight-bold); box-shadow:var(--xy-shadow-segment); }
.location-row text { font-weight:var(--xy-text-weight-bold); }
