.support-badge { margin-left:var(--xy-space-1); padding:var(--xy-space-1); border-radius:var(--xy-radius-pill); color:var(--xy-color-text-inverse); background:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.support-copy { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
