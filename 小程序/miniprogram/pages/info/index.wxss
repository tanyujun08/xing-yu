/* 沟通页：官方客服白卡 → 绿竖条分组标题 → 会话合并成一张白卡、行间细线。 */
.info-page { min-height:100vh; box-sizing:border-box; padding:0 var(--xy-space-4) var(--xy-fixed-tab-clearance); background:var(--xy-color-page); color:var(--xy-color-text-primary); }
.info-content { padding-top:var(--xy-space-3); }

/* 官方客服卡：头像 48 圆形绿底 */
.support-row { display:block; width:100%; min-height:var(--xy-size-touch-min); margin:0; padding:var(--xy-space-4); box-sizing:border-box; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); text-align:left; }
.support-row:active { background:var(--xy-color-surface-subtle); }
.conversation-main { display:flex; align-items:center; gap:var(--xy-space-3); min-width:0; }
.support-avatar { display:flex; flex:none; width:48px; height:48px; align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-brand); }
.support-avatar .support-icon { width:var(--xy-size-icon-lg); height:var(--xy-size-icon-lg); }
.support-row .conversation-name { display:flex; align-items:center; gap:var(--xy-space-2); }
.support-badge { flex:none; padding:0 var(--xy-inset-chip-compact-x); border-radius:var(--xy-radius-sm); background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); font-weight:var(--xy-text-weight-semibold); }
.support-copy { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.support-copy + .support-copy { margin-top:0; color:var(--xy-color-text-muted); }
.support-arrow { flex:none; color:var(--xy-color-text-muted); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }

/* 分组标题：区块间 24，标题到内容 12，前面绿竖条 */
.directory-heading { display:flex; align-items:center; justify-content:space-between; min-height:var(--xy-text-section-title-line-height); margin:var(--xy-space-6) 0 var(--xy-space-3); color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.directory-heading > text { display:flex; align-items:center; }
.directory-heading > text::before { display:inline-block; width:var(--xy-space-1); height:var(--xy-space-4); margin-right:var(--xy-space-2); border-radius:var(--xy-radius-pill); background:var(--xy-color-brand); content:''; }
.directory-heading .info-text-action { margin:calc((var(--xy-size-touch-min) - var(--xy-text-section-title-line-height)) / -2) calc(var(--xy-space-2) * -1) calc((var(--xy-size-touch-min) - var(--xy-text-section-title-line-height)) / -2) 0; color:var(--xy-color-text-muted); font-weight:var(--xy-text-weight-regular); }

/* 会话列表：一张白卡，行内 16，细线从文字左缘开始 */
.conversation-list { overflow:hidden; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.conversation-row { position:relative; display:flex; align-items:flex-start; width:100%; min-height:var(--xy-size-touch-min); margin:0; padding:var(--xy-space-4); gap:var(--xy-space-3); box-sizing:border-box; border:0; border-radius:0; background:var(--xy-color-surface); text-align:left; }
.conversation-row:active { background:var(--xy-color-surface-subtle); }
.conversation-row + .conversation-row::before { position:absolute; top:0; right:var(--xy-space-4); left:calc(var(--xy-space-4) + 48px + var(--xy-space-3)); height:1rpx; background:var(--xy-color-divider); content:''; }
.conversation-avatar { display:flex; flex:none; width:48px; height:48px; align-items:center; justify-content:center; overflow:hidden; border-radius:50%; background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-section-title-size); font-weight:var(--xy-text-weight-semibold); }
.conversation-avatar image { width:100%; height:100%; }
.conversation-copy { flex:1; min-width:0; text-align:left; }
.conversation-head { display:flex; flex-wrap:wrap; align-items:center; gap:var(--xy-space-2); }
.conversation-name { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-strong); font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.conversation-role { flex:none; padding:0 var(--xy-inset-chip-compact-x); border-radius:var(--xy-radius-sm); background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.conversation-preview { display:block; margin-top:var(--xy-space-1); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.conversation-preview:last-child { color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.conversation-meta { display:block; margin-top:var(--xy-gap-label-value-compact); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.conversation-trailing { display:flex; flex:none; flex-direction:column; align-items:flex-end; gap:var(--xy-space-2); }
.conversation-time { color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); white-space:nowrap; }
.conversation-unread { flex:none; display:flex; align-items:center; justify-content:center; min-width:var(--xy-text-caption-line-height); padding:0 var(--xy-space-1); box-sizing:border-box; border-radius:var(--xy-radius-pill); background:var(--xy-color-danger); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); text-align:center; font-weight:var(--xy-text-weight-semibold); }

/* 文本操作、反馈、空态 */
.info-text-action { display:inline-flex; align-items:center; justify-content:center; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); margin:0; padding:0 var(--xy-space-2); background:transparent; color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.info-feedback { display:flex; flex-wrap:wrap; align-items:center; gap:var(--xy-space-2); margin-top:var(--xy-space-2); color:var(--xy-color-danger); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.info-loading { margin-top:var(--xy-space-3); padding:var(--xy-space-6) var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); text-align:center; }
.info-empty { min-height:360px; margin-top:0; padding:var(--xy-space-6) var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.info-empty .xy-empty-page__illustration { width:200px; max-width:100%; height:150px; margin-bottom:var(--xy-space-3); }
.info-empty .xy-empty-page__copy { margin-top:var(--xy-space-1); }
.info-order-action { display:flex; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin:var(--xy-space-4) 0 0; padding:0 var(--xy-space-6); border-radius:var(--xy-radius-md); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.info-order-action:active { background:var(--xy-color-brand-pressed); }
.directory-more { width:100%; border-top:1rpx solid var(--xy-color-divider); }
.directory-end { display:block; padding:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); text-align:center; }
