.conversation-list { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.conversation-row { display:flex; align-items:flex-start; width:100%; min-height:96px; margin:0; padding:var(--xy-space-4); gap:var(--xy-space-3); border-radius:var(--xy-radius-md); border:0; background:var(--xy-color-surface); box-sizing:border-box; }
