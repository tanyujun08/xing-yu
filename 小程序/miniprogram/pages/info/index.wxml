<page-meta root-font-size="system" />
<view class="info-page">
  <page-header variant="order-primary" title="沟通" show-back="{{false}}" />
  <view class="info-content">
    <view class="support-wrap"><button class="xy-button-reset support-row" bindtap="demoSupport" binderror="contactError" aria-label="官方客服，点击进入微信客服">
      <view class="support-icon-wrap"><image src="{{icons.orderSupport}}" class="support-icon" mode="aspectFit" aria-hidden="true" /></view>
      <view class="support-copy-wrap"><text class="support-name">官方客服</text><text class="support-copy">租赁、押金、售后问题都可以问</text></view>
      <text class="support-arrow" aria-hidden="true">›</text>
    </button></view>
    <text wx:if="{{supportError}}" class="info-feedback">{{supportError}}</text>
    <view class="seg" role="tablist">
      <view class="seg-item xy-tap {{filter === 'all' ? 'is-on' : ''}}" data-filter="all" bindtap="chooseFilter" role="tab">全部</view>
      <view class="seg-item xy-tap {{filter === 'rent' ? 'is-on' : ''}}" data-filter="rent" bindtap="chooseFilter" role="tab">我租的</view>
      <view class="seg-item xy-tap {{filter === 'lease' ? 'is-on' : ''}}" data-filter="lease" bindtap="chooseFilter" role="tab">我出租的</view>
    </view>
    <view wx:if="{{errorText}}" class="info-feedback" role="alert"><text>{{errorText}}</text><button class="xy-button-reset info-text-action" bindtap="refresh">重试</button></view>
    <view wx:if="{{!loggedIn}}" class="xy-empty-page info-empty"><image class="xy-empty-page__illustration" src="{{icons.orderEmptyMessages}}" mode="aspectFit" aria-hidden="true" /><text class="xy-empty-page__title">登录后查看订单会话</text><text class="xy-empty-page__copy">与出租方或承租方继续沟通</text><button class="xy-button-reset info-text-action" bindtap="openLogin">登录</button></view>
    <view wx:elif="{{loading && !loaded}}" class="info-loading">正在读取订单会话…</view>
    <view wx:elif="{{loaded && !errorText && !conversations.length}}" class="xy-empty-page info-empty"><image class="xy-empty-page__illustration" src="{{icons.orderEmptyMessages}}" mode="aspectFit" aria-hidden="true" /><text class="xy-empty-page__title">暂无订单会话</text><text class="xy-empty-page__copy">与订单相关的聊天会显示在这里</text><button class="xy-button-reset info-order-action" bindtap="openOrders">去查看订单</button></view>
    <view wx:elif="{{loaded && !groups.length}}" class="info-loading">这个分类下没有会话</view>
    <block wx:else>
      <view wx:for="{{groups}}" wx:for-item="group" wx:key="key" class="cgroup">
        <view class="cgroup-title"><text>{{group.title}}</text><text class="cgroup-count">{{group.items.length}}</text></view>
        <view class="conversation-list">
          <button wx:for="{{group.items}}" wx:key="id" class="xy-button-reset conversation-row {{item.tone === 'end' ? 'is-end' : ''}}" data-id="{{item.id}}" bindtap="openConversation" aria-label="{{item.counterpartName}} {{item.counterpartRoleText}} {{item.deviceName}} {{item.lastMessage}} {{item.unreadText ? item.unreadText + '条未读' : ''}}">
            <view class="conversation-avatar"><image wx:if="{{item.avatarURL}}" src="{{item.avatarURL}}" mode="aspectFill" /><text wx:else>{{item.avatarText}}</text></view>
            <view class="conversation-copy">
              <view class="line1"><text class="conversation-name">{{item.counterpartName}}</text><text class="conversation-role">{{item.counterpartRoleText}}</text><text class="conversation-time" aria-label="{{item.timeText}}">{{item.shortTimeText}}</text></view>
              <view class="line2"><text class="chip chip--{{item.tone}}">{{item.statusText}}</text><text class="line2-text">{{item.deviceName}} · {{item.periodShort}}</text></view>
              <view class="line3"><text class="conversation-preview">{{item.lastMessage}}</text><text wx:if="{{item.unreadText}}" class="conversation-unread">{{item.unreadText}}</text></view>
            </view>
          </button>
        </view>
      </view>
      <button wx:if="{{hasMore}}" class="xy-button-reset info-text-action directory-more" bindtap="loadMore" disabled="{{loadingMore}}" aria-disabled="{{loadingMore}}">{{loadingMore ? '读取中…' : '加载更多会话'}}</button>
      <text wx:elif="{{loaded && conversations.length}}" class="directory-end">已显示全部会话</text>
    </block>
  </view>
</view>
<login-sheet id="login-sheet" bindwechatlogin="onWechatLogin" bindphonelogin="onPhoneLogin" bindlegal="onLoginLegal" />
