<page-meta root-font-size="system" />
<view class="level-page member-theme tier-{{tierKey}}">
  <view class="member-page-light" aria-hidden="true"></view>
  <page-header title="{{secondaryNavigationTitle || '等级与权益'}}" background="{{headerScrolled ? 'var(--xy-color-page, #F5F5F7)' : 'transparent'}}" bindback="onSecondaryNavigationBack" />
  <view class="member-layout">
    <text wx:if="{{errorText}}" class="member-notice" role="status">{{errorText}}</text>
    <view class="level-hero">
      <view class="level-hero-copy">
        <text wx:if="{{tierKey}}" class="level-current">✦ 当前等级</text>
        <text class="level-hero-title member-tier-name">{{level}}</text>
        <view class="level-balance"><text class="member-points-number">{{starPoints}}</text><text class="member-unit">星光</text></view>
        <block wx:if="{{tierKey}}">
          <view class="member-track" aria-label="当前等级进度 {{progress}}%"><view class="member-fill" style="width:{{progress}}%;"></view></view>
          <view class="level-range"><text>{{currentLevelName}} {{currentThreshold}}</text><text>{{hasNextLevel ? nextLevel + ' ' + nextThreshold : '最高等级'}}</text></view>
        </block>
      </view>
      <view wx:if="{{heroVisual}}" class="level-visual tier-{{heroVisual.key}}">
        <view wx:if="{{heroVisual.showStand}}" class="level-stand" aria-hidden="true"></view>
        <image class="level-art {{heroVisual.showStand ? 'level-art--floating' : ''}}" src="{{heroVisual.src}}" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

    <view wx:if="{{levels.length}}" class="level-rail" aria-label="会员成长路线">
      <view class="level-rail-track" style="--rail-progress: {{railProgress}}%;" aria-hidden="true"></view>
      <view wx:for="{{levels}}" wx:key="key" class="level-node level-node--{{item.state}} {{item.next ? 'level-node--next' : ''}}" style="margin-top:{{(6 - index) * 6}}px;" aria-label="{{item.name}}，{{item.state === 'locked' && !item.next ? '未解锁' : item.statusLabel}}">
        <view class="level-dot" aria-hidden="true"><view wx:if="{{item.state === 'locked'}}" class="level-lock"></view><text wx:else>{{item.state === 'passed' ? '✓' : '✦'}}</text></view>
        <text class="level-name">{{item.name}}</text>
      </view>
    </view>

    <view wx:if="{{tierKey}}" class="member-surface level-next">
      <view class="level-next-heading">
        <view class="level-next-copy">
          <text wx:if="{{hasNextLevel}}" class="level-next-title">距{{nextLevel}}还差 <text class="level-next-amount">{{remainingPoints}} 星光</text></text>
          <text wx:else class="level-next-title">已达最高等级</text>
          <text class="member-secondary">{{rightsCaption}}</text>
        </view>
        <view wx:if="{{panelVisual}}" class="level-next-visual tier-{{panelVisual.key}}">
          <view wx:if="{{panelVisual.showStand}}" class="level-stand" aria-hidden="true"></view>
          <image class="level-art {{panelVisual.showStand ? 'level-art--floating' : ''}}" src="{{panelVisual.src}}" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>
      <view class="level-benefits">
        <view class="level-benefit"><view class="level-benefit-icon" aria-hidden="true"><image src="{{icons.membershipTaskWaiver}}" mode="aspectFit" /></view><text>信用免押</text></view>
        <view class="level-benefit"><view class="level-benefit-icon" aria-hidden="true"><image src="{{icons.membershipTaskQuota}}" mode="aspectFit" /></view><text>出租发布额度</text></view>
      </view>
      <view class="level-actions">
        <button wx:if="{{hasNextLevel}}" class="xy-button-reset primary-button level-button" bindtap="openGrowthTasks">去做升级任务</button>
        <button wx:elif="{{atMaxLevel}}" class="xy-button-reset primary-button level-button" bindtap="showCurrentBenefits">查看当前权益</button>
        <button class="xy-button-reset secondary-button level-button level-button--overview" bindtap="showStarOverview">星光概览</button>
      </view>
    </view>

    <view wx:if="{{loggedIn && !tierKey}}" class="member-section">
      <text class="member-section-title">当前权益</text>
      <view class="member-surface member-list">
        <view wx:for="{{currentBenefits}}" wx:key="id" class="level-benefit-line">
          <text class="member-row-title">{{item.label}}</text><text class="member-secondary">{{item.value}}</text>
        </view>
        <text wx:if="{{!currentBenefits.length}}" class="level-empty">暂无可展示的权益</text>
      </view>
    </view>

    <view wx:if="{{levels.length}}" class="member-section">
      <view class="level-rules-header"><text class="member-section-title">等级规则</text><text class="member-secondary">按累计星光评定等级</text></view>
      <view class="member-surface level-rules">
        <view class="level-rule level-rule--heading"><text class="level-rule-name">等级</text><text class="level-rule-value">所需星光</text><text class="level-rule-status">状态</text></view>
        <view wx:for="{{levels}}" wx:key="key" class="level-rule level-rule--{{item.state}}">
          <text class="level-rule-name">{{item.name}}会员</text><text class="level-rule-value">{{item.threshold}}</text>
          <view class="level-rule-status"><text class="{{item.state === 'locked' ? '' : 'level-state-pill'}}">{{item.statusLabel}}</text></view>
        </view>
      </view>
    </view>
  </view>
</view>
