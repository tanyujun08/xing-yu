@import "../../shared/design/member-subpage.wxss";

.level-badge {
  flex: none;
  padding: var(--xy-space-1) var(--xy-space-2);
  border: 1rpx solid var(--xy-member-color-gold-overlay);
  border-radius: var(--xy-radius-pill);
  color: var(--xy-member-color-gold);
  font-size: var(--xy-text-caption-size);
  font-weight: var(--xy-text-weight-semibold);
  letter-spacing: 1rpx;
}

.level-rail {
  width: 100%; margin-top: var(--xy-layout-card-stack-start-gap); border: 0;
  border-radius: var(--xy-radius-container);
  background: var(--xy-color-surface); box-shadow: none;
}

.level-rail__inner {
  position: relative;
  display: flex;
  min-width: 980rpx;
  padding: var(--xy-space-4) var(--xy-inset-card) var(--xy-inset-card);
}

.level-rail__inner::before {
  position: absolute;
  top: 49rpx;
  right: 74rpx;
  left: 74rpx;
  height: 3rpx;
  background: var(--xy-member-color-green-muted-border);
  content: '';
}

.level-node {
  position: relative;
  z-index: var(--xy-z-local);
  display: flex;
  flex: 0 0 134rpx;
  align-items: center;
  flex-direction: column;
}

.level-node__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  border: 1rpx solid var(--xy-member-color-green-border-soft);
  border-radius: 50%;
  background: var(--xy-member-color-page);
  color: var(--xy-member-color-neutral);
  font-size: var(--xy-text-caption-size);
  font-weight: var(--xy-text-weight-semibold);
}

.level-node--passed .level-node__dot {
  border-color: var(--xy-color-brand);
  background: var(--xy-color-brand);
  color: var(--xy-member-color-white);
}

.level-node--current .level-node__dot {
  width: 40rpx;
  height: 40rpx;
  margin-top: calc(-1 * var(--xy-gap-label-value-compact));
  border-color: var(--xy-member-color-gold-bronze);
  background: var(--xy-color-brand);
  box-shadow: var(--xy-member-shadow-gold-focus);
  color: var(--xy-member-color-gold);
}

.level-node__name {
  margin-top: var(--xy-space-2);
  color: var(--xy-color-text-muted);
  font-size: var(--xy-text-body-small-size);
  font-weight: var(--xy-text-weight-semibold);
  line-height: var(--xy-text-body-small-line-height);
  white-space: nowrap;
}

.level-node--current .level-node__name {
  color: var(--xy-color-text-primary);
}

.level-node__threshold {
  margin-top: var(--xy-gap-label-value-compact);
  color: var(--xy-color-text-muted);
  font-family: var(--xy-font-family-numeric);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}

.level-rule--current {
  background: var(--xy-member-color-gold-surface-warm);
  box-shadow: inset 4rpx 0 var(--xy-member-color-gold-bronze);
}

.level-rule--current::after {
  display: none;
}

.level-rule__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--xy-radius-container);
  background: var(--xy-member-color-neutral-light);
  color: var(--xy-color-brand);
  font-size: var(--xy-text-body-size);
  font-weight: var(--xy-text-weight-semibold);
}

.level-rule__mark--current {
  background: var(--xy-member-color-pink-surface-light);
  color: var(--xy-member-color-gold-deep);
}

.level-rule__mark--locked {
  background: var(--xy-member-color-muted-bg);
  color: var(--xy-member-color-muted-text);
}

.benefit-chip-list {
  display: flex;
  flex-direction: column; margin-top: var(--xy-layout-card-stack-start-gap);
  overflow: hidden; border: 0;
  border-radius: var(--xy-radius-container);
  background: var(--xy-color-surface); box-shadow: none;
}

.benefit-chip {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: var(--xy-inset-card);
  border-bottom: 0;
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-size);
  line-height: var(--xy-text-body-line-height);
}

.benefit-chip:not(:last-child)::after {
  position: absolute;
  right: var(--xy-inset-card);
  bottom: 0;
  left: var(--xy-inset-card);
  height: 1rpx;
  background: var(--xy-color-divider);
  content: '';
}

.benefit-chip image {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
  margin-right: var(--xy-space-2);
}

.member-subpage__button {
  min-height: var(--xy-size-touch-min);
}
