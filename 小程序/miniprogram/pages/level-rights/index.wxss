@import "../../shared/design/member-center.wxss";

.level-page { --level-accent: var(--xy-color-brand); }
.level-page.tier-royal { --level-accent: var(--member-accent); }
.level-page .member-page-light { opacity: .55; }

.level-hero { display: flex; align-items: center; min-height: 155px; padding: 0 var(--xy-space-2); }
.level-hero-copy { flex: 1; min-width: 0; position: relative; z-index: 1; }
.level-current {
  display: inline-block;
  padding: var(--xy-gap-label-value-compact) var(--xy-space-2);
  border-radius: var(--xy-radius-pill);
  color: var(--level-accent);
  background: var(--xy-color-glass-soft);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
  font-weight: var(--xy-text-weight-semibold);
}
.level-hero-title { display: block; margin-top: var(--xy-gap-related); }
.level-balance { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--xy-gap-label-value); margin-bottom: var(--xy-gap-group); }
.level-balance .member-unit { color: var(--xy-color-text-secondary); }
.level-hero .member-track { border: 1px solid var(--xy-color-surface); }
.level-hero .member-fill { background: linear-gradient(90deg, var(--member-shade), var(--level-accent)); }
.level-range {
  display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--xy-gap-label-value);
  margin-top: var(--xy-gap-label-value);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-caption-size);
  line-height: var(--xy-text-caption-line-height);
}
.level-visual, .level-next-visual { position: relative; flex: none; aspect-ratio: 1; }
.level-visual {
  width: 46%; max-width: 208px; margin-left: var(--xy-gap-label-value);
  background: radial-gradient(ellipse at 52% 58%, rgba(255,255,255,.72), transparent 68%);
}
.level-art { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; }
.level-art--floating { transform: translateY(-9%) scale(.9); }
.level-next-visual.tier-stellar .level-art--floating,
.level-visual.tier-stellar .level-art--floating { transform: translateY(-5%) scale(.78); }
.level-stand {
  position: absolute;
  bottom: 11%; left: 19%; right: 19%; height: 11%;
  border: 1px solid var(--xy-color-surface);
  border-radius: 50% / 40%;
  background: linear-gradient(100deg, var(--member-ambient), var(--xy-color-surface), var(--member-ambient));
  box-shadow: 0 5px 10px -5px var(--member-shade);
}
.level-stand::before {
  content: ''; position: absolute; top: -17%; left: 0; right: 0; height: 50%;
  box-sizing: border-box; border: 1px solid var(--xy-color-surface); border-radius: 50%;
  background: radial-gradient(ellipse, var(--xy-color-surface), var(--member-ambient));
}

.level-rail { display: flex; position: relative; margin: var(--xy-gap-group) 0 var(--xy-space-4); }
.level-rail-track {
  position: absolute;
  top: calc(var(--xy-size-icon-nav) / 2 - 1px); left: calc(100% / 14); right: calc(100% / 14); height: 38px;
  background: linear-gradient(90deg, var(--level-accent) var(--rail-progress), var(--xy-color-border) var(--rail-progress));
  clip-path: polygon(0 36px, 100% 0, 100% 2px, 0 100%);
}
.level-node { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: var(--xy-gap-label-value); }
.level-dot {
  display: flex; align-items: center; justify-content: center;
  width: var(--xy-size-icon-nav); height: var(--xy-size-icon-nav); box-sizing: border-box;
  border-radius: var(--xy-radius-circle); border: 1px solid var(--xy-color-surface);
  background: var(--xy-color-canvas-muted); color: var(--xy-color-text-secondary);
  box-shadow: var(--xy-shadow-raised);
  font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-bold);
}
.level-lock { position: relative; width: 8px; height: 6px; margin-top: 3px; border-radius: 1px; background: currentColor; }
.level-lock::before {
  content: ''; position: absolute; box-sizing: border-box;
  top: -4px; left: 2px; width: 4px; height: 5px;
  border: 1px solid currentColor; border-radius: 2px 2px 0 0;
}
.level-name {
  padding: 0 var(--xy-space-1); white-space: nowrap;
  font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); color: var(--xy-color-text-secondary);
}
.level-node--current .level-dot { background: var(--level-accent); color: var(--xy-color-text-inverse); box-shadow: 0 0 0 2px var(--member-ambient); }
.level-node--current .level-name { color: var(--xy-color-text-inverse); background: var(--level-accent); border-radius: var(--xy-radius-pill); font-weight: var(--xy-text-weight-bold); }
.level-node--next .level-dot { background: var(--xy-color-surface); border-color: var(--xy-color-border-strong); }
.level-node--next .level-name { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); }

.level-next {
  padding: var(--xy-space-4);
  border-radius: var(--xy-radius-sheet);
  background: radial-gradient(ellipse at 95% 0%, var(--xy-member-color-surface-muted), transparent 56%), var(--xy-color-surface);
}
.level-next-heading { display: flex; align-items: center; justify-content: space-between; gap: var(--xy-gap-related); }
.level-next-copy { flex: 1; min-width: 0; }
.level-next-title {
  display: block;
  font-size: var(--xy-text-section-title-size);
  font-weight: var(--xy-text-weight-bold);
  line-height: var(--xy-text-section-title-line-height);
}
.level-next-amount { color: var(--level-accent); white-space: nowrap; }
.level-next-copy .member-secondary { display: block; margin-top: var(--xy-gap-title-description); }
.level-next-visual { width: 25%; max-width: 88px; }
.level-benefits { display: flex; gap: var(--xy-gap-related); border-top: 1px solid var(--xy-color-divider); padding: var(--xy-gap-group) 0; }
.level-benefit {
  flex: 1; min-width: 0; display: flex; align-items: center; gap: var(--xy-gap-related);
  font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height);
  font-weight: var(--xy-text-weight-semibold);
}
.level-benefit-icon {
  flex: none; display: flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; border-radius: var(--xy-radius-container);
  background: var(--xy-color-icon-carrier);
}
.level-benefit-icon image { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.level-actions { display: flex; gap: var(--xy-gap-related); }
.level-page .level-button {
  flex: 1; min-width: 0; margin: 0; padding: var(--xy-space-1);
  border-radius: var(--xy-radius-container); text-align: center;
}
.level-page .level-button--overview { border: 0; background: var(--xy-member-color-surface-muted); }
.level-benefit-line {
  min-height: var(--xy-row-height-a);
  display: flex; align-items: center; justify-content: space-between; gap: var(--xy-gap-related);
}
.level-benefit-line + .level-benefit-line { border-top: 1px solid var(--xy-color-divider); }
.level-empty {
  display: block; padding: var(--xy-inset-card) 0;
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height);
}

.level-rules-header {
  display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;
  gap: var(--xy-gap-related); margin-bottom: var(--xy-layout-title-content-gap);
}
.level-rules-header .member-section-title { margin-bottom: 0; }
.level-rules { padding: var(--xy-space-1) var(--xy-space-2); border-radius: var(--xy-radius-sheet); }
.level-rule {
  display: flex; align-items: center; min-height: var(--xy-row-height);
  padding: 0 var(--xy-space-2); border-bottom: 1px solid var(--xy-color-divider);
  font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height);
  font-variant-numeric: tabular-nums;
}
.level-rule-name { flex: 1.2; }
.level-rule-value, .level-rule-status { flex: 1; text-align: right; }
.level-rule-status { flex-grow: 1.25; }
.level-rule--heading { color: var(--xy-color-text-secondary); font-weight: var(--xy-text-weight-semibold); }
.level-rule--current { color: var(--level-accent); background: var(--xy-member-color-surface-muted); border-radius: var(--xy-radius-container); font-weight: var(--xy-text-weight-bold); }
.level-rule:last-child { border-bottom: 0; }
.level-state-pill {
  display: inline-block;
  padding: var(--xy-gap-label-value-compact) var(--xy-space-2);
  border-radius: var(--xy-radius-pill);
  color: var(--xy-color-text-secondary);
  background: var(--xy-member-color-surface-muted);
  font-size: var(--xy-text-caption-size);
}
.level-rule--current .level-state-pill { color: var(--xy-color-text-inverse); background: var(--level-accent); }

@media (max-width: 345px) {
  .level-hero { padding: 0; }
  .level-visual { width: 41%; }
}
