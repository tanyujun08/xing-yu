/* 订单页：整份按第十四轮画布重写（390 宽基准）。
 * 结构：分段（我租的/我出租的）→ 状态筛选 → 进行中大卡 → 待你处理 → 其他订单。
 * 小按钮视觉 28/32/36，点击区保持 44（用负外边距和 ::before 抵消）。 */

.orders-page { min-height:100%; padding:0 var(--xy-space-4) var(--xy-fixed-tab-clearance); box-sizing:border-box; background:var(--xy-color-page); color:var(--xy-color-text-primary); }

/* 未登录 */
.orders-login-card { padding:var(--xy-space-4); }
.orders-login-title { display:block; font-size:var(--xy-text-section-title-size); font-weight:var(--xy-text-weight-semibold); }
.orders-login-copy { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.orders-login-button { display:flex; justify-content:center; align-items:center; min-height:var(--xy-control-height-large); margin-top:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }

/* 分段控件：灰槽 36，内部白块 32 */
.role-tabs { display:flex; gap:0; padding:calc(var(--xy-space-1) / 2); box-sizing:border-box; border-radius:var(--xy-radius-md); background:var(--xy-color-border); }
.role-tab { position:relative; isolation:isolate; display:flex; flex:1; min-width:0; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin:calc((var(--xy-size-touch-min) - var(--xy-button-height-small)) / -2) 0; background:transparent; color:var(--xy-color-text-secondary); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-medium); }
.role-tab-label { display:block; }
.role-tab.is-active { color:var(--xy-color-text-strong); font-weight:var(--xy-text-weight-bold); }
.role-tab.is-active::before { position:absolute; z-index:var(--xy-z-behind); top:calc((var(--xy-size-touch-min) - var(--xy-button-height-small)) / 2); right:0; bottom:calc((var(--xy-size-touch-min) - var(--xy-button-height-small)) / 2); left:0; border-radius:var(--xy-radius-sm); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-segment); content:''; }

/* 状态筛选：视觉 28 高、间隔 8；最后一项（更多）靠右 */
.filter-list { display:flex; flex-wrap:nowrap; gap:var(--xy-space-2); margin:var(--xy-space-1) 0; overflow-x:auto; }
.filter-chip { position:relative; isolation:isolate; display:flex; flex:none; align-items:center; justify-content:center; min-width:0; min-height:var(--xy-size-touch-min); margin:0; padding:0 var(--xy-space-3); box-sizing:border-box; background:transparent; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-medium); white-space:nowrap; }
.filter-chip::before { position:absolute; z-index:var(--xy-z-behind); top:var(--xy-space-2); right:0; bottom:var(--xy-space-2); left:0; border-radius:var(--xy-radius-sm); background:var(--xy-color-surface); box-shadow:inset 0 0 0 1rpx var(--xy-color-border); content:''; }
.filter-chip.is-active { color:var(--xy-color-text-inverse); font-weight:var(--xy-text-weight-semibold); }
.filter-chip.is-active::before { background:var(--xy-color-text-strong); box-shadow:none; }
.filter-chip:last-child { margin-left:auto; }
.selected-filter { display:block; margin:0 0 var(--xy-space-3); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.filter-menu { display:flex; flex-direction:column; padding:var(--xy-space-4); gap:var(--xy-space-2); }
.filter-option { display:flex; align-items:center; justify-content:space-between; min-height:var(--xy-control-height-large); padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-container); background:var(--xy-color-page); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); color:var(--xy-color-text-primary); }
.filter-option.is-active { background:var(--xy-color-brand-soft); color:var(--xy-color-brand); }

/* 分组标题：区块之间 24，标题到卡片 12 */
.order-group-title { margin:var(--xy-space-6) 0 var(--xy-space-3); color:var(--xy-color-text-strong); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.order-list > .order-group-title:first-child { margin-top:0; }

/* 进行中大卡：头 41 + 主体（左 120 倒计时 / 右商品+按钮）+ 脚 41 */
.order-hero { overflow:hidden; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.order-hero + .order-hero { margin-top:var(--xy-space-3); }
.order-hero-head { position:relative; display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); min-height:var(--xy-size-touch-min); margin:calc(var(--xy-space-1) * -0.375) 0; padding:0 var(--xy-space-4); }
.order-hero-head::before { position:absolute; top:calc(var(--xy-space-1) * 0.375); right:0; bottom:calc(var(--xy-space-1) * 0.375); left:0; border-bottom:1rpx solid var(--xy-color-divider); background:var(--xy-color-surface-subtle); content:''; }
.order-hero-head > text, .order-hero-head > view { position:relative; }
.order-hero-status { display:flex; align-items:center; gap:var(--xy-space-2); min-width:0; color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-bold); }
.order-hero-dot { flex:none; width:var(--xy-space-2); height:var(--xy-space-2); border-radius:50%; background:var(--xy-color-brand); }
.order-hero-link { flex:none; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.order-hero-body { display:flex; }
.order-hero-time { display:flex; flex-direction:column; flex:none; width:120px; padding:var(--xy-space-4); box-sizing:border-box; border-right:1rpx solid var(--xy-color-divider); }
.order-hero-label { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-medium); }
.order-hero-count { display:flex; align-items:baseline; gap:calc(var(--xy-space-1) / 2); margin-top:var(--xy-space-1); color:var(--xy-color-brand); white-space:nowrap; }
.order-hero-num { font-size:var(--xy-text-task-amount-size); line-height:var(--xy-text-task-amount-line-height); font-weight:var(--xy-text-weight-heavy); font-variant-numeric:tabular-nums; }
.order-hero-unit { margin:0; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-bold); }
.order-hero-progress { margin-top:auto; padding-top:var(--xy-space-3); }
.order-hero-bar { height:var(--xy-space-1); overflow:hidden; border-radius:var(--xy-radius-pill); background:var(--xy-color-canvas-muted); }
.order-hero-bar-fill { height:100%; border-radius:var(--xy-radius-pill); background:var(--xy-color-brand); }
.order-hero-used { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.order-hero-main { display:flex; flex-direction:column; flex:1; justify-content:space-between; min-width:0; gap:0; padding:var(--xy-space-4); }
.order-hero-main .order-meta { margin-top:calc(var(--xy-space-1) / 2); }
.order-hero-main .order-meta + .order-meta { margin-top:var(--xy-space-1); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.order-hero .order-hero-action { position:relative; isolation:isolate; display:flex; width:100%; box-sizing:border-box; align-items:center; justify-content:center; min-height:var(--xy-size-touch-min); margin:var(--xy-space-2) 0 calc(var(--xy-space-1) * -1); padding:0 var(--xy-space-4); background:transparent; color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-semibold); }
.order-hero .order-hero-action::after { border:0; }
.order-hero .order-hero-action::before { position:absolute; z-index:var(--xy-z-behind); top:var(--xy-space-1); right:0; bottom:var(--xy-space-1); left:0; border-radius:var(--xy-radius-md); background:var(--xy-color-brand); content:''; }
.order-hero-foot { padding:var(--xy-space-3) var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); background:var(--xy-color-surface-subtle); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }

/* 订单卡：头 41（状态 + 提示）/ 主体 p16 / 脚 57（金额 + 按钮） */
.order-card { min-height:var(--xy-size-touch-min); padding:0; overflow:hidden; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.order-card + .order-card { margin-top:var(--xy-space-3); }
.order-card-head { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); padding:var(--xy-space-3) var(--xy-space-4); border-bottom:1rpx solid var(--xy-color-divider); background:var(--xy-color-surface-subtle); }
.order-card-main { position:relative; display:flex; align-items:flex-start; min-width:0; gap:var(--xy-space-2); padding:var(--xy-space-4); }
.order-card-main > order-product-summary { flex:1; min-width:0; }
.order-status { flex:none; max-width:30%; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); overflow-wrap:anywhere; }
.order-card-head .order-status { max-width:none; font-weight:var(--xy-text-weight-bold); }
.order-status--warning { color:var(--xy-color-warning); }
.order-status--success { color:var(--xy-color-brand); }
.order-status--muted { color:var(--xy-color-text-secondary); }
.order-head-note { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.order-head-note--danger { color:var(--xy-color-danger); font-weight:var(--xy-text-weight-semibold); }
.order-meta { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); overflow-wrap:anywhere; }
.order-meta--nowrap { white-space:nowrap; overflow-wrap:normal; }
.order-card-main .order-meta { margin-top:var(--xy-space-1); }
.order-card-main .order-meta + .order-meta { margin-top:calc(var(--xy-space-1) / 2); color:var(--xy-color-text-muted); }
.order-deadline { margin-top:var(--xy-space-3); padding:var(--xy-space-2); border-radius:var(--xy-radius-md); color:var(--xy-color-danger); background:var(--xy-return-danger-soft); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.order-card-foot { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--xy-space-2); margin:0; padding:var(--xy-space-3) var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); }
.order-card-foot--task { justify-content:flex-end; }
.order-price { display:flex; align-items:baseline; gap:var(--xy-space-1); flex:1; min-width:0; }
.order-amount-label { display:inline; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.order-amount { display:inline; color:var(--xy-color-text-primary); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-heavy); font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
.order-card .order-card-action { position:relative; isolation:isolate; display:flex; flex:none; align-items:center; justify-content:center; max-width:100%; min-height:var(--xy-size-touch-min); margin:calc(var(--xy-space-1) * -1.5) 0; padding:0 var(--xy-space-4); box-sizing:border-box; border:0; background:transparent; color:var(--xy-color-text-strong); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-semibold); }
.order-card .order-card-action::after { border:0; }
.order-card .order-card-action::before { position:absolute; z-index:var(--xy-z-behind); top:calc(var(--xy-space-1) * 1.5); right:0; bottom:calc(var(--xy-space-1) * 1.5); left:0; border-radius:var(--xy-radius-md); background:var(--xy-color-surface); box-shadow:inset 0 0 0 1px var(--xy-color-border); content:''; }
.order-card .order-card-action.is-primary { color:var(--xy-color-text-inverse); }
.order-card .order-card-action.is-primary::before { background:var(--xy-color-brand); box-shadow:none; }
