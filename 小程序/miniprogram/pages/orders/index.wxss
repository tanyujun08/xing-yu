.orders-login-title { display:block; font-size:var(--xy-text-section-title-size); font-weight:var(--xy-text-weight-semibold); }
.orders-login-copy { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.orders-login-button { display:flex; justify-content:center; align-items:center; min-height:var(--xy-control-height-large); margin-top:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
