.order-price { flex:1; min-width:0; }
.order-amount-label { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.order-amount { display:block; color:var(--xy-color-text-primary); font-size:var(--xy-text-task-amount-size); line-height:var(--xy-text-task-amount-line-height); font-weight:var(--xy-text-weight-semibold); font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
