.role-tab-label { display:block; padding:var(--xy-space-2) 0; }
.role-tab.is-active { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.role-tab.is-active::after { content:''; position:absolute; bottom:0; left:30%; width:40%; height:var(--xy-space-1); border-radius:var(--xy-radius-pill); background:var(--xy-color-brand); }
.filter-list { display:flex; flex-wrap:wrap; gap:var(--xy-space-1); margin:var(--xy-space-3) 0; }
.filter-chip { display:flex; flex:1; min-width:calc(3em + var(--xy-space-2)); min-height:var(--xy-size-touch-min); margin:0; padding:0 var(--xy-space-1); box-sizing:border-box; align-items:center; justify-content:center; border-radius:var(--xy-radius-container); background:var(--xy-color-surface); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); white-space:nowrap; }
.filter-chip.is-active { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.selected-filter { display:block; margin:0 0 var(--xy-space-3); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.filter-menu { display:flex; flex-direction:column; padding:var(--xy-space-4); gap:var(--xy-space-2); }
.filter-option { display:flex; align-items:center; justify-content:space-between; min-height:var(--xy-control-height-large); padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-container); background:var(--xy-color-page); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); color:var(--xy-color-text-primary); }
.filter-option.is-active { background:var(--xy-color-brand-soft); color:var(--xy-color-brand); }
.order-card { min-height: var(--xy-size-touch-min); padding:var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); }
.order-card + .order-card { margin-top:var(--xy-space-3); }
.order-card-main { position:relative; display:flex; align-items:flex-start; min-width:0; gap:var(--xy-space-2); }
.order-card-main > order-product-summary { flex:1; min-width:0; }
.order-status { flex:none; max-width:30%; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); overflow-wrap:anywhere; }
.order-status--warning { color:var(--xy-color-warning); }
