.order-status--muted { color:var(--xy-color-text-secondary); }
.order-meta { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); overflow-wrap:anywhere; }
.order-deadline { margin-top:var(--xy-space-3); padding:var(--xy-space-2); border-radius:var(--xy-radius-md); color:var(--xy-color-danger); background:var(--xy-return-danger-soft); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.order-card-foot { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:var(--xy-space-2); margin-top:var(--xy-space-3); padding-top:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); }
