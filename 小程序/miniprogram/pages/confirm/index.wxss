@import "../../shared/design/order-recovery.wxss";
.confirm-page { padding:var(--xy-space-3) var(--xy-space-4) var(--xy-space-4); display:flex; flex-direction:column; gap:var(--xy-space-3); }
.confirm-section, .checkout-object { box-sizing:border-box; padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.checkout-details { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.checkout-details--editable { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); gap:0; }
.checkout-details--editable > .checkout-object, .checkout-details--editable > .confirm-section { padding:0; border-radius:0; }
.checkout-details--editable > .confirm-section { border-top:1rpx solid var(--xy-color-divider); margin-top:var(--xy-space-3); padding-top:var(--xy-space-3); }
.section-head, .pickup-summary-row { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-3); }
.section-title { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); color:var(--xy-color-text-primary); }
.section-note, .pickup-address { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); white-space:normal; }
.pickup-address { margin-top:var(--xy-space-2); }
.pickup-summary-row { min-height:var(--xy-size-touch-min); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.pickup-card, .voucher-option { display:block; box-sizing:border-box; min-height:var(--xy-size-touch-min); padding:var(--xy-space-3); margin-top:var(--xy-space-2); border:1rpx solid var(--xy-color-border); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); text-align:left; }
.term-range { display:flex; align-items:center; gap:var(--xy-space-3); margin:var(--xy-space-2) 0; }
.term-endpoint { flex:1; min-width:0; min-height:var(--xy-size-touch-min); text-align:left; padding:var(--xy-space-2) 0; border:0; background:transparent; }
.term-date { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.term-separator { color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); }
.term-days { flex:none; color:var(--xy-color-brand); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-weight:var(--xy-text-weight-semibold); }
.calendar-month-nav { display:flex; align-items:center; justify-content:space-between; }
.calendar-nav { display:flex; align-items:center; justify-content:center; flex:none; width:var(--xy-size-touch-min); min-width:var(--xy-size-touch-min); height:var(--xy-size-touch-min); margin:0; padding:0; border:0; background:transparent; color:var(--xy-color-text-primary); font-size:var(--xy-text-page-title-size); }
.calendar-nav[disabled] { color:var(--xy-color-text-muted); opacity:var(--xy-opacity-disabled); }
.calendar-weekdays, .calendar-grid { display:flex; flex-wrap:wrap; width:100%; }
.calendar-weekday { flex:0 0 14.2857%; min-height:var(--xy-size-touch-min); display:flex; align-items:center; justify-content:center; color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); }
.calendar-day, .calendar-placeholder { position:relative; display:flex; flex:0 0 14.2857%; align-items:center; justify-content:center; box-sizing:border-box; min-width:0; height:var(--xy-size-touch-min); padding:0; margin:0; border:0; border-radius:0; background:transparent; color:var(--xy-color-text-primary); }
.calendar-day::after { border:0; }
.calendar-day-inner { display:flex; align-items:center; justify-content:center; width:var(--xy-size-touch-min); height:var(--xy-size-touch-min); border-radius:var(--xy-radius-circle); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.calendar-day.is-in-range, .calendar-day.is-start, .calendar-day.is-end { background:var(--xy-color-brand-light); }
.calendar-day.is-start { border-radius:var(--xy-radius-pill) 0 0 var(--xy-radius-pill); }
.calendar-day.is-end { border-radius:0 var(--xy-radius-pill) var(--xy-radius-pill) 0; }
.calendar-day.is-start .calendar-day-inner, .calendar-day.is-end .calendar-day-inner { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.calendar-day.is-disabled { color:var(--xy-color-text-muted); opacity:var(--xy-opacity-disabled); }
.calendar-instruction { display:block; margin:var(--xy-space-2) 0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.calendar-summary { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); margin:var(--xy-space-2) var(--xy-space-4) 0; padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-page); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.calendar-summary > view { min-width:0; }
.calendar-summary > view > text { display:block; }
.calendar-actions { display:flex; gap:var(--xy-space-3); }
.calendar-actions > button { flex:1; min-width:0; margin:0; }
.voucher-sheet-list { padding-bottom:var(--xy-space-3); }
.confirm-page--frozen { padding-top:var(--xy-space-3); }
.confirm-page--frozen .confirm-section, .confirm-page--frozen .checkout-object { padding:var(--xy-space-4); }
.signed-state-heading { display:flex; align-items:center; gap:var(--xy-space-3); }
.signed-state-heading.is-signed { color:var(--xy-color-brand); background:var(--xy-color-brand-light); padding:var(--xy-space-4); margin:calc(-1 * var(--xy-space-4)) calc(-1 * var(--xy-space-4)) var(--xy-space-3); border-radius:var(--xy-radius-md) var(--xy-radius-md) 0 0; }
.signed-state-icon { flex:none; width:var(--xy-control-height-order); height:var(--xy-control-height-order); }
.signed-state-copy, .signed-contract-copy { flex:1; min-width:0; overflow-wrap:anywhere; }
.signed-state-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); }
.signed-state-hint { display:block; margin-top:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.signed-fact { display:flex; flex-wrap:wrap; gap:var(--xy-space-2); margin-top:var(--xy-space-2); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.signed-fact > text:first-child { color:var(--xy-color-text-secondary); }
.confirm-page--frozen .pickup-summary-row { font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); flex-wrap:wrap; }
.pickup-summary-row > text:last-child { margin-left:auto; text-align:right; overflow-wrap:anywhere; }
.confirm-total { border-top:1rpx solid var(--xy-color-divider); margin-top:var(--xy-space-2); padding-top:var(--xy-space-3); font-weight:var(--xy-text-weight-semibold); }
.confirm-total-value { font-size:var(--xy-order-amount-size); line-height:var(--xy-order-amount-line-height); }
.signed-contract-entry { display:flex; align-items:center; gap:var(--xy-space-3); margin:0; min-height:var(--xy-size-touch-min); text-align:left; }
.signed-contract-icon { flex:none; width:var(--xy-control-height-order); height:var(--xy-control-height-order); }
.signed-contract-chevron { flex:none; width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); }
.signed-contract-copy .section-note { margin-top:var(--xy-space-1); }
.confirm-submit { box-sizing:border-box; min-height:var(--xy-control-height-order); margin:0; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.quote-document-icon { width:var(--xy-control-height-order); height:var(--xy-control-height-order); }
.quote-refresh-icon { position:absolute; right:var(--xy-space-2); bottom:var(--xy-space-2); width:calc(var(--xy-space-4) + var(--xy-space-4)); height:calc(var(--xy-space-4) + var(--xy-space-4)); border-radius:var(--xy-radius-circle); background:var(--xy-color-brand-soft); }
.quote-change-warning { display:block; margin-top:var(--xy-space-3); }
.quote-change-actions { display:flex; flex-direction:column; gap:var(--xy-space-2); padding:var(--xy-space-4); }
.quote-change-button { box-sizing:border-box; min-height:var(--xy-control-height-order); margin:0; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }

.checkout-step {
  padding:var(--xy-space-1) 0;
  --td-step-item-circle-size:calc(var(--xy-space-3) + var(--xy-space-3));
  --td-step-item-circle-text-font:var(--xy-text-body-small-size) / var(--xy-text-body-small-line-height) var(--xy-font-family-sans);
  --td-font-body-medium:var(--xy-text-body-small-size) / var(--xy-text-body-small-line-height) var(--xy-font-family-sans);
  --td-spacer:var(--xy-space-1);
  --td-step-item-process-circle-bg:var(--xy-color-brand);
  --td-step-item-process-circle-color:var(--xy-color-text-inverse);
  --td-step-item-process-title-color:var(--xy-color-brand);
  --td-step-item-default-circle-bg:var(--xy-color-border);
  --td-step-item-default-circle-color:var(--xy-color-text-secondary);
  --td-step-item-default-title-color:var(--xy-color-text-secondary);
  --td-step-item-line-color:var(--xy-color-text-muted);
  --td-step-item-finish-circle-bg:var(--xy-color-brand-light);
  --td-step-item-finish-circle-color:var(--xy-color-brand);
  --td-step-item-finish-title-color:var(--xy-color-text-primary);
  --td-step-item-finish-line-color:var(--xy-color-brand);
}
.checkout-notice { display:flex; flex-direction:column; gap:var(--xy-space-1); padding:var(--xy-space-3); margin-top:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-brand-light); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.pickup-address { font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }

/* 视觉规范 v1：卡片 8 圆角；起止日期是浅灰小块；取还地点是一行柜机小块。 */
.confirm-section, .checkout-object, .checkout-details--editable { border-radius:var(--xy-radius-container); }
.term-endpoint { padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface-subtle); box-shadow:inset 0 0 0 1rpx var(--xy-color-border); }
.term-date { font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-bold); }
.pickup-tile { display:flex; align-items:center; gap:var(--xy-space-2); margin-top:var(--xy-space-3); padding:var(--xy-space-3); border-radius:var(--xy-radius-md); background:var(--xy-color-surface-subtle); box-shadow:inset 0 0 0 1rpx var(--xy-color-border); }
.pickup-tile-name { min-width:0; flex:1; overflow-wrap:anywhere; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.pickup-card, .voucher-option { border-color:var(--xy-color-border); }
