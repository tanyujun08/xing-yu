.preparation-page { padding:var(--xy-space-3) var(--xy-space-4); display:flex; flex-direction:column; gap:var(--xy-space-3); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.preparation-card { box-sizing:border-box; padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); overflow-wrap:anywhere; }
.preparation-heading { display:flex; gap:var(--xy-space-3); align-items:center; margin:calc(var(--xy-space-4) * -1); margin-bottom:var(--xy-space-4); padding:var(--xy-space-4); background:var(--xy-color-brand-soft); border-radius:var(--xy-radius-md) var(--xy-radius-md) 0 0; }
.preparation-heading > image { width:var(--xy-control-height-order); height:var(--xy-control-height-order); flex:none; }
.preparation-heading > view { flex:1; min-width:0; }
.preparation-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); color:var(--xy-color-brand); }
.preparation-copy { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); margin-top:var(--xy-space-1); }
.preparation-fact { display:flex; gap:var(--xy-space-3); justify-content:space-between; padding-top:var(--xy-space-3); }
.preparation-fact > text:last-child { text-align:right; overflow-wrap:anywhere; }
.preparation-total { margin-top:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); font-weight:var(--xy-text-weight-semibold); }
.preparation-total > text:last-child { font-size:var(--xy-order-amount-size); line-height:var(--xy-order-amount-line-height); }
.preparation-section { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.preparation-address { margin-top:var(--xy-space-3); display:flex; flex-direction:column; gap:var(--xy-space-2); }
.preparation-contract { margin:0; display:flex; gap:var(--xy-space-3); align-items:center; text-align:left; }
.preparation-contract > image { width:var(--xy-control-height-order); height:var(--xy-control-height-order); flex:none; }
.preparation-contract > view { flex:1; min-width:0; }
.preparation-contract > .preparation-chevron { width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); }
.preparation-number { display:flex; flex-wrap:wrap; align-items:center; gap:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.preparation-link { margin:0; padding:0 var(--xy-space-2); border:0; background:transparent; color:var(--xy-color-brand); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); display:flex; align-items:center; justify-content:center; }
.preparation-link::after { border:0; }
.preparation-contact { display:flex; flex-wrap:wrap; justify-content:center; gap:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); margin-top:var(--xy-space-2); }
.preparation-actions { padding:var(--xy-space-4); }
.preparation-actions > button { margin:0; min-height:var(--xy-control-height-order); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
