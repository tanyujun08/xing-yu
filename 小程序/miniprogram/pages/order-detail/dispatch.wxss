.dispatch-page { display:flex; flex-direction:column; gap:var(--xy-space-3); margin:var(--xy-space-3) var(--xy-space-4) 0; }
.dispatch-heading { display:flex; align-items:flex-start; gap:var(--xy-space-4); padding:var(--xy-space-4) 0; }
.dispatch-heading>view { flex:1; min-width:0; }
.dispatch-heading--tinted { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-brand-soft); }
.dispatch-status-icon { flex:none; width:48px; height:48px; }
.dispatch-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.dispatch-heading--tinted .dispatch-title { color:var(--xy-color-brand); }
.dispatch-copy { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.dispatch-heading .dispatch-copy { margin-top:var(--xy-space-2); }
.dispatch-heading--center { flex-direction:column; align-items:center; text-align:center; gap:var(--xy-space-3); padding:var(--xy-space-4) 0 var(--xy-space-3); }
.dispatch-heading>.dispatch-alert { flex:none; display:flex; align-items:center; justify-content:center; width:44px; height:44px; border-radius:50%; background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); }
.dispatch-product-term { display:block; margin-top:var(--xy-space-3); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); overflow-wrap:anywhere; }
.dispatch-page .delivery-value { text-align:left; color:var(--xy-color-text-secondary); }
.dispatch-page .delivery-deadline { color:var(--xy-color-danger); }
.dispatch-page .delivery-label { min-width:5em; }
.dispatch-page--E6 .delivery-label { max-width:7em; }
.dispatch-page .delivery-value>.delivery-link { justify-content:flex-start; }
.dispatch-page--F1b .dispatch-address { border-top:1rpx solid var(--xy-color-divider); margin-top:var(--xy-space-4); }
.dispatch-address-body { flex:1; min-width:0; font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.dispatch-address-body>text { display:block; }
.dispatch-address-body>text+text { margin-top:var(--xy-space-1); }
.dispatch-copy-button { flex:none; align-self:center; width:auto; min-width:6em; max-width:none; white-space:nowrap; }
.dispatch-section-title { display:block; margin:var(--xy-space-4) 0 0; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.dispatch-note { margin-top:var(--xy-space-3); }
.dispatch-accessories { margin-top:var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); padding-bottom:var(--xy-space-4); border-bottom:1rpx solid var(--xy-color-divider); }
.dispatch-accessories-copy { display:block; margin-top:var(--xy-space-3); padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-page); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.dispatch-evidence { display:flex; align-items:center; gap:var(--xy-space-2); }
.dispatch-evidence>image { flex:none; width:20px; height:20px; }
.dispatch-checkbox { display:flex; gap:var(--xy-space-3); align-items:center; text-align:left; font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); color:var(--xy-color-text-secondary); }
.dispatch-checkbox>text { flex:1; min-width:0; overflow-wrap:anywhere; }
.dispatch-check { flex:none; box-sizing:border-box; width:20px; height:20px; border:1px solid var(--xy-color-border-strong); border-radius:var(--xy-radius-sm); }
.dispatch-check--checked { border:0; }
.dispatch-check>image { width:20px; height:20px; }
.dispatch-context { display:flex; flex-wrap:wrap; justify-content:center; gap:var(--xy-space-2); }
@media (max-width:350px) { .dispatch-address { flex-wrap:wrap; } .dispatch-copy-button { margin-left:auto; } .dispatch-page--F2 .dispatch-address-body { flex-basis:calc(100% - var(--xy-size-icon-nav) - var(--xy-space-2)); margin-left:calc(var(--xy-size-icon-nav) + var(--xy-space-2)); } }
