.return-form-page { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.return-form-card { padding:var(--xy-space-4); background:var(--xy-color-surface); border-radius:var(--xy-radius-md); }
.return-form-title, .return-form-label { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.return-form-copy { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.return-form-notice { display:flex; align-items:flex-start; gap:var(--xy-space-3); padding:var(--xy-space-4); background:var(--xy-color-brand-soft); border-radius:var(--xy-radius-md); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.return-form-notice>image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.return-form-notice>text { flex:1; min-width:0; overflow-wrap:anywhere; }
.return-address-list { display:flex; flex-direction:column; gap:var(--xy-space-3); margin-top:var(--xy-space-3); }
.return-address-choice { display:flex; align-items:center; gap:var(--xy-space-4); box-sizing:border-box; margin:0; padding:var(--xy-space-3); min-height:var(--xy-control-height-order); border:1rpx solid var(--xy-color-border); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); text-align:left; }
.return-address-choice--selected { border-color:var(--xy-color-brand); background:var(--xy-color-brand-soft); }
.return-address-radio { display:flex; align-items:center; justify-content:center; flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); border:1rpx solid var(--xy-color-border); border-radius:var(--xy-radius-circle); }
.return-address-choice--selected .return-address-radio { border-color:var(--xy-color-brand); }
.return-address-radio>view { width:var(--xy-space-4); height:var(--xy-space-4); background:var(--xy-color-brand); border-radius:var(--xy-radius-circle); }
.return-address-copy { flex:1; min-width:0; color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.return-address-copy>text { display:block; }
.return-address-person { color:var(--xy-color-text-primary); margin-bottom:var(--xy-space-1); }
.return-address-manage { display:flex; align-items:center; gap:var(--xy-space-3); min-height:var(--xy-control-height-order); margin:var(--xy-space-4) 0 0; padding:var(--xy-space-3) 0 0; border:0; border-top:1rpx solid var(--xy-color-divider); border-radius:0; text-align:left; background:transparent; }
.return-address-manage>text { flex:1; min-width:0; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.return-address-manage>image, .return-form-waybill>image, .return-form-picker>image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.return-form-waybill { display:flex; align-items:center; gap:var(--xy-space-3); margin-top:var(--xy-space-4); padding-top:var(--xy-space-3); border-top:1rpx solid var(--xy-color-divider); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.return-form-waybill-value { flex:1; min-width:0; color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.return-receipt-form { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.return-form-label { margin-top:var(--xy-space-2); }
.return-form-required { color:var(--xy-color-danger); }
.return-form-optional { color:var(--xy-color-text-muted); font-weight:var(--xy-text-weight-regular); font-size:var(--xy-order-body-size); }
.return-form-picker { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-3); min-height:var(--xy-control-height-order); box-sizing:border-box; padding:var(--xy-space-2) var(--xy-space-3); border:1rpx solid var(--xy-color-border); border-radius:var(--xy-radius-md); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.return-form-picker>text { flex:1; min-width:0; overflow-wrap:anywhere; }
.return-note-box { border:1rpx solid var(--xy-color-border); border-radius:var(--xy-radius-md); padding:var(--xy-space-3); }
.return-form-note { box-sizing:border-box; width:100%; height:calc(var(--xy-control-height-order) + var(--xy-control-height-order)); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.return-note-count { display:block; text-align:right; margin-top:var(--xy-space-2); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.return-form-error { display:block; color:var(--xy-color-danger); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); overflow-wrap:anywhere; }
.return-form-actions { display:flex; flex-direction:column; gap:var(--xy-space-2); }
.return-form-button { box-sizing:border-box; min-height:var(--xy-control-height-order); margin:0; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.return-form-cancel { color:var(--xy-color-brand); }
