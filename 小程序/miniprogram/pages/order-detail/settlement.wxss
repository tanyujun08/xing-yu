.settlement-page { display:flex; flex-direction:column; gap:var(--xy-space-3); margin:var(--xy-space-3) var(--xy-space-4) 0; }
.settlement-card { box-sizing:border-box; padding:var(--xy-space-4); background:var(--xy-color-surface); border-radius:var(--xy-radius-md); }
.settlement-status { display:flex; align-items:flex-start; gap:var(--xy-space-4); padding:var(--xy-space-3) 0; }
.settlement-status>image { flex:none; width:52px; height:52px; }
.settlement-status>view { flex:1; min-width:0; }
.settlement-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.settlement-copy { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.settlement-status .settlement-copy { margin-top:var(--xy-space-2); }
.settlement-status--supplement { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-brand-soft); }
.settlement-section-title { display:block; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.settlement-amount { display:block; margin-top:var(--xy-space-3); color:var(--xy-color-brand); font-size:var(--xy-order-amount-size); line-height:var(--xy-order-amount-line-height); font-weight:var(--xy-text-weight-bold); overflow-wrap:anywhere; }
.settlement-row { display:flex; justify-content:space-between; align-items:baseline; gap:var(--xy-space-3); padding:var(--xy-space-4) 0; border-bottom:1rpx solid var(--xy-color-divider); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.settlement-row>text { min-width:0; overflow-wrap:anywhere; }
.settlement-label { color:var(--xy-color-text-secondary); }
.settlement-value { text-align:right; }
.settlement-row--last { border-bottom:0; padding-bottom:0; }
.settlement-product>order-product-summary { display:block; padding-bottom:var(--xy-space-3); border-bottom:1rpx solid var(--xy-color-divider); }
.settlement-amount-inline { font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); }
.settlement-total { color:var(--xy-color-brand); }
.settlement-progress .settlement-title { margin:var(--xy-space-4) 0 var(--xy-space-6); text-align:center; }
.settlement-progress-icon { display:block; width:76px; height:76px; margin:var(--xy-space-2) auto 0; }
.settlement-progress>.settlement-copy { text-align:center; margin-bottom:var(--xy-space-3); }
.settlement-note { display:flex; align-items:flex-start; gap:var(--xy-space-3); padding:var(--xy-space-3); margin-top:var(--xy-space-4); background:var(--xy-color-brand-soft); border-radius:var(--xy-radius-md); }
.settlement-note>image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.settlement-note>text { min-width:0; }
.settlement-services { display:flex; flex-wrap:wrap; justify-content:center; gap:var(--xy-space-2) var(--xy-space-4); }
.settlement-services>button { padding:0; color:var(--xy-color-brand); background:transparent; border:0; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.settlement-services>button::after { border:0; }
