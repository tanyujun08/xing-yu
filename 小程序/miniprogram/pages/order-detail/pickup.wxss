.pickup-order-page { display:flex; flex-direction:column; gap:var(--xy-space-3); margin:var(--xy-space-3) var(--xy-space-4) 0; }
.pickup-order-status { box-sizing:border-box; display:flex; align-items:center; min-height:112px; gap:var(--xy-space-5); padding:var(--xy-space-3) 0; }
.pickup-order-status>view { min-width:0; }
.pickup-order-status>image { flex:none; width:76px; height:76px; }
.pickup-order-status--ready { flex-direction:column; gap:var(--xy-space-2); text-align:center; }
.pickup-order-status--ready>image { width:52px; height:52px; }
.pickup-order-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.pickup-order-status--ready .pickup-order-title { color:var(--xy-color-brand); }
.pickup-order-copy { display:block; margin-top:var(--xy-space-2); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.pickup-order-card { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.pickup-order-card>order-product-summary { display:block; padding-bottom:var(--xy-space-4); border-bottom:1rpx solid var(--xy-color-divider); }
.pickup-order-check { margin-left:auto; flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.pickup-order-contract { display:flex; align-items:center; gap:var(--xy-space-3); width:100%; box-sizing:border-box; padding:var(--xy-space-4) 0; text-align:left; background:transparent; border:0; border-bottom:1rpx solid var(--xy-color-divider); border-radius:0; font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.pickup-order-contract::after { border:0; }
.pickup-order-contract>image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.pickup-order-contract>text { flex:1; min-width:0; overflow-wrap:anywhere; }
.pickup-order-contract>.pickup-order-contract-status { flex:0 0 auto; max-width:45%; text-align:right; }
.pickup-order-contract--ready { margin-top:var(--xy-space-4); padding-bottom:0; border-top:1rpx solid var(--xy-color-divider); border-bottom:0; }
.pickup-order-code { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
