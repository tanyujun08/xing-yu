}

.return-flow-step:not(:last-child)::after {
  position: absolute;
  top: calc(var(--xy-space-1) + var(--xy-space-2));
  bottom: calc(-1 * var(--xy-space-3) - var(--xy-space-3));
  left: 7px;
  width: 2rpx;
  background: var(--xy-color-divider);
  content: '';
}

.return-flow-dot {
  position: relative;
  z-index: var(--xy-z-local);
