@import "../../shared/design/order-recovery.wxss";
.nonfulfillment-page { margin:var(--xy-space-3) var(--xy-space-4) 0; }
.nonfulfillment-alert { display:flex; justify-content:center; align-items:center; width:var(--xy-control-height-order); height:var(--xy-control-height-order); box-sizing:border-box; border:var(--xy-space-1) solid var(--xy-color-brand); border-radius:var(--xy-radius-circle); color:var(--xy-color-brand); font-size:var(--xy-order-amount-size); line-height:var(--xy-order-amount-line-height); font-weight:var(--xy-text-weight-bold); }
.nonfulfillment-processing { margin-top:var(--xy-space-2); color:var(--xy-color-brand); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.nonfulfillment-amount { font-size:var(--xy-order-amount-size); line-height:var(--xy-order-amount-line-height); font-weight:var(--xy-text-weight-bold); }
.order-detail-page {
