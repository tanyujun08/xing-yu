}

.product-model {
  display: -webkit-box;
  overflow: hidden;
  margin-top: var(--xy-space-1);
  color: var(--xy-color-text-secondary);
  font-size: var(--xy-text-body-small-size);
  line-height: var(--xy-text-body-small-line-height);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-overflow: ellipsis;
  overflow-wrap: anywhere;
}

.product-arrow {
  flex: 0 0 var(--xy-size-icon-base);
  width: var(--xy-size-icon-base);
  height: var(--xy-size-icon-base);
  margin-left: var(--xy-space-2);
