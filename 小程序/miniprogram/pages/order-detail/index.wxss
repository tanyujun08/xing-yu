/* 订单详情（方向 H 整页骨架）：状态头 → 结论卡 → 对象卡 → 分支信息 → 更多记录 → 底栏。共用样式见 shared/design/order-flow-h.wxss。 */
.od-page { min-height: 100%; box-sizing: border-box; padding-bottom: var(--xy-space-6); background: var(--xy-color-page); font-family: var(--xy-font-family-sans); }
.od-recovery { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--xy-space-2); box-sizing: border-box; padding: var(--xy-space-6) var(--xy-space-4); text-align: center; }
.od-recovery__image { display: block; width: calc(var(--xy-space-6) * 5); height: calc(var(--xy-space-6) * 5); margin-bottom: var(--xy-space-2); }
.od-recovery__title { font-size: var(--xy-hero-title-size); line-height: var(--xy-hero-title-line-height); font-weight: var(--xy-text-weight-semibold); }
.od-num { flex: none; display: flex; align-items: center; justify-content: center; width: var(--xy-space-5); height: var(--xy-space-5); border-radius: var(--xy-radius-circle); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-row-caption-size); font-weight: var(--xy-text-weight-semibold); }
.od-v-wide { max-width: 64%; }
.od-v-warn { color: var(--xy-color-key-warning); font-weight: var(--xy-text-weight-semibold); }
.od-v-ok { color: var(--xy-color-brand); }
.od-address { display: flex; flex-direction: column; gap: var(--xy-space-1); }
.od-address__person, .od-body { font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); overflow-wrap: anywhere; }
.od-gap { margin-top: var(--xy-space-2); }
.od-key-text { font-size: var(--xy-hero-title-size); line-height: var(--xy-hero-title-line-height); font-weight: var(--xy-text-weight-semibold); }
.od-proofs { display: flex; flex-direction: column; gap: var(--xy-space-2); }
.od-proof-photo, .od-proof-poster { display: block; width: 100%; height: calc(var(--xy-space-6) * 7); border-radius: var(--xy-radius-md); overflow: hidden; }
.od-proof-video { display: block; width: 100%; height: calc(var(--xy-space-6) * 8); border-radius: var(--xy-radius-md); }
.od-btn-narrow { flex: none !important; padding: 0 var(--xy-space-4); }
.od-sheet { margin: 0 calc(var(--xy-space-4) * -1); background: var(--xy-color-page); }
.od-field-k { flex: none; width: calc(var(--xy-space-6) * 3); }
.od-input { flex: 1; min-width: 0; min-height: var(--xy-row-height); font-size: var(--xy-row-text-size); text-align: right; }
.od-textarea { display: block; width: 100%; height: calc(var(--xy-space-6) * 4); font-size: var(--xy-row-text-size); line-height: var(--xy-row-text-line-height); }
.od-count { text-align: right; }
.od-row-top { border-top: 1rpx solid var(--xy-color-hairline); }
.od-radio { flex: none; width: var(--xy-space-5); height: var(--xy-space-5); border: 1rpx solid var(--xy-color-border-strong); border-radius: var(--xy-radius-circle); box-sizing: border-box; }
.od-radio.is-on { border: calc(var(--xy-space-1) + 2rpx) solid var(--xy-color-brand); }
