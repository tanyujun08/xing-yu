}

.order-detail-page--unavailable { padding-bottom:0; }
.order-recovery { box-sizing:border-box; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:var(--xy-space-6) var(--xy-space-4); text-align:center; }
.order-recovery-image { display:block; width:160px; height:160px; flex:none; margin-bottom:var(--xy-space-3); }
.order-recovery-title { display:block; max-width:100%; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.order-recovery-copy { display:block; max-width:100%; margin-top:var(--xy-space-3); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); color:var(--xy-color-text-secondary); overflow-wrap:anywhere; }
.order-recovery-actions { display:flex; flex-direction:column; gap:var(--xy-space-2); padding:var(--xy-space-4); }
.order-recovery-actions .order-recovery-button { min-height:var(--xy-control-height-order); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.order-recovery-actions .xy-action-secondary { border-color:var(--xy-color-brand); color:var(--xy-color-brand); }

.status-card,
.missing-card {
  box-sizing: border-box;
  margin: var(--xy-space-4) var(--xy-space-4) 0;
  padding: var(--xy-space-3);
  border: 0;
  border-radius: var(--xy-radius-md);
  background: var(--xy-color-surface);
  box-shadow: none;
}

.status-card,
.missing-card {
