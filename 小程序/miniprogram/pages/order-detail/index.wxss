}

.detail-block {
  box-sizing: border-box;
  margin: var(--xy-space-3) var(--xy-space-4) 0;
  padding: var(--xy-space-3);
  border: 0;
  border-radius: var(--xy-radius-md);
  background: var(--xy-color-surface);
  box-shadow: none;
}

.status-card + .detail-block,
.detail-block + .detail-block { margin-top: var(--xy-layout-content-gap);
}

.status-card {
