.review-loss-item + .review-loss-item { margin-top: var(--xy-space-3); }
.review-proof { margin-top: var(--xy-space-2); }
.review-proof-photo { display: block; width: 100%; height: 200px; overflow: hidden; border-radius: var(--xy-radius-sm); }
.review-proof-video { display: block; width: 100%; height: 200px; margin-top: var(--xy-space-2); }
.review-video-poster { display: block; width: 72px; height: 72px; margin-top: var(--xy-space-2); overflow: hidden; }
.return-task-body > text { display: block; }
.pickup-code { display: block; font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); margin: var(--xy-space-3) 0; }

.return-landing { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.rental-active-status { display:flex; align-items:flex-start; gap:var(--xy-space-4); padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.rental-active-status .delivery-title { color:var(--xy-color-brand); }
.rental-active-status .delivery-copy { margin-top:var(--xy-space-2); }
.order-state-symbol { display:flex; align-items:center; justify-content:center; flex:none; width:var(--xy-control-height-order); height:var(--xy-control-height-order); border-radius:var(--xy-radius-circle); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.review-heading>.order-state-symbol, .delivery-status>.order-state-symbol, .settlement-status>.order-state-symbol { flex:none; }
.return-landing>.delivery-contract { justify-content:flex-start; }
.review-page--F5 .review-title { color:var(--xy-color-brand); }
.order-state-glyph { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); filter:brightness(0) invert(1); }
.order-state-symbol--large { width:calc(var(--xy-control-height-order) + var(--xy-space-6)); height:calc(var(--xy-control-height-order) + var(--xy-space-6)); margin:var(--xy-space-2) auto var(--xy-space-4); }
.order-state-symbol--soft { background:var(--xy-color-brand-light); color:var(--xy-color-brand); }
.order-state-symbol--danger { background:var(--xy-return-danger-soft); color:var(--xy-color-danger); }
.order-state-symbol--warning { background:var(--xy-color-warning); color:var(--xy-color-text-inverse); }
.review-page--E8>.review-heading { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-brand-soft); }
.review-page--E8>.review-heading .review-title { color:var(--xy-color-brand); }
.review-explanation { margin-top:var(--xy-space-4); padding-top:var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); }
.review-explanation-heading { display:flex; align-items:center; gap:var(--xy-space-3); }
.review-explanation-heading>image { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); flex:none; }
.review-timeline-title { margin-bottom:var(--xy-space-4); }
.return-order-status { position:relative; overflow:hidden; display:flex; align-items:center; gap:var(--xy-space-4); padding:var(--xy-space-4); border-radius:var(--xy-radius-lg); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.return-order-status>image { width:36px; height:36px; filter:brightness(0) invert(1); }
.return-order-product { display:flex; gap:var(--xy-space-4); align-items:center; padding:var(--xy-space-4); }
.return-order-product>image { width:104px; height:132px; border-radius:var(--xy-radius-md); flex:none; }
.return-order-product>view { min-width:0; flex:1; }
.return-order-product .return-title { font-size:var(--xy-text-section-title-size); }
.return-order-product .return-copy { font-size:var(--xy-text-body-small-size); margin-top:var(--xy-space-2); }
.return-method { display:inline-block; margin-top:var(--xy-space-2); padding:var(--xy-space-1) var(--xy-space-2); background:var(--xy-color-brand-light); color:var(--xy-color-brand); border-radius:var(--xy-radius-md); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.return-prepare { padding:var(--xy-space-4); }
.return-preparation { width:100%; display:flex; align-items:center; text-align:left; gap:var(--xy-space-3); min-height:52px; margin:0; padding:var(--xy-space-3) 0; border-bottom:1px solid var(--xy-color-border); border-radius:0; background:transparent; }
.return-preparation::after { border:0; }
.return-preparation>image { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); flex:none; }
.return-preparation>view { flex:1; min-width:0; }
.return-preparation .return-chevron { width:12px; height:16px; }
.return-preparation .return-subtitle { font-size:var(--xy-text-body-size); }
.return-preparation .return-copy { font-size:var(--xy-text-caption-size); }
.return-preparation-number { display:flex; align-items:center; justify-content:center; flex:none; width:var(--xy-return-step-size); height:var(--xy-return-step-size); border-radius:var(--xy-radius-circle); background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.return-prepare .return-note { margin-top:var(--xy-space-3); }
.return-order-facts { display:flex; flex-direction:column; gap:var(--xy-space-2); }
.return-order-facts .return-copy { font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }

.return-theme .order-detail-page { padding:var(--xy-space-3) var(--xy-space-4); }
.return-order-status .return-title,.return-prepare>.return-title { font-size:var(--xy-text-page-title-size); }

.order-result { display:flex; flex-direction:column; gap:var(--xy-space-3); margin:var(--xy-space-3) var(--xy-space-4) 0; }
.result-card { padding:var(--xy-space-4); background:var(--xy-color-surface); border-radius:var(--xy-radius-md); }
.result-status { text-align:center; }
.result-icon { display:block; width:72px; height:72px; margin:var(--xy-space-2) auto var(--xy-space-4); }
.result-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); }
.result-reason { margin-top:var(--xy-space-3); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); overflow-wrap:anywhere; }
.result-closed-at { display:block; margin-top:var(--xy-space-2); }
.result-status--zero { padding:var(--xy-space-4) 0 0; background:transparent; }
.result-reason--closed { padding:var(--xy-space-4); background:var(--xy-color-surface); border-radius:var(--xy-radius-md); text-align:left; }
.result-reason--unpaid { background:var(--xy-return-danger-soft); }
.result-original { margin-top:var(--xy-space-4); padding-top:var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); text-align:left; }
.result-facts { margin-top:var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); }
.result-line { display:flex; align-items:flex-start; justify-content:space-between; gap:var(--xy-space-3); padding:var(--xy-space-3) 0; border-bottom:1rpx solid var(--xy-color-divider); text-align:left; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); }
.result-line > text:first-child { flex:none; color:var(--xy-color-text-secondary); }
.result-line > text:last-child { min-width:0; overflow-wrap:anywhere; text-align:right; }
.result-amount { font-size:var(--xy-text-task-amount-size); line-height:var(--xy-text-task-amount-line-height); font-weight:var(--xy-text-weight-semibold); }
.result-credential { display:block; padding-top:var(--xy-space-3); text-align:left; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); }
.result-note { display:flex; gap:var(--xy-space-3); align-items:flex-start; padding:var(--xy-space-3); background:var(--xy-color-brand-light); border-radius:var(--xy-radius-sm); color:var(--xy-color-text-secondary); text-align:left; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); }
.result-status .result-note { margin-top:var(--xy-space-4); }
.result-note > image { flex:none; width:var(--xy-size-icon-base); height:var(--xy-size-icon-base); margin-top:var(--xy-space-1); }
.result-progress { margin:var(--xy-space-4) 0; display:flex; flex-direction:column; gap:var(--xy-space-4); }
.result-step { position:relative; display:flex; gap:var(--xy-space-3); align-items:center; text-align:left; font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.result-step:not(:last-child)::after { content:''; position:absolute; left:calc(var(--xy-size-icon-nav) / 2); top:calc(var(--xy-size-icon-nav) + var(--xy-space-1)); bottom:calc(-1 * var(--xy-space-4) + var(--xy-space-1)); width:1px; background:var(--xy-color-divider); }
.result-step--done:not(:last-child)::after { background:var(--xy-color-brand); }
.result-step > image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.result-services { display:flex; flex-wrap:wrap; gap:var(--xy-space-2); }
.result-services > button { flex:1 1 auto; min-height:var(--xy-size-touch-min); color:var(--xy-color-text-secondary); }
.return-order-status>.return-order-watermark { position:absolute; right:0; width:100px; height:100px; opacity:.12; }
.payment-page { display:flex; flex-direction:column; gap:var(--xy-space-3); margin:var(--xy-space-3) var(--xy-space-4) 0; }
.payment-status,.payment-card { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.payment-status { display:flex; align-items:flex-start; gap:var(--xy-space-4); }
.payment-status--ready { background:var(--xy-color-brand-light); }
.payment-status--retry { background:transparent; padding:var(--xy-space-4) 0; }
.payment-status--checking { flex-direction:column; align-items:center; text-align:center; }
.payment-clock { flex:none; width:44px; height:44px; }
.payment-status--checking .payment-clock { width:72px; height:72px; margin:var(--xy-space-2) 0; }
.payment-heading { min-width:0; }
.payment-title { display:block; font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.payment-status--ready .payment-title { color:var(--xy-color-brand); }
.payment-caption,.payment-copy { display:block; color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); overflow-wrap:anywhere; }
.payment-caption { margin-top:var(--xy-space-3); }
.payment-copy { margin-top:var(--xy-space-2); }
.payment-amount { font-size:calc(var(--xy-text-task-amount-size) + 4px); line-height:calc(var(--xy-text-task-amount-line-height) + 4px); font-weight:var(--xy-text-weight-bold); color:var(--xy-color-text-primary); }
.payment-heading>.payment-amount { display:block; margin:var(--xy-space-2) 0; }
.payment-details { width:100%; min-width:0; }
.payment-row { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-3); padding:var(--xy-space-4) 0; border-bottom:1rpx solid var(--xy-color-divider); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); text-align:left; }
.payment-row>text:first-child { flex:none; color:var(--xy-color-text-secondary); }
.payment-row>text:last-child { min-width:0; overflow-wrap:anywhere; text-align:right; }
.payment-row--fee { padding:var(--xy-space-2) 0; border:0; }
.payment-row--total { border-bottom:0; border-top:1rpx solid var(--xy-color-divider); margin-top:var(--xy-space-3); padding-bottom:0; font-weight:var(--xy-text-weight-semibold); }
.payment-details .result-note,.payment-card .result-note { margin-top:var(--xy-space-3); }
.payment-contract { display:flex; align-items:center; gap:var(--xy-space-3); text-align:left; margin:var(--xy-space-4) 0 0; padding:var(--xy-space-3) 0; border-radius:0; border-top:1rpx solid var(--xy-color-divider); border-bottom:1rpx solid var(--xy-color-divider); background:transparent; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-relaxed-line-height); }
.payment-contract::after { border:0; }
.payment-contract>image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.payment-contract-label { margin-left:auto; color:var(--xy-color-text-secondary); }
.payment-contract>.payment-chevron { width:12px; height:16px; }
.payment-section-title { display:block; margin:var(--xy-space-4) 0 var(--xy-space-2); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.payment-address .payment-section-title { margin-top:0; }
.payment-cancel { color:var(--xy-color-text-secondary); background:transparent; }

.funding-history-links { display: flex; gap: var(--xy-space-3); }
.funding-history-links button { flex: 1; width: 0; font-size: var(--xy-text-body-size); color: var(--xy-color-brand); }

.order-cabinet-location { padding: var(--xy-space-4) 0; border-bottom: 1rpx solid var(--xy-color-divider); }
.order-cabinet-line { display: flex; align-items: center; gap: var(--xy-space-3); min-height: var(--xy-size-touch-min); padding: var(--xy-space-2) 0; text-align: left; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-relaxed-line-height); }
.order-cabinet-line__label { flex: none; color: var(--xy-color-text-secondary); }
.order-cabinet-line__value { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.pickup-order-code > .pickup-code, .pickup-card-preview > .pickup-code { font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-operations-hero-size); line-height: var(--xy-text-operations-hero-line-height); font-weight: var(--xy-text-weight-bold); letter-spacing: var(--xy-space-1); text-align: center; }
