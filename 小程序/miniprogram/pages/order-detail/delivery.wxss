.delivery-page { display:flex; flex-direction:column; gap:var(--xy-space-3); margin:var(--xy-space-3) var(--xy-space-4) 0; }
.delivery-status { display:flex; align-items:center; gap:var(--xy-space-4); padding:var(--xy-space-3) 0; }
.delivery-status--lessor { padding:var(--xy-space-4); background:var(--xy-color-brand-light); border-radius:var(--xy-radius-md); }
.delivery-status-icon { flex:none; width:48px; height:48px; }
.delivery-status>view { min-width:0; }
.delivery-title { display:block; color:var(--xy-color-brand); font-size:var(--xy-order-status-size); line-height:var(--xy-order-status-line-height); font-weight:var(--xy-text-weight-semibold); overflow-wrap:anywhere; }
.delivery-copy { display:block; margin-top:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.delivery-card { padding:var(--xy-space-4); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); }
.delivery-section-title { display:block; margin-bottom:var(--xy-space-2); font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.delivery-row { display:flex; gap:var(--xy-space-2); align-items:flex-start; padding:var(--xy-space-4) 0; border-bottom:1rpx solid var(--xy-color-divider); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.delivery-card>order-product-summary+.delivery-row { border-top:1rpx solid var(--xy-color-divider); margin-top:var(--xy-space-4); }
.delivery-row--last { border-bottom:0; }
.delivery-row-icon { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.delivery-label { flex:none; min-width:4em; }
.delivery-value { flex:1; min-width:0; text-align:right; overflow-wrap:anywhere; }
.delivery-value>text { display:block; }
.delivery-value>text+text { margin-top:var(--xy-space-1); }
.delivery-deadline { color:var(--xy-color-danger); }
.delivery-link { display:flex; align-items:center; justify-content:center; margin:0; padding:0 var(--xy-space-2); background:transparent; color:var(--xy-color-brand); border:0; font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); white-space:normal; }
.delivery-link::after { border:0; }
.delivery-value>.delivery-link { justify-content:flex-end; padding:0; }
.delivery-note { display:flex; gap:var(--xy-space-3); align-items:flex-start; padding:var(--xy-space-3); background:var(--xy-color-brand-light); border-radius:var(--xy-radius-md); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); color:var(--xy-color-text-secondary); }
.delivery-note>image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.delivery-note>text,.delivery-note>view { min-width:0; overflow-wrap:anywhere; }
.delivery-note>view>text { display:block; }
.delivery-note>view>text+text { margin-top:var(--xy-space-2); }
.delivery-contract { display:flex; gap:var(--xy-space-3); align-items:center; text-align:left; font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); }
.delivery-contract>image { flex:none; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); }
.delivery-contract>.delivery-chevron { margin-left:auto; width:12px; height:16px; }
.delivery-address { display:block; font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.shipment-recipient { display:flex; align-items:flex-start; gap:var(--xy-space-3); }
.shipment-recipient-content { flex:1; min-width:0; }
.shipment-recipient-contact-row { display:flex; align-items:center; gap:var(--xy-space-2); }
.shipment-recipient-contact { display:flex; flex:1; min-width:0; flex-wrap:wrap; gap:var(--xy-space-1) var(--xy-space-2); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
.shipment-recipient-copy { flex:none; gap:var(--xy-space-1); padding:0; }
.shipment-recipient-content>.delivery-address+.delivery-address { margin-top:var(--xy-space-1); }
.delivery-form .delivery-note+order-product-summary { display:block; margin-top:var(--xy-space-4); }
.delivery-fields { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.delivery-field-label { display:block; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-medium); }
.delivery-fields .shipment-input { box-sizing:border-box; width:100%; min-height:var(--xy-control-height-order); margin:0 0 var(--xy-space-2); padding:var(--xy-space-3); border:1rpx solid var(--xy-color-border); border-radius:var(--xy-radius-md); background:var(--xy-color-surface); color:var(--xy-color-text-primary); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.delivery-reason { width:100%; min-height:112px; box-sizing:border-box; padding:var(--xy-space-3); border:1rpx solid var(--xy-color-border); border-radius:var(--xy-radius-md); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); }
.delivery-form-actions { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.delivery-form-actions>button { min-height:var(--xy-control-height-order); }
.delivery-form-error { color:var(--xy-color-danger); font-size:var(--xy-order-body-size); line-height:var(--xy-order-body-line-height); overflow-wrap:anywhere; }
@media (max-width:350px) { .delivery-row { flex-wrap:wrap; } .delivery-value { flex-basis:calc(100% - var(--xy-size-icon-nav) - var(--xy-space-2)); margin-left:calc(var(--xy-size-icon-nav) + var(--xy-space-2)); text-align:left; } .delivery-value>.delivery-link { justify-content:flex-start; } }
