            </view>
            <button class="completion-link completion-link--last xy-button-fluid xy-action-hit" data-mode="record" bindtap="openReviewEvidence" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}"><image src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text>查看已交材料</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
          </view>
          <view class="settlement-card"><view class="settlement-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><view><text class="settlement-section-title">补充说明</text><text class="review-copy review-section-copy">按要求补交材料，已有材料会保留。设备已收回，不再累计实收后的逾期。</text></view></view></view>
        </block>
        <view wx:elif="{{returnReviewPage.code === 'F5'}}" class="settlement-card">
