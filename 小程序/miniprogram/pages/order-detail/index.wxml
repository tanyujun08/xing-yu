          <button wx:if="{{viewContract}}" class="completion-link completion-link--last xy-button-fluid xy-action-hit" data-code="VIEW_CONTRACT" bindtap="handleAction" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}"><image src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text>已签合同</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
        </view>
        <view class="settlement-services"><button wx:if="{{returnReviewPage.code !== 'F5'}}" class="xy-action-hit" bindtap="demoSupport">联系客服</button><button wx:if="{{peerContact}}" class="xy-action-hit" bindtap="openPeerConversation">{{peerContact}}</button><button class="xy-action-hit" bindtap="copyOrderNumber">复制订单号</button></view>
      </view>
      <view wx:elif="{{completionPage}}" class="completion-page">
