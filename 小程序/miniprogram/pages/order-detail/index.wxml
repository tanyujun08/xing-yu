          <text wx:if="{{completionPage.closed && !completionPage.known}}" class="completion-copy completion-cash-note" role="status">{{completionPage.cashNote}}</text>
        </view>
        <view wx:if="{{!completionPage.closed}}" class="settlement-card">
          <text class="settlement-section-title">费用构成</text><template is="completion-cash" data="{{rows: completionPage.feeRows}}" />
          <view wx:if="{{completionPage.code === 'H4'}}" class="settlement-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text class="settlement-copy">{{completionPage.deductionNote}}</text></view>
        </view>
        <view wx:if="{{completionPage.code === 'G4'}}" class="settlement-card"><text class="settlement-section-title">资金说明</text><text class="completion-copy completion-cash-note">{{completionPage.deductionNote}}</text></view>
        <view class="settlement-card completion-links">
          <button wx:if="{{viewContract}}" class="completion-link xy-button-fluid xy-action-hit" data-code="VIEW_CONTRACT" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><image src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text>{{completionPage.closed ? '查看原合同' : '已签合同'}}</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
          <button wx:if="{{completionPage.returnId}}" class="completion-link xy-button-fluid xy-action-hit" bindtap="openCompletedReturn" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><image src="{{icons.returnClock}}" mode="aspectFit" aria-hidden="true" /><text>归还记录</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
          <button wx:if="{{!completionPage.closed && feeBasisVisible}}" class="completion-link completion-link--last xy-button-fluid xy-action-hit" bindtap="openFeeBasis" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><image src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text>费用依据</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
          <button wx:if="{{completionPage.closed}}" class="completion-link completion-link--last xy-button-fluid xy-action-hit" bindtap="toggleCompletionRecords" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}" aria-expanded="{{completionRecordsExpanded}}"><image src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text>{{completionRecordsExpanded ? '收起支付记录' : '查看支付记录'}}</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
          <block wx:if="{{completionPage.closed && completionRecordsExpanded}}">
            <view wx:for="{{paymentRows}}" wx:key="id" class="completion-record"><text class="completion-record-title">{{item.purpose}} · {{item.status}}</text><text class="completion-copy">支付编号：{{item.id}}</text><text class="completion-copy">应付金额：{{item.amount}}</text><text class="completion-copy">微信实付：{{item.cash}}</text><text class="completion-copy">最近查询：{{item.verified}}</text></view>
            <view wx:if="{{refundRecordVisible}}" class="completion-record"><text class="completion-record-title">{{refundTitle}} · {{refundStatus}}</text><text class="completion-copy">退款编号：{{refundId}}</text><text class="completion-copy">应退金额：{{refundAmount}}</text><text class="completion-copy">实际退还现金：{{refundCash}}</text><text class="completion-copy">退款时间：{{refundAt}}</text></view>
          </block>
        </view>
        <view class="settlement-services"><button wx:if="{{!completionPage.known}}" class="xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新原订单</button><button class="xy-action-hit" bindtap="demoSupport">联系客服</button><button wx:if="{{peerContact}}" class="xy-action-hit" bindtap="openPeerConversation">{{peerContact}}</button><button class="xy-action-hit" bindtap="copyOrderNumber">复制订单号</button></view>
      </view>
      <view wx:elif="{{settlementPage}}" class="settlement-page">
