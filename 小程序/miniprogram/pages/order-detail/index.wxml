          <view wx:else class="review-timeline"><text wx:if="{{returnReviewPage.code === 'E8'}}" class="settlement-section-title review-timeline-title">处理进度</text>
            <view wx:for="{{returnReviewPage.steps}}" wx:key="key" class="review-step {{item.done ? 'review-step--done' : ''}} {{item.current ? 'review-step--current' : ''}} {{index === returnReviewPage.steps.length - 1 ? 'review-step--last' : ''}}">
