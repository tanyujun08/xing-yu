            </view>
          </view>
        </view>
        <view wx:if="{{returnReviewPage.code === 'E8'}}" class="settlement-card completion-links">
          <button class="completion-link completion-link--last xy-button-fluid xy-action-hit" data-mode="record" bindtap="openReviewEvidence" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}"><image src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text>查看归还材料</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
          <view class="settlement-note review-bottom-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text class="review-copy">实际收回已记录，费用与结算进度将在本单更新。{{returnReviewPage.materialRequired ? '当前等待承租人补充材料。' : ''}}</text></view>
        </view>
        <view wx:if="{{returnReviewPage.complete}}" class="settlement-card">
          <view class="review-income"><image src="{{icons.profileWallet}}" mode="aspectFit" aria-hidden="true" /><view><text class="settlement-section-title">{{returnReviewPage.booked ? '收益已入账' : '收益入账待核实'}}</text><text class="review-copy review-section-copy">{{returnReviewPage.earningNote}}</text></view></view>
