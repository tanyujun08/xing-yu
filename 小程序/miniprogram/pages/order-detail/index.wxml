          <view><text class="settlement-title">{{completionPage.title}}</text><text class="settlement-copy">{{completionPage.note}}</text></view>
        </view>
        <view class="settlement-card settlement-product completion-product">
          <order-product-summary variant="order-list" clickable bindopen="openProduct" title="{{title}}" secondary="{{completionPage.supply}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}">
            <view wx:if="{{completionPage.code === 'G3'}}" slot="meta"><text class="completion-copy">租期：{{term}}</text><text class="completion-copy">实际收回时间：{{returned || '待核实'}}</text></view>
          </order-product-summary>
          <view wx:if="{{completionPage.closed}}" class="settlement-row settlement-row--last"><text class="settlement-label">原租期</text><text class="settlement-value">{{term}}</text></view>
          <view wx:elif="{{completionPage.code !== 'G3'}}" class="settlement-row settlement-row--last"><text class="settlement-label">实际收回时间</text><text class="settlement-value">{{returned || '待核实'}}</text></view>
        </view>
        <view wx:if="{{!completionPage.closed}}" class="settlement-card {{completionPage.code === 'G3' ? 'completion-highlight' : ''}}">
          <text class="settlement-section-title">最终花费</text><text wx:if="{{completionPage.known}}" class="settlement-amount">{{completionPage.amount}}</text>
          <text wx:else class="completion-copy completion-cash-note" role="status">{{completionPage.cashNote}}</text>
          <template wx:if="{{completionPage.code === 'G4'}}" is="completion-cash" data="{{rows: completionPage.cashRows}}" />
        </view>
        <view wx:if="{{completionPage.code !== 'G4'}}" class="settlement-card">
          <text class="settlement-section-title">{{completionPage.closed ? '退款信息' : '资金记录'}}</text>
          <template is="completion-cash" data="{{rows: completionPage.cashRows}}" />
