          <text class="settlement-title">{{settlementPage.title}}</text>
          <text wx:if="{{settlementPage.expiredNote}}" class="settlement-copy">{{settlementPage.expiredNote}}</text>
          <view class="settlement-row"><text class="settlement-label">{{settlementPage.amountLabel}}</text><text class="settlement-value settlement-amount-inline">{{settlementPage.amount}}</text></view>
          <block wx:if="{{!settlementPage.isRefund && !settlementPage.failed}}">
            <view class="settlement-row"><text class="settlement-label">发起</text><text class="settlement-value">{{settlementPage.created}}</text></view>
            <view class="settlement-row"><text class="settlement-label">原支付截止</text><text class="settlement-value">{{settlementPage.deadline}}</text></view>
          </block>
          <view wx:if="{{!settlementPage.failed}}" class="settlement-row"><text class="settlement-label">最近查询</text><text class="settlement-value">{{settlementPage.verified}}</text></view>
