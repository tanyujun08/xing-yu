            <view class="settlement-row settlement-row--last"><text class="settlement-label">实际收回时间</text><text class="settlement-value">{{returned || '待核实'}}</text></view>
          </view>
          <view wx:if="{{settlementPage.isRefund}}" class="settlement-card"><text class="settlement-section-title">应退押金</text><text class="settlement-amount">{{settlementPage.amount}}</text></view>
          <view class="settlement-card">
            <text class="settlement-section-title">费用已核定</text>
            <view wx:for="{{settlementPage.rows}}" wx:key="label" class="settlement-row {{settlementPage.isRefund && index === settlementPage.rows.length - 1 ? 'settlement-row--last' : ''}}"><text class="settlement-label">{{item.label}}</text><text class="settlement-value">{{item.value}}</text></view>
            <view wx:if="{{!settlementPage.isRefund}}" class="settlement-row settlement-row--last"><text class="settlement-section-title">本次需补缴</text><text class="settlement-value settlement-amount-inline settlement-total">{{settlementPage.amount}}</text></view>
          </view>
