            <view class="payment-row"><text>发起</text><text>{{paymentPage.created}}</text></view>
            <view class="payment-row"><text>最近查询</text><text>{{paymentPage.verified}}</text></view>
            <view class="result-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>{{paymentPage.note}}</text></view>
