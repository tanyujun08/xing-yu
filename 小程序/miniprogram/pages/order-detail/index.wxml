<page-meta root-font-size="system" />
<template name="completion-cash">
  <view wx:for="{{rows}}" wx:key="label" class="settlement-row {{index === rows.length - 1 ? 'settlement-row--last' : ''}}"><text class="settlement-label">{{item.label}}</text><text class="settlement-value">{{item.value}}</text></view>
</template>
<template name="delivery-term">
  <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.orderCalendar}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">租赁日期</text><view class="delivery-value"><text>{{deliveryPage.term}}</text><text class="delivery-deadline">归还截止：{{deliveryPage.deadline}}</text></view></view>
</template>
<template name="delivery-recipient">
  <view class="delivery-row delivery-row--last"><image class="delivery-row-icon" src="{{icons.discoveryLocation}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">收货地址</text><view class="delivery-value"><block wx:if="{{deliveryPage.recipient}}"><text>{{deliveryPage.recipient.person}} {{deliveryPage.recipient.phone}}</text><text>{{deliveryPage.recipient.region}}</text><text>{{deliveryPage.recipient.detail}}</text></block><text wx:else>收货地址待核实</text></view></view>
</template>
<template name="delivery-logistics">
  <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.discoveryClock}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">发货时间</text><text class="delivery-value">{{deliveryPage.shipped}}</text></view>
  <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.orderTruck}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">物流公司</text><text class="delivery-value">{{deliveryPage.carrier}}</text></view>
  <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.discoveryBox}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">运单号</text><view class="delivery-value"><text>{{deliveryPage.tracking || '待核实'}}</text><button wx:if="{{deliveryPage.tracking}}" class="delivery-link xy-action-hit" bindtap="copyTracking">复制运单号</button><button wx:if="{{deliveryPage.canCorrect}}" class="delivery-link xy-action-hit" data-code="CORRECT_SHIPMENT" bindtap="handleAction" disabled="{{busy || loading || shipmentPending}}" aria-disabled="{{busy || loading || shipmentPending}}">更正物流信息</button></view></view>
</template>
<template name="result-order">
  <order-product-summary id="result-product-summary" variant="order-list" clickable bindopen="openProduct" title="{{title}}" secondary="{{term}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" />
  <view wx:if="{{resultPage.kind === 'closed'}}" class="result-facts">
    <view wx:if="{{resultPage.zeroClosed}}" class="result-line"><text>原应付</text><text class="result-amount">{{total}}</text></view>
    <view class="result-line"><text>支付状态</text><text>{{resultPage.payment}}</text></view>
    <view class="result-line"><text>优惠券</text><text>{{resultPage.coupon}}</text></view>
    <text wx:if="{{resultPage.credential}}" class="result-credential">{{resultPage.credential}}</text>
    <block wx:if="{{quotaVisible}}">
      <view class="result-line"><text>合同次数</text><text>{{quotaState}}</text></view>
      <view class="result-line"><text>原权益有效期</text><text>{{quotaValidUntil}}</text></view>
      <text wx:if="{{quotaError}}" class="status-copy" role="alert">{{quotaError}}</text>
    </block>
  </view>
</template>
<view>
<page-shell surface="page" fixed-header has-footer="{{loaded || !loading}}">
  <page-header variant="order" title="{{settlementPage ? settlementPage.navTitle : paymentPage && paymentPage.kind === 'checking' ? '支付结果' : '订单详情'}}" bindback="onSecondaryNavigationBack" slot="header" />
  <view class="order-detail-page {{!loaded ? 'order-detail-page--unavailable' : ''}} {{loaded && !returnLanding && (preparationPage || nonfulfillmentPage || resultPage && resultPage.kind || returnDispatchPage || returnReviewPage || completionPage || settlementPage || paymentPage || pickupPage || deliveryPage) ? 'order-detail-page--r4' : ''}}">
    <view wx:if="{{loading}}" class="missing-card" role="status">正在读取订单…</view>
    <view wx:if="{{!loaded && !loading}}" class="order-recovery" style="min-height:{{recoveryHeight || 480}}px;" role="alert">
      <image class="order-recovery-image" src="{{icons.orderLoadFailed}}" mode="aspectFit" aria-hidden="true" />
      <text class="order-recovery-title">暂时无法加载订单</text>
      <text class="order-recovery-copy">{{errorText || '请检查网络后重试。'}}</text>
    </view>
    <block wx:if="{{loaded}}">
      <view wx:if="{{returnLanding}}" class="return-landing">
        <view class="rental-active-status"><view class="order-state-symbol" aria-hidden="true"><t-icon name="time" size="28" /></view><view><text class="delivery-title">租赁中</text><text class="delivery-copy">请按时归还，避免产生额外费用。</text></view></view>
        <view class="delivery-card">
          <order-product-summary variant="order-list" clickable bindopen="openProduct" title="{{title}}" secondary="官方设备" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" />
          <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.orderCalendar}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">租赁日期</text><view class="delivery-value"><text>{{term}}</text><text class="delivery-deadline">归还截止：{{returnDeadline}}</text></view></view>
          <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.returnCabinet}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">取还方式</text><text class="delivery-value">租赁柜取还</text></view>
          <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.discoveryLocation}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">归还地点</text><text class="delivery-value">按归还指引选择可用租赁柜</text></view>
          <block wx:for="{{assetFacts}}" wx:key="label"><view wx:if="{{item.label === '随附配件'}}" class="delivery-row"><image class="delivery-row-icon" src="{{icons.discoveryBox}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">附件清单</text><text class="delivery-value">{{item.value}}</text></view></block>
          <view class="delivery-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>归还前请核对本单设备与随附配件。</text></view>
        </view>
        <button wx:if="{{viewContract}}" class="delivery-card delivery-contract xy-button-fluid xy-action-hit" data-code="VIEW_CONTRACT" bindtap="handleAction"><image src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text>查看合同</text><image class="delivery-chevron" src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
        <button class="delivery-link xy-action-hit" bindtap="toggleReturnPreparation">{{returnGuideOpen ? '收起准备说明' : '归还前准备说明'}}</button>
        <button class="delivery-link xy-action-hit" bindtap="demoSupport">联系官方客服</button>
        <view wx:if="{{returnGuideOpen}}" class="return-card return-prepare"><text class="return-title">归还前请准备</text>
          <button class="return-preparation" bindtap="showReturnGuide"><text class="return-preparation-number">1</text><image src="{{icons.returnCamera}}" mode="aspectFit" /><view><text class="return-subtitle">拍清设备与配件</text><text class="return-copy">{{returnPhotoCount}}张照片，按分类逐项拍摄</text></view><image class="return-chevron" src="{{icons.returnChevron}}" mode="aspectFit" /></button>
          <button class="return-preparation" bindtap="showReturnGuide"><text class="return-preparation-number">2</text><image src="{{icons.returnVideo}}" mode="aspectFit" /><view><text class="return-subtitle">录制验机视频</text><text class="return-copy">展示拍照、闪光灯、录像及回放</text></view><image class="return-chevron" src="{{icons.returnChevron}}" mode="aspectFit" /></button>
          <button class="return-preparation" bindtap="showReturnGuide"><text class="return-preparation-number">3</text><image class="return-cabinet-icon" src="{{icons.returnCabinet}}" mode="aspectFit" /><view><text class="return-subtitle">到柜后放妥并关门</text><text class="return-copy">确认归还后等待设备核验</text></view><image class="return-chevron" src="{{icons.returnChevron}}" mode="aspectFit" /></button>
          <view class="return-note">归还完成后，平台继续验机与核费。</view>
        </view>
      </view>
      <view wx:elif="{{preparationPage}}" class="preparation-page">
        <view class="preparation-card preparation-status">
          <view class="preparation-heading"><image src="{{preparationPage.signed && !preparationPage.expired ? icons.returnSuccess : icons.contractPending}}" mode="aspectFit" aria-hidden="true" /><view><text class="preparation-title">{{preparationPage.title}}</text><text class="preparation-copy">{{preparationPage.hint}}</text></view></view>
          <view wx:if="{{preparationPage.signed}}" class="preparation-fact"><text>签署时间</text><text>{{preparationPage.signedAt}}</text></view>
          <view class="preparation-fact"><text>确认截止</text><text>{{preparationPage.deadline}}</text></view>
        </view>
        <view class="preparation-card">
          <order-product-summary variant="order-list" clickable bindopen="openProduct" title="{{title}}" secondary="{{'租期：' + term}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" />
          <view class="preparation-fact"><text>租金</text><text>{{rent}}</text></view>
          <view wx:if="{{hasDiscount}}" class="preparation-fact"><text>租金优惠</text><text>-{{discount}}</text></view>
          <view class="preparation-fact"><text>租赁押金</text><text>{{deposit}}</text></view>
          <view class="preparation-fact preparation-total"><text>本单应付</text><text>{{total}}</text></view>
        </view>
        <view class="preparation-card"><text class="preparation-section">取还信息</text><view class="preparation-fact"><text>取还方式</text><text>{{pickupText}}</text></view><view wx:if="{{recipient}}" class="preparation-address"><text class="preparation-copy">收货地址</text><text>{{recipient}}</text></view></view>
        <button wx:if="{{viewContract}}" class="preparation-card preparation-contract xy-action-hit xy-button-reset xy-button-fluid" data-code="VIEW_CONTRACT" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><image src="{{icons.contractPreview}}" mode="aspectFit" aria-hidden="true" /><view><text class="preparation-section">{{preparationPage.signed ? '已签合同可查看' : '查看租赁合同'}}</text><text class="preparation-copy">查看合同详情，了解双方权利义务</text></view><image class="preparation-chevron" src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
        <view class="preparation-card"><view class="preparation-number"><text>订单编号</text><text>{{orderNo}}</text><button class="preparation-link xy-action-hit" bindtap="copyOrderNumber">复制</button></view><view class="preparation-contact"><button wx:if="{{preparationPage.canCancel}}" class="preparation-link xy-action-hit" data-code="CANCEL_UNPAID" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">取消本次订单</button><button class="preparation-link xy-action-hit" bindtap="demoSupport">联系官方客服</button><button wx:if="{{peerContact}}" class="preparation-link xy-action-hit" bindtap="openPeerConversation">{{peerContact}}</button></view></view>
      </view>
      <view wx:elif="{{nonfulfillmentPage}}" class="nonfulfillment-page order-recovery-card">
        <view class="order-recovery-heading">
          <view class="order-recovery-symbol" aria-hidden="true"><text class="nonfulfillment-alert">!</text></view>
          <text class="order-recovery-state">无法履约</text><text class="nonfulfillment-processing">官方处理中</text>
        </view>
        <order-product-summary variant="order-list" clickable bindopen="openProduct" title="{{title}}" secondary="{{'原租期 ' + term}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" />
        <view class="order-recovery-facts">
          <view class="order-recovery-fact"><text>{{nonfulfillmentPage.knownCash ? '已支付金额' : '已支付'}}</text><text class="order-recovery-value {{nonfulfillmentPage.knownCash ? 'nonfulfillment-amount' : ''}}">{{nonfulfillmentPage.paid}}</text></view>
          <view class="order-recovery-fact"><text>设备状态</text><text class="order-recovery-value">设备尚未交付</text></view>
        </view>
        <view class="order-recovery-notice"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>官方正在核实并处理原订单，退款结果将在此更新。</text></view>
        <text wx:if="{{paymentNotice}}" class="status-copy" role="status">{{paymentNotice}}</text>
      </view>
      <view wx:elif="{{resultPage && resultPage.kind}}" class="order-result">
        <view class="result-card result-status {{resultPage.zeroClosed || resultPage.unpaidClosed ? 'result-status--zero' : ''}}">
          <view wx:if="{{resultPage.kind === 'settlement' || resultPage.unpaidClosed}}" class="order-state-symbol order-state-symbol--large order-state-symbol--soft {{resultPage.unpaidClosed ? 'order-state-symbol--danger' : ''}}" aria-hidden="true"><t-icon name="{{resultPage.unpaidClosed ? 'close' : 'time'}}" size="40" /></view>
          <image wx:else class="result-icon" src="{{icons.orderClosed}}" mode="aspectFit" aria-hidden="true" />
          <text class="result-title">{{resultPage.title}}</text>
          <view class="result-reason {{resultPage.zeroClosed || resultPage.unpaidClosed ? 'result-reason--closed result-reason--unpaid' : ''}}">
            <text>{{resultPage.reason}}</text>
            <text wx:if="{{resultPage.zeroClosed || resultPage.unpaidClosed}}" class="result-closed-at">{{closed}}</text>
            <text wx:if="{{resultPage.unpaidClosed && resultPage.canReorder}}" class="result-closed-at">{{resultPage.note}}</text>
          </view>
          <view wx:if="{{resultPage.steps.length}}" class="result-progress">
            <view wx:for="{{resultPage.steps}}" wx:key="label" class="result-step {{item.done ? 'result-step--done' : ''}}">
              <image src="{{item.done ? icons.returnSuccess : icons.returnClock}}" mode="aspectFit" aria-hidden="true" />
              <text>{{item.label}}</text>
            </view>
          </view>
          <view wx:if="{{resultPage.preparation}}" class="result-original">
            <template is="result-order" data="{{title, media, term, resultPage, total, quotaVisible, quotaState, quotaValidUntil, quotaError}}" />
          </view>
          <view wx:if="{{!resultPage.zeroClosed && !resultPage.unpaidClosed}}" class="result-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>{{resultPage.note}}</text></view>
        </view>
        <view wx:if="{{!resultPage.preparation}}" class="result-card">
          <template is="result-order" data="{{title, media, term, resultPage, total, quotaVisible, quotaState, quotaValidUntil, quotaError}}" />
        </view>
        <view wx:if="{{resultPage.zeroClosed}}" class="result-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>{{resultPage.note}}</text></view>
        <text wx:if="{{hasException}}" class="status-copy" role="alert">订单异常，请联系客服协助核实。</text>
        <text wx:if="{{paymentNotice}}" class="status-copy" role="status">{{paymentNotice}}</text>
        <view class="result-services">
          <button wx:if="{{feeBasisVisible}}" class="xy-action-hit" bindtap="openFeeBasis">查看费用依据</button>
          <block wx:for="{{actions}}" wx:key="action_code">
            <button wx:if="{{item.action_code === 'VIEW_CONTRACT' || item.action_code === 'QUERY_PAYMENT' || item.action_code === 'QUERY_REFUND'}}" class="xy-action-hit" data-code="{{item.action_code}}" bindtap="handleAction" disabled="{{busy || !item.allowed}}" aria-disabled="{{busy || !item.allowed}}">{{item.label}}</button>
            <text wx:if="{{!item.allowed}}" class="status-copy">{{item.display_reason}}</text>
          </block>
          <button class="xy-action-hit" bindtap="copyOrderNumber">复制订单号</button>
          <button class="xy-action-hit" bindtap="demoSupport">联系官方客服</button>
          <button wx:if="{{peerContact}}" class="xy-action-hit" bindtap="openPeerConversation">{{peerContact}}</button>
        </view>
      </view>
      <view wx:elif="{{returnDispatchPage}}" class="dispatch-page dispatch-page--{{returnDispatchPage.code}}">
        <view class="dispatch-heading {{returnDispatchPage.code === 'F1c' ? 'dispatch-heading--center' : ''}} {{returnDispatchPage.code === 'F1b' || returnDispatchPage.code === 'F2' ? 'dispatch-heading--tinted' : ''}}">
          <view wx:if="{{returnDispatchPage.code === 'F1c'}}" class="dispatch-alert" aria-hidden="true">!</view>
          <image wx:else class="dispatch-status-icon" src="{{returnDispatchPage.transit ? icons.orderTruck : icons.returnWaiting}}" mode="aspectFit" aria-hidden="true" />
          <view><text class="dispatch-title">{{returnDispatchPage.title}}</text><text class="dispatch-copy">{{returnDispatchPage.code === 'F1c' ? '请联系客服协助完善归还地址' : returnDispatchPage.note}}</text></view>
        </view>
        <view class="delivery-card">
          <order-product-summary variant="order-list" clickable bindopen="openProduct" title="{{title}}" secondary="{{returnDispatchPage.supply}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}"><text wx:if="{{returnDispatchPage.code === 'F1b' || returnDispatchPage.official}}" slot="meta" class="dispatch-product-term">{{returnDispatchPage.term}}</text></order-product-summary>
          <view wx:if="{{returnDispatchPage.transit}}" class="delivery-row"><image class="delivery-row-icon" src="{{icons.orderCalendar}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">租赁日期</text><text class="delivery-value">{{returnDispatchPage.term}}</text></view>
          <view wx:if="{{returnDispatchPage.code === 'F1c'}}" class="delivery-row delivery-row--last"><image class="delivery-row-icon" src="{{icons.returnClock}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">归还截止</text><text class="delivery-value {{returnDispatchPage.overdue ? 'delivery-deadline' : ''}}">{{returnDispatchPage.deadline}}</text></view>
          <block wx:if="{{returnDispatchPage.transit}}">
            <text wx:if="{{returnDispatchPage.lessor}}" class="dispatch-section-title">寄回信息</text>
            <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.discoveryBox}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">{{returnDispatchPage.lessor ? '承租人寄回时间' : '寄回时间'}}</text><text class="delivery-value">{{returnDispatchPage.shipped}}</text></view>
            <view class="delivery-row"><image class="delivery-row-icon" src="{{icons.orderTruck}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">物流公司</text><view class="delivery-value"><text>{{returnDispatchPage.carrier}}</text><text wx:if="{{!returnDispatchPage.lessor}}">{{returnDispatchPage.tracking || '运单号待核实'}}</text></view></view>
            <view wx:if="{{returnDispatchPage.lessor}}" class="delivery-row"><image class="delivery-row-icon" src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">快递单号</text><view class="delivery-value"><text>{{returnDispatchPage.tracking || '待核实'}}</text><button wx:if="{{returnDispatchPage.tracking}}" class="delivery-link xy-action-hit" data-kind="return" bindtap="copyTracking">复制运单号</button></view></view>
          </block>
          <block wx:if="{{returnDispatchPage.personal && returnDispatchPage.code !== 'F1c'}}">
            <text wx:if="{{returnDispatchPage.lessor}}" class="dispatch-section-title">归还收件人</text>
            <view class="delivery-row dispatch-address">
              <image class="delivery-row-icon" src="{{icons.discoveryLocation}}" mode="aspectFit" aria-hidden="true" />
              <text wx:if="{{returnDispatchPage.code === 'F2'}}" class="delivery-label">收件人信息</text>
              <view class="dispatch-address-body"><text wx:if="{{returnDispatchPage.code === 'F1b'}}">当前归还地址</text><block wx:if="{{returnDispatchPage.address}}"><text>{{returnDispatchPage.address.person}} {{returnDispatchPage.address.phone}}</text><text class="dispatch-copy">{{returnDispatchPage.address.region}}</text><text class="dispatch-copy">{{returnDispatchPage.address.detail}}</text></block><text wx:else>归还收件地址待核实，请刷新订单。</text></view>
              <button wx:if="{{returnDispatchPage.code === 'F1b'}}" class="delivery-link dispatch-copy-button xy-action-hit" bindtap="copyReturnAddress" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}">复制地址</button>
            </view>
          </block>
          <block wx:if="{{returnDispatchPage.code === 'F1b'}}"><view class="delivery-row"><image class="delivery-row-icon" src="{{icons.orderTruck}}" mode="aspectFit" aria-hidden="true" /><view class="dispatch-address-body"><text>寄回运费</text><text class="dispatch-copy">{{returnDispatchPage.returnFreight}}</text></view></view><view class="delivery-note dispatch-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>寄回运输时间计入租期，请合理安排。</text></view></block>
          <block wx:if="{{returnDispatchPage.official}}"><view class="dispatch-accessories"><text class="dispatch-section-title">附件清单</text><text class="dispatch-accessories-copy">{{returnDispatchPage.accessories || '本单未列出附件，请核对设备及随附物品。'}}</text></view><view class="delivery-note dispatch-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>设备实际收回后停止计算逾期费用，最终费用以官方核定为准。</text></view></block>
          <block wx:if="{{returnDispatchPage.code === 'F2'}}"><view class="delivery-row"><image class="delivery-row-icon" src="{{icons.returnDocument}}" mode="aspectFit" aria-hidden="true" /><text class="delivery-label">归还凭证</text><view class="delivery-value dispatch-evidence"><text>{{returnDispatchPage.evidenceSaved ? '已保存' : '尚有材料待完善'}}</text><image wx:if="{{returnDispatchPage.evidenceSaved}}" src="{{icons.returnSuccess}}" mode="aspectFit" aria-hidden="true" /></view></view></block>
          <view wx:if="{{returnDispatchPage.transit}}" class="delivery-note dispatch-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>{{returnDispatchPage.lessor ? '请实际收到设备后，再确认收回时间。' : '等待实际收回，寄出不等于归还完成。'}}</text></view>
        </view>
        <view wx:if="{{returnDispatchPage.code === 'F1c'}}" class="delivery-card"><view class="delivery-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>{{returnDispatchPage.note}}</text></view></view>
        <button wx:if="{{returnDispatchPage.code === 'F1b'}}" class="delivery-card dispatch-checkbox xy-button-fluid xy-action-hit" role="checkbox" aria-checked="{{returnAddressChecked}}" bindtap="toggleReturnAddress" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><view class="dispatch-check {{returnAddressChecked ? 'dispatch-check--checked' : ''}}"><image wx:if="{{returnAddressChecked}}" src="{{icons.returnSuccess}}" mode="aspectFit" aria-hidden="true" /></view><text>我已核对本单最新归还地址。</text></button>
        <view wx:if="{{returnDispatchPage.transit}}" class="dispatch-context"><button wx:if="{{returnDispatchPage.canCorrect}}" class="delivery-link xy-action-hit" data-mode="correction" bindtap="openDispatchRecord" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">更正物流信息</button><button wx:if="{{returnDispatchPage.lessor}}" class="delivery-link xy-action-hit" bindtap="openDispatchRecord" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查看归还材料</button><button class="delivery-link xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新归还进度</button></view>
      </view>
      <view wx:elif="{{returnReviewPage}}" class="review-page review-page--{{returnReviewPage.code}}">
        <view wx:if="{{returnReviewPage.code === 'F3' || returnReviewPage.lessor}}" class="review-heading">
          <image class="review-status-icon" src="{{icons.returnSuccess}}" mode="aspectFit" aria-hidden="true" />
          <view><text class="review-title">{{returnReviewPage.title}}</text><text class="review-copy">{{returnReviewPage.code === 'F3' ? '实际收回：' + returnReviewPage.received : returnReviewPage.note}}</text></view>
        </view>
        <view class="settlement-card review-product-card">
