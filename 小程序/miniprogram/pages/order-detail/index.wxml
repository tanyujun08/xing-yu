  <view wx:if="{{!loaded && !loading}}" slot="footer" class="order-recovery-actions">
    <button class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="refreshStatus" disabled="{{busy}}" aria-disabled="{{busy}}">重新加载</button>
    <button class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="backToOrders" disabled="{{busy}}" aria-disabled="{{busy}}">返回订单列表</button>
  </view>
  <view wx:if="{{loaded && returnLanding}}" slot="footer" class="order-recovery-actions"><button class="order-recovery-button xy-button-fluid xy-action-primary" data-code="{{returnEntryAction}}" bindtap="handleAction" disabled="{{busy || !returnEntryAction}}" aria-disabled="{{busy || !returnEntryAction}}">查看归还指引</button></view>
  <view wx:if="{{loaded && resultPage && resultPage.kind && !returnLanding}}" slot="footer" class="order-recovery-actions">
    <button wx:if="{{resultPage.canReorder}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="reorder" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{resultPage.primaryLabel}}</button>
    <button wx:if="{{resultPage.kind === 'settlement'}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新订单状态</button>
    <button class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="backToOrders" disabled="{{busy}}" aria-disabled="{{busy}}">返回订单列表</button>
  </view>
  <view wx:if="{{loaded && paymentPage && !returnLanding && (!resultPage || !resultPage.kind)}}" slot="footer" class="order-recovery-actions">
    <button class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="paymentPrimary" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{paymentPage.primaryLabel}}</button>
    <button wx:if="{{paymentPage.canCancel && paymentPage.kind !== 'checking'}}" class="order-recovery-button payment-cancel xy-button-fluid xy-action-hit" data-code="CANCEL_UNPAID" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">取消订单</button>
    <button wx:else class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="returnToPaymentOrder" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单</button>
  </view>
  <view wx:if="{{loaded && deliveryPage && !returnLanding && !paymentPage && (!resultPage || !resultPage.kind)}}" slot="footer" class="order-recovery-actions">
    <button wx:if="{{deliveryUnknown}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询原订单</button>
    <button wx:elif="{{deliveryPage.canReceive}}" class="order-recovery-button xy-button-fluid xy-action-primary" data-code="CONFIRM_DELIVERY" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">确认收货</button>
    <button wx:elif="{{deliveryPage.canShip}}" class="order-recovery-button xy-button-fluid xy-action-primary" data-code="SHIP" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">填写发货信息</button>
    <button wx:elif="{{deliveryAddressAction}}" class="order-recovery-button xy-button-fluid xy-action-primary" data-code="{{deliveryAddressAction}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{returnAddress ? '更新归还地址' : '设置归还地址'}}</button>
    <button wx:elif="{{deliveryPage.returnAction}}" class="order-recovery-button xy-button-fluid xy-action-primary" data-code="{{deliveryPage.returnAction}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查看归还指引</button>
    <button wx:else class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
    <button wx:if="{{deliveryAddressAction}}" class="delivery-link xy-action-hit" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
    <button wx:if="{{deliveryPage.kind === 'waiting' && deliveryPage.tenant}}" class="delivery-link xy-action-hit" bindtap="demoSupport">联系客服</button>
  </view>
  <view wx:if="{{loaded && pickupPage && !returnLanding && !paymentPage && (!resultPage || !resultPage.kind)}}" slot="footer" class="order-recovery-actions">
    <button class="order-recovery-button xy-button-fluid {{pickupPage.ready ? 'xy-action-secondary' : 'xy-action-primary'}}" bindtap="showPickupGuide" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{pickupPage.ready ? '取件指引' : '查看取件指引'}}</button>
    <button wx:if="{{pickupPage.taskAction}}" class="delivery-link xy-action-hit" data-code="{{pickupPage.taskAction}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">继续原取件任务</button>
  </view>
  <view wx:if="{{loaded && settlementPage && (!resultPage || !resultPage.kind)}}" slot="footer" class="order-recovery-actions">
    <button wx:if="{{settlementPage.failed}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="demoSupport">联系客服</button>
    <button wx:else class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="settlementPrimary" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{settlementPage.primaryLabel}}</button>
    <button wx:if="{{settlementPage.failed}}" class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="settlementPrimary" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询处理进度</button>
    <button wx:else class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="returnToPaymentOrder" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单</button>
  </view>
  <view wx:if="{{loaded && completionPage && (!resultPage || !resultPage.kind)}}" slot="footer" class="order-recovery-actions">
    <button wx:if="{{completionPage.closed}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="browseOtherDevices" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">选择其他设备</button>
    <button wx:elif="{{completionPage.code !== 'G3' && feeBasisVisible}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="openFeeBasis" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查看费用依据</button>
    <button class="order-recovery-button xy-button-fluid {{completionPage.closed || completionPage.code !== 'G3' && feeBasisVisible ? 'xy-action-secondary' : 'xy-action-primary'}}" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
  </view>
  <view wx:if="{{loaded && returnReviewPage && (!resultPage || !resultPage.kind)}}" slot="footer" class="order-recovery-actions">
    <button wx:if="{{returnReviewPage.code === 'F3'}}" class="order-recovery-button xy-button-fluid xy-action-primary" data-mode="supplement" bindtap="openReviewEvidence" disabled="{{busy || loading || !returnReviewPage.canSupplement}}" aria-disabled="{{busy || loading || !returnReviewPage.canSupplement}}">补交材料</button>
    <button wx:elif="{{returnReviewPage.code === 'F5'}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="demoSupport">联系客服</button>
    <button wx:elif="{{returnReviewPage.complete && returnReviewPage.booked}}" class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="openOrderEarning" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查看结算明细</button>
    <button wx:else class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{returnReviewPage.complete ? '刷新进度' : returnReviewPage.primaryLabel}}</button>
    <button wx:if="{{returnReviewPage.code === 'F5'}}" class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新处理进度</button>
    <button wx:elif="{{returnReviewPage.code !== 'F3'}}" class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
  </view>
  <view wx:if="{{loaded && returnDispatchPage && (!resultPage || !resultPage.kind)}}" slot="footer" class="order-recovery-actions">
    <button class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="returnDispatchPrimary" disabled="{{busy || loading || (returnDispatchPage.code === 'F1b' && (!returnAddressChecked || !returnDispatchPage.canReturn)) || (returnDispatchPage.code === 'F1e' && !returnDispatchPage.canReturn) || (returnDispatchPage.code === 'E6' && !returnDispatchPage.canReceive)}}" aria-disabled="{{busy || loading || (returnDispatchPage.code === 'F1b' && (!returnAddressChecked || !returnDispatchPage.canReturn)) || (returnDispatchPage.code === 'F1e' && !returnDispatchPage.canReturn) || (returnDispatchPage.code === 'E6' && !returnDispatchPage.canReceive)}}">{{returnDispatchPage.primaryLabel}}</button>
    <button wx:if="{{returnDispatchPage.code === 'F1c' || returnDispatchPage.official}}" class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="demoSupport">联系客服</button>
  </view>
  <view wx:if="{{loaded && nonfulfillmentPage}}" slot="footer" class="order-recovery-actions">
    <button class="order-recovery-button xy-button-fluid xy-action-primary" bindtap="demoSupport">联系客服</button>
    <button class="order-recovery-button xy-button-fluid xy-action-secondary" bindtap="queryNonfulfillment" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询处理进度</button>
  </view>
  <view wx:if="{{loaded && preparationPage}}" slot="footer" class="preparation-actions">
    <button wx:if="{{preparationPage.primaryCode}}" class="xy-button-fluid xy-action-primary" data-code="{{preparationPage.primaryCode}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{preparationPage.primaryLabel}}</button>
    <button wx:else class="xy-button-fluid xy-action-primary" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新订单状态</button>
  </view>
  <bottom-actions wx:if="{{loaded && !preparationPage && !nonfulfillmentPage && !returnDispatchPage && !returnReviewPage && !completionPage && !settlementPage && !pickupPage && !deliveryPage && !paymentPage && !returnLanding && (!resultPage || !resultPage.kind)}}" slot="footer" layout="custom">
    <view slot="actions" class="order-actions">
      <view wx:for="{{actions}}" wx:key="action_code" class="order-action-item">
        <button class="order-task-action xy-action-hit {{item.primary ? 'xy-action-primary' : 'xy-action-secondary'}}" data-code="{{item.action_code}}" bindtap="handleAction" disabled="{{busy || !item.allowed}}" aria-disabled="{{busy || !item.allowed}}">{{item.label}}</button>
        <text wx:if="{{!item.allowed}}" class="status-copy">{{item.display_reason}}</text>
      </view>
      <button class="order-task-action order-contact xy-action-secondary" bindtap="demoSupport" aria-label="联系官方客服">联系客服</button>
      <button wx:if="{{peerContact}}" class="order-task-action order-contact xy-action-secondary" bindtap="openPeerConversation">{{peerContact}}</button>
    </view>
  </bottom-actions>

</page-shell>
<confirmation-dialog visible="{{cancelDialog}}" order-style="{{true}}" title="取消本次订单？" content="将先核实支付结果，确认未支付后关闭；已签合同保留为只读。" confirm-text="{{preparationPage ? '继续当前订单' : '继续支付'}}" cancel-text="确认取消" busy="{{busy}}" bindconfirm="closeCancelDialog" bindcancel="confirmCancelOrder" />
</view>
<confirmation-dialog visible="{{(loaded && !!errorText) || pickupGuideOpen}}" tone="{{errorText ? 'error' : 'confirm'}}" title="{{errorText ? '操作未完成' : '到柜取件'}}" content="{{errorText || (pickupPage && !pickupPage.ready ? '可以提前查看本单取件码，租期开始前不能开柜。请于' + pickupPage.start + '起前往本单租赁柜，扫描柜身小程序码后输入取件码；晚取不顺延租期。' : '请到本单租赁柜，使用微信扫一扫扫描柜身小程序码，在柜详情输入本单六位取件码。弹窗会自动更新开柜状态；取出设备并关好柜门后，系统将自动确认取件结果。')}}" show-cancel="{{false}}" confirm-text="知道了" busy="{{busy}}" bindconfirm="dismissFeedback" />
<task-sheet id="shipment-sheet" open="{{shipmentSheet}}" title="{{shipmentCorrection ? '更正物流信息' : '填写发货信息'}}" busy="{{busy}}" show-footer full-height bindclose="closeShipment">
  <view class="task-body delivery-form">
    <view class="delivery-card"><view class="delivery-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>{{shipmentCorrection ? '更正本单物流信息，原记录和更正原因将保留。' : '请按订单地址寄出。'}}</text></view><order-product-summary variant="order-list" title="{{title}}" secondary="{{deliveryPage.term || term}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" /></view>
    <view class="delivery-card shipment-recipient">
      <image class="delivery-row-icon" src="{{icons.discoveryLocation}}" mode="aspectFit" aria-hidden="true" />
      <view class="shipment-recipient-content">
        <text class="delivery-section-title">收货人信息</text>
        <block wx:if="{{deliveryPage.recipient}}">
          <view class="shipment-recipient-contact-row">
            <view class="shipment-recipient-contact"><text>{{deliveryPage.recipient.person}}</text><text>{{deliveryPage.recipient.phone}}</text></view>
            <button class="delivery-link shipment-recipient-copy xy-action-hit" bindtap="copyRecipient" disabled="{{busy}}" aria-disabled="{{busy}}"><text>复制地址</text><t-icon name="file-copy" size="20" aria-hidden="true" /></button>
          </view>
          <text class="delivery-address">{{deliveryPage.recipient.region}}</text>
          <text class="delivery-address">{{deliveryPage.recipient.detail}}</text>
        </block>
        <text wx:else class="delivery-address">收货地址待核实</text>
      </view>
    </view>
    <view class="delivery-card delivery-fields">
      <text class="delivery-field-label">快递单号（必填）</text>
      <input id="shipment-tracking-input" class="dispatch-input shipment-input" type="text" maxlength="64" value="{{trackingInput}}" data-field="trackingInput" bindinput="inputShipment" placeholder="请输入快递单号" aria-label="快递单号" disabled="{{busy || shipmentPending}}" aria-disabled="{{busy || shipmentPending}}" focus="{{shipmentErrorField === 'trackingInput'}}" />
      <text wx:if="{{shipmentErrorField === 'trackingInput' && shipmentError}}" class="delivery-form-error" role="alert">{{shipmentError}}</text>
      <text class="delivery-field-label">快递公司（选填）</text>
      <input id="shipment-carrier-input" class="dispatch-input shipment-input" type="text" maxlength="64" value="{{carrierInput}}" data-field="carrierInput" bindinput="inputShipment" placeholder="请输入快递公司" aria-label="快递公司" disabled="{{busy || shipmentPending}}" aria-disabled="{{busy || shipmentPending}}" focus="{{shipmentErrorField === 'carrierInput'}}" />
      <text wx:if="{{shipmentErrorField === 'carrierInput' && shipmentError}}" class="delivery-form-error" role="alert">{{shipmentError}}</text>
      <text wx:if="{{shipmentCorrection}}" class="delivery-field-label">更正原因（必填）· 最多500字</text>
      <textarea wx:if="{{shipmentCorrection}}" class="delivery-reason xy-action-hit" maxlength="500" value="{{correctionReason}}" data-field="correctionReason" bindinput="inputShipment" placeholder="请说明更正原因" aria-label="更正原因" disabled="{{busy || shipmentPending}}" aria-disabled="{{busy || shipmentPending}}" focus="{{shipmentErrorField === 'correctionReason'}}" />
      <text wx:if="{{shipmentErrorField === 'correctionReason' && shipmentError}}" class="delivery-form-error" role="alert">{{shipmentError}}</text>
      <view class="delivery-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>{{deliveryPage.outboundFreight || '寄出运费以本单约定为准'}}，运输不顺延租期。</text></view>
    </view>
    <text wx:if="{{shipmentPending}}" class="delivery-copy" role="status">原请求结果待核实，内容已锁定；请先查询原订单，必要时显式恢复同一请求。</text>
    <text wx:if="{{shipmentError && !shipmentErrorField}}" class="delivery-form-error" role="alert">{{shipmentError}}</text>
  </view>
  <view slot="footer" class="delivery-form-actions">
    <button wx:if="{{shipmentPending}}" class="xy-button-fluid xy-action-secondary" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询原订单</button>
    <button class="xy-button-fluid xy-action-primary" bindtap="submitShipment" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{shipmentPending ? '恢复原物流请求' : shipmentCorrection ? '确认更正' : '确认发货'}}</button>
    <button class="xy-button-fluid xy-action-secondary" bindtap="closeShipment" disabled="{{busy}}" aria-disabled="{{busy}}">{{shipmentPending ? '返回订单' : '取消填写'}}</button>
  </view>
</task-sheet>
<task-sheet id="return-sheet" open="{{!!returnSheet}}" title="{{returnSheet === 'receipt' ? '确认实际收回' : '设置归还地址'}}" busy="{{returnBusy}}" show-footer full-height bindclose="closeReturnSheet">
  <view class="return-form-page">
    <block wx:if="{{returnSheet === 'receipt'}}">
      <view class="return-form-card">
        <order-product-summary variant="order-list" title="{{title}}" secondary="个人设备" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" />
        <view class="return-form-waybill"><image src="{{icons.orderTruck}}" mode="aspectFit" aria-hidden="true" /><text>返程单号</text><text class="return-form-waybill-value">{{returnTracking || '未登记'}}</text></view>
      </view>
      <view class="return-form-card return-receipt-form">
        <text class="return-form-label"><text class="return-form-required">*</text> 实际收回日期</text>
        <picker mode="date" value="{{receiptDate}}" data-field="receiptDate" bindchange="receiptTimeChange" disabled="{{returnBusy || returnPending}}" aria-disabled="{{returnBusy || returnPending}}" aria-label="实际收回日期，必填"><view class="return-form-picker xy-action-hit"><text>{{receiptDate || '请选择日期'}}</text><image src="{{icons.orderCalendar}}" mode="aspectFit" aria-hidden="true" /></view></picker>
        <text class="return-form-label"><text class="return-form-required">*</text> 实际收回时间</text>
        <picker mode="time" value="{{receiptTime}}" data-field="receiptTime" bindchange="receiptTimeChange" disabled="{{returnBusy || returnPending}}" aria-disabled="{{returnBusy || returnPending}}" aria-label="实际收回时间，必填"><view class="return-form-picker xy-action-hit"><text>{{receiptTime || '请选择时间'}}</text><image src="{{icons.returnClock}}" mode="aspectFit" aria-hidden="true" /></view></picker>
        <text wx:if="{{returnError && returnErrorField === 'receiptTime'}}" class="return-form-error" role="alert">{{returnError}}</text>
        <text class="return-form-label">收回备注 <text class="return-form-optional">（选填）</text></text>
        <view class="return-note-box"><textarea class="return-form-note" maxlength="500" value="{{receiptNote}}" placeholder="请输入收回备注" data-field="receiptNote" bindinput="inputReturnField" disabled="{{returnBusy || returnPending}}" aria-disabled="{{returnBusy || returnPending}}" focus="{{returnErrorField === 'receiptNote'}}" aria-label="收回备注，选填，最多500字" /><text class="return-note-count">{{receiptNote.length}}/500</text></view>
        <text wx:if="{{returnError && returnErrorField === 'receiptNote'}}" class="return-form-error" role="alert">{{returnError}}</text>
        <view class="return-form-notice"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>实际收回后停止继续计算逾期，费用由官方审核核定。</text></view>
      </view>
    </block>
    <block wx:elif="{{returnSheet === 'address'}}">
      <view class="return-form-notice"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text>为本单选择收件地址。地址簿保存后，还需应用到本单；承租人将按本单最新归还地址寄回。</text></view>
      <view class="return-form-card">
        <text class="return-form-title">选择收件地址</text>
        <text wx:if="{{addressListBusy}}" class="return-form-copy" role="status">正在读取本人地址…</text>
        <text wx:elif="{{!addressOptions.length}}" class="return-form-copy">暂无可用收件地址，请先到“管理地址”添加。</text>
        <view class="return-address-list" role="radiogroup" aria-label="选择本单归还收件地址">
          <button wx:for="{{addressOptions}}" wx:key="id" class="return-address-choice xy-button-reset xy-button-fluid {{selectedAddressId === item.id ? 'return-address-choice--selected' : ''}}" data-id="{{item.id}}" bindtap="chooseOwnReturnAddress" disabled="{{returnBusy || returnPending || addressListBusy}}" aria-disabled="{{returnBusy || returnPending || addressListBusy}}" role="radio" aria-checked="{{selectedAddressId === item.id}}" aria-label="{{item.name + ' ' + item.phone + ' ' + item.region + item.detail}}">
            <view class="return-address-radio" aria-hidden="true"><view wx:if="{{selectedAddressId === item.id}}"></view></view>
            <view class="return-address-copy"><text class="return-address-person">{{item.name}} {{item.phone}}</text><text>{{item.region}}</text><text>{{item.detail}}</text></view>
          </button>
        </view>
        <button wx:if="{{addressNext}}" class="xy-action-hit xy-button-fluid" bindtap="loadOwnReturnAddresses" disabled="{{addressListBusy || returnPending || returnBusy}}" aria-disabled="{{addressListBusy || returnPending || returnBusy}}">加载更多地址</button>
        <button wx:if="{{returnError && !returnPending}}" class="xy-action-hit xy-button-fluid" bindtap="showOwnReturnAddresses" disabled="{{addressListBusy || returnBusy}}" aria-disabled="{{addressListBusy || returnBusy}}">重新读取地址</button>
        <button class="return-address-manage xy-button-reset xy-button-fluid" bindtap="manageReturnAddresses" disabled="{{returnBusy || returnPending || addressListBusy}}" aria-disabled="{{returnBusy || returnPending || addressListBusy}}"><image src="{{icons.discoveryLocation}}" mode="aspectFit" aria-hidden="true" /><text>管理地址</text><image src="{{icons.returnChevron}}" mode="aspectFit" aria-hidden="true" /></button>
      </view>
      <text wx:if="{{addressNotice}}" class="return-form-copy" role="status">{{addressNotice}}</text>
    </block>
    <text wx:if="{{returnError && returnErrorField !== 'receiptTime' && returnErrorField !== 'receiptNote'}}" class="return-form-error" role="alert">{{returnError}}</text>
    <text wx:if="{{returnPending}}" class="return-form-copy" role="status">原请求结果待核实，暂不可修改；请恢复原请求。</text>
  </view>
  <view slot="footer" class="return-form-actions">
    <button wx:if="{{returnSheet === 'receipt'}}" class="return-form-button xy-action-primary xy-button-fluid" bindtap="submitReceipt" disabled="{{returnBusy || !receiptDate || !receiptTime}}" aria-disabled="{{returnBusy || !receiptDate || !receiptTime}}" aria-busy="{{returnBusy}}">{{returnPending ? '恢复原收回确认' : '确认已收回'}}</button>
    <button wx:else class="return-form-button xy-action-primary xy-button-fluid" bindtap="submitReturnAddress" disabled="{{returnBusy || addressListBusy || !selectedAddressId}}" aria-disabled="{{returnBusy || addressListBusy || !selectedAddressId}}" aria-busy="{{returnBusy}}">{{returnPending ? '恢复原地址应用' : '应用所选地址到本单'}}</button>
    <button wx:if="{{returnSheet === 'receipt'}}" class="return-form-button return-form-cancel xy-action-hit xy-button-fluid" bindtap="closeReturnSheet" disabled="{{returnBusy}}" aria-disabled="{{returnBusy}}">暂不确认</button>
  </view>
</task-sheet>
