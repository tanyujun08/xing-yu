          <view wx:else class="settlement-row"><text class="settlement-label">设备状态</text><text class="settlement-value">设备已收回</text></view>
          <view class="settlement-note"><image src="{{icons.returnInfo}}" mode="aspectFit" aria-hidden="true" /><text class="settlement-copy">{{settlementPage.note}}</text></view>
        </view>
        <block wx:else>
          <view class="settlement-status {{!settlementPage.isRefund ? 'settlement-status--supplement' : ''}}">
