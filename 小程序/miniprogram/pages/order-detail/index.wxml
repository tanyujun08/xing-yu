<page-meta root-font-size="system" />
<wxs module="od">
function pick(landing, prep, nonful, result, dispatch, review, done, settle, pay, pickup, delivery) {
  if (landing) return 'landing';
  if (prep) return 'prep';
  if (nonful) return 'nonful';
  if (result && result.kind) return 'result';
  if (dispatch) return 'dispatch';
  if (review) return 'review';
  if (done) return 'done';
  if (settle) return 'settle';
  if (pay) return 'pay';
  if (pickup) return 'pickup';
  if (delivery) return 'delivery';
  return 'generic';
}
module.exports.v = function (landing, prep, nonful, result, dispatch, review, done, settle, pay, pickup, delivery) {
  return [{ id: 'branch', b: pick(landing, prep, nonful, result, dispatch, review, done, settle, pay, pickup, delivery) }];
};
</wxs>
<template name="device">
  <view class="xy-h-dev"><order-product-summary variant="order-list" clickable bindopen="openProduct" title="{{title}}" secondary="{{secondary}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" /></view>
</template>
<template name="cabinet">
  <view class="xy-h-loc"><image class="xy-h-loc__icon" src="{{icons.discoveryLocation}}" mode="aspectFit" aria-hidden="true" /><button class="xy-h-loc__main xy-action-hit" bindtap="openOrderCabinet"><text>{{name || '位置待核实'}}</text><text class="xy-h-row__sub">{{address || '地址待核实，请联系客服'}}</text></button><button class="xy-h-loc__nav xy-action-hit" bindtap="navigateOrderCabinet" aria-label="{{'导航到' + address}}">导航</button></view>
</template>
<template name="kf">
  <button class="xy-action-hit xy-h-kf" bindtap="demoSupport" aria-label="联系官方客服"><image src="{{icons.flowSupport}}" mode="aspectFit" aria-hidden="true" /><text>客服</text></button>
</template>
<view>
<page-shell surface="page" fixed-header has-footer="{{loaded || !loading}}">
  <page-header variant="order" title="{{settlementPage ? settlementPage.navTitle : paymentPage && paymentPage.kind === 'checking' ? '支付结果' : '订单详情'}}" bindback="onSecondaryNavigationBack" slot="header" />
  <view class="xy-h-page od-page">
    <view wx:if="{{loading}}" class="xy-h-blk xy-h-blk--pad xy-h-note" role="status">正在读取订单…</view>
    <view wx:if="{{!loaded && !loading}}" class="od-recovery" style="min-height:{{recoveryHeight || 480}}px;" role="alert">
      <image class="od-recovery__image" src="{{icons.orderLoadFailed}}" mode="aspectFit" aria-hidden="true" />
      <text class="od-recovery__title">暂时无法加载订单</text>
      <text class="xy-h-note">{{errorText || '请检查网络后重试。'}}</text>
    </view>
    <block wx:if="{{loaded}}" wx:for="{{od.v(returnLanding, preparationPage, nonfulfillmentPage, resultPage, returnDispatchPage, returnReviewPage, completionPage, settlementPage, paymentPage, pickupPage, deliveryPage)}}" wx:for-item="br" wx:key="id">

      <!-- 租赁中（官方租赁柜） -->
      <block wx:if="{{br.b === 'landing'}}">
        <status-hero tone="green" art="clock" title="租赁中" description="请于 {{returnDeadline}} 前归还，避免产生超期费。" />
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: '官方设备'}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">租期</text><text class="xy-h-row__v">{{term}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">归还截止</text><text class="xy-h-row__v xy-h-row__v--strong">{{returnDeadline}}</text></view>
          <block wx:for="{{assetFacts}}" wx:key="label"><view wx:if="{{item.label === '随附配件'}}" class="xy-h-row"><text class="xy-h-row__k">附件清单</text><text class="xy-h-row__v">{{item.value}}</text></view></block>
        </view>
        <text class="xy-h-cap">归还到</text>
        <view class="xy-h-blk">
          <block wx:if="{{orderCabinetId}}"><template is="cabinet" data="{{icons, name: orderCabinetName, address: orderCabinetAddress}}" /></block>
          <view wx:else class="xy-h-row"><text class="xy-h-row__k">租赁柜</text><text class="xy-h-row__v">按归还指引选择可用租赁柜</text></view>
        </view>
        <text class="xy-h-cap">归还三步</text>
        <view class="xy-h-blk">
          <button class="xy-h-link xy-action-hit" bindtap="showReturnGuide"><text class="od-num">1</text><view class="xy-h-link__k"><text>拍清设备与配件</text><text class="xy-h-row__sub">{{returnPhotoCount}} 张照片，按分类逐项拍摄</text></view><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          <button class="xy-h-link xy-action-hit" bindtap="showReturnGuide"><text class="od-num">2</text><view class="xy-h-link__k"><text>录制验机视频</text><text class="xy-h-row__sub">展示拍照、闪光灯、录像及回放</text></view><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          <button class="xy-h-link xy-action-hit" bindtap="showReturnGuide"><text class="od-num">3</text><view class="xy-h-link__k"><text>到柜后放妥并关门</text><text class="xy-h-row__sub">确认归还后等待设备核验</text></view><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          <text class="xy-h-inote">归还完成后，平台继续验机与核费。</text>
        </view>
      </block>

      <!-- 签约准备 -->
      <block wx:elif="{{br.b === 'prep'}}">
        <status-hero tone="{{preparationPage.expired ? 'neutral' : preparationPage.signed ? 'green' : 'orange'}}" art="{{preparationPage.expired ? 'clock' : preparationPage.signed ? 'check' : 'contract'}}" title="{{preparationPage.title}}" description="{{preparationPage.hint}}" />
        <view class="xy-h-blk">
          <view class="xy-h-key"><text class="xy-h-key__label">本单应付</text><text class="xy-h-key__amount">{{total}}</text><text class="xy-h-key__note">请于 {{preparationPage.deadline}} 前确认</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">租金</text><text class="xy-h-row__v xy-h-row__v--strong">{{rent}}</text></view>
          <view wx:if="{{hasDiscount}}" class="xy-h-row"><text class="xy-h-row__k">租金优惠</text><text class="xy-h-row__v xy-h-row__v--strong">-{{discount}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">租赁押金</text><text class="xy-h-row__v xy-h-row__v--strong">{{deposit}}</text></view>
        </view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: term}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">取还方式</text><text class="xy-h-row__v">{{pickupText}}</text></view>
          <view wx:if="{{recipient}}" class="xy-h-row"><text class="xy-h-row__k">收货地址</text><text class="xy-h-row__v od-v-wide">{{recipient}}</text></view>
          <block wx:if="{{orderCabinetId}}"><template is="cabinet" data="{{icons, name: orderCabinetName, address: orderCabinetAddress}}" /></block>
          <view wx:if="{{preparationPage.signed}}" class="xy-h-row"><text class="xy-h-row__k">签署时间</text><text class="xy-h-row__v">{{preparationPage.signedAt}}</text></view>
        </view>
      </block>

      <!-- 无法履约 -->
      <block wx:elif="{{br.b === 'nonful'}}">
        <status-hero tone="red" art="shield" title="无法履约" description="官方正在核实并处理原订单，退款结果将在此更新。" />
        <view class="xy-h-blk">
          <view class="xy-h-key"><text class="xy-h-key__label">{{nonfulfillmentPage.knownCash ? '已支付金额' : '已支付'}}</text><text class="{{nonfulfillmentPage.knownCash ? 'xy-h-key__amount' : 'xy-h-key__note'}}">{{nonfulfillmentPage.paid}}</text><text class="xy-h-key__note">官方处理中</text></view>
        </view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: '原租期 ' + term}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">设备状态</text><text class="xy-h-row__v">设备尚未交付</text></view>
        </view>
        <text wx:if="{{paymentNotice}}" class="xy-h-note" role="status">{{paymentNotice}}</text>
      </block>

      <!-- 已关闭 / 结算确认中 -->
      <block wx:elif="{{br.b === 'result'}}">
        <status-hero tone="{{resultPage.kind === 'settlement' ? 'blue' : 'neutral'}}" art="{{resultPage.kind === 'settlement' ? 'clock' : 'contract'}}" title="{{resultPage.title}}" description="{{resultPage.reason}}" />
        <view wx:if="{{resultPage.steps.length}}" class="xy-h-blk">
          <view class="xy-h-tl"><view wx:for="{{resultPage.steps}}" wx:key="label" class="xy-h-tl__item {{item.done ? 'is-done' : ''}}"><view class="xy-h-tl__dot" aria-hidden="true"></view><view class="xy-h-tl__copy"><text>{{item.label}}</text></view></view></view>
          <text class="xy-h-inote">{{resultPage.note}}</text>
        </view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: term}}" />
          <view wx:if="{{resultPage.zeroClosed || resultPage.unpaidClosed}}" class="xy-h-row"><text class="xy-h-row__k">关闭时间</text><text class="xy-h-row__v">{{closed}}</text></view>
          <view wx:if="{{resultPage.zeroClosed}}" class="xy-h-row"><text class="xy-h-row__k">原应付</text><text class="xy-h-row__v xy-h-row__v--strong">{{total}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">支付状态</text><text class="xy-h-row__v">{{resultPage.payment}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">优惠券</text><text class="xy-h-row__v od-v-wide">{{resultPage.coupon}}</text></view>
          <block wx:if="{{quotaVisible}}">
            <view class="xy-h-row"><text class="xy-h-row__k">合同次数</text><text class="xy-h-row__v">{{quotaState}}</text></view>
            <view class="xy-h-row"><text class="xy-h-row__k">原权益有效期</text><text class="xy-h-row__v">{{quotaValidUntil}}</text></view>
          </block>
          <text wx:if="{{resultPage.credential}}" class="xy-h-inote">{{resultPage.credential}}</text>
          <text wx:if="{{quotaError}}" class="xy-h-inote xy-h-alert" role="alert">{{quotaError}}</text>
          <text wx:if="{{!resultPage.steps.length}}" class="xy-h-inote">{{resultPage.note}}</text>
        </view>
        <text wx:if="{{hasException}}" class="xy-h-note xy-h-alert" role="alert">订单异常，请联系客服协助核实。</text>
        <text wx:if="{{paymentNotice}}" class="xy-h-note" role="status">{{paymentNotice}}</text>
        <block wx:for="{{actions}}" wx:key="action_code"><text wx:if="{{(item.action_code === 'QUERY_PAYMENT' || item.action_code === 'QUERY_REFUND') && !item.allowed}}" class="xy-h-note">{{item.display_reason}}</text></block>
      </block>

      <!-- 归还：待归还 / 逾期 / 寄回中 -->
      <block wx:elif="{{br.b === 'dispatch'}}">
        <status-hero tone="{{returnDispatchPage.overdue && !returnDispatchPage.transit ? 'red' : returnDispatchPage.code === 'F1c' ? 'orange' : 'green'}}" art="{{returnDispatchPage.overdue && !returnDispatchPage.transit ? 'calendar' : 'clock'}}" title="{{returnDispatchPage.title}}" description="{{returnDispatchPage.code === 'F1c' ? '请联系客服协助完善归还地址' : returnDispatchPage.note}}" />
        <view wx:if="{{returnDispatchPage.overdue && !returnDispatchPage.transit && overtime && overtime !== '¥0.00'}}" class="xy-h-blk">
          <view class="xy-h-key xy-h-key--warn"><text class="xy-h-key__label">已产生超期费</text><text class="xy-h-key__amount">{{overtime}}</text><text class="xy-h-key__note">设备实际收回后停止计算，最终以官方核定为准</text></view>
        </view>
        <block wx:if="{{orderCabinetId && !returnDispatchPage.transit}}">
          <text class="xy-h-cap">归还到</text>
          <view class="xy-h-blk"><template is="cabinet" data="{{icons, name: orderCabinetName, address: orderCabinetAddress}}" /></view>
        </block>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: returnDispatchPage.supply}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">租期</text><text class="xy-h-row__v">{{returnDispatchPage.term}}</text></view>
          <view wx:if="{{!returnDispatchPage.transit}}" class="xy-h-row"><text class="xy-h-row__k">归还截止</text><text class="xy-h-row__v {{returnDispatchPage.overdue ? 'od-v-warn' : 'xy-h-row__v--strong'}}">{{returnDispatchPage.deadline}}</text></view>
          <view wx:if="{{returnDispatchPage.official}}" class="xy-h-row"><text class="xy-h-row__k">附件清单</text><text class="xy-h-row__v od-v-wide">{{returnDispatchPage.accessories || '本单未列出附件，请核对设备及随附物品'}}</text></view>
          <view wx:if="{{returnDispatchPage.code === 'F1b'}}" class="xy-h-row"><text class="xy-h-row__k">寄回运费</text><text class="xy-h-row__v od-v-wide">{{returnDispatchPage.returnFreight}}</text></view>
          <text wx:if="{{returnDispatchPage.code === 'F1b'}}" class="xy-h-inote">寄回运输时间计入租期，请合理安排。</text>
        </view>
        <block wx:if="{{returnDispatchPage.transit}}">
          <text class="xy-h-cap">寄回信息</text>
          <view class="xy-h-blk">
            <view class="xy-h-row"><text class="xy-h-row__k">{{returnDispatchPage.lessor ? '承租人寄回时间' : '寄回时间'}}</text><text class="xy-h-row__v">{{returnDispatchPage.shipped}}</text></view>
            <view class="xy-h-row"><text class="xy-h-row__k">物流公司</text><text class="xy-h-row__v">{{returnDispatchPage.carrier}}</text></view>
            <button wx:if="{{returnDispatchPage.tracking}}" class="xy-h-link xy-action-hit" data-kind="return" bindtap="copyTracking"><text class="xy-h-link__k">运单号</text><text class="xy-h-link__v">{{returnDispatchPage.tracking}}</text><text class="xy-h-link__act">复制</text></button><view wx:else class="xy-h-row"><text class="xy-h-row__k">运单号</text><text class="xy-h-row__v">待核实</text></view>
            <view wx:if="{{returnDispatchPage.code === 'F2'}}" class="xy-h-row"><text class="xy-h-row__k">归还凭证</text><text class="xy-h-row__v {{returnDispatchPage.evidenceSaved ? 'od-v-ok' : 'od-v-warn'}}">{{returnDispatchPage.evidenceSaved ? '已保存' : '尚有材料待完善'}}</text></view>
            <text class="xy-h-inote">{{returnDispatchPage.lessor ? '请实际收到设备后，再确认收回时间。' : '等待实际收回，寄出不等于归还完成。'}}</text>
          </view>
        </block>
        <block wx:if="{{returnDispatchPage.personal && returnDispatchPage.code !== 'F1c'}}">
          <text class="xy-h-cap">{{returnDispatchPage.code === 'F1b' ? '当前归还地址' : '归还收件人'}}</text>
          <view class="xy-h-blk xy-h-blk--pad od-address">
            <block wx:if="{{returnDispatchPage.address}}"><text class="od-address__person">{{returnDispatchPage.address.person}} {{returnDispatchPage.address.phone}}</text><text class="xy-h-note">{{returnDispatchPage.address.region}}{{returnDispatchPage.address.detail}}</text></block>
            <text wx:else class="xy-h-note">归还收件地址待核实，请刷新订单。</text>
            <button wx:if="{{returnDispatchPage.code === 'F1b'}}" class="xy-h-detail__act xy-action-hit" bindtap="copyReturnAddress" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}">复制地址</button>
          </view>
        </block>
        <text wx:if="{{returnDispatchPage.code === 'F1c'}}" class="xy-h-note">{{returnDispatchPage.note}}</text>
        <block wx:if="{{returnDispatchPage.transit && (returnDispatchPage.canCorrect || returnDispatchPage.lessor)}}">
          <view class="xy-h-blk">
            <button wx:if="{{returnDispatchPage.canCorrect}}" class="xy-h-link xy-action-hit" data-mode="correction" bindtap="openDispatchRecord" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">更正物流信息</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
            <button wx:if="{{returnDispatchPage.lessor}}" class="xy-h-link xy-action-hit" bindtap="openDispatchRecord" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">查看归还材料</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          </view>
        </block>
      </block>

      <!-- 归还审核 -->
      <block wx:elif="{{br.b === 'review'}}">
        <status-hero tone="{{returnReviewPage.code === 'F3' || returnReviewPage.code === 'F5' ? 'orange' : returnReviewPage.complete ? 'green' : 'blue'}}" art="{{returnReviewPage.code === 'F3' || returnReviewPage.code === 'F5' ? 'shield' : returnReviewPage.complete ? 'check' : 'clock'}}" title="{{returnReviewPage.title}}" description="{{returnReviewPage.code === 'F3' ? '实际收回：' + returnReviewPage.received : returnReviewPage.code === 'F5' ? '设备已于 ' + returnReviewPage.received + ' 收回' : returnReviewPage.note}}" />
        <block wx:if="{{returnReviewPage.code === 'F3'}}">
          <text class="xy-h-cap">待补充的材料</text>
          <view class="xy-h-blk">
            <view wx:for="{{returnReviewPage.missing}}" wx:key="key" class="xy-h-row"><view class="xy-h-row__k"><text>{{item.title}}</text><text class="xy-h-row__sub">{{item.reason}}</text></view><text class="xy-h-tag xy-h-tag--warn">待补</text></view>
            <text wx:if="{{!returnReviewPage.missing.length}}" class="xy-h-inote">缺项说明暂不可用，请刷新订单或联系客服核实。</text>
            <button class="xy-h-link xy-action-hit" data-mode="record" bindtap="openReviewEvidence" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}"><text class="xy-h-link__k">查看已交材料</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
            <button wx:if="{{!returnReviewPage.canSupplement}}" class="xy-h-link xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">刷新材料要求</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
            <text class="xy-h-inote">按要求补交材料，已有材料会保留。设备已收回，不再累计实收后的逾期。</text>
          </view>
        </block>
        <block wx:elif="{{returnReviewPage.code === 'F5'}}">
          <text class="xy-h-cap">待核实事项</text>
          <view class="xy-h-blk xy-h-blk--pad"><text class="od-body">{{returnReviewPage.reason}}</text><text class="xy-h-note od-gap">官方正在核实费用依据，处理结果将在本单更新。实收后不继续累计逾期。</text></view>
        </block>
        <block wx:elif="{{returnReviewPage.complete}}">
          <text class="xy-h-cap">完成进度</text>
          <view class="xy-h-blk"><view wx:for="{{returnReviewPage.steps}}" wx:key="key" class="xy-h-row"><text class="xy-h-row__k">{{item.label}}</text><text class="xy-h-row__v {{item.done ? 'od-v-ok' : ''}}">{{item.done ? '已完成' : '待核实'}}</text></view></view>
          <view class="xy-h-blk">
            <view class="xy-h-key {{returnReviewPage.booked ? 'xy-h-key--brand' : ''}}"><text class="xy-h-key__label">收益</text><text class="od-key-text">{{returnReviewPage.booked ? '收益已入账' : '收益入账待核实'}}</text><text class="xy-h-key__note">{{returnReviewPage.earningNote}}</text></view>
            <text wx:if="{{earningError}}" class="xy-h-inote xy-h-alert" role="alert">{{earningError}}</text>
          </view>
        </block>
        <block wx:else>
          <text class="xy-h-cap">处理进度</text>
          <view class="xy-h-blk">
            <view class="xy-h-tl"><view wx:for="{{returnReviewPage.steps}}" wx:key="key" class="xy-h-tl__item {{item.done ? 'is-done' : ''}} {{item.current ? 'is-current' : ''}}"><view class="xy-h-tl__dot" aria-hidden="true"></view><view class="xy-h-tl__copy"><text>{{item.label}}</text><text wx:if="{{item.detail}}" class="xy-h-row__sub">{{item.detail}}</text></view></view></view>
            <block wx:if="{{returnReviewPage.code === 'E8'}}">
              <button class="xy-h-link xy-action-hit" data-mode="record" bindtap="openReviewEvidence" disabled="{{loading || busy}}" aria-disabled="{{loading || busy}}"><text class="xy-h-link__k">查看归还材料</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
              <text class="xy-h-inote">实际收回已记录，费用与结算进度将在本单更新。{{returnReviewPage.materialRequired ? '当前等待承租人补充材料。' : ''}}</text>
            </block>
          </view>
        </block>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: returnReviewPage.supply}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">租期</text><text class="xy-h-row__v">{{returnReviewPage.term}}</text></view>
          <view wx:if="{{returnReviewPage.received && returnReviewPage.code !== 'F3' && returnReviewPage.code !== 'F5'}}" class="xy-h-row"><text class="xy-h-row__k">实际收回</text><text class="xy-h-row__v">{{returnReviewPage.received}}</text></view>
        </view>
      </block>

      <!-- 已完成 / 已关闭（有资金记录） -->
      <block wx:elif="{{br.b === 'done'}}">
        <status-hero tone="{{completionPage.closed ? 'neutral' : completionPage.transactionsVerified ? 'green' : 'orange'}}" art="{{completionPage.closed ? 'contract' : completionPage.transactionsVerified ? 'check' : 'clock'}}" title="{{completionPage.title}}" description="{{completionPage.note}}" />
        <view class="xy-h-blk">
          <view class="xy-h-key"><text class="xy-h-key__label">{{completionPage.closed ? '本单净支付' : '最终花费'}}</text><text wx:if="{{completionPage.known}}" class="xy-h-key__amount">{{completionPage.amount}}</text><text wx:else class="xy-h-key__note" role="status">{{completionPage.cashNote}}</text></view>
          <block wx:if="{{!completionPage.closed}}"><view wx:for="{{completionPage.feeRows}}" wx:key="label" class="xy-h-row"><text class="xy-h-row__k">{{item.label}}</text><text class="xy-h-row__v xy-h-row__v--strong">{{item.value}}</text></view></block>
          <text wx:if="{{!completionPage.closed && (completionPage.code === 'H4' || completionPage.code === 'G4')}}" class="xy-h-inote">{{completionPage.deductionNote}}</text>
        </view>
        <text class="xy-h-cap">{{completionPage.closed ? '退款信息' : '资金记录'}}</text>
        <view class="xy-h-blk">
          <view wx:for="{{completionPage.cashRows}}" wx:key="label" class="xy-h-row"><text class="xy-h-row__k">{{item.label}}</text><text class="xy-h-row__v xy-h-row__v--strong">{{item.value}}</text></view>
          <button wx:if="{{completionPage.closed}}" class="xy-h-link xy-action-hit" bindtap="toggleCompletionRecords" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}" aria-expanded="{{completionRecordsExpanded}}"><text class="xy-h-link__k">支付记录</text><text class="xy-h-link__act">{{completionRecordsExpanded ? '收起' : '展开'}}</text></button>
          <view wx:if="{{completionPage.closed && completionRecordsExpanded}}" class="xy-h-detail">
            <block wx:for="{{paymentRows}}" wx:key="id"><text class="xy-h-detail__title">{{item.purpose}} · {{item.status}}</text><view class="xy-h-detail__line"><text>支付编号</text><text>{{item.id}}</text></view><view class="xy-h-detail__line"><text>应付金额</text><text>{{item.amount}}</text></view><view class="xy-h-detail__line"><text>微信实付</text><text>{{item.cash}}</text></view><view class="xy-h-detail__line"><text>最近查询</text><text>{{item.verified}}</text></view></block>
            <block wx:if="{{refundRecordVisible}}"><text class="xy-h-detail__title">{{refundTitle}} · {{refundStatus}}</text><view class="xy-h-detail__line"><text>退款编号</text><text>{{refundId}}</text></view><view class="xy-h-detail__line"><text>应退金额</text><text>{{refundAmount}}</text></view><view class="xy-h-detail__line"><text>实际退还现金</text><text>{{refundCash}}</text></view><view class="xy-h-detail__line"><text>渠道退款时间</text><text>{{refundAt}}</text></view></block>
          </view>
        </view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: completionPage.supply}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">{{completionPage.closed ? '原租期' : '租期'}}</text><text class="xy-h-row__v">{{term}}</text></view>
          <view wx:if="{{!completionPage.closed}}" class="xy-h-row"><text class="xy-h-row__k">实际收回</text><text class="xy-h-row__v">{{returned || '待核实'}}</text></view>
        </view>
      </block>

      <!-- 退押 / 补缴 -->
      <block wx:elif="{{br.b === 'settle'}}">
        <status-hero tone="{{settlementPage.failed ? 'red' : settlementPage.isRefund ? 'blue' : 'orange'}}" art="{{settlementPage.failed ? 'shield' : settlementPage.isRefund ? 'wallet' : 'clock'}}" title="{{settlementPage.title}}" description="{{settlementPage.expiredNote || settlementPage.note}}" />
        <view class="xy-h-blk">
          <view class="xy-h-key {{settlementPage.isRefund ? 'xy-h-key--brand' : 'xy-h-key--warn'}}"><text class="xy-h-key__label">{{settlementPage.compact ? settlementPage.amountLabel : settlementPage.isRefund ? '应退押金' : '本次需补缴'}}</text><text class="xy-h-key__amount">{{settlementPage.amount}}</text><text wx:if="{{!settlementPage.compact}}" class="xy-h-key__note">费用已核定{{settlementPage.isRefund ? '，退还至原支付渠道' : '，已由押金抵扣部分费用'}}</text></view>
          <block wx:if="{{settlementPage.compact}}">
            <block wx:if="{{!settlementPage.isRefund && !settlementPage.failed}}">
              <view class="xy-h-row"><text class="xy-h-row__k">发起</text><text class="xy-h-row__v">{{settlementPage.created}}</text></view>
              <view class="xy-h-row"><text class="xy-h-row__k">原支付截止</text><text class="xy-h-row__v">{{settlementPage.deadline}}</text></view>
            </block>
            <view wx:if="{{!settlementPage.failed}}" class="xy-h-row"><text class="xy-h-row__k">最近查询</text><text class="xy-h-row__v">{{settlementPage.verified}}</text></view>
            <view wx:elif="{{settlementPage.isRefund}}" class="xy-h-row"><text class="xy-h-row__k">原因</text><text class="xy-h-row__v od-v-wide">{{settlementPage.reason}}</text></view>
            <view wx:else class="xy-h-row"><text class="xy-h-row__k">设备状态</text><text class="xy-h-row__v">设备已收回</text></view>
          </block>
          <block wx:else><view wx:for="{{settlementPage.rows}}" wx:key="label" class="xy-h-row"><text class="xy-h-row__k">{{item.label}}</text><text class="xy-h-row__v xy-h-row__v--strong">{{item.value}}</text></view></block>
        </view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: settlementPage.supply || term}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">实际收回</text><text class="xy-h-row__v">{{returned || '待核实'}}</text></view>
        </view>
        <text wx:if="{{paymentNotice}}" class="xy-h-note" role="status">{{paymentNotice}}</text>
      </block>

      <!-- 待支付 / 支付确认 -->
      <block wx:elif="{{br.b === 'pay'}}">
        <status-hero tone="{{paymentPage.kind === 'checking' ? 'blue' : 'orange'}}" art="{{paymentPage.kind === 'checking' ? 'clock' : 'wallet'}}" title="{{paymentPage.title}}" description="{{paymentPage.kind === 'ready' ? '请于 ' + paymentPage.deadline + ' 前完成支付' : paymentPage.note}}" />
        <view class="xy-h-blk">
          <view class="xy-h-key"><text class="xy-h-key__label">{{paymentPage.kind === 'ready' ? '本单应付' : '原支付金额'}}</text><text class="xy-h-key__amount">{{paymentPage.amount}}</text></view>
          <block wx:if="{{paymentPage.kind === 'ready'}}">
            <view class="xy-h-row"><text class="xy-h-row__k">租金</text><text class="xy-h-row__v xy-h-row__v--strong">{{rent}}</text></view>
            <view wx:if="{{hasDiscount}}" class="xy-h-row"><text class="xy-h-row__k">优惠券抵扣</text><text class="xy-h-row__v xy-h-row__v--strong">−{{discount}}</text></view>
            <view class="xy-h-row"><text class="xy-h-row__k">租赁押金</text><text class="xy-h-row__v xy-h-row__v--strong">{{deposit}}</text></view>
          </block>
          <block wx:elif="{{paymentPage.kind === 'checking'}}">
            <view class="xy-h-row"><text class="xy-h-row__k">发起</text><text class="xy-h-row__v">{{paymentPage.created}}</text></view>
            <view class="xy-h-row"><text class="xy-h-row__k">最近查询</text><text class="xy-h-row__v">{{paymentPage.verified}}</text></view>
          </block>
          <view wx:else class="xy-h-row"><text class="xy-h-row__k">支付截止时间</text><text class="xy-h-row__v">{{paymentPage.deadline}}</text></view>
        </view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: paymentSummary}}" />
          <view wx:if="{{recipient}}" class="xy-h-row"><text class="xy-h-row__k">收货地址</text><text class="xy-h-row__v od-v-wide">{{recipient}}</text></view>
          <block wx:if="{{orderCabinetId}}"><template is="cabinet" data="{{icons, name: orderCabinetName, address: orderCabinetAddress}}" /></block>
        </view>
        <text wx:if="{{paymentNotice}}" class="xy-h-note" role="status">{{paymentNotice}}</text>
        <text wx:if="{{hasException}}" class="xy-h-note xy-h-alert" role="alert">订单异常，请联系客服协助核实。</text>
      </block>

      <!-- 待取件 / 可以取件 -->
      <block wx:elif="{{br.b === 'pickup'}}">
        <status-hero tone="green" art="{{pickupPage.ready ? 'check' : 'calendar'}}" title="{{pickupPage.title}}" description="{{pickupPage.ready ? '请按预约时间前往取件，晚取不顺延租期' : pickupPage.start + ' 起可取件，晚取不顺延租期'}}" />
        <view wx:if="{{pickupVisible}}" class="xy-h-blk pickup-order-code">
          <view class="xy-h-key"><text class="xy-h-key__label">本单取件码 · 格口 {{pickupCompartment}}</text><text wx:if="{{pickupCode}}" class="pickup-code xy-h-code">{{pickupCode}}</text><text class="xy-h-key__note">取件时间 {{pickupStart}} 至 {{pickupEnd}}</text></view>
          <button wx:if="{{pickupCode}}" class="xy-h-link xy-action-hit" bindtap="copyCode"><text class="xy-h-link__k">复制六位取件码</text><text class="xy-h-link__act">复制</text></button>
          <text wx:if="{{pickupError}}" class="xy-h-inote xy-h-alert" role="alert">{{pickupError}}</text>
          <button wx:if="{{pickupError}}" class="xy-h-link xy-action-hit" data-code="READ_PICKUP_CODE" bindtap="handleAction" disabled="{{loading}}" aria-disabled="{{loading}}"><text class="xy-h-link__k">重新查询取件码</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          <text class="xy-h-inote">租期开始前不能开柜；到柜后扫描柜身小程序码，输入取件码。</text>
        </view>
        <text class="xy-h-cap">取件地点</text>
        <view class="xy-h-blk"><template is="cabinet" data="{{icons, name: pickupPage.name, address: pickupPage.address}}" /></view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: '官方设备'}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">租期</text><text class="xy-h-row__v">{{pickupPage.term}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">归还截止</text><text class="xy-h-row__v xy-h-row__v--strong">{{pickupPage.deadline}}</text></view>
          <view wx:if="{{viewContract}}" class="xy-h-row"><text class="xy-h-row__k">合同</text><text class="xy-h-row__v {{pickupSigned ? 'od-v-ok' : ''}}">{{pickupSigned ? '已签署' : '待核实'}}</text></view>
          <text wx:if="{{pickupContractError}}" class="xy-h-inote xy-h-alert" role="alert">{{pickupContractError}}</text>
        </view>
      </block>

      <!-- 快递往返：发货 / 收货 / 租赁中 -->
      <block wx:elif="{{br.b === 'delivery'}}">
        <status-hero tone="{{deliveryPage.kind === 'using' ? 'green' : 'blue'}}" art="clock" title="{{deliveryPage.title}}" description="{{deliveryPage.copy}}" />
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: deliveryPage.kind === 'waiting' ? '个人设备 · 快递往返' : '个人设备'}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">租期</text><text class="xy-h-row__v">{{deliveryPage.term}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">归还截止</text><text class="xy-h-row__v xy-h-row__v--strong">{{deliveryPage.deadline}}</text></view>
          <view wx:if="{{deliveryPage.kind === 'using' && deliveryPage.tenant}}" class="xy-h-row"><text class="xy-h-row__k">取还方式</text><text class="xy-h-row__v">快递往返</text></view>
          <text wx:if="{{deliveryPage.kind === 'using' && deliveryPage.tenant}}" class="xy-h-inote">寄回运输时间计入租期，请合理安排。{{deliveryPage.returnFreight}}。归还收件信息在办理归还前核对。</text>
        </view>
        <block wx:if="{{deliveryPage.kind === 'outbound'}}">
          <text class="xy-h-cap">物流信息</text>
          <view class="xy-h-blk">
            <view class="xy-h-row"><text class="xy-h-row__k">发货时间</text><text class="xy-h-row__v">{{deliveryPage.shipped}}</text></view>
            <view class="xy-h-row"><text class="xy-h-row__k">物流公司</text><text class="xy-h-row__v">{{deliveryPage.carrier}}</text></view>
            <button wx:if="{{deliveryPage.tracking}}" class="xy-h-link xy-action-hit" bindtap="copyTracking"><text class="xy-h-link__k">运单号</text><text class="xy-h-link__v">{{deliveryPage.tracking}}</text><text class="xy-h-link__act">复制</text></button><view wx:else class="xy-h-row"><text class="xy-h-row__k">运单号</text><text class="xy-h-row__v">待核实</text></view>
            <button wx:if="{{deliveryPage.canCorrect}}" class="xy-h-link xy-action-hit" data-code="CORRECT_SHIPMENT" bindtap="handleAction" disabled="{{busy || loading || shipmentPending}}" aria-disabled="{{busy || loading || shipmentPending}}"><text class="xy-h-link__k">更正物流信息</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          </view>
        </block>
        <block wx:if="{{deliveryPage.kind === 'outbound' || deliveryPage.kind === 'waiting'}}">
          <text class="xy-h-cap">收货信息</text>
          <view class="xy-h-blk xy-h-blk--pad od-address">
            <block wx:if="{{deliveryPage.recipient}}"><text class="od-address__person">{{deliveryPage.recipient.person}} {{deliveryPage.recipient.phone}}</text><text class="xy-h-note">{{deliveryPage.recipient.region}}{{deliveryPage.recipient.detail}}</text></block>
            <text wx:else class="xy-h-note">收货地址待核实</text>
            <text wx:if="{{deliveryPage.kind === 'waiting'}}" class="xy-h-note od-gap">{{deliveryPage.outboundFreight}}；{{deliveryPage.returnFreight}}。运输不顺延租期。</text>
            <text wx:elif="{{deliveryPage.tenant}}" class="xy-h-note od-gap">仅在实际收到设备后确认；收货不顺延租期。</text>
            <text wx:else class="xy-h-note od-gap">实际收货由承租人确认。</text>
          </view>
        </block>
        <block wx:if="{{deliveryPage.kind === 'using' && !deliveryPage.tenant}}">
          <text class="xy-h-cap">承租人信息</text>
          <view class="xy-h-blk">
            <view class="xy-h-row"><text class="xy-h-row__k">承租人</text><text class="xy-h-row__v">{{deliveryTenant || '待核实'}}</text></view>
            <view class="xy-h-row"><text class="xy-h-row__k">收货时间</text><text class="xy-h-row__v">{{deliveryPage.delivered}}</text></view>
            <text wx:if="{{deliveryTenantError}}" class="xy-h-inote xy-h-alert" role="alert">{{deliveryTenantError}}</text>
          </view>
          <text class="xy-h-cap">归还收件地址</text>
          <view class="xy-h-blk xy-h-blk--pad od-address"><text class="od-body">{{returnAddress || (deliveryAddressKnown ? '尚未设置' : '地址读取失败，请刷新')}}</text><text class="xy-h-note od-gap">{{returnAddress ? '已设置本单归还地址；如需更新，请在承租人寄回前修改。' : '请设置本单归还收件地址，便于承租人寄回。'}}</text></view>
        </block>
        <view wx:if="{{shipmentPending}}" class="xy-h-blk">
          <text class="xy-h-inote" role="status">原物流请求结果待核实；请恢复原请求，不要重新填写。</text>
          <button class="xy-h-link xy-action-hit" bindtap="restoreShipment" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">恢复原物流请求</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        </view>
        <text wx:if="{{deliveryUnknown}}" class="xy-h-note" role="status">收货确认结果待核实，请查询原订单；不会自动重复提交。</text>
        <text wx:if="{{blockers}}" class="xy-h-note" role="status">{{blockers}}</text>
      </block>

      <!-- 其他状态（待补缴、已关闭等通用详情） -->
      <block wx:else>
        <status-hero tone="{{status === '待补缴' || status === '待支付' ? 'orange' : status === '已关闭' || status === '已取消' ? 'neutral' : hasException ? 'red' : 'green'}}" art="{{status === '待补缴' || status === '待支付' ? 'wallet' : status === '已关闭' || status === '已取消' ? 'contract' : hasException ? 'shield' : 'check'}}" title="{{status}}" description="{{hasException ? '订单异常，请联系客服协助处理。' : blockers || paymentNotice || (status === '待补缴' ? '核定费用超过押金抵扣，请补缴差额。' : status === '已关闭' ? '关闭时间 ' + closed : '')}}" />
        <view wx:if="{{depositSettlementVisible}}" class="xy-h-blk">
          <view class="xy-h-key {{supplement !== '¥0.00' ? 'xy-h-key--warn' : 'xy-h-key--brand'}}"><text class="xy-h-key__label">{{supplement !== '¥0.00' ? '应补缴' : '应退押金'}}</text><text class="xy-h-key__amount">{{supplement !== '¥0.00' ? supplement : refundDue}}</text><text class="xy-h-key__note">{{billFinalized ? '官方费用已核定' : '等待官方核定，待核实金额不是零元'}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">租金</text><text class="xy-h-tag">已付</text><text class="xy-h-row__v xy-h-row__v--strong">{{rent}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">现金押金</text><text class="xy-h-tag">{{refunded !== '¥0.00' ? '已退 ' + refunded : '抵扣后退回'}}</text><text class="xy-h-row__v xy-h-row__v--strong">{{deposit}}</text></view>
          <view class="xy-h-row"><text class="xy-h-row__k">超期费</text><text wx:if="{{supplement !== '¥0.00'}}" class="xy-h-tag xy-h-tag--warn">待付</text><text class="xy-h-row__v xy-h-row__v--strong">{{overtime}}</text></view>
          <view wx:if="{{loss !== '¥0.00'}}" class="xy-h-row"><text class="xy-h-row__k">设备损失</text><text class="xy-h-row__v xy-h-row__v--strong">{{loss}}</text></view>
        </view>
        <view class="xy-h-blk">
          <template is="device" data="{{title, media, secondary: term}}" />
          <view class="xy-h-row"><text class="xy-h-row__k">取还方式</text><text class="xy-h-row__v">{{pickupText}}</text></view>
          <view wx:if="{{stage === '准备签约' || stage === '待支付'}}" class="xy-h-row"><text class="xy-h-row__k">本阶段截止</text><text class="xy-h-row__v">{{deadline}}</text></view>
          <block wx:if="{{orderCabinetId && status !== '已关闭' && status !== '已取消' && status !== '已完成'}}"><template is="cabinet" data="{{icons, name: orderCabinetName, address: orderCabinetAddress}}" /></block>
        </view>
        <view wx:if="{{pickupVisible}}" class="xy-h-blk pickup-order-code">
          <view class="xy-h-key"><text class="xy-h-key__label">本单取件码 · 格口 {{pickupCompartment}}</text><text wx:if="{{pickupCode}}" class="pickup-code xy-h-code">{{pickupCode}}</text><text class="xy-h-key__note">取件时间 {{pickupStart}} 至 {{pickupEnd}}</text></view>
          <button wx:if="{{pickupCode}}" class="xy-h-link xy-action-hit" bindtap="copyCode"><text class="xy-h-link__k">复制六位取件码</text><text class="xy-h-link__act">复制</text></button>
          <text wx:if="{{pickupError}}" class="xy-h-inote xy-h-alert" role="alert">{{pickupError}}</text>
          <button wx:if="{{pickupError}}" class="xy-h-link xy-action-hit" bindtap="refreshStatus" disabled="{{loading}}" aria-disabled="{{loading}}"><text class="xy-h-link__k">重新查询取件码</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          <text class="xy-h-inote">租期开始前不能开柜；到柜后扫描柜身小程序码，输入取件码。</text>
        </view>
      </block>

      <!-- 更多记录：所有状态统一 -->
      <text class="xy-h-cap">更多记录</text>
      <view class="xy-h-blk">
        <button class="xy-h-link xy-action-hit" bindtap="copyOrderNumber"><text class="xy-h-link__k">订单编号</text><text class="xy-h-link__v">{{orderNo}}</text><text class="xy-h-link__act">复制</text></button>
        <button wx:if="{{viewContract}}" class="xy-h-link xy-action-hit" data-code="VIEW_CONTRACT" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">{{br.b === 'done' && completionPage.closed ? '原租赁合同' : '租赁合同'}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <button wx:if="{{feeBasisVisible && br.b !== 'settle'}}" class="xy-h-link xy-action-hit" bindtap="openFeeBasis" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">费用计算依据</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <button wx:if="{{br.b === 'settle' && feeBasisVisible}}" class="xy-h-link xy-action-hit" bindtap="openFeeBasis" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">费用明细与依据</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <button wx:if="{{br.b === 'done' && completionPage.returnId}}" class="xy-h-link xy-action-hit" bindtap="openCompletedReturn" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">归还记录</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <block wx:for="{{actions}}" wx:key="action_code"><button wx:if="{{br.b === 'result' && (item.action_code === 'QUERY_PAYMENT' || item.action_code === 'QUERY_REFUND')}}" class="xy-h-link xy-action-hit" data-code="{{item.action_code}}" bindtap="handleAction" disabled="{{busy || !item.allowed}}" aria-disabled="{{busy || !item.allowed}}"><text class="xy-h-link__k">{{item.label}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></button></block>
        <block wx:if="{{br.b === 'generic'}}">
          <button class="xy-h-link xy-action-hit" bindtap="toggleOrderInfo" aria-expanded="{{orderInfoExpanded}}"><text class="xy-h-link__k">订单信息与支付记录</text><text class="xy-h-link__act">{{orderInfoExpanded ? '收起' : '展开'}}</text></button>
          <view wx:if="{{orderInfoExpanded}}" class="xy-h-detail">
            <view wx:for="{{assetFacts}}" wx:key="label" class="xy-h-detail__line"><text>{{item.label}}</text><text>{{item.value}}</text></view>
            <view class="xy-h-detail__line"><text>租金</text><text>{{rent}}</text></view>
            <view class="xy-h-detail__line"><text>现金押金</text><text>{{deposit}}</text></view>
            <view class="xy-h-detail__line"><text>初始应付</text><text>{{total}}</text></view>
            <view class="xy-h-detail__line"><text>租客实付（微信）</text><text>{{paid}}</text></view>
            <view class="xy-h-detail__line"><text>完成时间</text><text>{{completed}}</text></view>
            <view class="xy-h-detail__line"><text>关闭时间</text><text>{{closed}}</text></view>
            <view class="xy-h-detail__line"><text>本单优惠券</text><text>{{couponStatus}}</text></view>
            <block wx:if="{{quotaVisible}}">
              <view class="xy-h-detail__line"><text>合同次数</text><text>{{quotaState}}</text></view>
              <view class="xy-h-detail__line"><text>原权益有效期</text><text>{{quotaValidUntil}}</text></view>
              <text wx:if="{{quotaError}}" class="xy-h-alert" role="alert">{{quotaError}}</text>
              <text>权益释放或恢复不延长原有效期，以本单最新记录为准。</text>
            </block>
            <block wx:if="{{paymentRows.length}}">
              <text class="xy-h-detail__title od-gap">原支付记录</text>
              <block wx:for="{{paymentRows}}" wx:key="id">
                <text>{{item.purpose}} · {{item.status}}</text>
                <view class="xy-h-detail__line"><text>应付金额</text><text>{{item.amount}}</text></view>
                <view class="xy-h-detail__line"><text>实际支付现金</text><text>{{item.cash}}</text></view>
                <view class="xy-h-detail__line"><text>发起时间</text><text>{{item.created}}</text></view>
                <view class="xy-h-detail__line"><text>最近核实</text><text>{{item.verified}}</text></view>
                <button wx:if="{{item.canQuery}}" class="xy-h-detail__act xy-action-hit" data-id="{{item.id}}" bindtap="queryPaymentRecord" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询本次{{item.purpose}}</button>
              </block>
              <text>结果待核实不代表未付款，请使用本单查询支付结果入口或联系客服。</text>
            </block>
            <block wx:if="{{refundRecordVisible}}">
              <text class="xy-h-detail__title od-gap">{{refundTitle}}</text>
              <text role="{{refundFailed ? 'alert' : 'status'}}">{{refundStatus}}</text>
              <view class="xy-h-detail__line"><text>退款编号</text><text>{{refundId}}</text></view>
              <view class="xy-h-detail__line"><text>申请退还</text><text>{{refundAmount}}</text></view>
              <view class="xy-h-detail__line"><text>实际退还现金</text><text>{{refundCash}}</text></view>
              <view class="xy-h-detail__line"><text>渠道退款时间</text><text>{{refundAt}}</text></view>
              <text wx:if="{{refundReason}}">{{refundReason}}</text>
              <text wx:if="{{refundFailed}}">{{refundHelp}}</text>
            </block>
            <block wx:if="{{assessmentVisible}}">
              <text class="xy-h-detail__title od-gap">官方审核说明</text>
              <text>{{assessmentStatus}}</text>
              <text wx:for="{{assessmentNotes}}" wx:key="key">{{item.text}}</text>
              <view wx:for="{{lossItems}}" wx:key="key" class="od-proofs">
                <view class="xy-h-detail__line"><text>损失项说明</text><text>{{item.description}}</text></view>
                <view class="xy-h-detail__line"><text>核定金额</text><text>{{item.amount}}</text></view>
                <view wx:for="{{item.evidence}}" wx:for-item="proof" wx:key="key">
                  <media-state wx:if="{{proof.available && proof.kind === 'PHOTO'}}" class="od-proof-photo" state="ready" src="{{proof.url}}" mode="aspectFit" alt="本单官方损失照片" bindload="onReviewMediaActivity" bindretry="onReviewMediaActivity" />
                  <button wx:elif="{{proof.available}}" class="xy-h-detail__act xy-action-hit" data-key="{{proof.key}}" data-epoch="{{reviewVideoEpoch}}" bindtap="playReviewVideo">查看本项凭证视频</button>
                  <text wx:else>此项凭证暂不可用，请联系客服。</text>
                </view>
              </view>
              <view wx:if="{{reviewEvidence.length}}" class="od-proofs">
                <text class="xy-h-detail__title">审核补充凭证</text>
                <view wx:for="{{reviewEvidence}}" wx:for-item="proof" wx:key="key">
                  <media-state wx:if="{{proof.available && proof.kind === 'PHOTO'}}" class="od-proof-photo" state="ready" src="{{proof.url}}" mode="aspectFit" alt="本单官方审核照片" bindload="onReviewMediaActivity" bindretry="onReviewMediaActivity" />
                  <button wx:elif="{{proof.available}}" class="xy-h-detail__act xy-action-hit" data-key="{{proof.key}}" data-epoch="{{reviewVideoEpoch}}" bindtap="playReviewVideo">查看审核凭证视频</button>
                  <text wx:else>此项凭证暂不可用，请联系客服。</text>
                </view>
              </view>
              <video wx:if="{{reviewVideo}}" id="order-review-video" class="od-proof-video" src="{{reviewVideo.src}}" poster="{{reviewVideo.poster}}" controls autoplay data-key="{{reviewVideo.key}}" data-epoch="{{reviewVideoEpoch}}" data-player="{{reviewPlayerVersion}}" binderror="onReviewVideoError" bindtimeupdate="onReviewMediaActivity" aria-label="本单官方审核凭证视频" />
              <media-state wx:if="{{reviewVideo}}" class="od-proof-poster" density="thumbnail" state="ready" src="{{reviewVideo.poster}}" alt="本凭证视频封面" retry-label="重试封面" data-key="{{reviewVideo.key}}" data-epoch="{{reviewVideoEpoch}}" bindretry="playReviewVideo" bindload="onReviewMediaActivity" />
              <text wx:if="{{reviewVideoError}}" class="xy-h-alert" role="alert">{{reviewVideoError}}</text>
              <button wx:if="{{reviewVideoError}}" class="xy-h-detail__act xy-action-hit" data-key="{{reviewVideoKey}}" data-epoch="{{reviewVideoEpoch}}" bindtap="playReviewVideo">重试凭证视频</button>
            </block>
          </view>
          <button class="xy-h-link xy-action-hit" bindtap="toggleProgress" aria-expanded="{{progressExpanded}}"><text class="xy-h-link__k">订单进度与物流</text><text class="xy-h-link__act">{{progressExpanded ? '收起' : '展开'}}</text></button>
          <view wx:if="{{progressExpanded}}" class="xy-h-detail">
            <view class="xy-h-detail__line"><text>订单 / 实物 / 审核</text><text>{{stage}} / {{physical}} / {{review}}</text></view>
            <view class="xy-h-detail__line"><text>交付确认时间</text><text>{{delivered}}</text></view>
            <view wx:if="{{recipient}}" class="xy-h-detail__line"><text>收货信息</text><text>{{recipient}}</text></view>
            <button wx:if="{{recipient}}" class="xy-h-detail__act xy-action-hit" bindtap="copyRecipient">复制本单收货信息</button>
            <view wx:if="{{tracking}}" class="xy-h-detail__line"><text>寄出单号</text><text>{{carrier}} {{tracking}}</text></view>
            <button wx:if="{{tracking}}" class="xy-h-detail__act xy-action-hit" bindtap="copyTracking" data-kind="outbound">复制寄出单号</button>
            <view wx:if="{{returnAddress}}" class="xy-h-detail__line"><text>返程收货地址</text><text>{{returnAddress}}</text></view>
            <view wx:if="{{returnTracking}}" class="xy-h-detail__line"><text>返程快递单号</text><text>{{returnTracking}}</text></view>
            <button wx:if="{{returnTracking}}" class="xy-h-detail__act xy-action-hit" bindtap="copyTracking" data-kind="return">复制返程单号</button>
            <view wx:if="{{returnMaterialState}}" class="xy-h-detail__line"><text>归还材料</text><text>{{returnMaterialState}} · 实际收回 {{returned}}</text></view>
            <text wx:if="{{addressNotice && !returnSheet}}" role="status">{{addressNotice}}</text>
            <text>{{pickupText === '快递往返' ? '运输时间不顺延租期。' : ''}}归还需提交照片与视频，官方核费后办理退押或补缴。</text>
          </view>
        </block>
        <block wx:if="{{role === '我的租赁订单'}}">
          <button class="xy-h-link xy-action-hit" data-kind="payment" bindtap="showFundingHistory" disabled="{{fundingHistoryBusy}}" aria-disabled="{{fundingHistoryBusy}}"><text class="xy-h-link__k">支付历史</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          <button class="xy-h-link xy-action-hit" data-kind="refund" bindtap="showFundingHistory" disabled="{{fundingHistoryBusy}}" aria-disabled="{{fundingHistoryBusy}}"><text class="xy-h-link__k">退款历史</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
          <view wx:if="{{fundingHistoryOpen}}" class="xy-h-detail">
            <text wx:if="{{fundingHistoryBusy}}" role="status">加载中</text>
            <text wx:if="{{fundingHistoryError}}" class="xy-h-alert" role="alert">{{fundingHistoryError}}</text>
            <button wx:if="{{fundingHistoryError}}" class="xy-h-detail__act xy-action-hit" bindtap="retryFundingHistory">重试读取</button>
            <text wx:if="{{!fundingHistoryBusy && !fundingHistoryError && !fundingHistoryRows.length}}">暂无记录</text>
            <block wx:for="{{fundingHistoryRows}}" wx:key="id"><text class="xy-h-detail__title">{{item.title}} · {{item.status}}</text><view class="xy-h-detail__line"><text>交易金额</text><text>{{item.amount}}</text></view><view class="xy-h-detail__line"><text>微信现金</text><text>{{item.cash}}</text></view><view class="xy-h-detail__line"><text>时间</text><text>{{item.time}}</text></view></block>
            <view wx:if="{{fundingHistoryPrevious.length || fundingHistoryNext}}" class="xy-h-detail__line">
              <button wx:if="{{fundingHistoryPrevious.length}}" class="xy-h-detail__act xy-action-hit" bindtap="previousFundingHistory" disabled="{{fundingHistoryBusy}}" aria-disabled="{{fundingHistoryBusy}}">上一页</button>
              <button wx:if="{{fundingHistoryNext}}" class="xy-h-detail__act xy-action-hit" bindtap="nextFundingHistory" disabled="{{fundingHistoryBusy}}" aria-disabled="{{fundingHistoryBusy}}">下一页</button>
            </view>
          </view>
        </block>
        <button wx:if="{{peerContact}}" class="xy-h-link xy-action-hit" bindtap="openPeerConversation"><text class="xy-h-link__k">{{peerContact}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <button wx:if="{{br.b === 'generic' || br.b === 'dispatch' && returnDispatchPage.transit || br.b === 'done' && !completionPage.known}}" class="xy-h-link xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><text class="xy-h-link__k">{{br.b === 'dispatch' ? '刷新归还进度' : '刷新订单状态'}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
      </view>
    </block>
  </view>

  <!-- 底栏：客服图标 + 次要按钮（左）+ 主按钮（右） -->
  <view wx:if="{{!loaded && !loading}}" slot="footer" class="xy-h-foot"><view class="xy-h-actions"><template is="kf" data="{{icons}}" /><view class="xy-h-actions__main">
    <button class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="backToOrders" disabled="{{busy}}" aria-disabled="{{busy}}">返回订单列表</button>
    <button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refreshStatus" disabled="{{busy}}" aria-disabled="{{busy}}">重新加载</button>
  </view></view></view>
  <block wx:if="{{loaded}}" wx:for="{{od.v(returnLanding, preparationPage, nonfulfillmentPage, resultPage, returnDispatchPage, returnReviewPage, completionPage, settlementPage, paymentPage, pickupPage, deliveryPage)}}" wx:for-item="br" wx:key="id">
  <view slot="footer" class="xy-h-foot">
    <view wx:if="{{br.b === 'dispatch' && returnDispatchPage.code === 'F1b'}}" class="xy-h-foot__hint"><button class="xy-h-agree xy-action-hit" role="checkbox" aria-checked="{{returnAddressChecked}}" bindtap="toggleReturnAddress" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}"><view class="xy-h-check {{returnAddressChecked ? 'is-checked' : ''}}"><image wx:if="{{returnAddressChecked}}" src="{{icons.flowCheck}}" mode="aspectFit" aria-hidden="true" /></view><text>我已核对本单最新归还地址</text></button></view>
    <view class="xy-h-actions"><template is="kf" data="{{icons}}" /><view class="xy-h-actions__main">
      <block wx:if="{{br.b === 'landing'}}">
        <button class="xy-h-btn xy-h-btn--primary xy-action-hit" data-code="{{returnEntryAction}}" bindtap="handleAction" disabled="{{busy || !returnEntryAction}}" aria-disabled="{{busy || !returnEntryAction}}">办理归还</button>
      </block>
      <block wx:elif="{{br.b === 'prep'}}">
        <button wx:if="{{preparationPage.canCancel}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit od-btn-narrow" data-code="CANCEL_UNPAID" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">取消订单</button>
        <button wx:if="{{preparationPage.primaryCode}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" data-code="{{preparationPage.primaryCode}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{preparationPage.primaryLabel}}</button>
        <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新订单状态</button>
      </block>
      <block wx:elif="{{br.b === 'nonful'}}">
        <button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="queryNonfulfillment" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询处理进度</button>
      </block>
      <block wx:elif="{{br.b === 'result'}}">
        <button class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="backToOrders" disabled="{{busy}}" aria-disabled="{{busy}}">返回订单列表</button>
        <button wx:if="{{resultPage.canReorder}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="reorder" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{resultPage.primaryLabel}}</button>
        <button wx:elif="{{resultPage.kind === 'settlement'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新订单状态</button>
      </block>
      <block wx:elif="{{br.b === 'dispatch'}}">
        <button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="returnDispatchPrimary" disabled="{{busy || loading || (returnDispatchPage.code === 'F1b' && (!returnAddressChecked || !returnDispatchPage.canReturn)) || (returnDispatchPage.code === 'F1e' && !returnDispatchPage.canReturn) || (returnDispatchPage.code === 'E6' && !returnDispatchPage.canReceive)}}" aria-disabled="{{busy || loading || (returnDispatchPage.code === 'F1b' && (!returnAddressChecked || !returnDispatchPage.canReturn)) || (returnDispatchPage.code === 'F1e' && !returnDispatchPage.canReturn) || (returnDispatchPage.code === 'E6' && !returnDispatchPage.canReceive)}}">{{returnDispatchPage.primaryLabel}}</button>
      </block>
      <block wx:elif="{{br.b === 'review'}}">
        <button wx:if="{{returnReviewPage.code !== 'F3' && returnReviewPage.code !== 'F5'}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
        <button wx:if="{{returnReviewPage.code === 'F3'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" data-mode="supplement" bindtap="openReviewEvidence" disabled="{{busy || loading || !returnReviewPage.canSupplement}}" aria-disabled="{{busy || loading || !returnReviewPage.canSupplement}}">补交材料</button>
        <button wx:elif="{{returnReviewPage.code === 'F5'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">刷新处理进度</button>
        <button wx:elif="{{returnReviewPage.complete && returnReviewPage.booked}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="openOrderEarning" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查看结算明细</button>
        <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{returnReviewPage.complete ? '刷新进度' : returnReviewPage.primaryLabel}}</button>
      </block>
      <block wx:elif="{{br.b === 'done'}}">
        <button wx:if="{{completionPage.closed}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
        <button wx:if="{{completionPage.closed}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="browseOtherDevices" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">选择其他设备</button>
        <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
      </block>
      <block wx:elif="{{br.b === 'settle'}}">
        <button wx:if="{{!settlementPage.failed}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="returnToPaymentOrder" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单</button>
        <button wx:if="{{settlementPage.failed}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="settlementPrimary" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询处理进度</button>
        <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="settlementPrimary" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{settlementPage.primaryLabel}}</button>
      </block>
      <block wx:elif="{{br.b === 'pay'}}">
        <button wx:if="{{paymentPage.canCancel && paymentPage.kind !== 'checking'}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit od-btn-narrow" data-code="CANCEL_UNPAID" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">取消订单</button>
        <button wx:else class="xy-h-btn xy-h-btn--secondary xy-action-hit od-btn-narrow" bindtap="returnToPaymentOrder" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单</button>
        <button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="paymentPrimary" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{paymentPage.primaryLabel}}</button>
      </block>
      <block wx:elif="{{br.b === 'pickup'}}">
        <button wx:if="{{pickupPage.taskAction}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="showPickupGuide" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">取件指引</button>
        <button wx:if="{{pickupPage.taskAction}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" data-code="{{pickupPage.taskAction}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">继续原取件任务</button>
        <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="showPickupGuide" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查看取件指引</button>
      </block>
      <block wx:elif="{{br.b === 'delivery'}}">
        <button wx:if="{{deliveryAddressAction}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
        <button wx:if="{{deliveryUnknown}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询原订单</button>
        <button wx:elif="{{deliveryPage.canReceive}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" data-code="CONFIRM_DELIVERY" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">确认收货</button>
        <button wx:elif="{{deliveryPage.canShip}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" data-code="SHIP" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">填写发货信息</button>
        <button wx:elif="{{deliveryAddressAction}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" data-code="{{deliveryAddressAction}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{returnAddress ? '更新归还地址' : '设置归还地址'}}</button>
        <button wx:elif="{{deliveryPage.returnAction}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" data-code="{{deliveryPage.returnAction}}" bindtap="handleAction" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查看归还指引</button>
        <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="backToOrders" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">返回订单列表</button>
      </block>
      <block wx:else>
        <block wx:for="{{actions}}" wx:key="action_code"><button wx:if="{{item.action_code !== 'VIEW_CONTRACT'}}" class="xy-h-btn {{item.primary ? 'xy-h-btn--primary' : 'xy-h-btn--secondary'}} xy-action-hit" data-code="{{item.action_code}}" bindtap="handleAction" disabled="{{busy || !item.allowed}}" aria-disabled="{{busy || !item.allowed}}" aria-label="{{item.allowed ? item.label : item.label + '，' + item.display_reason}}">{{item.label}}</button></block>
        <button wx:if="{{!actions.length || actions.length === 1 && actions[0].action_code === 'VIEW_CONTRACT'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="backToOrders">返回订单列表</button>
      </block>
    </view></view>
  </view>
  </block>
</page-shell>
<confirmation-dialog visible="{{cancelDialog}}" order-style="{{true}}" title="取消本次订单？" content="将先核实支付结果，确认未支付后关闭；已签合同保留为只读。" confirm-text="{{preparationPage ? '继续当前订单' : '继续支付'}}" cancel-text="确认取消" busy="{{busy}}" bindconfirm="closeCancelDialog" bindcancel="confirmCancelOrder" />
</view>
<confirmation-dialog visible="{{(loaded && !!errorText) || pickupGuideOpen}}" tone="{{errorText ? 'error' : 'confirm'}}" title="{{errorText ? '操作未完成' : '到柜取件'}}" content="{{errorText || (pickupPage && !pickupPage.ready ? '可以提前查看本单取件码，租期开始前不能开柜。请于' + pickupPage.start + '起前往本单租赁柜，扫描柜身小程序码后输入取件码；晚取不顺延租期。' : '请到本单租赁柜，使用微信扫一扫扫描柜身小程序码，在柜详情输入本单六位取件码。弹窗会自动更新开柜状态；取出设备并关好柜门后，系统将自动确认取件结果。')}}" show-cancel="{{false}}" confirm-text="知道了" busy="{{busy}}" bindconfirm="dismissFeedback" />
<task-sheet id="shipment-sheet" open="{{shipmentSheet}}" title="{{shipmentCorrection ? '更正物流信息' : '填写发货信息'}}" busy="{{busy}}" show-footer full-height bindclose="closeShipment">
  <view class="xy-h-page od-sheet">
    <text class="xy-h-note">{{shipmentCorrection ? '更正本单物流信息，原记录和更正原因将保留。' : '请按订单地址寄出。'}}</text>
    <view class="xy-h-blk"><view class="xy-h-dev"><order-product-summary variant="order-list" title="{{title}}" secondary="{{deliveryPage.term || term}}" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" /></view></view>
    <text class="xy-h-cap">收货人信息</text>
    <view class="xy-h-blk xy-h-blk--pad od-address">
      <block wx:if="{{deliveryPage.recipient}}"><text class="od-address__person">{{deliveryPage.recipient.person}} {{deliveryPage.recipient.phone}}</text><text class="xy-h-note">{{deliveryPage.recipient.region}}{{deliveryPage.recipient.detail}}</text><button class="xy-h-detail__act xy-action-hit" bindtap="copyRecipient" disabled="{{busy}}" aria-disabled="{{busy}}">复制地址</button></block>
      <text wx:else class="xy-h-note">收货地址待核实</text>
    </view>
    <text class="xy-h-cap">物流信息</text>
    <view class="xy-h-blk">
      <view class="xy-h-row"><text class="xy-h-row__k od-field-k">快递单号</text><input id="shipment-tracking-input" class="od-input" type="text" maxlength="64" value="{{trackingInput}}" data-field="trackingInput" bindinput="inputShipment" placeholder="必填" aria-label="快递单号" disabled="{{busy || shipmentPending}}" aria-disabled="{{busy || shipmentPending}}" focus="{{shipmentErrorField === 'trackingInput'}}" /></view>
      <text wx:if="{{shipmentErrorField === 'trackingInput' && shipmentError}}" class="xy-h-inote xy-h-alert" role="alert">{{shipmentError}}</text>
      <view class="xy-h-row"><text class="xy-h-row__k od-field-k">快递公司</text><input id="shipment-carrier-input" class="od-input" type="text" maxlength="64" value="{{carrierInput}}" data-field="carrierInput" bindinput="inputShipment" placeholder="选填" aria-label="快递公司" disabled="{{busy || shipmentPending}}" aria-disabled="{{busy || shipmentPending}}" focus="{{shipmentErrorField === 'carrierInput'}}" /></view>
      <text wx:if="{{shipmentErrorField === 'carrierInput' && shipmentError}}" class="xy-h-inote xy-h-alert" role="alert">{{shipmentError}}</text>
      <text class="xy-h-inote">{{deliveryPage.outboundFreight || '寄出运费以本单约定为准'}}，运输不顺延租期。</text>
    </view>
    <block wx:if="{{shipmentCorrection}}">
      <text class="xy-h-cap">更正原因（必填，最多 500 字）</text>
      <view class="xy-h-blk xy-h-blk--pad"><textarea class="od-textarea" maxlength="500" value="{{correctionReason}}" data-field="correctionReason" bindinput="inputShipment" placeholder="请说明更正原因" aria-label="更正原因" disabled="{{busy || shipmentPending}}" aria-disabled="{{busy || shipmentPending}}" focus="{{shipmentErrorField === 'correctionReason'}}" /></view>
      <text wx:if="{{shipmentErrorField === 'correctionReason' && shipmentError}}" class="xy-h-note xy-h-alert" role="alert">{{shipmentError}}</text>
    </block>
    <text wx:if="{{shipmentPending}}" class="xy-h-note" role="status">原请求结果待核实，内容已锁定；请先查询原订单，必要时显式恢复同一请求。</text>
    <text wx:if="{{shipmentError && !shipmentErrorField}}" class="xy-h-note xy-h-alert" role="alert">{{shipmentError}}</text>
  </view>
  <view slot="footer" class="xy-h-actions__main">
    <button wx:if="{{shipmentPending}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="refreshStatus" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">查询原订单</button>
    <button wx:else class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="closeShipment" disabled="{{busy}}" aria-disabled="{{busy}}">取消填写</button>
    <button class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="submitShipment" disabled="{{busy || loading}}" aria-disabled="{{busy || loading}}">{{shipmentPending ? '恢复原物流请求' : shipmentCorrection ? '确认更正' : '确认发货'}}</button>
  </view>
</task-sheet>
<task-sheet id="return-sheet" open="{{!!returnSheet}}" title="{{returnSheet === 'receipt' ? '确认实际收回' : '设置归还地址'}}" busy="{{returnBusy}}" show-footer full-height bindclose="closeReturnSheet">
  <view class="xy-h-page od-sheet">
    <block wx:if="{{returnSheet === 'receipt'}}">
      <view class="xy-h-blk">
        <view class="xy-h-dev"><order-product-summary variant="order-list" title="{{title}}" secondary="个人设备" media-src="{{media}}" media-state="{{media ? 'ready' : 'idle'}}" /></view>
        <view class="xy-h-row"><text class="xy-h-row__k">返程单号</text><text class="xy-h-row__v">{{returnTracking || '未登记'}}</text></view>
      </view>
      <text class="xy-h-cap">实际收回时间（必填）</text>
      <view class="xy-h-blk">
        <picker mode="date" value="{{receiptDate}}" data-field="receiptDate" bindchange="receiptTimeChange" disabled="{{returnBusy || returnPending}}" aria-disabled="{{returnBusy || returnPending}}" aria-label="实际收回日期，必填"><view class="xy-h-row"><text class="xy-h-row__k">日期</text><text class="xy-h-row__v {{receiptDate ? 'xy-h-row__v--strong' : ''}}">{{receiptDate || '请选择日期'}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></view></picker>
        <picker mode="time" value="{{receiptTime}}" data-field="receiptTime" bindchange="receiptTimeChange" disabled="{{returnBusy || returnPending}}" aria-disabled="{{returnBusy || returnPending}}" aria-label="实际收回时间，必填"><view class="xy-h-row od-row-top"><text class="xy-h-row__k">时间</text><text class="xy-h-row__v {{receiptTime ? 'xy-h-row__v--strong' : ''}}">{{receiptTime || '请选择时间'}}</text><text class="xy-h-link__more" aria-hidden="true">›</text></view></picker>
        <text wx:if="{{returnError && returnErrorField === 'receiptTime'}}" class="xy-h-inote xy-h-alert" role="alert">{{returnError}}</text>
      </view>
      <text class="xy-h-cap">收回备注（选填）</text>
      <view class="xy-h-blk xy-h-blk--pad"><textarea class="od-textarea" maxlength="500" value="{{receiptNote}}" placeholder="请输入收回备注" data-field="receiptNote" bindinput="inputReturnField" disabled="{{returnBusy || returnPending}}" aria-disabled="{{returnBusy || returnPending}}" focus="{{returnErrorField === 'receiptNote'}}" aria-label="收回备注，选填，最多500字" /><text class="xy-h-note od-count">{{receiptNote.length}}/500</text></view>
      <text wx:if="{{returnError && returnErrorField === 'receiptNote'}}" class="xy-h-note xy-h-alert" role="alert">{{returnError}}</text>
      <text class="xy-h-note">实际收回后停止继续计算逾期，费用由官方审核核定。</text>
    </block>
    <block wx:elif="{{returnSheet === 'address'}}">
      <text class="xy-h-note">为本单选择收件地址。地址簿保存后，还需应用到本单；承租人将按本单最新归还地址寄回。</text>
      <text class="xy-h-cap">选择收件地址</text>
      <view class="xy-h-blk" role="radiogroup" aria-label="选择本单归还收件地址">
        <text wx:if="{{addressListBusy}}" class="xy-h-inote" role="status">正在读取本人地址…</text>
        <text wx:elif="{{!addressOptions.length}}" class="xy-h-inote">暂无可用收件地址，请先到“管理地址”添加。</text>
        <button wx:for="{{addressOptions}}" wx:key="id" class="xy-h-link xy-action-hit" data-id="{{item.id}}" bindtap="chooseOwnReturnAddress" disabled="{{returnBusy || returnPending || addressListBusy}}" aria-disabled="{{returnBusy || returnPending || addressListBusy}}" role="radio" aria-checked="{{selectedAddressId === item.id}}" aria-label="{{item.name + ' ' + item.phone + ' ' + item.region + item.detail}}"><view class="od-radio {{selectedAddressId === item.id ? 'is-on' : ''}}" aria-hidden="true"></view><view class="xy-h-link__k"><text>{{item.name}} {{item.phone}}</text><text class="xy-h-row__sub">{{item.region}}{{item.detail}}</text></view></button>
        <button wx:if="{{addressNext}}" class="xy-h-link xy-action-hit" bindtap="loadOwnReturnAddresses" disabled="{{addressListBusy || returnPending || returnBusy}}" aria-disabled="{{addressListBusy || returnPending || returnBusy}}"><text class="xy-h-link__k">加载更多地址</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <button wx:if="{{returnError && !returnPending}}" class="xy-h-link xy-action-hit" bindtap="showOwnReturnAddresses" disabled="{{addressListBusy || returnBusy}}" aria-disabled="{{addressListBusy || returnBusy}}"><text class="xy-h-link__k">重新读取地址</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
        <button class="xy-h-link xy-action-hit" bindtap="manageReturnAddresses" disabled="{{returnBusy || returnPending || addressListBusy}}" aria-disabled="{{returnBusy || returnPending || addressListBusy}}"><text class="xy-h-link__k">管理地址</text><text class="xy-h-link__more" aria-hidden="true">›</text></button>
      </view>
      <text wx:if="{{addressNotice}}" class="xy-h-note" role="status">{{addressNotice}}</text>
    </block>
    <text wx:if="{{returnError && returnErrorField !== 'receiptTime' && returnErrorField !== 'receiptNote'}}" class="xy-h-note xy-h-alert" role="alert">{{returnError}}</text>
    <text wx:if="{{returnPending}}" class="xy-h-note" role="status">原请求结果待核实，暂不可修改；请恢复原请求。</text>
  </view>
  <view slot="footer" class="xy-h-actions__main">
    <button wx:if="{{returnSheet === 'receipt'}}" class="xy-h-btn xy-h-btn--secondary xy-action-hit" bindtap="closeReturnSheet" disabled="{{returnBusy}}" aria-disabled="{{returnBusy}}">暂不确认</button>
    <button wx:if="{{returnSheet === 'receipt'}}" class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="submitReceipt" disabled="{{returnBusy || !receiptDate || !receiptTime}}" aria-disabled="{{returnBusy || !receiptDate || !receiptTime}}" aria-busy="{{returnBusy}}">{{returnPending ? '恢复原收回确认' : '确认已收回'}}</button>
    <button wx:else class="xy-h-btn xy-h-btn--primary xy-action-hit" bindtap="submitReturnAddress" disabled="{{returnBusy || addressListBusy || !selectedAddressId}}" aria-disabled="{{returnBusy || addressListBusy || !selectedAddressId}}" aria-busy="{{returnBusy}}">{{returnPending ? '恢复原地址应用' : '应用所选地址到本单'}}</button>
  </view>
</task-sheet>
