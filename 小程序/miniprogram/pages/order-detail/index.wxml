            <view><text class="settlement-title">{{settlementPage.title}}</text><text wx:if="{{!settlementPage.isRefund}}" class="settlement-amount">{{settlementPage.amount}}</text><text class="settlement-copy">{{settlementPage.note}}</text></view>
          </view>
          <view class="settlement-card settlement-product">
