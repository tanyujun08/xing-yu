@import "../../shared/design/return-flow.wxss";
.cabinets-page { display: flex; min-height: 100vh; height: 100vh; box-sizing: border-box; flex-direction: column; background: var(--xy-color-page); }
.location-bar { display: flex; flex: none; min-height: calc(var(--xy-size-touch-min) + var(--xy-space-3)); align-items: center; justify-content: space-between; padding: 0 var(--xy-layout-page-padding-x); border-bottom: 1rpx solid var(--xy-color-divider); background: var(--xy-color-surface); }
.location-row { display: flex; min-width: 0; min-height: var(--xy-size-touch-min); align-items: center; padding: 0; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.location-icon { width: var(--xy-size-icon-sm); height: var(--xy-size-icon-sm); flex: none; margin-right: var(--xy-space-2); }
.location-caret { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); flex: none; margin-left: var(--xy-space-1); }
.mode-switch { display: flex; flex: none; align-items: center; gap: var(--xy-space-2); padding: 0; border-bottom: 0; background: transparent; }
.mode-option { display: flex; min-width: var(--xy-size-touch-min); min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 0; color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.mode-option.is-active { border-color: transparent; background: transparent; color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); }
.is-unavailable { color: var(--xy-color-danger) !important; }



.xy-discovery-empty__action { min-height: var(--xy-size-touch-min); }
.cabinet-page-empty { display: flex; min-height: 0; flex: 1; align-items: center; flex-direction: column; justify-content: flex-start; box-sizing: border-box; padding: var(--xy-space-6) var(--xy-layout-page-padding-x); color: var(--xy-color-text-secondary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); text-align: center; }
.cabinet-return-empty { gap: var(--xy-space-3); }
.return-empty-title { display: block; color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); line-height: var(--xy-text-section-title-line-height); font-weight: var(--xy-text-weight-semibold); }
.return-empty-copy { display: block; width: 100%; margin-bottom: var(--xy-space-1); overflow-wrap: anywhere; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); }
.cabinet-return-empty button { width: 100%; min-height: var(--xy-size-touch-min); box-sizing: border-box; margin: 0; }



.page--large .location-bar { flex-wrap:wrap; }
.page--large .location-row { flex-basis:100%; }



.location-bar .mode-option::before { content:none; }

.touch-overlay { position:absolute; left:50%; top:50%; width:100% !important; height:100%; min-width:var(--xy-size-touch-min); min-height:var(--xy-size-touch-min); transform:translate(-50%,-50%); box-sizing:border-box; padding:0; margin:0; border:0; border-radius:0; background:transparent; }
.touch-overlay::after { border:0; }

.location-choice { display:flex; align-items:center; gap:var(--xy-space-2); }
.location-choice image { width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); flex:none; }
.location-choice>view { min-width:0; flex:1; }
.location-choice .return-subtitle { font-size:var(--xy-text-body-size); }
.location-choice .return-copy { font-size:var(--xy-text-caption-size); }
.return-list-heading { margin-top:var(--xy-space-3); }
.return-cabinet-row { display:flex; gap:var(--xy-space-3); }
.return-cabinet-photo { width:92px; height:88px; flex:none; border-radius:var(--xy-radius-md); }
.return-cabinet-info { min-width:0; flex:1; }
.return-cabinet-heading { display:flex; align-items:center; gap:var(--xy-space-1); }
.return-cabinet-heading .return-subtitle { font-size:var(--xy-text-body-size); }
.capacity-tag { padding:var(--xy-gap-label-value-compact) var(--xy-space-2); border-radius:var(--xy-radius-md); background:var(--xy-color-brand-light); color:var(--xy-color-brand); font-size:var(--xy-text-caption-size); line-height:var(--xy-return-line-copy); }
.return-cabinet-info .return-copy { font-size:var(--xy-text-body-small-size); }
.return-cabinet-links { display:flex; justify-content:space-between; }
.return-cabinet-links button { font-size:var(--xy-text-body-small-size); }
.return-cabinet-row.is-unavailable .return-cabinet-photo { opacity:.45; }
.return-cabinet-row.is-unavailable .return-subtitle { color:var(--xy-color-text-muted); }
.return-cabinet-row.is-unavailable .capacity-tag { background:var(--xy-color-surface-subtle); color:var(--xy-color-text-muted); }
.return-empty-state { display:flex; flex-direction:column; gap:var(--xy-space-4); align-items:center; padding:var(--xy-space-4) 0; text-align:center; }
.return-empty-art { position:relative; width:176px; height:176px; overflow:hidden; }
.return-empty-art image { position:absolute; width:228px; height:228px; left:-26px; top:-26px; }
.return-empty-state .return-copy { white-space:pre-line; }

.return-cabinet-heading .return-subtitle { min-width:0; flex:1; }
.return-cabinet-heading .capacity-tag { flex:none; }
.return-cabinet-links { gap:var(--xy-space-3); }

.cabinet-scroll { box-sizing: border-box; min-height: 0; flex: 1; width: 100%; padding-bottom: calc(var(--xy-space-4) + env(safe-area-inset-bottom)); }
.sortbar { display: flex; align-items: baseline; justify-content: space-between; padding: var(--xy-space-3) var(--xy-layout-page-padding-x); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.sortbar text:first-child { color: var(--xy-color-text-primary); font-weight: var(--xy-text-weight-semibold); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); }
.cab { margin: 0 var(--xy-layout-page-padding-x) var(--xy-space-3); padding: 0 var(--xy-space-2) var(--xy-space-2); border-radius: var(--xy-radius-lg); background: var(--xy-color-canvas-muted); box-shadow: var(--xy-shadow-raised); }
.cab-sign { display: flex; min-height: var(--xy-size-touch-min); align-items: center; gap: var(--xy-space-2); margin: 0 calc(var(--xy-space-2) * -1); padding: 0 var(--xy-space-3); border-radius: var(--xy-radius-lg) var(--xy-radius-lg) 0 0; background: var(--xy-color-brand); color: var(--xy-color-text-inverse); box-sizing: border-box; }
.cab--off .cab-sign { background: var(--xy-color-text-muted); }
.cab-sign__name { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); font-weight: var(--xy-text-weight-semibold); }
.cab-sign__from { flex: none; font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-variant-numeric: tabular-nums; opacity: .9; }
.cab-meta { display: flex; align-items: center; gap: var(--xy-space-1); padding: var(--xy-space-2) var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.cab-meta__icon { flex: none; width: var(--xy-size-icon-xs); height: var(--xy-size-icon-xs); }
.cab-meta__addr { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cab-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--xy-space-1); }
.slot { display: flex; min-height: var(--xy-size-touch-min); min-width: 0; flex-direction: column; overflow: hidden; border-radius: var(--xy-radius-md); background: var(--xy-color-surface); }
.sq { position: relative; width: 100%; aspect-ratio: 1; overflow: hidden; background: var(--xy-color-well); }
.sq__img { position: absolute; left: 0; top: 0; display: block; width: 100%; height: 100%; }
.slot__text { display: flex; min-width: 0; flex-direction: column; padding: var(--xy-space-2); }
.slot__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-weight: var(--xy-text-weight-semibold); color: var(--xy-color-text-primary); }
.slot__price { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); line-height: var(--xy-text-body-small-line-height); font-weight: var(--xy-text-weight-bold); font-variant-numeric: tabular-nums; white-space: nowrap; }
.slot__yen { font-size: var(--xy-text-caption-size); }
.slot__unit { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-regular); }
.slot--low .slot__price, .slot--low .slot__yen { color: var(--xy-color-brand); }
.cab-empty { padding: var(--xy-space-5) var(--xy-space-3); border-radius: var(--xy-radius-md); background: var(--xy-color-surface); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); text-align: center; }
.cab-base { display: flex; gap: var(--xy-space-2); margin-top: var(--xy-space-2); }
.cab-btn { position: relative; display: flex; flex: 1; align-items: center; justify-content: center; gap: var(--xy-space-1); padding: var(--xy-space-2) var(--xy-space-3); border-radius: var(--xy-radius-pill); background: var(--xy-color-surface); color: var(--xy-color-text-primary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); font-weight: var(--xy-text-weight-semibold); }
.cab-btn image { width: var(--xy-size-icon-xs); height: var(--xy-size-icon-xs); }
.cab-btn--main { background: var(--xy-color-brand-soft); color: var(--xy-color-brand); }
.cab-loading { padding: var(--xy-space-4); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); text-align: center; }
.page--large .cab-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

.hit-area { position: absolute; left: 0; right: 0; top: 50%; min-height: var(--xy-size-touch-min); transform: translateY(-50%); }

.mini { position: relative; display: flex; min-height: var(--xy-size-touch-min); align-items: center; gap: var(--xy-space-3); margin: 0 var(--xy-layout-page-padding-x) var(--xy-space-3); padding: var(--xy-space-2); border-radius: var(--xy-radius-lg); background: var(--xy-color-surface); box-shadow: var(--xy-shadow-raised); box-sizing: border-box; }
.mini__thumb { display: block; flex: none; width: calc(var(--xy-space-6) * 2 + var(--xy-space-2)); height: calc(var(--xy-space-6) * 2 + var(--xy-space-2)); border-radius: var(--xy-radius-md); background: var(--xy-color-well); }
.mini__info { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: var(--xy-space-1); }
.mini__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); line-height: var(--xy-text-body-line-height); font-weight: var(--xy-text-weight-semibold); }
.mini__meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.mini__price { display: flex; flex: none; flex-direction: column; align-items: flex-end; gap: var(--xy-space-1); }
.mini__from { color: var(--xy-color-brand); font-size: var(--xy-text-item-title-size); line-height: var(--xy-text-item-title-line-height); font-weight: var(--xy-text-weight-bold); font-variant-numeric: tabular-nums; white-space: nowrap; }
.mini__yen, .mini__unit { font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-regular); }
.mini__count { color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.mini__chev { flex: none; width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
