/* 签到：页头一句话 → 唯一一张白卡（本周七天、里程碑、按钮）→ 余额 → 本月日历 → 最近签到。 */
.check-in-page { min-height:100vh; box-sizing:border-box; padding:0 0 calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background:var(--xy-color-page); color:var(--xy-color-text-primary); }
.check-in-main { display:flex; flex-direction:column; gap:var(--xy-space-5); padding-top:var(--xy-space-3); }
.ci-note { margin:0 var(--xy-space-4); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.ci-note--error { color:var(--xy-color-danger); }
.ci-head { display:flex; align-items:center; gap:var(--xy-space-3); padding:0 var(--xy-space-4); }
.ci-head__text { display:flex; flex:1; flex-direction:column; gap:var(--xy-space-1); min-width:0; }
.ci-head__title { font-size:var(--xy-text-section-title-size); line-height:var(--xy-text-section-title-line-height); font-weight:var(--xy-text-weight-semibold); }
.ci-head__num { color:var(--xy-color-brand); font-variant-numeric:tabular-nums; }
.ci-head__sub { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-head__art { flex:none; width:calc(var(--xy-size-icon-feature) * 2); height:calc(var(--xy-size-icon-feature) * 2); }
.ci-card { margin:0 var(--xy-space-4); padding-bottom:var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-key); }
.ci-week { display:grid; grid-template-columns:repeat(7, minmax(0, 1fr)); padding:var(--xy-space-4) var(--xy-space-3) var(--xy-space-1); }
.ci-day { display:flex; flex-direction:column; align-items:center; gap:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-dot { display:flex; width:calc(var(--xy-size-icon-feature) - var(--xy-space-0-5) * 2); height:calc(var(--xy-size-icon-feature) - var(--xy-space-0-5) * 2); align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-well); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); }
.is-done .ci-dot { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.is-today .ci-dot { background:var(--xy-color-surface); box-shadow:inset 0 0 0 2rpx var(--xy-color-brand); color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.is-today .ci-day__name { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-mile { margin:var(--xy-space-3) var(--xy-space-4) 0; padding:var(--xy-space-3); border-radius:var(--xy-radius-control); background:var(--xy-color-well); }
.ci-mile__row { display:flex; justify-content:space-between; gap:var(--xy-space-2); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-strong { color:var(--xy-color-text-primary); font-weight:var(--xy-text-weight-semibold); }
.ci-bar { position:relative; height:var(--xy-space-1); margin-top:var(--xy-space-2); border-radius:var(--xy-radius-segment); background:var(--xy-color-border); }
.ci-bar__fill { position:absolute; left:0; top:0; bottom:0; border-radius:var(--xy-radius-segment); background:var(--xy-color-brand); }
.ci-button-wrap { padding:var(--xy-space-3) var(--xy-space-4) 0; }
.ci-button { display:flex; width:100%; align-items:center; justify-content:center; gap:var(--xy-space-2); min-height:var(--xy-size-touch-min); margin:0; border-radius:var(--xy-radius-control); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.ci-button:active { background:var(--xy-color-brand-pressed); }
.ci-button[disabled] { background:var(--xy-color-brand-disabled); color:var(--xy-color-text-inverse); }
.ci-button__sub { font-size:var(--xy-text-caption-size); font-weight:var(--xy-text-weight-regular); opacity:.85; }
.ci-assets { display:flex; gap:var(--xy-space-3); padding:0 var(--xy-space-4); }
.ci-asset { display:flex; flex:1; align-items:center; gap:var(--xy-space-2); padding:var(--xy-space-2) var(--xy-space-3); border-radius:var(--xy-radius-control); background:var(--xy-color-well); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-body-small-line-height); }
.ci-asset image { flex:none; width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); }
.ci-asset__num { margin-left:auto; color:var(--xy-color-text-primary); font-weight:var(--xy-text-weight-semibold); font-variant-numeric:tabular-nums; }
.ci-group { display:flex; flex-direction:column; gap:var(--xy-space-3); }
.ci-group__title { padding:0 var(--xy-space-4); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-cal { padding:var(--xy-space-3) var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); border-bottom:1rpx solid var(--xy-color-divider); }
.ci-cal__head,.ci-cal__grid { display:grid; grid-template-columns:repeat(7, minmax(0, 1fr)); }
.ci-cal__head text { text-align:center; color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); padding-bottom:var(--xy-space-2); }
.ci-cal__cell { position:relative; display:flex; align-items:center; justify-content:center; padding:var(--xy-space-1) 0; color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-body-small-line-height); font-variant-numeric:tabular-nums; }
.ci-cal__cell text { display:flex; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); align-items:center; justify-content:center; border-radius:50%; }
.ci-cal__cell--signed text { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.ci-cal__cell--today text { box-shadow:inset 0 0 0 2rpx var(--xy-color-brand); color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-cal__cell--future { color:var(--xy-color-text-disabled); }
.ci-list { padding-left:var(--xy-space-4); border-top:1rpx solid var(--xy-color-divider); border-bottom:1rpx solid var(--xy-color-divider); }
.ci-row { position:relative; display:flex; align-items:center; gap:var(--xy-space-2); width:100%; min-height:var(--xy-size-touch-min); margin:0; padding:var(--xy-space-3) var(--xy-space-4) var(--xy-space-3) 0; box-sizing:border-box; text-align:left; font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.ci-row + .ci-row::before { content:""; position:absolute; top:0; right:0; left:0; height:1rpx; background:var(--xy-color-divider); }
.ci-row:active { opacity:var(--xy-opacity-pressed); }
.ci-row__main { flex:1; min-width:0; }
.ci-row__reward { flex:none; color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-row__chev { flex:none; color:var(--xy-color-text-disabled); font-size:var(--xy-text-section-title-size); }
.ci-foot { margin:0 var(--xy-space-4); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.hit-area { position:absolute; left:0; right:0; top:50%; min-height:var(--xy-size-touch-min); transform:translateY(-50%); }
