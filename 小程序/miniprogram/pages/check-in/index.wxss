/* 签到：渐变头图（状态 + 连签天数）→ 7 日奖励卡 → 累计粉钻/星光 → 本月记录 → 最近签到。 */
.check-in-page { position:relative; min-height:100vh; box-sizing:border-box; padding:0 0 calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background:var(--xy-color-page); color:var(--xy-color-text-primary); overflow:hidden; }
.ci-bg { position:absolute; left:0; top:0; display:block; width:100%; }
.check-in-main { position:relative; display:flex; flex-direction:column; gap:var(--xy-space-3); }
.ci-note { margin:0 var(--xy-space-4); color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.ci-note--error { color:var(--xy-color-danger); }
.ci-hero { display:flex; flex-direction:column; gap:var(--xy-space-1); padding:var(--xy-space-4) var(--xy-space-4) var(--xy-space-5) calc(var(--xy-space-4) * 2); }
.ci-hero__title { display:flex; align-items:center; gap:var(--xy-space-2); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-bold); color:var(--xy-color-text-strong); }
.ci-hero__ok { display:flex; width:var(--xy-size-icon-nav); height:var(--xy-size-icon-nav); align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); }
.ci-hero__sub { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.ci-hero__streak { display:flex; flex-direction:column; margin-top:var(--xy-space-3); }
.ci-hero__label { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-hero__row { display:flex; align-items:baseline; gap:var(--xy-space-1); }
.ci-hero__num { color:var(--xy-color-brand); font-size:calc(var(--xy-space-6) * 2); line-height:calc(var(--xy-space-6) * 2 + var(--xy-space-2)); font-weight:var(--xy-text-weight-bold); font-style:italic; font-variant-numeric:tabular-nums; }
.ci-hero__unit { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); }
.ci-card { margin:0 var(--xy-space-4); padding:var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-raised); }
.ci-card__head { display:flex; align-items:center; justify-content:space-between; gap:var(--xy-space-2); }
.ci-card__title { font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); font-weight:var(--xy-text-weight-bold); color:var(--xy-color-text-strong); }
.ci-card__hint { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-hero__sub .ci-brand { font-size:var(--xy-text-body-size); }
.ci-brand { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); font-variant-numeric:tabular-nums; }
.ci-week { display:grid; grid-template-columns:repeat(7, minmax(0, 1fr)); padding:var(--xy-space-4) 0 var(--xy-space-2); }
.ci-day { display:flex; flex-direction:column; align-items:center; gap:var(--xy-space-1); color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-dot { display:flex; width:calc(var(--xy-space-6) + var(--xy-space-2)); height:calc(var(--xy-space-6) + var(--xy-space-2)); align-items:center; justify-content:center; margin-bottom:var(--xy-space-1); border-radius:50%; background:var(--xy-color-well); color:var(--xy-color-text-muted); font-size:var(--xy-text-body-small-size); }
.is-today .ci-dot { background:var(--xy-color-surface); box-shadow:inset 0 0 0 2rpx var(--xy-color-brand); color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.is-done .ci-dot { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.is-gift .ci-dot { background:var(--xy-color-brand-soft); color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.is-today .ci-day__name { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-day__reward { color:var(--xy-color-text-secondary); font-variant-numeric:tabular-nums; }
.is-done .ci-day__reward, .is-gift .ci-day__reward { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-mile { display:flex; flex-direction:column; gap:var(--xy-space-2); padding:var(--xy-space-2) 0 0; }
.ci-mile__text { color:var(--xy-color-text-secondary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); }
.ci-strong { color:var(--xy-color-text-primary); font-weight:var(--xy-text-weight-semibold); }
.ci-bar { position:relative; height:var(--xy-space-2); border-radius:var(--xy-radius-segment); background:var(--xy-color-well); }
.ci-bar__fill { position:absolute; left:0; top:0; bottom:0; border-radius:var(--xy-radius-segment); background:var(--xy-color-brand); }
.ci-button-wrap { padding:var(--xy-space-4) 0 0; }
.ci-button { display:flex; width:100%; align-items:center; justify-content:center; gap:var(--xy-space-2); min-height:var(--xy-size-touch-min); margin:0; border-radius:var(--xy-radius-control); background:var(--xy-color-brand); color:var(--xy-color-text-inverse); font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-body-line-height); font-weight:var(--xy-text-weight-semibold); }
.ci-button:active { background:var(--xy-color-brand-pressed); }
.ci-button[disabled] { background:var(--xy-color-brand-disabled); color:var(--xy-color-text-inverse); }
.ci-button.is-signed[disabled] { background:var(--xy-color-well); color:var(--xy-color-text-muted); }
.ci-button__ok { display:flex; width:var(--xy-size-icon-row); height:var(--xy-size-icon-row); align-items:center; justify-content:center; border-radius:50%; background:var(--xy-color-text-muted); color:var(--xy-color-text-inverse); font-size:var(--xy-text-caption-size); }
.ci-button__sub { font-size:var(--xy-text-body-small-size); font-weight:var(--xy-text-weight-regular); opacity:.85; }
.ci-assets { display:flex; gap:var(--xy-space-3); padding:0 var(--xy-space-4); }
.ci-asset { display:flex; flex:1; min-width:0; min-height:var(--xy-size-touch-min); align-items:center; gap:var(--xy-space-3); padding:var(--xy-space-4) var(--xy-space-3) var(--xy-space-4) var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-raised); box-sizing:border-box; }
.ci-asset > image:first-child { flex:none; width:calc(var(--xy-space-6) + var(--xy-space-3)); height:calc(var(--xy-space-6) + var(--xy-space-3)); }
.ci-asset__text { display:flex; min-width:0; flex:1; flex-direction:column; }
.ci-asset__label { color:var(--xy-color-text-secondary); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.ci-asset__num { color:var(--xy-color-text-strong); font-size:var(--xy-text-page-title-size); line-height:var(--xy-text-page-title-line-height); font-weight:var(--xy-text-weight-bold); font-variant-numeric:tabular-nums; }
.ci-asset__chev { flex:none; width:var(--xy-size-icon-xs); height:var(--xy-size-icon-xs); opacity:.5; }
.ci-card--cal { padding-bottom:var(--xy-space-3); }
.ci-cal { margin-top:var(--xy-space-3); padding-top:var(--xy-space-2); border-top:1rpx solid var(--xy-color-divider); }
.ci-cal__head,.ci-cal__grid { display:grid; grid-template-columns:repeat(7, minmax(0, 1fr)); }
.ci-cal__head text { text-align:center; color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); padding-bottom:var(--xy-space-2); }
.ci-cal__cell { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:calc(var(--xy-space-6) * 2); color:var(--xy-color-text-primary); font-size:var(--xy-text-body-small-size); line-height:var(--xy-text-body-small-line-height); font-variant-numeric:tabular-nums; }
.ci-cal__day { display:flex; width:var(--xy-size-icon-feature); height:var(--xy-size-icon-feature); align-items:center; justify-content:center; border-radius:50%; }
.ci-cal__cell--signed { color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-cal__cell--signed::after { content:''; position:absolute; bottom:var(--xy-space-0-5); left:50%; width:var(--xy-space-1); height:var(--xy-space-1); margin-left:calc(var(--xy-space-0-5) * -1); border-radius:50%; background:var(--xy-color-brand); }
.ci-cal__cell--signed.is-today::after { display:none; }
.ci-cal__cell--signed.is-today .ci-cal__day { background:var(--xy-color-brand); color:var(--xy-color-text-inverse); }
.ci-cal__cell--today .ci-cal__day { box-shadow:inset 0 0 0 2rpx var(--xy-color-brand); color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-cal__cell--future { color:var(--xy-color-text-disabled); }
.ci-group { display:flex; flex-direction:column; gap:var(--xy-space-2); padding-top:var(--xy-space-1); }
.ci-group__title { padding:0 var(--xy-space-4); color:var(--xy-color-text-strong); font-size:var(--xy-text-item-title-size); line-height:var(--xy-text-item-title-line-height); font-weight:var(--xy-text-weight-bold); }
.ci-list { margin:0 var(--xy-space-4); padding-left:var(--xy-space-4); border-radius:var(--xy-radius-container); background:var(--xy-color-surface); box-shadow:var(--xy-shadow-raised); overflow:hidden; }
.ci-row { position:relative; display:flex; align-items:center; gap:var(--xy-space-2); width:100%; min-height:var(--xy-size-touch-min); margin:0; padding:var(--xy-space-3) var(--xy-space-4) var(--xy-space-3) 0; box-sizing:border-box; text-align:left; background:transparent; font-size:var(--xy-text-body-size); line-height:var(--xy-text-body-line-height); }
.ci-row + .ci-row::before { content:""; position:absolute; top:0; right:0; left:0; height:1rpx; background:var(--xy-color-divider); }
.ci-row:active { opacity:var(--xy-opacity-pressed); }
.ci-row__main { flex:1; min-width:0; }
.ci-row__reward { flex:none; color:var(--xy-color-brand); font-weight:var(--xy-text-weight-semibold); }
.ci-row__chev { flex:none; color:var(--xy-color-text-disabled); font-size:var(--xy-text-section-title-size); }
.ci-foot { margin:0 var(--xy-space-4); color:var(--xy-color-text-muted); font-size:var(--xy-text-caption-size); line-height:var(--xy-text-caption-line-height); }
.hit-area { position:absolute; left:0; right:0; top:50%; min-height:var(--xy-size-touch-min); transform:translateY(-50%); }
