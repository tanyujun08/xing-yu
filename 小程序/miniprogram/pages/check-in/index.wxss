@import "../../shared/design/member-tokens.wxss";

.check-in-page { min-height: 100vh; padding-bottom: calc(var(--xy-space-6) + env(safe-area-inset-bottom)); background: var(--xy-member-color-page-soft); color: var(--xy-color-text-primary); }
.check-in-main { padding: var(--xy-space-2) var(--xy-layout-page-padding-x) 0; 
  padding-top: var(--xy-layout-card-stack-start-gap);
}
.sign-hero { overflow: hidden; border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.sign-hero__body { position: relative; display: grid; min-height: 190px; grid-template-columns: minmax(0, 52%) minmax(0, 48%); overflow: hidden; background: var(--xy-member-gradient-hero-pink); }
.sign-hero__info { position: relative; z-index: var(--xy-z-local-raised); display: flex; min-width: 0; flex-direction: column; padding: var(--xy-space-5) 0 var(--xy-space-4) var(--xy-space-4); }
.sign-greeting { color: var(--xy-member-color-pink-text); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-body-small-line-height); white-space: nowrap; }
.sign-kicker { margin-top: var(--xy-space-5); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); }
.sign-reward { display: flex; align-items: baseline; gap: var(--xy-space-1); margin-top: var(--xy-space-1); }
.sign-reward text:first-child { color: var(--xy-member-color-pink-text); font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-operations-hero-size); font-weight: var(--xy-text-weight-bold); line-height: var(--xy-text-operations-hero-line-height); }
.sign-reward text:last-child { color: var(--xy-member-color-pink-text); font-size: var(--xy-text-caption-size); }
.sign-assets { display: flex; flex-wrap: wrap; gap: var(--xy-space-3); margin-top: var(--xy-space-4); }
.sign-assets > view { display: flex; align-items: center; gap: var(--xy-space-1); color: var(--xy-color-text-secondary); font-size: var(--xy-text-caption-size); }
.sign-assets image { width: var(--xy-size-icon-base); height: var(--xy-size-icon-base); }
.sign-assets text text { color: var(--xy-color-text-primary); font-family: var(--xy-font-family-numeric); font-weight: var(--xy-text-weight-semibold); }
.sign-hero__visual { position: absolute; right: calc(-1 * var(--xy-space-5)); bottom: 0; width: 210px; height: 158px; }
.sign-button { display: flex; min-height: var(--xy-control-height); align-items: center; justify-content: space-between; padding: 0 var(--xy-space-4); background: var(--xy-color-brand); color: var(--xy-color-text-inverse); }
.sign-button text:first-child { font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
.sign-button text:last-child { font-size: var(--xy-text-caption-size); }
.sign-button[disabled] { background: var(--xy-color-brand-disabled); }

.week-panel, .reminder-row, .task-list, .calendar-panel, .reward-list, .milestone { border: 0; border-radius: var(--xy-radius-container); background: var(--xy-color-surface); }
.week-panel { margin-top: var(--xy-layout-content-gap); padding: var(--xy-inset-card); }
.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--xy-space-3); }
.section-head > view { min-width: 0; }
.section-title, .section-copy { display: block; }
.section-title { color: var(--xy-color-text-primary); font-size: var(--xy-text-section-title-size); font-weight: var(--xy-text-weight-semibold); line-height: var(--xy-text-section-title-line-height); }
.section-copy { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-caption-line-height); }
.week-summary, .section-count { flex: none; color: var(--xy-member-color-pink-text); font-size: var(--xy-text-caption-size); line-height: var(--xy-text-section-title-line-height); }
.week-track { position: relative; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); margin-top: var(--xy-space-5); }
.track-line { position: absolute; top: calc(var(--xy-size-icon-feature) / 2); right: var(--xy-space-4); left: var(--xy-space-4); height: 1rpx; background: var(--xy-color-divider); }
.week-day { position: relative; z-index: var(--xy-z-local); display: flex; min-width: 0; align-items: center; flex-direction: column; }
.week-day > view { display: flex; width: var(--xy-size-icon-feature); height: var(--xy-size-icon-feature); align-items: center; justify-content: center; border: 1rpx solid var(--xy-color-border); border-radius: var(--xy-radius-circle); background: var(--xy-color-surface); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.week-day--done > view { border-color: var(--xy-color-brand); background: var(--xy-color-brand); color: var(--xy-color-text-inverse); }
.week-day--today > view { border-color: var(--xy-member-color-pink-border); background: var(--xy-member-color-pink-surface); color: var(--xy-member-color-pink-text); }
.week-day > text:nth-child(2) { margin-top: var(--xy-space-2); color: var(--xy-color-text-primary); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-semibold); }
.week-day > text:last-child { max-width: 100%; overflow: hidden; margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); text-overflow: ellipsis; white-space: nowrap; }
.sign-shortcuts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--xy-space-3); margin-top: var(--xy-space-5); }
.sign-shortcuts button { display: flex; min-width: 0; min-height: calc(var(--xy-control-height) + var(--xy-space-5)); align-items: center; gap: var(--xy-space-3); padding: var(--xy-space-3); border-radius: var(--xy-radius-container); background: var(--xy-member-color-pink-surface-pale); text-align: left; }
.sign-shortcuts button:last-child { background: var(--xy-color-brand-light); }
.sign-shortcuts image { width: var(--xy-size-icon-feature); height: var(--xy-size-icon-feature); }
.sign-shortcuts view { display: flex; min-width: 0; flex-direction: column; }
.sign-shortcuts text:first-child { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); }
.sign-shortcuts text:last-child { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }

.reminder-row { display: grid; min-height: 64px; grid-template-columns: var(--xy-size-icon-feature) minmax(0, 1fr) 64px; align-items: center; gap: var(--xy-space-3); margin-top: var(--xy-space-4); padding: var(--xy-space-3); overflow: hidden; }
.reminder-row > image { width: var(--xy-size-icon-feature); height: var(--xy-size-icon-feature); }
.reminder-row > view { display: flex; min-width: 0; flex-direction: column; }
.reminder-row view text:first-child { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
.reminder-row view text:last-child { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.reminder-row button { display: flex; width: 64px; min-height: var(--xy-size-touch-min); align-items: center; justify-content: center; color: var(--xy-color-brand); font-size: var(--xy-text-body-size); }

.sign-section { margin-top: var(--xy-layout-section-gap); }
.task-list, .reward-list { margin-top: var(--xy-layout-card-stack-start-gap); padding: 0 var(--xy-space-3); overflow: hidden; }
.task-row { display: grid; min-height: 68px; grid-template-columns: var(--xy-size-icon-feature) minmax(0, 1fr) 72px; align-items: center; gap: var(--xy-space-3); border-top: 1rpx solid var(--xy-color-divider); }
.task-row:first-child { border-top: 0; }
.task-icon { display: flex; width: var(--xy-size-icon-feature); height: var(--xy-size-icon-feature); align-items: center; justify-content: center; border-radius: var(--xy-radius-circle); background: var(--xy-color-brand-light); color: var(--xy-color-brand); font-size: var(--xy-text-caption-size); }
.task-icon--pink { background: var(--xy-member-color-pink-surface); color: var(--xy-member-color-pink-text); }
.task-icon--gold { background: var(--xy-member-color-gold-surface); color: var(--xy-member-color-gold-text); }
.task-copy, .task-side { display: flex; min-width: 0; flex-direction: column; }
.task-copy text:first-child { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
.task-copy text:last-child { overflow: hidden; margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); text-overflow: ellipsis; white-space: nowrap; }
.task-side { align-items: flex-end; }
.task-side > text { color: var(--xy-member-color-gold-text); font-size: var(--xy-text-caption-size); }
.task-side button { display: flex; min-width: 64px; min-height: var(--xy-size-touch-min); align-items: center; justify-content: flex-end; color: var(--xy-color-brand); font-size: var(--xy-text-body-size); }
.compact-action-shell { display: inline-flex; min-height: var(--xy-control-height-compact); align-items: center; justify-content: center; }

.calendar-panel { margin-top: var(--xy-layout-card-stack-start-gap); padding: 0 var(--xy-space-3) var(--xy-space-3); overflow: hidden; }
.calendar-head { display: flex; min-height: var(--xy-control-height-large); align-items: center; justify-content: space-between; gap: var(--xy-space-3); border-bottom: 1rpx solid var(--xy-color-divider); }
.calendar-head text:first-child { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); }
.calendar-head text:last-child { color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.calendar-weekdays, .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.calendar-weekdays text { padding: var(--xy-space-3) 0 var(--xy-space-2); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); text-align: center; }
.calendar-day { display: flex; min-width: 0; min-height: 44px; align-items: center; justify-content: center; flex-direction: column; border-radius: var(--xy-radius-compact); color: var(--xy-color-text-secondary); }
.calendar-day text:first-child { font-family: var(--xy-font-family-numeric); font-size: var(--xy-text-caption-size); font-weight: var(--xy-text-weight-semibold); }
.calendar-day text:last-child { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
.calendar-day--signed { background: var(--xy-color-brand-light); color: var(--xy-color-brand); }
.calendar-day--today { background: var(--xy-member-color-pink-surface); color: var(--xy-member-color-pink-text); }
.calendar-day--empty { visibility: hidden; }

.reward-row { display: flex; min-height: 64px; align-items: center; justify-content: space-between; gap: var(--xy-space-3); border-top: 1rpx solid var(--xy-color-divider); }
.reward-row:first-child { border-top: 0; }
.reward-row > view { display: flex; min-width: 0; flex-direction: column; }
.reward-row view text:first-child { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-size); font-weight: var(--xy-text-weight-semibold); }
.reward-row view text:last-child { overflow: hidden; margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); text-overflow: ellipsis; white-space: nowrap; }
.reward-row > text { flex: none; color: var(--xy-member-color-pink-text); font-size: var(--xy-text-caption-size); }
.milestone-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--xy-space-2); margin-top: var(--xy-space-3); }
.milestone { display: flex; min-height: 96px; align-items: center; flex-direction: column; justify-content: center; padding: var(--xy-space-2); text-align: center; }
.milestone.is-current { border-color: var(--xy-member-color-gold-border-soft); background: var(--xy-member-color-gold-surface-warm); }
.milestone text:first-child { color: var(--xy-color-text-primary); font-size: var(--xy-text-body-small-size); font-weight: var(--xy-text-weight-semibold); }
.milestone text:nth-child(2) { margin-top: var(--xy-space-1); color: var(--xy-member-color-gold-text); font-size: var(--xy-text-caption-size); white-space: pre-line; }
.milestone text:last-child { margin-top: var(--xy-space-1); color: var(--xy-color-text-muted); font-size: var(--xy-text-caption-size); }
