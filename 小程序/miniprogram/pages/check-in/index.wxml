<page-meta root-font-size="system" />
<view class="check-in-page">
  <image class="ci-bg" src="{{icons.checkInHeaderBg}}" mode="widthFix" aria-hidden="true" />
  <page-header title="{{secondaryNavigationTitle || '每日签到'}}" background="{{headerScrolled ? '#ffffff' : 'transparent'}}" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <view class="check-in-main">
    <text wx:if="{{errorText}}" class="ci-note ci-note--error" role="alert">{{errorText}}</text>
    <text wx:if="{{receiptText}}" class="ci-note">{{receiptText}}</text>
    <view class="ci-hero">
      <view class="ci-hero__title"><view wx:if="{{signedToday}}" class="ci-hero__ok"><text>✓</text></view><text>{{signedToday ? '签到成功' : '今天还没签到'}}</text></view>
      <text class="ci-hero__sub">{{signedToday ? '今日已到账 ' + dailyReward : ruleAvailable ? '签到可得 ' + dailyReward : '签到规则暂不可用'}}</text>
      <view class="ci-hero__streak"><text class="ci-hero__label">已连续签到</text><view class="ci-hero__row"><text class="ci-hero__num">{{streakText}}</text><text class="ci-hero__unit">天</text></view></view>
    </view>
    <view class="ci-card">
      <view class="ci-card__head"><text class="ci-card__title">7 日签到奖励</text><text wx:if="{{nextMilestone}}" class="ci-card__hint">再签 <text class="ci-brand">{{nextMilestone.remaining}}</text> 天额外得 <text class="ci-brand">{{nextMilestone.reward}}</text></text></view>
      <view class="ci-week"><view wx:for="{{weekDays}}" wx:key="key" class="ci-day {{item.state === 'done' ? 'is-done' : ''}} {{item.today ? 'is-today' : ''}} {{item.gift ? 'is-gift' : ''}}"><view class="ci-dot"><text wx:if="{{item.state === 'done'}}">✓</text><text wx:elif="{{item.gift}}">礼</text></view><text class="ci-day__name">{{item.today ? '今天' : '周' + item.label}}</text><text class="ci-day__reward">{{item.rewardShort}}</text></view></view>
      <view wx:if="{{nextMilestone}}" class="ci-mile"><text class="ci-mile__text">连续签到 <text class="ci-strong">{{nextMilestone.streak}}</text> / {{nextMilestone.days}} 天</text><view class="ci-bar"><view class="ci-bar__fill" style="width:{{nextMilestone.percent}}%"></view></view></view>
      <view class="ci-button-wrap"><button class="ci-button xy-button-reset {{signedToday ? 'is-signed' : ''}}" bindtap="checkIn" disabled="{{signedToday || busy || !loggedIn || !ruleAvailable}}" aria-disabled="{{signedToday || busy || !loggedIn || !ruleAvailable}}" aria-label="{{signedToday ? '今日已签到' : '立即签到'}}"><text wx:if="{{signedToday}}" class="ci-button__ok">✓</text><text>{{signedToday ? '今日已签到' : busy ? '签到中…' : '立即签到'}}</text><text wx:if="{{!signedToday && ruleAvailable}}" class="ci-button__sub">{{dailyReward}}</text></button></view>
    </view>
    <view class="ci-assets">
      <view class="ci-asset xy-tap" data-kind="powder" bindtap="openLedger" role="button" aria-label="查看粉钻明细"><image src="{{icons.membershipDiamond}}" mode="aspectFit" /><view class="ci-asset__text"><text class="ci-asset__label">累计粉钻</text><text class="ci-asset__num">{{balance}}</text></view><image class="ci-asset__chev" src="{{icons.arrowRight}}" mode="aspectFit" /></view>
      <view class="ci-asset xy-tap" data-kind="star" bindtap="openLedger" role="button" aria-label="查看星光明细"><image src="{{icons.profileMemberStar}}" mode="aspectFit" /><view class="ci-asset__text"><text class="ci-asset__label">累计星光</text><text class="ci-asset__num">{{starPoints}}</text></view><image class="ci-asset__chev" src="{{icons.arrowRight}}" mode="aspectFit" /></view>
    </view>
    <view class="ci-card ci-card--cal">
      <view class="ci-card__head"><text class="ci-card__title">{{monthShort}}签到记录</text><text class="ci-card__hint">本月已签 <text class="ci-brand">{{signedMonthCount}}</text> 天</text></view>
      <view class="ci-cal">
        <view class="ci-cal__head"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
        <view class="ci-cal__grid"><block wx:for="{{calendarDays}}" wx:key="key"><view wx:if="{{item.state === 'empty'}}" class="ci-cal__cell"></view><view wx:else class="ci-cal__cell ci-cal__cell--{{item.state}} {{item.today ? 'is-today' : ''}}"><text class="ci-cal__day">{{item.day}}</text><view wx:if="{{item.id}}" class="hit-area xy-tap" data-id="{{item.id}}" bindtap="openReceipt" role="button" aria-label="{{item.day}}日已签到，查看回执"></view></view></block></view>
      </view>
    </view>
    <view wx:if="{{recent.length || receiptCoupons.length}}" class="ci-group"><text class="ci-group__title">最近签到</text>
      <view class="ci-list">
        <button wx:for="{{recent}}" wx:key="key" class="ci-row xy-button-reset check-in-receipt" data-id="{{item.key}}" bindtap="openReceipt"><view class="ci-row__main"><text>{{item.date}} · 连续 {{item.streak}} 天</text></view><text class="ci-row__reward">+{{item.reward}}</text><text class="ci-row__chev" aria-hidden="true">›</text></button>
        <button wx:for="{{receiptCoupons}}" wx:key="id" class="ci-row xy-button-reset check-in-coupon" data-id="{{item.id}}" bindtap="openCoupon"><view class="ci-row__main"><text>查看签到奖励：{{item.title}}</text></view><text class="ci-row__chev" aria-hidden="true">›</text></button>
      </view>
    </view>
    <text wx:if="{{ruleNote}}" class="ci-foot">{{ruleNote}}奖励以到账记录为准，规则调整不影响已发放的奖励。</text>
  </view>
</view>
