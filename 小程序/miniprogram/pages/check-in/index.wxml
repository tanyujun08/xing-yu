<page-meta root-font-size="system" />
<view class="check-in-page">
  <page-header title="{{secondaryNavigationTitle || '签到'}}" background="#ffffff" inverse="{{false}}" bindback="onSecondaryNavigationBack" />
  <view class="check-in-main">
    <text wx:if="{{errorText}}" class="ci-note ci-note--error" role="alert">{{errorText}}</text>
    <text wx:if="{{receiptText}}" class="ci-note">{{receiptText}}</text>
    <view class="ci-head">
      <view class="ci-head__text"><text class="ci-head__title">已连续签到 <text class="ci-head__num">{{streak === '—' ? 0 : streak}}</text> 天</text><text class="ci-head__sub">{{signedToday ? '今天已签到，明天继续' : ruleAvailable ? '今天签到可得 ' + dailyReward : '签到规则暂不可用'}}</text></view>
      <image class="ci-head__art" src="{{icons.checkInHero}}" mode="aspectFit" aria-hidden="true" />
    </view>
    <view class="ci-card">
      <view class="ci-week"><view wx:for="{{weekDays}}" wx:key="key" class="ci-day {{item.state === 'done' ? 'is-done' : ''}} {{item.today ? 'is-today' : ''}}"><view class="ci-dot"><text wx:if="{{item.state === 'done'}}">✓</text><text wx:elif="{{item.today}}">今</text></view><text class="ci-day__name">周{{item.label}}</text></view></view>
      <view wx:if="{{nextMilestone}}" class="ci-mile"><view class="ci-mile__row"><text>连续签到 <text class="ci-strong">{{nextMilestone.streak}}</text> / {{nextMilestone.days}} 天</text><text>第 {{nextMilestone.days}} 天额外得 <text class="ci-strong">{{nextMilestone.reward}}</text></text></view><view class="ci-bar"><view class="ci-bar__fill" style="width:{{nextMilestone.percent}}%"></view></view></view>
      <view class="ci-button-wrap"><button class="ci-button xy-button-reset" bindtap="checkIn" disabled="{{signedToday || busy || !loggedIn || !ruleAvailable}}" aria-disabled="{{signedToday || busy || !loggedIn || !ruleAvailable}}" aria-label="{{signedToday ? '今日已签到' : '立即签到'}}"><text>{{signedToday ? '今日已签到' : busy ? '签到中…' : '立即签到'}}</text><text wx:if="{{!signedToday && ruleAvailable}}" class="ci-button__sub">+{{dailyReward}}</text></button></view>
    </view>
    <view class="ci-assets"><view class="ci-asset"><image src="{{icons.membershipDiamond}}" mode="aspectFit" /><text>粉钻</text><text class="ci-asset__num">{{balance}}</text></view><view class="ci-asset"><image src="{{icons.profileMemberStar}}" mode="aspectFit" /><text>星光</text><text class="ci-asset__num">{{starPoints}}</text></view></view>
    <view class="ci-group"><text class="ci-group__title">{{monthTitle}} · 已签 {{signedMonthCount}} 天</text>
      <view class="ci-cal">
        <view class="ci-cal__head"><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text><text>日</text></view>
        <view class="ci-cal__grid"><block wx:for="{{calendarDays}}" wx:key="key"><view wx:if="{{item.state === 'empty'}}" class="ci-cal__cell"></view><view wx:else class="ci-cal__cell ci-cal__cell--{{item.state}} {{item.id ? 'xy-tap' : ''}}" data-id="{{item.id}}" bindtap="openReceipt" role="{{item.id ? 'button' : ''}}" aria-label="{{item.id ? item.day + '日已签到，查看回执' : ''}}"><text>{{item.day}}</text></view></block></view>
      </view>
    </view>
    <view wx:if="{{recent.length || receiptCoupons.length}}" class="ci-group"><text class="ci-group__title">最近签到</text>
      <view class="ci-list">
        <button wx:for="{{recent}}" wx:key="key" class="ci-row xy-button-reset check-in-receipt" data-id="{{item.key}}" bindtap="openReceipt"><view class="ci-row__main"><text>{{item.date}} · 连续 {{item.streak}} 天</text></view><text class="ci-row__reward">{{item.reward}}</text><text class="ci-row__chev" aria-hidden="true">›</text></button>
        <button wx:for="{{receiptCoupons}}" wx:key="id" class="ci-row xy-button-reset check-in-coupon" data-id="{{item.id}}" bindtap="openCoupon"><view class="ci-row__main"><text>查看签到奖励：{{item.title}}</text></view><text class="ci-row__chev" aria-hidden="true">›</text></button>
      </view>
    </view>
    <text wx:if="{{ruleNote}}" class="ci-foot">{{ruleNote}}奖励以到账记录为准，规则调整不影响已发放的奖励。</text>
  </view>
</view>
